{
  "name": "@adoctra/editor-react",
  "version": "0.0.4",
  "description": "React bindings of the adoctra AsciiDoc editor.",
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "asciidoc",
    "editor",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avskor/adoctra.git",
    "directory": "editor/packages/editor-react"
  },
  "homepage": "https://github.com/avskor/adoctra/blob/master/docs/editor.adoc",
  "bugs": "https://github.com/avskor/adoctra/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node ../../scripts/copy-licenses.mjs"
  },
  "dependencies": {
    "@adoctra/editor-core": "0.0.4"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
