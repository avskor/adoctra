{
  "name": "@adoctra/wasm-preview",
  "version": "0.0.4",
  "description": "The adoctra AsciiDoc parser and HTML converter for the browser (WASM): everything in @adoctra/wasm plus a live preview.",
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "asciidoc",
    "parser",
    "html",
    "wasm",
    "preview"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avskor/adoctra.git",
    "directory": "editor/packages/wasm-preview"
  },
  "homepage": "https://github.com/avskor/adoctra/blob/master/docs/editor.adoc",
  "bugs": "https://github.com/avskor/adoctra/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./pkg/adoctra_wasm_preview.js",
  "types": "./pkg/adoctra_wasm_preview.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/adoctra_wasm_preview.d.ts",
      "default": "./pkg/adoctra_wasm_preview.js"
    },
    "./wasm": "./pkg/adoctra_wasm_preview_bg.wasm"
  },
  "files": [
    "pkg",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "LICENSE-third-party",
    "LICENSE-rouge"
  ],
  "sideEffects": false,
  "scripts": {
    "prepack": "node ../../scripts/copy-licenses.mjs --diagram --rouge"
  }
}
