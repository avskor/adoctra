{
  "name": "@adoctra/wasm",
  "version": "0.0.4",
  "description": "The adoctra AsciiDoc parser for the browser (WASM): syntax tree, editor view, tokens, diagnostics.",
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "asciidoc",
    "parser",
    "wasm",
    "editor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avskor/adoctra.git",
    "directory": "editor/packages/wasm"
  },
  "homepage": "https://github.com/avskor/adoctra/blob/master/docs/editor.adoc",
  "bugs": "https://github.com/avskor/adoctra/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./pkg/adoctra_wasm.js",
  "types": "./pkg/adoctra_wasm.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/adoctra_wasm.d.ts",
      "default": "./pkg/adoctra_wasm.js"
    },
    "./wasm": "./pkg/adoctra_wasm_bg.wasm"
  },
  "files": [
    "pkg",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "LICENSE-third-party"
  ],
  "sideEffects": false,
  "scripts": {
    "prepack": "node ../../scripts/copy-licenses.mjs --diagram"
  }
}
