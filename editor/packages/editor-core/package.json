{
  "name": "@adoctra/editor-core",
  "version": "0.0.5",
  "description": "Framework-free AsciiDoc source editor on CodeMirror 6, driven by the adoctra parser (WASM).",
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "asciidoc",
    "editor",
    "codemirror"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avskor/adoctra.git",
    "directory": "editor/packages/editor-core"
  },
  "homepage": "https://github.com/avskor/adoctra/blob/master/docs/editor.adoc",
  "bugs": "https://github.com/avskor/adoctra/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "node ../../scripts/copy-licenses.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^5.1.1"
  }
}
