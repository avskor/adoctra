{
  "name": "adoctra-editor-workspace",
  "private": true,
  "description": "The adoctra AsciiDoc editor: WASM packages, the framework-free core and the Vue/React bindings.",
  "type": "module",
  "workspaces": [
    "packages/wasm",
    "packages/wasm-preview",
    "packages/editor-core",
    "packages/editor-vue",
    "packages/editor-react",
    "playground"
  ],
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "npm run build -w @adoctra/editor-core && npm run build -w @adoctra/editor-vue -w @adoctra/editor-react",
    "test": "npm run test -w @adoctra/editor-core",
    "dev": "npm run dev -w adoctra-editor-playground",
    "e2e": "node playground/e2e.mjs",
    "version:sync": "node scripts/sync-version.mjs && npm install --package-lock-only --ignore-scripts",
    "version:check": "node scripts/sync-version.mjs --check",
    "pack:check": "bash scripts/publish-npm.sh --dry-run"
  },
  "devDependencies": {
    "binaryen": "^132.0.0"
  }
}
