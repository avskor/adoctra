    {
      "id": "paragraphs",
      "category": "blocks",
      "expect": "pass",
      "source": "First *bold* paragraph.\n\nSecond _italic_ paragraph."
    },
    {
      "id": "attribute-simple",
      "category": "attributes",
      "expect": "pass",
      "source": ":who: World\n\nHello {who}."
    },
    {
