  "cases": [
    {
      "id": "semantic-attr-hard-set",
      "category": "attributes",
      "source": "fixtures/attr-hard-set.adoc",
      "expect": "pass",
      "upstream": {
        "file": "sources/test/attributes_test.rb",
        "line": 305,
        "test": "attribute set via API overrides attribute set in document",
        "adaptation": "Append ifdef/ifndef paragraphs to observe the cash attribute asserted by the Ruby test. Pass the original string host override via CLI; Ruby nil/false/true API variants are outside this string-only adapter. This additional profile compares inline semantic nodes and the explicitly selected header/final attributes instead of HTML; source inputs and resources are unchanged."
      },
      "attributes": {
        "cash": "heroes"
      },
      "semantic_attributes": [
        "cash",
        "sectids",
        "backend",
        "doctype"
      ]
    },
    {
      "id": "semantic-attr-hard-set-unset",
      "category": "attributes",
      "source": "fixtures/attr-hard-set-unset.adoc",
      "expect": "pass",
      "upstream": {
        "file": "sources/test/attributes_test.rb",
        "line": 310,
