            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If we write tests that use JUnit Jupiter, we can reduce code duplication even further, since annotations in JUnit 5 can also be used as meta-annotations. Consider the following example:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@ExtendWith(SpringExtension.class)\n@ContextConfiguration({\"/app-config.xml\", \"/test-data-access-config.xml\"})\n@ActiveProfiles(\"dev\")\n@Transactional\nclass OrderRepositoryTests { }\n\n@ExtendWith(SpringExtension.class)\n@ContextConfiguration({\"/app-config.xml\", \"/test-data-access-config.xml\"})\n@ActiveProfiles(\"dev\")\n@Transactional\nclass UserRepositoryTests { }"
                        }
                      ],
