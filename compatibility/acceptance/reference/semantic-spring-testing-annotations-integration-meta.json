        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If we discover that we are repeating the preceding configuration across our JUnit 4-based test suite, we can reduce the duplication by introducing a custom composed annotation that centralizes the common test configuration for Spring, as follows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@Target(ElementType.TYPE)\n@Retention(RetentionPolicy.RUNTIME)\n@ContextConfiguration({\"/app-config.xml\", \"/test-data-access-config.xml\"})\n@ActiveProfiles(\"dev\")\n@Transactional\npublic @interface TransactionalDevTestConfig { }"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@Target(AnnotationTarget.TYPE)\n@Retention(AnnotationRetention.RUNTIME)\n@ContextConfiguration(\"/app-config.xml\", \"/test-data-access-config.xml\")\n@ActiveProfiles(\"dev\")\n@Transactional\nannotation class TransactionalDevTestConfig { }"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Then we can use our custom "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@TransactionalDevTestConfig"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation to simplify the configuration of individual JUnit 4 based test classes, as follows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@RunWith(SpringRunner.class)\n@TransactionalDevTestConfig\npublic class OrderRepositoryTests { }\n\n@RunWith(SpringRunner.class)\n@TransactionalDevTestConfig\npublic class UserRepositoryTests { }"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@RunWith(SpringRunner::class)\n@TransactionalDevTestConfig\nclass OrderRepositoryTests\n\n@RunWith(SpringRunner::class)\n@TransactionalDevTestConfig\nclass UserRepositoryTests"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
