                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@RunWith(SpringRunner.class)\n@ContextConfiguration({\"/app-config.xml\", \"/test-data-access-config.xml\"})\n@ActiveProfiles(\"dev\")\n@Transactional\npublic class OrderRepositoryTests { }\n\n@RunWith(SpringRunner.class)\n@ContextConfiguration({\"/app-config.xml\", \"/test-data-access-config.xml\"})\n@ActiveProfiles(\"dev\")\n@Transactional\npublic class UserRepositoryTests { }"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@RunWith(SpringRunner::class)\n@ContextConfiguration(\"/app-config.xml\", \"/test-data-access-config.xml\")\n@ActiveProfiles(\"dev\")\n@Transactional\nclass OrderRepositoryTests { }\n\n@RunWith(SpringRunner::class)\n@ContextConfiguration(\"/app-config.xml\", \"/test-data-access-config.xml\")\n@ActiveProfiles(\"dev\")\n@Transactional\nclass UserRepositoryTests { }"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
