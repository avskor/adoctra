            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Many of the theme keys, such as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "border-width"
                  }
                ],
                "kind": "monospace",
                "roles": []
