    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "JUnit Jupiter provides the ability to repeat a test a specified number of times by annotating a method with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RepeatedTest"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and specifying the total number of repetitions desired. Each invocation of a repeated test behaves like the execution of a regular "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Test"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method with full support for the same lifecycle callbacks and extensions."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following example demonstrates how to declare a test named "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "repeatedTest()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " that will be automatically repeated 10 times."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "blocks": [
                            {
                              "context": "listing",
                              "id": null,
                              "inlines": [
                                {
                                  "kind": "text",
                                  "value": "@RepeatedTest(10)\nvoid repeatedTest() {\n\t// ...\n}"
                                }
                              ],
                              "language": "java",
                              "roles": [],
                              "title": null
                            }
                          ],
                          "context": "open",
                          "id": null,
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "blocks": [
                            {
                              "context": "listing",
                              "id": null,
                              "inlines": [
                                {
                                  "kind": "text",
                                  "value": "@RepeatedTest(10)\nfun repeatedTest() {\n    // ...\n}"
                                }
                              ],
                              "language": "kotlin",
                              "roles": [],
                              "title": null
                            }
                          ],
                          "context": "open",
                          "id": null,
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RepeatedTest"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " can be configured with a failure threshold which signifies the number of failures after which remaining repetitions will be automatically skipped. Set the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "failureThreshold"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute to a positive number less than the total number of repetitions in order to skip the invocations of remaining repetitions after the specified number of failures has been encountered."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For example, if you are using "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RepeatedTest"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to repeatedly invoke a test that you suspect to be "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "flaky"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", a single failure is sufficient to demonstrate that the test is flaky, and there is no need to invoke the remaining repetitions. To support that specific use case, set "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "failureThreshold = 1"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". You can alternatively set the threshold to a number greater than 1 depending on your use case."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By default, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "failureThreshold"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute is set to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Integer.MAX_VALUE"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", signaling that no failure threshold will be applied, which effectively means that the specified number of repetitions will be invoked regardless of whether any repetitions fail."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the repetitions of a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RepeatedTest"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method are executed in parallel, no guarantees can be made regarding the failure threshold. It is therefore recommended that a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RepeatedTest"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method be annotated with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Execution(SAME_THREAD)"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " when parallel execution is configured. See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "writing-tests/parallel-execution.html"
                  }
                ],
                "kind": "xref",
                "target": "writing-tests/parallel-execution.html"
              },
              {
                "kind": "text",
                "value": " for further details."
              }
            ],
            "roles": [],
            "title": null,
            "type": "warning"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In addition to specifying the number of repetitions and failure threshold, a custom display name can be configured for each repetition via the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "name"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RepeatedTest"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotation. Furthermore, the display name can be a pattern composed of a combination of static text and dynamic placeholders. The following placeholders are currently supported."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "{displayName}"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ": display name of the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@RepeatedTest"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " method"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "{currentRepetition}"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ": the current repetition count"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "{totalRepetitions}"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ": the total number of repetitions"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The default display name for a given repetition is generated based on the following pattern: "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "\"repetition {currentRepetition} of {totalRepetitions}\""
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ".Thus, the display names for individual repetitions of the previous "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "repeatedTest()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " example would be: "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "repetition 1 of 10"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "repetition 2 of 10"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", etc.If you would like the display name of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RepeatedTest"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method included in the name of each repetition, you can define your own custom pattern or use the predefined "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "RepeatedTest.LONG_DISPLAY_NAME"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " pattern.The latter is equal to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "\"{displayName} :: repetition {currentRepetition} of {totalRepetitions}\""
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " which results in display names for individual repetitions like "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "repeatedTest() :: repetition 1 of 10"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "repeatedTest() :: repetition 2 of 10"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", etc."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In order to retrieve information about the current repetition, the total number of repetitions, the number of repetitions that have failed, and the failure threshold, a developer can choose to have an instance of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "RepetitionInfo"
                      }
                    ],
                    "kind": "xref",
                    "target": "attachment$api/org.junit.jupiter.api/org/junit/jupiter/api/RepetitionInfo.html"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " injected into a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RepeatedTest"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@BeforeEach"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@AfterEach"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "RepeatedTestsDemo"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " class at the end of this section demonstrates several examples of repeated tests."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "repeatedTest()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method is identical to the example from the previous section; whereas, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "repeatedTestWithRepetitionInfo()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " demonstrates how to have an instance of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "RepetitionInfo"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " injected into a test to access the total number of repetitions for the current repeated test."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "repeatedTestWithFailureThreshold()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " demonstrates how to set a failure threshold and simulates an unexpected failure for every second repetition.The resulting behavior can be viewed in the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ConsoleLauncher"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " output at the end of this section."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The next two methods demonstrate how to include a custom "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@DisplayName"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RepeatedTest"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method in the display name of each repetition. "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "customDisplayName()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " combines a custom display name with a custom pattern and then uses "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TestInfo"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to verify the format of the generated display name. "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Repeat!"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "{displayName}"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " which comes from the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@DisplayName"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " declaration, and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "1/1"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " comes from "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "{currentRepetition}/{totalRepetitions}"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ".In contrast, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "customDisplayNameWithLongPattern()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " uses the aforementioned predefined "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "RepeatedTest.LONG_DISPLAY_NAME"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " pattern."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "repeatedTestInGerman()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " demonstrates the ability to translate display names of repeated tests into foreign languages — in this case German, resulting in names for individual repetitions such as: "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Wiederholung 1 von 5"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Wiederholung 2 von 5"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", etc."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Since the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "beforeEach()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method is annotated with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@BeforeEach"
                  }
