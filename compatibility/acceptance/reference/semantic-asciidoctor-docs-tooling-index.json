                    "metadata": {
                      "rel": "noopener",
                      "window": "_blank"
                    },
                    "target": "https://intellij-asciidoc-plugin.ahus1.de/docs/users-guide/quick-start.html"
                  },
                  {
                    "kind": "text",
                    "value": " or "
                  },
                  {
                    "inlines": [
