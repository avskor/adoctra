{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The Spring TestContext Framework provides support for "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "dynamic"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " properties via the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DynamicPropertyRegistry"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@DynamicPropertySource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotation, and the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DynamicPropertyRegistrar"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " API."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The dynamic property source infrastructure was originally designed to allow properties from "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Testcontainers"
                      }
                    ],
                    "kind": "link",
                    "target": "https://www.testcontainers.org"
                  },
                  {
                    "kind": "text",
                    "value": " based tests to be exposed easily to Spring integration tests. However, these features may be used with any form of external resource whose lifecycle is managed outside the test’s "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "ApplicationContext"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " or with beans whose lifecycle is managed by the test’s "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "ApplicationContext"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "admonition",
            "id": null,
            "roles": [],
            "title": null,
            "type": "note"
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Dynamic properties have higher precedence than those loaded from "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@TestPropertySource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", the operating system’s environment, Java system properties, or property sources added by the application declaratively by using "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@PropertySource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or programmatically. Thus, dynamic properties can be used to selectively override properties loaded via "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@TestPropertySource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", system property sources, and application property sources."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "testcontext-ctx-management-dynamic-property-sources-precedence",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Precedence"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DynamicPropertyRegistry"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is used to add "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "name-value"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " pairs to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Environment"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Values are dynamic and provided via a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Supplier"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " which is only invoked when the property is resolved. Typically, method references are used to supply values. The following sections provide examples of how to use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DynamicPropertyRegistry"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "testcontext-ctx-management-dynamic-property-sources-dynamic-property-registry",
        "level": 1,
        "roles": [],
        "title": [
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DynamicPropertyRegistry"
              }
            ],
            "kind": "monospace",
            "roles": []
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In contrast to the "
              },
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@TestPropertySource"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ],
                "kind": "xref",
                "target": "testing/testcontext-framework/ctx-management/property-sources.html"
              },
              {
                "kind": "text",
                "value": " annotation that is applied at the class level, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@DynamicPropertySource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " can be applied to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "static"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " methods in integration test classes in order to add properties with dynamic values to the set of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "PropertySources"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Environment"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " loaded for the integration test."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Methods in integration test classes that are annotated with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@DynamicPropertySource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " must be "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "static"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and must accept a single "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DynamicPropertyRegistry"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " argument. See the class-level javadoc for "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DynamicPropertyRegistry"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " for further details."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If you use "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@DynamicPropertySource"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " in a base class and discover that tests in subclasses fail because the dynamic properties change between subclasses, you may need to annotate your base class with "
                  },
                  {
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "@DirtiesContext"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ],
                    "kind": "xref",
                    "target": "testing/annotations/integration-spring/annotation-dirtiescontext.html"
                  },
                  {
                    "kind": "text",
                    "value": " to ensure that each subclass gets its own "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "ApplicationContext"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " with the correct dynamic properties."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "admonition",
            "id": null,
            "roles": [],
            "title": null,
            "type": "tip"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following example uses the Testcontainers project to manage a Redis container outside of the Spring "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The IP address and port of the managed Redis container are made available to components within the test’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " via the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "redis.host"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "redis.port"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " properties. These properties can be accessed via Spring’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Environment"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " abstraction or injected directly into Spring-managed components – for example, via "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Value(\"${redis.host}\")"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Value(\"${redis.port}\")"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", respectively."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@SpringJUnitConfig(/* ... */)\n@Testcontainers\nclass ExampleIntegrationTests {\n\n\t@Container\n\tstatic GenericContainer redis =\n\t\tnew GenericContainer(\"redis:5.0.3-alpine\").withExposedPorts(6379);\n\n\t@DynamicPropertySource\n\tstatic void redisProperties(DynamicPropertyRegistry registry) {\n\t\tregistry.add(\"redis.host\", redis::getHost);\n\t\tregistry.add(\"redis.port\", redis::getFirstMappedPort);\n\t}\n\n\t// tests ...\n\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@SpringJUnitConfig(/* ... */)\n@Testcontainers\nclass ExampleIntegrationTests {\n\n\tcompanion object {\n\n\t\t@Container\n\t\t@JvmStatic\n\t\tval redis: GenericContainer =\n\t\t\tGenericContainer(\"redis:5.0.3-alpine\").withExposedPorts(6379)\n\n\t\t@DynamicPropertySource\n\t\t@JvmStatic\n\t\tfun redisProperties(registry: DynamicPropertyRegistry) {\n\t\t\tregistry.add(\"redis.host\", redis::getHost)\n\t\t\tregistry.add(\"redis.port\", redis::getFirstMappedPort)\n\t\t}\n\t}\n\n\t// tests ...\n\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "testcontext-ctx-management-dynamic-property-sources-dynamic-property-source",
        "level": 1,
        "roles": [],
        "title": [
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@DynamicPropertySource"
              }
            ],
            "kind": "monospace",
            "roles": []
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "As an alternative to implementing "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@DynamicPropertySource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " methods in integration test classes, you can register implementations of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DynamicPropertyRegistrar"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " API as beans within the test’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Doing so allows you to support additional use cases that are not possible with a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@DynamicPropertySource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method. For example, since a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DynamicPropertyRegistrar"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is itself a bean in the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", it can interact with other beans in the context and register dynamic properties that are sourced from those beans."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Any bean in a test’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " that implements the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DynamicPropertyRegistrar"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " interface will be automatically detected and eagerly initialized before the singleton pre-instantiation phase, and the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "accept()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " methods of such beans will be invoked with a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DynamicPropertyRegistry"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " that performs the actual dynamic property registration on behalf of the registrar."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Any interaction with other beans results in eager initialization of those other beans and their dependencies."
              }
            ],
            "roles": [],
            "title": null,
            "type": "warning"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following example demonstrates how to implement a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DynamicPropertyRegistrar"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " as a lambda expression that registers a dynamic property for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApiServer"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " bean. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "api.url"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " property can be accessed via Spring’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Environment"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " abstraction or injected directly into other Spring-managed components – for example, via "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Value(\"${api.url}\")"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", and the value of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "api.url"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " property will be dynamically retrieved from the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
