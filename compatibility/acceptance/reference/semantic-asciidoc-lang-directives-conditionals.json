                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "ifeval"
                      }
                    ],
                    "kind": "xref",
                    "target": "ifeval.html"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the processor encounters one of these conditionals, it evaluates the specified condition. The condition is based on the presence or value of one or more document attributes. If the condition evaluates to true, the lines the conditional encloses are included. Otherwise, the lines are skipped."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Although a conditional preprocessor directive looks like a block macro, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "it’s not a macro and therefore isn’t processed like one"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". It’s a preprocessor directive; it’s important to understand the distinction."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A "
              },
              {
                "id": "def-preprocessor",
                "inlines": [
                  {
                    "kind": "text",
                    "value": "preprocessor directive"
                  }
                ],
                "kind": "strong",
                "roles": [
                  "term"
                ]
              },
              {
                "kind": "text",
                "value": " is processed when the lines of a document are read, but before the document structure is parsed. Therefore, it’s not aware of the surrounding document structure. A preprocessor directive merely adds lines to the reader or takes lines away. The conditional preprocessor directives determine which lines to add and which ones to take away based on the condition."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_conditional_processing",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Conditional processing"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you don’t want a conditional preprocessor directive to be processed, you must escape it using a backslash."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "\\ifdef::just-an-example[]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Escaping the directive is necessary "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "even if it appears in a verbatim block"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " since it’s not aware of the surrounding document structure."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
