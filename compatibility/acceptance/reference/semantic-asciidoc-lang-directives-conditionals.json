              {
                "kind": "text",
                "value": "You can include or exclude lines of text in your document using the following conditional preprocessor directives:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "inlines": [
