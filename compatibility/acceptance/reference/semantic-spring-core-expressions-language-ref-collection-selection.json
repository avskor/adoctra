{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Selection is a powerful expression language feature that lets you transform a source collection into another collection by selecting from its entries."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Selection uses a syntax of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ".?[selectionExpression]"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". It filters the collection and returns a new collection that contains a subset of the original elements. For example, selection lets us easily get a list of Serbian inventors, as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "List<Inventor> list = (List<Inventor>) parser.parseExpression(\n\t\t\"members.?[nationality == 'Serbian']\").getValue(societyContext);"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "val list = parser.parseExpression(\n\t\t\"members.?[nationality == 'Serbian']\").getValue(societyContext) as List<Inventor>"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Selection is supported for arrays and anything that implements "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "java.lang.Iterable"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "java.util.Map"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". For an array or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Iterable"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", the selection expression is evaluated against each individual element. Against a map, the selection expression is evaluated against each map entry (objects of the Java type "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Map.Entry"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "). Each map entry has its "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "key"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "value"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " accessible as properties for use in the selection."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Given a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Map"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " stored in a variable named "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "#map"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", the following expression returns a new map that consists of those elements of the original map where the entry’s value is less than 27:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Map newMap = parser.parseExpression(\"#map.?[value < 27]\").getValue(Map.class);"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "val newMap = parser.parseExpression(\"#map.?[value < 27]\").getValue() as Map"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "In addition to returning all the selected elements, you can retrieve only the first or the last element. To obtain the first element matching the selection expression, the syntax is "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ".^[selectionExpression]"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". To obtain the last element matching the selection expression, the syntax is "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ".$[selectionExpression]"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The Spring Expression Language also supports safe navigation for collection selection."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Safe Collection Selection and Projection"
                  }
                ],
                "kind": "xref",
                "target": "core/expressions/language-ref/operator-safe-navigation.html#expressions-operator-safe-navigation-selection-and-projection"
              },
              {
                "kind": "text",
                "value": " for details."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "admonition",
        "id": null,
        "roles": [],
        "title": null,
        "type": "note"
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Collection Selection"
      }
    ]
  }
}
