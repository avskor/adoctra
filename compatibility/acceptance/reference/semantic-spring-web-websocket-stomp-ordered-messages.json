    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Messages from the broker are published to the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "clientOutboundChannel"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", from where they are written to WebSocket sessions. As the channel is backed by a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ThreadPoolExecutor"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", messages are processed in different threads, and the resulting sequence received by the client may not match the exact order of publication."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "To enable ordered publishing, set the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "setPreservePublishOrder"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " flag as follows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./PublishOrderWebSocketConfiguration[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "When the flag is set, messages within the same client session are published to the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "clientOutboundChannel"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " one at a time, so that the order of publication is guaranteed. Note that this incurs a small performance overhead, so you should enable it only if it is required."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The same also applies to messages from the client, which are sent to the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "clientInboundChannel"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", from where they are handled according to their destination prefix. As the channel is backed by a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ThreadPoolExecutor"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", messages are processed in different threads, and the resulting sequence of handling may not match the exact order in which they were received."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "To enable ordered publishing, set the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "setPreserveReceiveOrder"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " flag as follows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./ReceiveOrderWebSocketConfiguration[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Order of Messages"
      }
    ]
  }
}
