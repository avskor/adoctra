            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "--cache-dir"
                      }
                    ],
                    "kind": "xref",
                    "target": "cli:options.html#cache-dir"
                  },
                  {
                    "kind": "text",
                    "value": " option from the CLI,"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "ANTORA_CACHE_DIR environment variable"
                      }
                    ],
                    "kind": "xref",
                    "target": "playbook:environment-variables.html"
                  },
                  {
                    "kind": "text",
                    "value": ", or"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "cache_dir key"
                      }
                    ],
                    "kind": "xref",
                    "target": "playbook:runtime-cache-dir.html"
                  },
                  {
                    "kind": "text",
                    "value": " in the playbook."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          }
        ],
        "context": "section",
        "id": "override-the-default-cache-location",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Override the default cache location"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want Antora to update the cache on subsequent runs, pass the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--fetch option"
                  }
                ],
                "kind": "xref",
                "target": "cli:options.html#fetch"
              },
              {
                "kind": "text",
                "value": " to the Antora CLI or set the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fetch key"
                  }
                ],
                "kind": "xref",
                "target": "playbook:runtime-fetch.html"
              },
              {
                "kind": "text",
                "value": " to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "true"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in the playbook. This switch will force Antora to run a fetch operation on each repository it previously cloned. It will also force Antora to download a fresh copy of the UI bundle, if the URL is remote and the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "snapshot key"
                  }
                ],
                "kind": "xref",
                "target": "playbook:ui-bundle-url.html#snapshot"
              },
              {
                "kind": "text",
                "value": " is "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "true"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "update-the-cache",
        "level": 1,
