            "inlines": [
              {
                "kind": "text",
                "value": "When Antora runs the first time, it will save resources it fetches over the network in a local cache. Antora caches two types of resources:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "cloned git repositories"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "downloaded UI bundles"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Antora stores these resources in the cache directory, which are further organized under the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "content"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ui"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " folders, respectively. The "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "default cache directory"
                  }
                ],
                "kind": "xref",
                "target": "playbook:runtime-cache-dir.html#default"
              },
              {
                "kind": "text",
                "value": " varies by operating system."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "about-antoras-cache",
        "level": 1,
