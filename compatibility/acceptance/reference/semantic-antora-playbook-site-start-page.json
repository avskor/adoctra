    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When you assign the valid resource ID of a page to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "start_page"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key in your playbook, site visitors will be redirected from the site’s index page at the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "site URL"
                  }
                ],
                "kind": "xref",
                "target": "site-url.html"
              },
              {
                "kind": "text",
                "value": " to the URL of the start page."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "start_page"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is optional. It’s configured under the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "site key"
                  }
                ],
                "kind": "xref",
                "target": "configure-site.html"
              },
              {
                "kind": "text",
                "value": " in a playbook."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "site:\n  title: Site Title\n  url: https://example.org\n  start_page: component:module:file-coordinate-of-page.adoc"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can use any page that belongs to a component version as the index page for your site. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "start_page"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key accepts the resource ID of a page as a value. "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The resource ID must include the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "component, module, and file coordinates"
                      }
                    ],
                    "kind": "xref",
                    "target": "page:resource-id-coordinates.html#id-component"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "version coordinate"
                  }
                ],
                "kind": "xref",
                "target": "page:resource-id-coordinates.html#id-version"
              },
              {
                "kind": "text",
                "value": " can be specified if you want to use a specific version of a page instead of the latest version. Alternatively, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "start_page"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " can be assigned from the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CLI"
                  }
                ],
                "kind": "xref",
                "target": "cli:options.html#start-page"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If your site has a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "versionless component named ROOT"
                  }
                ],
                "kind": "xref",
                "target": "ROOT:component-name-key.html#root-component"
              },
              {
                "kind": "text",
                "value": " (i.e., name: ROOT, version: ~), that component will be published to the root of the site. The component name will not appear in the URL of those pages. That means that the index.adoc page in the ROOT module (i.e., modules/ROOT/pages/index.adoc) of the versionless ROOT component implicitly acts as the site start page without having to specify it in the playbook. In other words, the site start page is effectively "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ROOT::index.adoc"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". If you specify a different site start page in this case, it will be ignored since the site already has a start page."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "start-page-key",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "start_page key"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To have the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "start_page"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key always point to the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "latest version"
                  }
                ],
                "kind": "xref",
                "target": "ROOT:how-component-versions-are-sorted.html#latest-version"
              },
              {
                "kind": "text",
                "value": " of the specified page, don’t enter the version coordinate in the resource ID of the page."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "site:\n  title: Demo Docs Site\n  url: https://demo.antora.org\n  start_page: component-b::index.adoc"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For this example, let’s say that version 2.0 is the latest version of Component B. In this case, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "https://demo.antora.org/index.html"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " will redirect to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "https://demo.antora.org/component-b/2.0/index.html"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "use-a-pages-latest-version",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Use a page’s latest version"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want the site’s start page to be a specific version of the designated page, include the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "version coordinate in the resource ID"
                  }
                ],
                "kind": "xref",
                "target": "page:resource-id-coordinates.html#id-version"
