            "inlines": [
              {
                "kind": "text",
                "value": "You can convert Atlassian Confluence XHTML pages to Asciidoctor using this Groovy script."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The script calls "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Pandoc"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://pandoc.org"
              },
              {
                "kind": "text",
                "value": " to convert single or multiple HTML files exported from Confluence to AsciiDoc files. You’ll need Pandoc installed before running this script. If you have trouble running this script, you can use the Pandoc command referenced inside the script to convert XHTML files to AsciiDoc manually."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "// This script is provided by melix.\n// The source can be found at https://gist.github.com/melix/6020336\n\n@Grab('net.sourceforge.htmlcleaner:htmlcleaner:2.4')\nimport org.htmlcleaner.*\n\ndef src = new File('html').toPath()\ndef dst = new File('asciidoc').toPath()\n\ndef cleaner = new HtmlCleaner()\ndef props = cleaner.properties\nprops.translateSpecialEntities = false\ndef serializer = new SimpleHtmlSerializer(props)\n\nsrc.toFile().eachFileRecurse { f ->\n    def relative = src.relativize(f.toPath())\n    def target = dst.resolve(relative)\n    if (f.isDirectory()) {\n        target.toFile().mkdir()\n    } else if (f.name.endsWith('.html')) {\n        def tmpHtml = File.createTempFile('clean', 'html')\n        println \"Converting $relative\"\n        def result = cleaner.clean(f)\n        result.traverse({ tagNode, htmlNode ->\n                tagNode?.attributes?.remove 'class'\n                if ('td' == tagNode?.name || 'th'==tagNode?.name) {\n                    tagNode.name='td'\n                    String txt = tagNode.text\n                    tagNode.removeAllChildren()\n                    tagNode.insertChild(0, new ContentNode(txt))\n                }\n\n            true\n        } as TagNodeVisitor)\n        serializer.writeToFile(\n                result, tmpHtml.absolutePath, \"utf-8\"\n        )\n        \"pandoc -f html-native_divs -t asciidoctor $tmpHtml --wrap=none -o ${target}.adoc\".execute().waitFor()\n        tmpHtml.delete()\n    }/* else {\n        \"cp html/$relative $target\".execute()\n    }*/\n}"
              }
            ],
