        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can use the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ModelAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "ulist",
        "id": null,
        "items": [
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "On a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "method argument"
                  }
                ],
                "kind": "xref",
                "target": "web/webflux/controller/ann-methods/modelattrib-method-args.html"
              },
              {
                "kind": "text",
                "value": " in "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RequestMapping"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " methods to create or access an Object from the model and to bind it to the request through a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "WebDataBinder"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "As a method-level annotation in "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Controller"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@ControllerAdvice"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " classes, helping to initialize the model prior to any "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RequestMapping"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method invocation."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "On a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RequestMapping"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method to mark its return value as a model attribute."
              }
            ]
          }
        ],
        "roles": [],
        "style": null,
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "This section discusses "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ModelAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " methods, or the second item from the preceding list. A controller can have any number of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ModelAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " methods. All such methods are invoked before "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestMapping"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " methods in the same controller. A "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ModelAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method can also be shared across controllers through "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ControllerAdvice"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". See the section on "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Controller Advice"
              }
            ],
            "kind": "xref",
            "target": "web/webflux/controller/ann-advice.html"
          },
          {
            "kind": "text",
            "value": " for more details."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ModelAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " methods have flexible method signatures. They support many of the same arguments as "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestMapping"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " methods (except for "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ModelAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " itself and anything related to the request body)."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following example uses a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ModelAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@ModelAttribute\npublic void populateModel(@RequestParam String number, Model model) {\n\tmodel.addAttribute(accountRepository.findAccount(number));\n\t// add more ...\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@ModelAttribute\nfun populateModel(@RequestParam number: String, model: Model) {\n\tmodel.addAttribute(accountRepository.findAccount(number))\n\t// add more ...\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
