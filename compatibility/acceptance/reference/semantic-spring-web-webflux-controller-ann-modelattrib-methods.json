      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "When a name is not explicitly specified, a default name is chosen based on the type, as explained in the javadoc for "
          },
          {
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Conventions"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "kind": "link",
            "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/core/Conventions.html"
          },
          {
            "kind": "text",
            "value": ". You can always assign an explicit name by using the overloaded "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "addAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method or through the name attribute on "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ModelAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " (for a return value)."
          }
        ],
        "roles": [],
        "title": null,
        "type": "note"
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Spring WebFlux, unlike Spring MVC, explicitly supports reactive types in the model (for example, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Mono<Account>"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "io.reactivex.Single<Account>"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "). Such asynchronous model attributes can be transparently resolved (and the model updated) to their actual values at the time of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestMapping"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " invocation, provided a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ModelAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " argument is declared without a wrapper, as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@ModelAttribute\npublic void addAccount(@RequestParam String number) {\n    Mono<Account> accountMono = accountRepository.findAccount(number);\n    model.addAttribute(\"account\", accountMono);\n}\n\n@PostMapping(\"/accounts\")\npublic String handle(@ModelAttribute Account account, BindingResult errors) {\n\t// ...\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "import org.springframework.ui.set\n\n@ModelAttribute\nfun addAccount(@RequestParam number: String) {\n\tval accountMono: Mono<Account> = accountRepository.findAccount(number)\n\tmodel[\"account\"] = accountMono\n}\n\n@PostMapping(\"/accounts\")\nfun handle(@ModelAttribute account: Account, errors: BindingResult): String {\n\t// ...\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "In addition, any model attributes that have a reactive type wrapper are resolved to their actual values (and the model updated) just prior to view rendering."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can also use "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ModelAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " as a method-level annotation on "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestMapping"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " methods, in which case the return value of the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestMapping"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method is interpreted as a model attribute. This is typically not required, as it is the default behavior in HTML controllers, unless the return value is a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "String"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " that would otherwise be interpreted as a view name. "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ModelAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " can also help to customize the model attribute name, as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@GetMapping(\"/accounts/{id}\")\n@ModelAttribute(\"myAccount\")\npublic Account handle() {\n\t// ...\n\treturn account;\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@GetMapping(\"/accounts/{id}\")\n@ModelAttribute(\"myAccount\")\nfun handle(): Account {\n\t// ...\n\treturn account\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
