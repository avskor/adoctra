        "head": [
          [
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "inlines": [
                {
                  "kind": "text",
                  "value": "Event name"
                }
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            },
            {
              "background": null,
              "colspan": 1,
