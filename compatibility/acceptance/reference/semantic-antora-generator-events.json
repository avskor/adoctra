                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            }
          ],
          [
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "kind": "text",
                    "value": "contextClosed"
                  },
                  {
                    "id": null,
                    "index": "6",
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Listeners of the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "contextClosed"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " event are expected to catch their own errors so all listeners are notified."
                      }
                    ],
                    "kind": "footnote",
                    "type": "definition"
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            },
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "kind": "text",
                    "value": "(any variable still in scope at the time the context is closed)"
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            }
          ]
        ],
        "caption": [
          {
            "kind": "text",
            "value": "Table 1. "
          }
        ],
        "columns": [
          {
            "autowidth": false,
            "halign": "left",
