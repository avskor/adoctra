        "inlines": [
          {
            "kind": "text",
            "value": "By default, date and time fields not annotated with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@DateTimeFormat"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " are converted from strings by using the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DateFormat.SHORT"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " style. If you prefer, you can change this by defining your own global format."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "To do that, ensure that Spring does not register default formatters. Instead, register formatters manually with the help of:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "ulist",
        "id": null,
