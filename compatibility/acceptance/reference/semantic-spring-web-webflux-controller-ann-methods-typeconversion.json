            ]
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Some annotated controller method arguments that represent String-based request input (for example, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestParam"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestHeader"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@PathVariable"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@MatrixVariable"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@CookieValue"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ") can require type conversion if the argument is declared as something other than "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "String"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "For such cases, type conversion is automatically applied based on the configured converters. By default, simple types (such as "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "int"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "long"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Date"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", and others) are supported. Type conversion can be customized through a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebDataBinder"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " (see "
          },
          {
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DataBinder"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "kind": "xref",
            "target": "web/webflux/controller/ann-initbinder.html"
          },
          {
            "kind": "text",
            "value": ") or by registering "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Formatters"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " with the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "FormattingConversionService"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " (see "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Spring Field Formatting"
              }
            ],
            "kind": "xref",
            "target": "core/validation/format.html"
          },
          {
            "kind": "text",
            "value": ")."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "A practical issue in type conversion is the treatment of an empty String source value. Such a value is treated as missing if it becomes "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "null"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " as a result of type conversion. This can be the case for "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Long"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "UUID"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", and other target types. If you want to allow "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "null"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " to be injected, either use the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "required"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " flag on the argument annotation, or declare the argument as "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Nullable"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Type Conversion"
      }
    ]
  }
