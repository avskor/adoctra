                "target": "https://groovy.jfrog.io/artifactory/libs-release-local/"
              },
              {
                "kind": "text",
                "value": ". Please see the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "download page"
                  }
                ],
                "kind": "link",
                "target": "https://groovy.apache.org/download.html#buildtools"
              },
              {
                "kind": "text",
                "value": " for available modules for each Groovy version."
