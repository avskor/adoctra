        "context": "section",
        "id": "_maven_repository",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Maven Repository"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This tool makes installing Groovy on any Bash platform (Mac OSX, Linux, Cygwin, Solaris or FreeBSD) very easy."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Simply open a new terminal and enter:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ curl -s \"https://get.sdkman.io\" | bash"
              }
            ],
            "language": "shell",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Follow the instructions on-screen to complete installation."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Open a new terminal or type the command:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ source \"$HOME/.sdkman/bin/sdkman-init.sh\""
              }
            ],
            "language": "shell",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Then install the latest stable Groovy:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ sdk install groovy"
              }
            ],
            "language": "shell",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "After installation is complete and you’ve made it your default version, test it with:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ groovy -version"
              }
            ],
            "language": "shell",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "That’s all there is to it!"
              }
            ],
            "roles": [],
            "title": null
          }
        ],
