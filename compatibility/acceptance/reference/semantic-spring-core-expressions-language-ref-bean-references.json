      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "To access a factory bean itself, you should instead prefix the bean name with an "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "&"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " symbol. The following example shows how to do so:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
