        "inlines": [
          {
            "kind": "text",
            "value": "If the evaluation context has been configured with a bean resolver, you can look up beans from an expression by using the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " symbol as a prefix. The following example shows how to do so:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "ExpressionParser parser = new SpelExpressionParser();\nStandardEvaluationContext context = new StandardEvaluationContext();\ncontext.setBeanResolver(new MyBeanResolver());\n\n// This will end up calling resolve(context, \"someBean\") on MyBeanResolver\n// during evaluation.\nObject bean = parser.parseExpression(\"@someBean\").getValue(context);"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "val parser = SpelExpressionParser()\nval context = StandardEvaluationContext()\ncontext.setBeanResolver(MyBeanResolver())\n\n// This will end up calling resolve(context, \"someBean\") on MyBeanResolver\n// during evaluation.\nval bean = parser.parseExpression(\"@someBean\").getValue(context)"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
