    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "In a Servlet environment, you have the option of configuring the Servlet container programmatically as an alternative or in combination with a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "web.xml"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " file. The following example registers a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DispatcherServlet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ":"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "import org.springframework.web.WebApplicationInitializer;\n\npublic class MyWebApplicationInitializer implements WebApplicationInitializer {\n\n\t@Override\n\tpublic void onStartup(ServletContext container) {\n\t\tXmlWebApplicationContext appContext = new XmlWebApplicationContext();\n\t\tappContext.setConfigLocation(\"/WEB-INF/spring/dispatcher-config.xml\");\n\n\t\tServletRegistration.Dynamic registration = container.addServlet(\"dispatcher\", new DispatcherServlet(appContext));\n\t\tregistration.setLoadOnStartup(1);\n\t\tregistration.addMapping(\"/\");\n\t}\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "import org.springframework.web.WebApplicationInitializer\n\nclass MyWebApplicationInitializer : WebApplicationInitializer {\n\n\toverride fun onStartup(container: ServletContext) {\n\t\tval appContext = XmlWebApplicationContext()\n\t\tappContext.setConfigLocation(\"/WEB-INF/spring/dispatcher-config.xml\")\n\n\t\tval registration = container.addServlet(\"dispatcher\", DispatcherServlet(appContext))\n\t\tregistration.setLoadOnStartup(1)\n\t\tregistration.addMapping(\"/\")\n\t}\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebApplicationInitializer"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is an interface provided by Spring MVC that ensures your implementation is detected and automatically used to initialize any Servlet 3 container. An abstract base class implementation of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebApplicationInitializer"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " named "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "AbstractDispatcherServletInitializer"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " makes it even easier to register the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DispatcherServlet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " by overriding methods to specify the servlet mapping and the location of the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DispatcherServlet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " configuration."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "This is recommended for applications that use Java-based Spring configuration, as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "public class MyWebAppInitializer extends AbstractAnnotationConfigDispatcherServletInitializer {\n\n\t@Override\n\tprotected Class<?>[] getRootConfigClasses() {\n\t\treturn null;\n\t}\n\n\t@Override\n\tprotected Class<?>[] getServletConfigClasses() {\n\t\treturn new Class<?>[] { MyWebConfig.class };\n\t}\n\n\t@Override\n\tprotected String[] getServletMappings() {\n\t\treturn new String[] { \"/\" };\n\t}\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "class MyWebAppInitializer : AbstractAnnotationConfigDispatcherServletInitializer() {\n\n\toverride fun getRootConfigClasses(): Array<Class<*>>? {\n\t\treturn null\n\t}\n\n\toverride fun getServletConfigClasses(): Array<Class<*>>? {\n\t\treturn arrayOf(MyWebConfig::class.java)\n\t}\n\n\toverride fun getServletMappings(): Array<String> {\n\t\treturn arrayOf(\"/\")\n\t}\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If you use XML-based Spring configuration, you should extend directly from "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "AbstractDispatcherServletInitializer"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "public class MyWebAppInitializer extends AbstractDispatcherServletInitializer {\n\n\t@Override\n\tprotected WebApplicationContext createRootApplicationContext() {\n\t\treturn null;\n\t}\n\n\t@Override\n\tprotected WebApplicationContext createServletApplicationContext() {\n\t\tXmlWebApplicationContext cxt = new XmlWebApplicationContext();\n\t\tcxt.setConfigLocation(\"/WEB-INF/spring/dispatcher-config.xml\");\n\t\treturn cxt;\n\t}\n\n\t@Override\n\tprotected String[] getServletMappings() {\n\t\treturn new String[] { \"/\" };\n\t}\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "class MyWebAppInitializer : AbstractDispatcherServletInitializer() {\n\n\toverride fun createRootApplicationContext(): WebApplicationContext? {\n\t\treturn null\n\t}\n\n\toverride fun createServletApplicationContext(): WebApplicationContext {\n\t\treturn XmlWebApplicationContext().apply {\n\t\t\tsetConfigLocation(\"/WEB-INF/spring/dispatcher-config.xml\")\n\t\t}\n\t}\n\n\toverride fun getServletMappings(): Array<String> {\n\t\treturn arrayOf(\"/\")\n\t}\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "AbstractDispatcherServletInitializer"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " also provides a convenient way to add "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Filter"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " instances and have them be automatically mapped to the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DispatcherServlet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "public class MyWebAppInitializer extends AbstractDispatcherServletInitializer {\n\n\t// ...\n\n\t@Override\n\tprotected Filter[] getServletFilters() {\n\t\treturn new Filter[] {\n\t\t\tnew HiddenHttpMethodFilter(), new CharacterEncodingFilter() };\n\t}\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "class MyWebAppInitializer : AbstractDispatcherServletInitializer() {\n\n\t// ...\n\n\toverride fun getServletFilters(): Array<Filter> {\n\t\treturn arrayOf(HiddenHttpMethodFilter(), CharacterEncodingFilter())\n\t}\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Each filter is added with a default name based on its concrete type and automatically mapped to the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DispatcherServlet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "isAsyncSupported"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " protected method of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "AbstractDispatcherServletInitializer"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " provides a single place to enable async support on the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DispatcherServlet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and all filters mapped to it. By default, this flag is set to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "true"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Finally, if you need to further customize the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DispatcherServlet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " itself, you can override the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "createDispatcherServlet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method."
          }
        ],
        "roles": [],
        "title": null
      }
    ],
