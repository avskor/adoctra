            "kind": "text",
            "value": "Button macro syntax"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Trying to explain how to select a menu item can be a pain. With the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "menu"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " macro, the symbols do the work."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-menu",
            "inlines": [
              {
                "kind": "text",
                "value": "To save the file, select menu:File[Save].\n\nSelect menu:View[Zoom > Reset] to reset the zoom level to the default setting."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Using the menu macro syntax"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The instructions in "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 2"
                  }
                ],
                "kind": "xref",
                "target": "#ex-menu"
              },
              {
                "kind": "text",
                "value": " appear below."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "To save the file, select menu:File[Save]."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Select menu:View[Zoom > Reset] to reset the zoom level to the default setting."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the menu has more than one item, it can be expressed using a shorthand."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The shorthand syntax for menu is not on a standards track. You can use it for transient documents, but do not rely on it long term."
              }
            ],
            "roles": [],
            "title": null,
            "type": "important"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In the shorthand syntax:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "each item is separated by a greater than sign ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": ">"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ") with spaces on either side"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "the whole expression must be enclosed in double quotes ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "\""
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ")"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The text of the item itself may contain spaces."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-menu-short",
            "inlines": [
              {
                "kind": "text",
                "value": "Select \"Zoom > Reset\" to reset the zoom level."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Using the shorthand menu syntax"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The shorthand syntax can be escaped by preceding the opening double quote with a backslash character."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Both the menu macro and menu shorthand require the first menu item start with a word character (alphanumeric character or underscore) or ampersand (to accommodate a character reference). If you need the first menu item to start with a non-word character, you will need to substitute it with the equivalent character reference. For example, to make a menu item that starts with vertical ellipsis, you must use "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "&#8942;"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-menu-short-charref",
            "inlines": [
              {
                "kind": "text",
                "value": "Select \"&#8942; > More Tools > Extensions\" to find and enable extensions."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Using a character reference at the start of the menu"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Subsequent menu items don’t have this requirement and thus can start with any character."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_menu_macro_syntax",
        "level": 1,
