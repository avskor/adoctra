    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can extend SpEL by registering user-defined functions that can be called within expressions by using the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "#functionName(…​)"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " syntax. Functions can be registered as variables in "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "EvaluationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " implementations via the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "setVariable()"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "StandardEvaluationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " also defines "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "registerFunction(…​)"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " methods that provide a convenient way to register a function as a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "java.lang.reflect.Method"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "java.lang.invoke.MethodHandle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "admonition",
        "id": null,
        "roles": [],
        "title": null,
        "type": "tip"
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Since functions share a common namespace with "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "variables"
                  }
                ],
                "kind": "xref",
                "target": "core/expressions/language-ref/variables.html"
              },
              {
                "kind": "text",
                "value": " in the evaluation context, care must be taken to ensure that function names and variable names do not overlap."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "admonition",
        "id": null,
        "roles": [],
        "title": null,
        "type": "warning"
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following example shows how to register a user-defined function to be invoked via reflection using a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "java.lang.reflect.Method"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ":"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Method method = ...;\n\nEvaluationContext context = SimpleEvaluationContext.forReadOnlyDataBinding().build();\ncontext.setVariable(\"myFunction\", method);"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "val method: Method = ...\n\nval context = SimpleEvaluationContext.forReadOnlyDataBinding().build()\ncontext.setVariable(\"myFunction\", method)"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "For example, consider the following utility method that reverses a string:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "public abstract class StringUtils {\n\n\tpublic static String reverseString(String input) {\n\t\treturn new StringBuilder(input).reverse().toString();\n\t}\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "fun reverseString(input: String): String {\n\treturn StringBuilder(input).reverse().toString()\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can register and use the preceding method, as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "ExpressionParser parser = new SpelExpressionParser();\n\nEvaluationContext context = SimpleEvaluationContext.forReadOnlyDataBinding().build();\ncontext.setVariable(\"reverseString\",\n\t\tStringUtils.class.getMethod(\"reverseString\", String.class));\n\n// evaluates to \"olleh\"\nString helloWorldReversed = parser.parseExpression(\n\t\t\"#reverseString('hello')\").getValue(context, String.class);"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "val parser = SpelExpressionParser()\n\nval context = SimpleEvaluationContext.forReadOnlyDataBinding().build()\ncontext.setVariable(\"reverseString\", ::reverseString.javaMethod)\n\n// evaluates to \"olleh\"\nval helloWorldReversed = parser.parseExpression(\n\t\t\"#reverseString('hello')\").getValue(context, String::class.java)"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "A function can also be registered as a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "java.lang.invoke.MethodHandle"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". This enables potentially more efficient use cases if the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MethodHandle"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " target and parameters have been fully bound prior to registration; however, partially bound handles are also supported."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Consider the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "String#formatted(String, Object…​)"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " instance method, which produces a message according to a template and a variable number of arguments."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can register and use the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "formatted"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method as a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MethodHandle"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "ExpressionParser parser = new SpelExpressionParser();\nEvaluationContext context = SimpleEvaluationContext.forReadOnlyDataBinding().build();\n\nMethodHandle mh = MethodHandles.lookup().findVirtual(String.class, \"formatted\",\n\t\tMethodType.methodType(String.class, Object[].class));\ncontext.setVariable(\"message\", mh);\n\n// evaluates to \"Simple message: <Hello World>\"\nString message = parser.parseExpression(\"#message('Simple message: <%s>', 'Hello World', 'ignored')\")\n\t\t.getValue(context, String.class);"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "val parser = SpelExpressionParser()\nval context = SimpleEvaluationContext.forReadOnlyDataBinding().build()\n\nval mh = MethodHandles.lookup().findVirtual(String::class.java, \"formatted\",\n\t\tMethodType.methodType(String::class.java, Array<Any>::class.java))\ncontext.setVariable(\"message\", mh)\n\n// evaluates to \"Simple message: <Hello World>\"\nval message = parser.parseExpression(\"#message('Simple message: <%s>', 'Hello World', 'ignored')\")\n\t\t.getValue(context, String::class.java)"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "As hinted above, binding a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MethodHandle"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and registering the bound "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MethodHandle"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is also supported. This is likely to be more performant if both the target and all the arguments are bound. In that case no arguments are necessary in the SpEL expression, as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "ExpressionParser parser = new SpelExpressionParser();\nEvaluationContext context = SimpleEvaluationContext.forReadOnlyDataBinding().build();\n\nString template = \"This is a %s message with %s words: <%s>\";\nObject varargs = new Object[] { \"prerecorded\", 3, \"Oh Hello World!\", \"ignored\" };\nMethodHandle mh = MethodHandles.lookup().findVirtual(String.class, \"formatted\",\n\t\tMethodType.methodType(String.class, Object[].class))\n\t\t.bindTo(template)\n\t\t.bindTo(varargs); //here we have to provide arguments in a single array binding\ncontext.setVariable(\"message\", mh);\n\n// evaluates to \"This is a prerecorded message with 3 words: <Oh Hello World!>\"\nString message = parser.parseExpression(\"#message()\")\n\t\t.getValue(context, String.class);"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "val parser = SpelExpressionParser()\nval context = SimpleEvaluationContext.forReadOnlyDataBinding().build()\n\nval template = \"This is a %s message with %s words: <%s>\"\nval varargs = arrayOf(\"prerecorded\", 3, \"Oh Hello World!\", \"ignored\")\n\nval mh = MethodHandles.lookup().findVirtual(String::class.java, \"formatted\",\n\t\tMethodType.methodType(String::class.java, Array<Any>::class.java))\n\t\t.bindTo(template)\n\t\t.bindTo(varargs) //here we have to provide arguments in a single array binding\ncontext.setVariable(\"message\", mh)\n\n// evaluates to \"This is a prerecorded message with 3 words: <Oh Hello World!>\"\nval message = parser.parseExpression(\"#message()\")\n\t\t.getValue(context, String::class.java)"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
