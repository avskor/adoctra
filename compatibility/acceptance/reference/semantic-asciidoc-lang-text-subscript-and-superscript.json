            "inlines": [
              {
                "kind": "text",
                "value": "Superscript and subscript have unique boundary constraints in AsciiDoc that are neither constrained nor unconstrained. Rather, they are unconstrained with the key restriction that the text must be continuous. (It may not contain spaces). This restriction is in place to avoid unexpected behavior where "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "~"
                  }
                ],
                "kind": "monospace",
                "roles": []
