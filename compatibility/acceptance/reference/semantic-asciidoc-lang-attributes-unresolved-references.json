              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "attribute-undefined"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attributes. You’ll want to think about how you want the processor to handle these situations and configure the processor accordingly."
              }
            ],
            "roles": [],
            "title": null
          }
