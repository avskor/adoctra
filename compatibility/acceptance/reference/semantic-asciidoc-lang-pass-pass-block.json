            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A passthrough block is delimited by four plus signs ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "++++"
                  }
