                    "value": "subs attribute to specify a comma-separated list of substitutions"
                  }
                ],
                "kind": "xref",
                "target": "subs:apply-subs-to-blocks.html"
              },
              {
                "kind": "text",
                "value": ". These substitutions will be applied to the content prior to it being reintroduced to the output document."
              }
