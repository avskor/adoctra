        "inlines": [
          {
            "kind": "text",
            "value": "The PHP language has two modes. It can either be used as a standalone language (pure mode) or it can be mixed with HTML (mixed mode) by putting it inside PHP tags (a form that resembles an XML processing instruction). This presents some challenges for the syntax highlighter."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If the code in the source block is pure PHP, you should use the language tag "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "php"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". For example:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "listing",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "[source,php]\n----\necho \"Hello, World!\";\n----"
          }
        ],
        "language": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If the PHP source is mixed with HTML, you should either use the language tag "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "html+php"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", as shown here:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "listing",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "[source,html+php]\n----\n<p>\n<?php echo \"Hello, World!\"; ?>\n</p>\n----"
          }
        ],
        "language": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Or you should use the language tag "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "php"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
