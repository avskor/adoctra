            "kind": "text",
            "value": " and set the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "mixed"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " option on the source block, as shown here:"
          }
        ],
        "roles": [],
        "title": null
      },
