              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "basic"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " style is displayed as:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
