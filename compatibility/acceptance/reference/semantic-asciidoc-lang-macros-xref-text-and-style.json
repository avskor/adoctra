        "context": "section",
        "id": "_cross_reference_styles",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Cross reference styles"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can use document attributes to customize the signifier that is placed in front of the reference’s number. This "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "reference signifier"
                  }
                ],
                "kind": "strong",
                "roles": [
                  "term"
                ]
              },
              {
                "kind": "text",
                "value": " indicates the reference’s type (e.g., Chapter or Section)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "chapter-refsig"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " — defines the signifier to use for a cross reference to a chapter (default: Chapter)"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "section-refsig"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " — defines the signifier to use for a cross reference to a section (default: Section)"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "appendix-refsig"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " — defines the signifier to use for a cross reference to an appendix (default: Appendix)"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "(The signifier attribute for a part cross reference will be introduced once numeration is supported for parts)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For example, to customize the word “Section”, define the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "section-refsig"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute in the document header:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ":section-refsig: Sect."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "full"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " xrefstyle would then be displayed as:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Sect. 2.3, “Installation”"
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "short"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " xrefstyle would be displayed as:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Sect. 2.3"
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you unset the attribute, the signifier is dropped from the cross reference text. For example:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ":!section-refsig:"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In this case, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "full"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " xrefstyle will display only the number and title:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "2.3, “Installation”"
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "short"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " xrefstyle will fall back to the number only:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "2.3"
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
