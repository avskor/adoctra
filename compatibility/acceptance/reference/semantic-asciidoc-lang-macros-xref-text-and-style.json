              {
                "kind": "text",
                "value": " xrefstyle is unaffected by the value of the signifier."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Only the aforementioned styles are provided out of the box. Support for a custom formatting string is planned. Refer to "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "#2212"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://github.com/asciidoctor/asciidoctor/issues/2212"
              },
              {
                "kind": "text",
                "value": " for details. Until then, you can implement custom formatting in a custom converter or overriding the xreftext method on the node."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
