    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "On this page, you’ll learn:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "How to preview a site locally."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "How to run an optional local server to preview a site locally."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Since Antora generates static sites, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "you do not have to publish the site to a web server to view it"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". A site generated by Antora works just as well using the browser’s local file: protocol. This characteristic of an Antora site is an essential tool for previewing your work."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To view the site locally, navigate to any HTML page inside the destination folder in your browser. If you’re following along with the Demo, look for the file "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "build/site/index.html"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " in your project. You will be viewing the HTML pages through the file: protocol of the browser, which you can see in the location bar."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "local-site-preview",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Local site preview"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Although the site is viewable without a web server, you may still need to view your site through a web server to test certain features, such as indexified URLs, caching, or scripts that don’t work over the file: protocol. You can use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "http-server"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " package for this purpose. "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "http-server"
                  }
                ],
                "kind": "link",
                "target": "https://yarnpkg.com/en/package/http-server"
              },
              {
                "kind": "text",
                "value": " is a simple, static web server for Node.js."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The most straightforward way to use "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "http-server"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is to invoke it using npx:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "demo-site $ npx http-server -v"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you prefer, you can install the package globally using npm instead."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "demo-site $ npm i -g http-server"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "That puts a command by the same name on your PATH so you don’t need to prefix it with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "npx"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". We’ll assume for the purpose of this tutorial that you are calling "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "http-server"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " using "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "npx"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Now launch the web server by pointing it at the location of the generated site. In the terminal, type the command name, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "npx http-server"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", followed by the location of the generated site (i.e., the output dir). We also recommend adding the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-c-1"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " flag to disable caching."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "demo-site $ npx http-server build/site -c-1"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Upon launching the command, the local address of the web server will be displayed in your terminal. You should see the following output in your terminal:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Starting up http-server, serving build/site\nAvailable on:\n  http://127.0.0.1:8080\n  http://192.168.1.8:8080\nHit CTRL-C to stop the server"
              }
            ],
            "language": null,
            "roles": [
              "output"
            ],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Paste the first provided URL into the location bar of your browser to view your site through a local web server."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Press "
              },
              {
                "keys": [
                  [
                    {
                      "kind": "text",
                      "value": "Ctrl"
                    }
                  ],
                  [
                    {
                      "kind": "text",
                      "value": "C"
                    }
                  ]
                ],
                "kind": "kbd"
              },
              {
                "kind": "text",
                "value": " to stop the server."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you get a port conflict when starting the server (i.e., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "listen EADDRINUSE: address already in use"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), you can use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-p <port>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option to change to another port. For example, append "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-p 5000"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to the command to switch to port 5000."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "demo-site $ npx http-server build/site -c-1 -p 5000"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "run-a-local-server-optional",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Run a local server (optional)"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
