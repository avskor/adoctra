                    "kind": "text",
                    "value": "module directory"
                  }
                ],
                "kind": "xref",
                "target": "module-directories.html#module-dir"
              },
              {
                "kind": "text",
                "value": ". At runtime, Antora collects the source files stored in the family directories and assigns them to the corresponding "
              },
