                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "normal-group",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Normal substitution group"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The header substitution group ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "header"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ") is applied to metadata lines (author and revision information) in the document header. It’s also applied to the values of attribute entries, regardless of whether those entries are defined in the document header or body. Only special characters, attribute references, and the inline pass macro are replaced in elements that fall under the header group."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "admonition",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "You can use the inline pass macro in attribute entries to "
                  },
