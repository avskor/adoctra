{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If an extension is declared as enabled in the playbook file, there is still a way to turn it off for a single run of Antora using the CLI. Much like the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "--extension"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " option is used to enable an extension flagged as not enabled, the option can also be used to switch the enabled flag to false."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "To do so, you negate the value of the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "--extension"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " option by prefixing the value with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "!"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " (read as: not). After removing the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "!"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", Antora will look for the first entry whose "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "id"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " key matches this value. If no match is found, Antora will then look for the first entry whose "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "require"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " key matches this value."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "First, let’s give our extension an ID:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "listing",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "antora:\n  extensions:\n  - id: my-extension\n    require: ./my-extension.js\n    custom: value"
          }
        ],
        "language": "yaml",
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "An extension with an ID that is enabled"
          }
        ]
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Now we can now switch off this extension from the CLI as follows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "literal",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "$ antora --extension '!my-extension' antora-playbook.yml"
          }
        ],
        "language": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "We enclose the value of the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "--extension"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " option here in single quotes since "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "!"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is a reserved shell character. If a match is found, Antora will switch the the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "enabled"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " key on the extension to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "false"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", effectively switching it off."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Note that a subsequent "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "--extension"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " option could still enable it again."
          }
        ],
        "roles": [],
        "title": null
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Switch Off Extension"
      }
    ]
  }
}
