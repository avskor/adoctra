{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "PDF is a fixed-width canvas, therefore you almost always need to specify a width to get the image to fit properly on the page."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "There are several attributes available for specifying the width of an image. These attributes are listed in the following table in order of precedence."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "autowidth": false,
            "body": [
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "pdfwidth"
                          }
                        ],
                        "kind": "xref",
                        "target": "#pdfwidth"
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": "strong",
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "The display width of the image as an absolute size (e.g., 2in), percentage of the content area width (e.g., 75%), percentage of the intrinsic width of the image (e.g., 50iw), or percentage of the page width (e.g., 100vw). If a unit of measurement is not specified (or not recognized), points ("
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "pt"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": ") is assumed. "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Intended to be used for the PDF converter only."
                          }
                        ],
                        "kind": "emphasis",
                        "roles": []
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ],
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "scale"
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": "strong",
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "A percentage of the intrinsic width of the image."
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ],
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "scaledwidth"
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": "strong",
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "The display width of the image as an absolute size (e.g., 2in) or percentage of the content area width (e.g., 75%). If a unit of measurement is not specified, percentage ("
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "%"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": ") is assumed. If a unit of measurement is recognized, points ("
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "pt"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": ") is assumed. "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Intended to be used for print output such as PDF."
                          }
                        ],
                        "kind": "emphasis",
                        "roles": []
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ],
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "image-width key from theme"
                          }
                        ],
                        "kind": "xref",
                        "target": "#image-width"
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": "strong",
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "Accepts the same values as "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "pdfwidth"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": ". "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Only applies to block images and "
                          },
                          {
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "is set in the theme"
                              }
                            ],
                            "kind": "xref",
                            "target": "theme:block-images.html#fallback"
                          },
                          {
                            "kind": "text",
                            "value": ", not the content."
                          }
                        ],
                        "kind": "emphasis",
                        "roles": []
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ],
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "width"
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": "strong",
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "The unitless display width of the image (assumed to be pixels), typically matching the intrinsic width of the image. If the value ends in "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "%"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " (not recommended), it’s assumed to be the percentage of the available content area width. If the width exceeds the content area width, the image is scaled down to the content area width."
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ],
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "fit"
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": "strong",
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "(Inline image only)"
                          }
                        ],
                        "kind": "emphasis",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " If the value is "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "line"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": ", the image will be scaled down proportionally, as necessary, to fit the height of a line of text. If the value is "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "none"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": ", the image will never be scaled down to fit within the height of the content area. The "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "none"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " value should only be used as a workaround in cases when the converter is scaling the image when it shouldn’t."
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ],
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "unspecified"
                          }
                        ],
                        "kind": "emphasis",
                        "roles": []
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": "strong",
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "If you don’t specify one of the aforementioned width settings, the intrinsic width of the image is used (the px value is multiplied by 75% to convert to pt, assuming canvas is 96 dpi) unless the width exceeds the content area width, in which case the image is scaled down to the content area width."
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ]
            ],
            "caption": null,
            "columns": [
              {
                "autowidth": false,
                "halign": "left",
                "style": "strong",
                "valign": "top",
                "width": "25"
              },
              {
                "autowidth": false,
                "halign": "left",
                "style": null,
                "valign": "top",
                "width": "75"
              }
            ],
            "context": "table",
            "explicit_width": false,
            "float": null,
            "foot": [],
            "frame": "none",
            "grid": "rows",
            "head": [
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Attribute Name"
                    }
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Description"
                    }
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ]
            ],
            "id": null,
            "options": [],
            "roles": [],
            "stripes": null,
            "title": null,
            "width": 100
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Images in running content and page background images also support the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fit"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute when specified using the image macro. However, the acceptable values of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fit"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute in those cases differs from the acceptable values for an inline image. See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "background-images.html"
                  }
                ],
                "kind": "xref",
                "target": "background-images.html"
              },
              {
                "kind": "text",
                "value": " for details."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          }
        ],
        "context": "section",
        "id": "width-attributes",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Image width attributes"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An image is always sized based on the user-specified or intrinsic width (aka the resolved width), then its height is scaled proportionally. The computed height of the image is honored unless this value exceeds the height of the content area. In this case, the image is scaled down to fit within the content area."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The height of the content area is typically the space between the top and bottom margins of the page. However, the content area in table cells is handled in two phases."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In tables, each cell is considered its own content area. That content area is computed based on how much space the content requires, though still limited to the space between the top and bottom margins of the page. Inline images in table cells are permitted to increase the height of the cell. However, there can be differences in how the image is sized in a normal cell compared to an AsciiDoc table cell."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The calculation of the content’s height in a normal table cell can be inaccurate, often impacted by the font used. When the table cell is rendered, its height is restricted to the computed height. This can impact the sizing of inline images in a normal table cell if "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "fit=line"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " is set on the image. If the computed height ends up being less than the line height, the image will be scaled down to fit. If you want to prevent the converter from attempting to scale down the height of the inline image in a normal table cell, don’t use "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "fit=line"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " or set "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "fit=none"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " on the inline image."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The content area of an AsciiDoc table cell is computed more accurately. Thus, when you specify the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "a"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " style on a table cell, the scaling of an inline image is true. An inline image will never be scaled down if it fits within the maximum available height of a single page. In this scenario, the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "fit=line"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " attribute will work in the same way it does outside a table cell."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "inline-image-sizing-in-table-cells",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Inline image sizing in table cells"
              }
            ]
          }
        ],
        "context": "section",
        "id": "default",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Default sizing"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdfwidth"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute is the recommended way to set the image size for the PDF output. This attribute is provided for two reasons. First, the fixed-width canvas often calls for a width that is distinct from other output formats, such as HTML. Second, this attribute allows the width to be expressed using a variety of units."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdfwidth"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute supports the following units:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pt (default)"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "in"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "cm"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "mm"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "px"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pc"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "iw (percentage of intrinsic width of image)"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "vw (percentage of page width)"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "% (percentage of content area width)"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In all cases, the width is converted to pt internally."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "See this "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "discussion about image quality in PDFs"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://groups.google.com/forum/#!msg/prawn-ruby/MbMsCx862iY/6ImCsvLGfVcJ"
              },
              {
                "kind": "text",
                "value": " for more information."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          }
        ],
        "context": "section",
        "id": "pdfwidth",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "pdfwidth attribute"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To scale all block images that don’t define either a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdfwidth"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "scaledwidth"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute on an image macro in your document, assign a value to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "image-width"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key in your theme file. If specified, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "image-width"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " value takes precedence over the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "width"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute on an image macro. See "
              },
              {
