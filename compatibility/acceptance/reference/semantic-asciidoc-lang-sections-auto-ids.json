    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Sections and discrete headings support automatic ID generation. Unless you’ve assigned a custom ID to one of these blocks, or you’ve unset the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sectids"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " document attribute, the AsciiDoc processor will automatically generate and assign an ID for the block using the title. This page explains how the ID is derived and how to control this behavior."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The AsciiDoc processor builds an ID from the title using the following order of events and rules:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Inline formatting is applied (in title substitution order)."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "All characters are converted to lowercase."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The value of the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "idprefix attribute"
                      }
                    ],
                    "kind": "xref",
                    "target": "id-prefix-and-separator.html#prefix"
                  },
                  {
                    "kind": "text",
                    "value": " ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "_"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " by default) is prepended."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "ulist",
                    "id": null,
                    "items": [
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Refer to the "
                          },
                          {
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "NT-Name"
                              }
                            ],
                            "kind": "link",
                            "metadata": {
                              "rel": "noopener",
                              "window": "_blank"
                            },
                            "target": "https://www.w3.org/TR/REC-xml/#NT-Name"
                          },
                          {
                            "kind": "text",
                            "value": " section of the XML specification for a list of valid ID characters."
                          }
                        ]
                      }
                    ],
                    "roles": [],
                    "style": null,
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Character references, HTML/XML tags (not their contents), and invalid ID characters are removed."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Spaces, hyphens, and periods are replaced with the value of the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "idseparator attribute"
                      }
                    ],
                    "kind": "xref",
                    "target": "id-prefix-and-separator.html#separator"
                  },
                  {
                    "kind": "text",
                    "value": " ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "_"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " by default)"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Repeating separator characters are condensed."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If necessary, a sequence number is appended until the ID is unique within the document."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Given the following section title:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "== Wiley & Sons, Inc."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The processor will produce the following ID:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "_wiley_sons_inc"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can toggle ID autogeneration on and off using "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sectids"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "customize the ID prefix and word separator"
                  }
                ],
                "kind": "xref",
                "target": "id-prefix-and-separator.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the title contains a forward looking xref (i.e., an xref to an element that comes later in document order), you must either assign a custom ID to the block or "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "disable ID generation"
                  }
                ],
                "kind": "xref",
                "target": "#disable"
              },
              {
                "kind": "text",
                "value": " around the title. Otherwise, the AsciiDoc processor may warn that the reference is invalid. This happens because, in order to generate an ID, the processor must convert the title. This conversion happens before the processor has visited the target element. As a result, the processor is not able to lookup the reference and therefore must consider it invalid."
              }
            ],
            "roles": [],
            "title": null,
            "type": "caution"
          }
        ],
        "context": "section",
        "id": "_how_a_section_id_is_computed",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "How a section ID is computed"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To disable autogeneration of section and discrete heading IDs, unset the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sectids"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ":!sectids:"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Custom IDs"
                  }
                ],
                "kind": "xref",
                "target": "custom-ids.html"
              },
              {
                "kind": "text",
                "value": " are still used even when automatic section IDs are disabled."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can unset this attribute anywhere that attribute entries are permitted in the document. By doing so, you can disable ID generation for only certain sections and discrete headings."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "== ID generation on\n\n:!sectids:\n== ID generation off\n:sectids:\n\n== ID generation on again"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you disable autogenerated section IDs, and you don’t assign a custom ID to a section or discrete headings, you won’t be able to create cross references to that element."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "disable",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Disable automatic section ID generation"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Autogenerate Section IDs"
      }
    ]
  }
