        ],
        "context": "section",
        "id": "expected",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Asserting Expected Exceptions"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Although any exception thrown from a test method will cause the test to fail, there are certain use cases where it can be beneficial to explicitly assert that an exception is "
              },
              {
                "id": null,
