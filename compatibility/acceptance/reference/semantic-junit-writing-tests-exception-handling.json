                          "checkbox": null,
                          "inlines": []
                        },
                        "terms": [
                          [
                            {
                              "kind": "text",
                              "value": "Kotlin"
                            }
                          ]
                        ]
                      }
                    ],
                    "roles": [],
                    "title": null
