                ],
                "context": "example",
                "id": null,
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "expected-assertThrows",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Using "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "assertThrows()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "assertThrowsExactly()"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " method is used when you need to assert that the exception thrown is exactly of a specific type, not allowing for subclasses of the expected exception type. This is useful when precise exception handling behavior needs to be validated. Similar to "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "assertThrows()"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "assertThrowsExactly()"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " assertion method also returns the thrown exception object to allow performing additional assertions on it."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "blocks": [
                  {
                    "context": "dlist",
                    "id": null,
                    "items": [
                      {
                        "description": {
                          "blocks": [
                            {
                              "blocks": [
                                {
                                  "context": "listing",
                                  "id": null,
                                  "inlines": [
                                    {
                                      "kind": "text",
                                      "value": "@Test\nvoid testExpectedExceptionIsThrown() {\n\t// The following assertion succeeds because the code under assertion throws\n\t// IllegalArgumentException which is exactly equal to the expected type.\n\t// The assertion also returns the thrown exception which can be used for\n\t// further assertions like asserting the exception message.\n\tIllegalArgumentException exception =\n\t\tassertThrowsExactly(IllegalArgumentException.class, () -> {\n\t\t\tthrow new IllegalArgumentException(\"expected message\");\n\t\t});\n\tassertEquals(\"expected message\", exception.getMessage());\n\n\t// The following assertion fails because the assertion expects exactly\n\t// RuntimeException to be thrown, not subclasses of RuntimeException.\n\tassertThrowsExactly(RuntimeException.class, () -> {\n\t\tthrow new IllegalArgumentException(\"expected message\");\n\t});\n}"
                                    }
                                  ],
                                  "language": "java",
                                  "roles": [],
                                  "title": null
                                }
                              ],
                              "context": "open",
                              "id": null,
                              "roles": [],
                              "title": null
                            }
