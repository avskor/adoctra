        ],
        "context": "section",
        "id": "failed-assertions",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Failed Assertions"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "JUnit Jupiter offers specialized assertions for testing that specific exceptions are thrown under expected conditions. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "assertThrows()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "assertThrowsExactly()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " assertions are critical tools for validating that your code responds correctly to error conditions by throwing the appropriate exceptions."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "assertThrows()"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " method is used to verify that a particular type of exception is thrown during the execution of a provided executable block. It not only checks for the type of the thrown exception but also its subclasses, making it suitable for more generalized exception handling tests. The "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "assertThrows()"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " assertion method returns the thrown exception object to allow performing additional assertions on it."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "blocks": [
                  {
                    "context": "dlist",
                    "id": null,
                    "items": [
                      {
                        "description": {
                          "blocks": [
                            {
                              "blocks": [
                                {
                                  "context": "listing",
                                  "id": null,
                                  "inlines": [
                                    {
                                      "kind": "text",
                                      "value": "@Test\nvoid testExpectedExceptionIsThrown() {\n\t// The following assertion succeeds because the code under assertion\n\t// throws the expected IllegalArgumentException.\n\t// The assertion also returns the thrown exception which can be used for\n\t// further assertions like asserting the exception message.\n\tIllegalArgumentException exception =\n\t\tassertThrows(IllegalArgumentException.class, () -> {\n\t\t\tthrow new IllegalArgumentException(\"expected message\");\n\t\t});\n\tassertEquals(\"expected message\", exception.getMessage());\n\n\t// The following assertion also succeeds because the code under assertion\n\t// throws IllegalArgumentException which is a subclass of RuntimeException.\n\tassertThrows(RuntimeException.class, () -> {\n\t\tthrow new IllegalArgumentException(\"expected message\");\n\t});\n}"
                                    }
                                  ],
                                  "language": "java",
                                  "roles": [],
                                  "title": null
                                }
                              ],
                              "context": "open",
                              "id": null,
                              "roles": [],
                              "title": null
                            }
                          ],
                          "checkbox": null,
                          "inlines": []
                        },
                        "terms": [
                          [
                            {
                              "kind": "text",
                              "value": "Java"
                            }
                          ]
                        ]
                      },
                      {
                        "description": {
                          "blocks": [
                            {
                              "blocks": [
                                {
                                  "context": "listing",
                                  "id": null,
                                  "inlines": [
                                    {
                                      "kind": "text",
                                      "value": "@Test\nfun testExpectedExceptionIsThrown() {\n    // The following assertion succeeds because the code under assertion\n    // throws the expected IllegalArgumentException.\n    // The assertion also returns the thrown exception which can be used for\n    // further assertions like asserting the exception message.\n    val exception =\n        assertThrows<IllegalArgumentException> {\n            throw IllegalArgumentException(\"expected message\")\n        }\n    assertEquals(\"expected message\", exception.message)\n\n    // The following assertion also succeeds because the code under assertion\n    // throws IllegalArgumentException which is a subclass of RuntimeException.\n    assertThrows<RuntimeException> {\n        throw IllegalArgumentException(\"expected message\")\n    }\n}"
                                    }
                                  ],
                                  "language": "kotlin",
                                  "roles": [],
                                  "title": null
                                }
                              ],
                              "context": "open",
                              "id": null,
                              "roles": [],
                              "title": null
                            }
