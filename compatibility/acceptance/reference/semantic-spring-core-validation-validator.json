      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Validation errors are reported to the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Errors"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " object passed to the validator. In the case of Spring Web MVC, you can use the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "<spring:bind/>"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " tag to inspect the error messages, but you can also inspect the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Errors"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " object yourself. More information about the methods it offers can be found in the "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "javadoc"
              }
            ],
            "kind": "link",
            "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/validation/Errors.html"
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Validators may also get locally invoked for the immediate validation of a given object, not involving a binding process. As of 6.1, this has been simplified through a new "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Validator.validateObject(Object)"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method which is available by default now, returning a simple "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Errors"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " representation which can be inspected: typically calling "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "hasErrors()"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or the new "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "failOnError"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method for turning the error summary message into an exception (for example, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "validator.validateObject(myObject).failOnError(IllegalArgumentException::new)"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ")."
          }
        ],
        "roles": [],
        "title": null
      }
    ],
    "outline": null,
