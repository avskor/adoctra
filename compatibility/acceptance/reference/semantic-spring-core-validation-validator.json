                      "inlines": [
                        {
                          "kind": "text",
                          "value": "public class CustomerValidator implements Validator {\n\n\tprivate final Validator addressValidator;\n\n\tpublic CustomerValidator(Validator addressValidator) {\n\t\tif (addressValidator == null) {\n\t\t\tthrow new IllegalArgumentException(\"The supplied [Validator] is \" +\n\t\t\t\t\"required and must not be null.\");\n\t\t}\n\t\tif (!addressValidator.supports(Address.class)) {\n\t\t\tthrow new IllegalArgumentException(\"The supplied [Validator] must \" +\n\t\t\t\t\"support the validation of [Address] instances.\");\n\t\t}\n\t\tthis.addressValidator = addressValidator;\n\t}\n\n\t/**\n\t * This Validator validates Customer instances, and any subclasses of Customer too\n\t */\n\tpublic boolean supports(Class clazz) {\n\t\treturn Customer.class.isAssignableFrom(clazz);\n\t}\n\n\tpublic void validate(Object target, Errors errors) {\n\t\tValidationUtils.rejectIfEmptyOrWhitespace(errors, \"firstName\", \"field.required\");\n\t\tValidationUtils.rejectIfEmptyOrWhitespace(errors, \"surname\", \"field.required\");\n\t\tCustomer customer = (Customer) target;\n\t\ttry {\n\t\t\terrors.pushNestedPath(\"address\");\n\t\t\tValidationUtils.invokeValidator(this.addressValidator, customer.getAddress(), errors);\n\t\t} finally {\n\t\t\terrors.popNestedPath();\n\t\t}\n\t}\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "class CustomerValidator(private val addressValidator: Validator) : Validator {\n\n\tinit {\n\t\tif (addressValidator == null) {\n\t\t\tthrow IllegalArgumentException(\"The supplied [Validator] is required and must not be null.\")\n\t\t}\n\t\tif (!addressValidator.supports(Address::class.java)) {\n\t\t\tthrow IllegalArgumentException(\"The supplied [Validator] must support the validation of [Address] instances.\")\n\t\t}\n\t}\n\n\t/"
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "*\n\t* This Validator validates Customer instances, and any subclasses of Customer too\n\t*/\n\toverride fun supports(clazz: Class<"
                            }
                          ],
                          "kind": "strong",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": ">): Boolean {\n\t\treturn Customer::class.java.isAssignableFrom(clazz)\n\t}\n\n\toverride fun validate(target: Any, errors: Errors) {\n\t\tValidationUtils.rejectIfEmptyOrWhitespace(errors, \"firstName\", \"field.required\")\n\t\tValidationUtils.rejectIfEmptyOrWhitespace(errors, \"surname\", \"field.required\")\n\t\tval customer = target as Customer\n\t\ttry {\n\t\t\terrors.pushNestedPath(\"address\")\n\t\t\tValidationUtils.invokeValidator(this.addressValidator, customer.address, errors)\n\t\t} finally {\n\t\t\terrors.popNestedPath()\n\t\t}\n\t}\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
