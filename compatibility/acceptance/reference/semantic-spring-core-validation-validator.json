                      "inlines": [
                        {
                          "kind": "text",
                          "value": "public class PersonValidator implements Validator {\n\n\t/**\n\t * This Validator validates only Person instances\n\t */\n\tpublic boolean supports(Class clazz) {\n\t\treturn Person.class.equals(clazz);\n\t}\n\n\tpublic void validate(Object obj, Errors e) {\n\t\tValidationUtils.rejectIfEmpty(e, \"name\", \"name.empty\");\n\t\tPerson p = (Person) obj;\n\t\tif (p.getAge() < 0) {\n\t\t\te.rejectValue(\"age\", \"negativevalue\");\n\t\t} else if (p.getAge() > 110) {\n\t\t\te.rejectValue(\"age\", \"too.darn.old\");\n\t\t}\n\t}\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "class PersonValidator : Validator {\n\n\t/**\n\t * This Validator validates only Person instances\n\t */\n\toverride fun supports(clazz: Class<*>): Boolean {\n\t\treturn Person::class.java == clazz\n\t}\n\n\toverride fun validate(obj: Any, e: Errors) {\n\t\tValidationUtils.rejectIfEmpty(e, \"name\", \"name.empty\")\n\t\tval p = obj as Person\n\t\tif (p.age < 0) {\n\t\t\te.rejectValue(\"age\", \"negativevalue\")\n\t\t} else if (p.age > 110) {\n\t\t\te.rejectValue(\"age\", \"too.darn.old\")\n\t\t}\n\t}\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
