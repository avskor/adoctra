          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ValidationUtils"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " helper class that the Spring Framework also provides. The following example implements "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Validator"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " for "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Person"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " instances:"
          }
        ],
        "roles": [],
        "title": null
      },
