                    "target": "attachment$api/org.junit.platform.launcher/org/junit/platform/launcher/TestExecutionListener.html"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " implementations that generate XML test reports in two flavors: "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
