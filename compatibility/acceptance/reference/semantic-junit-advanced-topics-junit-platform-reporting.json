      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The JUnit Platform provides an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "OutputDirectoryCreator"
                      }
                    ],
                    "kind": "xref",
                    "target": "attachment$api/org.junit.platform.engine/org/junit/platform/engine/OutputDirectoryCreator.html"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " via "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "EngineDiscoveryRequest"
                      }
                    ],
                    "kind": "xref",
                    "target": "attachment$api/org.junit.platform.engine/org/junit/platform/engine/EngineDiscoveryRequest.html"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "TestPlan"
                      }
                    ],
                    "kind": "xref",
                    "target": "attachment$api/org.junit.platform.launcher/org/junit/platform/launcher/TestPlan.html"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to registered "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "test engines"
                  }
                ],
                "kind": "xref",
                "target": "advanced-topics/engines.html"
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "listeners"
                  }
                ],
                "kind": "xref",
                "target": "running-tests/using-listeners-and-interceptors.html"
              },
              {
                "kind": "text",
                "value": ", respectively. Its root directory can be configured via the following "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "configuration parameter"
                  }
                ],
                "kind": "xref",
                "target": "running-tests/configuration-parameters.html"
              },
              {
                "kind": "text",
                "value": ":"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Configure the output directory for reporting. By default, "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "build"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " is used if a Gradle build script is found, and "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "target"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " if a Maven POM is found; otherwise, the current working directory is used."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "junit.platform.reporting.output.dir=<path>"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To create a unique output directory per test run, you can use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "{uniqueNumber}"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " placeholder in the path. For example, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "reports/junit-{uniqueNumber}"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " will create directories like "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "reports/junit-8803697269315188212"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". This can be useful when using Gradle’s or Maven’s parallel execution capabilities which create multiple JVM forks that run concurrently."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "output-directory",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Output Directory"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "OpenTestReportGeneratingListener"
                      }
                    ],
                    "kind": "xref",
                    "target": "attachment$api/org.junit.platform.reporting/org/junit/platform/reporting/open/xml/OpenTestReportGeneratingListener.html"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " writes an XML report for the entire execution in the event-based format specified by "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Open Test Reporting"
                  }
                ],
                "kind": "link",
                "target": "https://github.com/ota4j-team/open-test-reporting"
              },
              {
                "kind": "text",
                "value": " which supports all features of the JUnit Platform such as hierarchical test structures, display names, tags, etc."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The listener is auto-registered and can be configured via the following "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "configuration parameters"
                  }
                ],
                "kind": "xref",
                "target": "running-tests/configuration-parameters.html"
              },
              {
                "kind": "text",
                "value": ":"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Enable/disable writing the report; defaults to "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "false"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": "."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "junit.platform.reporting.open.xml.enabled=true|false"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Enable/disable including information about the Git repository (see "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Git extension schema"
                        }
                      ],
                      "kind": "link",
                      "target": "https://github.com/ota4j-team/open-test-reporting#git"
                    },
                    {
                      "kind": "text",
                      "value": " of open-test-reporting); defaults to "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "false"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": "."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "junit.platform.reporting.open.xml.git.enabled=true|false"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Optional port number to redirect events to a socket instead of a file. When specified, the listener will connect to "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "127.0.0.1:<port>"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " and send the XML events to the socket. The socket connection is automatically closed when the test execution completes."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "junit.platform.reporting.open.xml.socket=<port>"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If enabled, the listener creates an XML report file named "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "open-test-report.xml"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in the configured "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "output directory"
                  }
                ],
                "kind": "xref",
                "target": "#output-directory"
              },
              {
                "kind": "text",
                "value": ", unless the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "junit.platform.reporting.open.xml.socket"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " configuration parameter is set, in which case the events are sent to the specified socket instead."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "output capturing"
                  }
                ],
                "kind": "xref",
                "target": "running-tests/capturing-standard-output-error.html"
              },
              {
                "kind": "text",
                "value": " is enabled, the captured output written to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "System.out"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "System.err"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " will be included in the report as well."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Open Test Reporting CLI Tool"
                  }
                ],
                "kind": "link",
                "target": "https://github.com/ota4j-team/open-test-reporting#cli-tool-for-validation-and-format-conversion"
              },
              {
                "kind": "text",
                "value": " can be used to convert from the event-based format to the hierarchical format which is more human-readable."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "For Gradle, writing Open Test Reporting compatible XML reports can be enabled and configured via system properties. The following samples configure its output directory to be the same directory Gradle uses for its own XML reports. A "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "CommandLineArgumentProvider"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " is used to keep the tasks relocatable across different machines which is important when using Gradle’s Build Cache."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "dependencies {\n    testRuntimeOnly(\"org.junit.platform:junit-platform-reporting:{version}\")\n}\ntasks.withType(Test).configureEach {\n    def outputDir = reports.junitXml.outputLocation\n    jvmArgumentProviders << ({\n        [\n            \"-Djunit.platform.reporting.open.xml.enabled=true\",\n            \"-Djunit.platform.reporting.output.dir=${outputDir.get().asFile.absolutePath}\"\n        ]\n    } as CommandLineArgumentProvider)\n}"
                  }
                ],
                "language": "groovy",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Groovy DSL"
                  }
                ]
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "dependencies {\n    testRuntimeOnly(\"org.junit.platform:junit-platform-reporting:{version}\")\n}\ntasks.withType<Test>().configureEach {\n    val outputDir = reports.junitXml.outputLocation\n    jvmArgumentProviders += CommandLineArgumentProvider {\n\t\tlistOf(\n\t\t\t\"-Djunit.platform.reporting.open.xml.enabled=true\",\n\t\t\t\"-Djunit.platform.reporting.output.dir=${outputDir.get().asFile.absolutePath}\"\n\t\t)\n\t}\n}"
                  }
                ],
                "language": "kotlin",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Kotlin DSL"
                  }
                ]
              }
            ],
            "context": "section",
            "id": "_gradle",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Gradle"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "For Maven Surefire/Failsafe, you can enable Open Test Reporting output and configure the resulting XML files to be written to the same directory Surefire/Failsafe uses for its own XML reports as follows:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<project>\n\t<!-- ... -->\n\t<dependencies>\n\t\t<dependency>\n\t\t\t<groupId>org.junit.platform</groupId>\n\t\t\t<artifactId>junit-platform-reporting</artifactId>\n\t\t\t<version>{version}</version>\n\t\t\t<scope>test</scope>\n\t\t</dependency>\n\t</dependencies>\n\t<build>\n\t\t<plugins>\n\t\t\t<plugin>\n\t\t\t\t<artifactId>maven-surefire-plugin</artifactId>\n\t\t\t\t<version>{surefire-version}</version>\n\t\t\t\t<configuration>\n\t\t\t\t\t<properties>\n\t\t\t\t\t\t<configurationParameters>\n\t\t\t\t\t\t\tjunit.platform.reporting.open.xml.enabled = true\n\t\t\t\t\t\t\tjunit.platform.reporting.output.dir = target/surefire-reports\n\t\t\t\t\t\t</configurationParameters>\n\t\t\t\t\t</properties>\n\t\t\t\t</configuration>\n\t\t\t</plugin>\n\t\t</plugins>\n\t</build>\n\t<!-- ... -->\n</project>"
                  }
                ],
                "language": "xml",
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "_maven",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Maven"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "When using the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "running-tests/console-launcher.html"
                      }
                    ],
                    "kind": "xref",
                    "target": "running-tests/console-launcher.html"
                  },
                  {
                    "kind": "text",
                    "value": ", you can enable Open Test Reporting output by setting the configuration parameters via "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "--config"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ":"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "$ java -jar junit-platform-console-standalone-{version}.jar <OPTIONS> \\\n  --config=junit.platform.reporting.open.xml.enabled=true \\\n  --config=junit.platform.reporting.output.dir=reports"
                  }
                ],
                "language": "console",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Configuration parameters can also be set in a custom properties file supplied as a classpath resource via the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "--config-resource"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " option:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "$ java -jar junit-platform-console-standalone-{version}.jar <OPTIONS> \\\n  --config-resource=configuration.properties"
                  }
                ],
                "language": "console",
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "_console_launcher",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Console Launcher"
              }
            ]
          }
        ],
        "context": "section",
        "id": "open-test-reporting",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Open Test Reporting"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "LegacyXmlReportGeneratingListener"
                      }
                    ],
                    "kind": "xref",
                    "target": "attachment$api/org.junit.platform.reporting/org/junit/platform/reporting/legacy/xml/LegacyXmlReportGeneratingListener.html"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
