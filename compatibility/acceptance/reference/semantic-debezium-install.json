            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Although Debezium is intended to be used as turnkey services, all of JARs and other artifacts are available in "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Maven Central"
                  }
                ],
                "kind": "link",
                "target": "https://search.maven.org/#search%7Cga%7C1%7Cg%3A%22io.debezium%22"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "We do provide a small library so applications can "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "embed any Kafka Connect connector"
                  }
                ],
                "kind": "xref",
                "target": "development/engine.html"
              },
              {
                "kind": "text",
                "value": " and consume data change events read directly from the source system. This provides a light weight system (since Kafka and Kafka Connect services are not needed), but as a consequence it is not as fault tolerant or reliable since the application must manage and maintain all state normally kept inside Kafka’s distributed and replicated logs. It’s perfect for use in tests, and with careful consideration it may be useful in some applications."
              }
            ],
            "roles": [],
            "title": null
          }
