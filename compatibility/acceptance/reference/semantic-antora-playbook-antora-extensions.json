    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "antora"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key can be used to register Antora extensions."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For more information about writing and using Antora extensions, see "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "extend:extensions.html"
                  }
                ],
                "kind": "xref",
                "target": "extend:extensions.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Before registering an extension in your playbook, you need to install the extension code. You can install it globally, declare it as a dependency of the project, or add the extension script to the playbook project."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "install-extension-code",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Install extension code"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An Antora extension is registered using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "extensions"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "extensions"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key accepts a list of node module names (i.e., npm package names) and relative or absolute filesystem paths. An entry can also be a map to specify additional configuration. In this case, the require path is specified using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "require"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When registering an Antora extension, make sure you’re using the nested key "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "antora.extensions"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and not "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoc.extensions"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The latter key is for registering Asciidoctor extensions, which use a different extension facility."
              }
            ],
            "roles": [],
            "title": null,
            "type": "important"
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "antora:\n  extensions:\n  - name-of-node-module\n  - require: ./path/to/extension.js\n    name: value"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you’re requiring a Node.js module (e.g., a package installed from npmjs.com) whose name ends with a file extension, such as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".js"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", you must append a trailing forward slash. This suffix tells Antora to resolve the request as the name of a module, not as a local file. Without this suffix, Antora assumes the request is a local file. If it’s not a local file, this can result in the error message "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Cannot find module"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". If the request is already a local file, the suffix is not needed."
              }
            ],
            "roles": [],
            "title": null,
            "type": "important"
          }
        ],
        "context": "section",
        "id": "extensions-key",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "extensions key"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want to configure an extension, but not enable it, you must use the map-style entry and set "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "enabled: false"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "antora:\n  extensions:\n  - require: '@antora/lunr-extension'\n    enabled: false\n    index_by_heading: true"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can then enable the extension using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--extension"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " CLI option when invoking the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "antora"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " commmand:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ npx antora --extension @antora/lunr-extension antora-playbook.yml"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can refer to the extension by an alias instead of the require path by assigning a value to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "id"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key on the extension entry. For more information about registering and enabling extensions, refer to "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "extend:enable-extension.html"
                  }
                ],
                "kind": "xref",
                "target": "extend:enable-extension.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "configure-extension-only",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Configure extension only"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Antora Extensions"
      }
    ]
  }
