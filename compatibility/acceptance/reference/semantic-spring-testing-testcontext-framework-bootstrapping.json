{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The default configuration for the internals of the Spring TestContext Framework is sufficient for all common use cases. However, there are times when a development team or third party framework would like to change the default "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ContextLoader"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", implement a custom "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "TestContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ContextCache"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", augment the default sets of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ContextCustomizerFactory"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "TestExecutionListener"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " implementations, and so on. For such low-level control over how the TestContext framework operates, Spring provides a bootstrapping strategy."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "TestContextBootstrapper"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " defines the SPI for bootstrapping the TestContext framework. A "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "TestContextBootstrapper"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is used by the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "TestContextManager"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " to load the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "TestExecutionListener"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " implementations for the current test and to build the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "TestContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " that it manages. You can configure a custom bootstrapping strategy for a test class (or test class hierarchy) by using "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@BootstrapWith"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", either directly or as a meta-annotation. If a bootstrapper is not explicitly configured by using "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@BootstrapWith"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", either the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DefaultTestContextBootstrapper"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebTestContextBootstrapper"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is used, depending on the presence of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@WebAppConfiguration"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Since the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "TestContextBootstrapper"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " SPI is likely to change in the future (to accommodate new requirements), we strongly encourage implementers not to implement this interface directly but rather to extend "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "AbstractTestContextBootstrapper"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or one of its concrete subclasses instead."
          }
        ],
        "roles": [],
        "title": null
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Bootstrapping the TestContext Framework"
      }
    ]
  }
}
