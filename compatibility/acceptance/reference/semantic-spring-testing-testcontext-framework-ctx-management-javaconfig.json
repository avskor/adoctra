      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The term “component class” can refer to any of the following:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "A class annotated with "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@Configuration"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "A component (that is, a class annotated with "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@Component"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@Service"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@Repository"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", or other stereotype annotations)."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "A JSR-330 compliant class that is annotated with "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "jakarta.inject"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " annotations."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Any class that contains "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@Bean"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "-methods."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Any other class that is intended to be registered as a Spring component (i.e., a Spring bean in the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "ApplicationContext"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), potentially taking advantage of automatic autowiring of a single constructor without the use of Spring annotations."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "See the javadoc of "
              },
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@Configuration"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ],
                "kind": "link",
                "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/context/annotation/Configuration.html"
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@Bean"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ],
                "kind": "link",
                "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/context/annotation/Bean.html"
              },
              {
                "kind": "text",
                "value": " for further information regarding the configuration and semantics of component classes, paying special attention to the discussion of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Bean"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " Lite Mode."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "admonition",
        "id": "testcontext-ctx-management-javaconfig-component-classes",
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Component Classes"
          }
        ],
        "type": "tip"
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If you omit the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "classes"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " attribute from the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ContextConfiguration"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation, the TestContext framework tries to detect the presence of default configuration classes. Specifically, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "AnnotationConfigContextLoader"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "AnnotationConfigWebContextLoader"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " detect all "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "static"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " nested classes of the test class that meet the requirements for configuration class implementations, as specified in the "
          },
          {
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Configuration"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "kind": "link",
            "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/context/annotation/Configuration.html"
          },
          {
            "kind": "text",
            "value": " javadoc. Note that the name of the configuration class is arbitrary. In addition, a test class can contain more than one "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "static"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " nested configuration class if desired. In the following example, the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "OrderServiceTest"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " class declares a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "static"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " nested configuration class named "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Config"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " that is automatically used to load the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " for the test class:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@SpringJUnitConfig "
                        },
                        {
                          "guard": null,
                          "icons": null,
                          "id": "CO3-1",
                          "kind": "callout",
                          "number": "1",
                          "src": "",
                          "xml": false
                        },
                        {
                          "kind": "text",
                          "value": "\n// ApplicationContext will be loaded from the static nested Config class\nclass OrderServiceTest {\n\n\t@Configuration\n\tstatic class Config {\n\n\t\t// this bean will be injected into the OrderServiceTest class\n\t\t@Bean\n\t\tOrderService orderService() {\n\t\t\tOrderService orderService = new OrderServiceImpl();\n\t\t\t// set properties, etc.\n\t\t\treturn orderService;\n\t\t}\n\t}\n\n\t@Autowired\n\tOrderService orderService;\n\n\t@Test\n\tvoid testOrderService() {\n\t\t// test the orderService\n\t}\n\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    },
                    {
                      "context": "colist",
                      "id": null,
                      "items": [
                        {
                          "blocks": [],
                          "checkbox": null,
                          "coids": [
                            "CO3-1"
                          ],
                          "icons": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "Loading configuration information from the nested "
                            },
                            {
                              "id": null,
                              "inlines": [
                                {
                                  "kind": "text",
                                  "value": "Config"
                                }
                              ],
                              "kind": "monospace",
                              "roles": []
                            },
                            {
                              "kind": "text",
                              "value": " class."
                            }
                          ],
                          "src": ""
                        }
                      ],
                      "roles": [],
                      "style": "arabic",
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@SpringJUnitConfig "
                        },
                        {
                          "guard": null,
                          "icons": null,
                          "id": "CO4-1",
                          "kind": "callout",
                          "number": "1",
                          "src": "",
                          "xml": false
                        },
                        {
                          "kind": "text",
                          "value": "\n// ApplicationContext will be loaded from the nested Config class\nclass OrderServiceTest {\n\n\t@Autowired\n\tlateinit var orderService: OrderService\n\n\t@Configuration\n\tclass Config {\n\n\t\t// this bean will be injected into the OrderServiceTest class\n\t\t@Bean\n\t\tfun orderService(): OrderService {\n\t\t\t// set properties, etc.\n\t\t\treturn OrderServiceImpl()\n\t\t}\n\t}\n\n\t@Test\n\tfun testOrderService() {\n\t\t// test the orderService\n\t}\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    },
