    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "To load an "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " for your tests by using component classes (see "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Java-based container configuration"
              }
            ],
            "kind": "xref",
            "target": "core/beans/java.html"
          },
          {
            "kind": "text",
            "value": "), you can annotate your test class with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ContextConfiguration"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and configure the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "classes"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " attribute with an array that contains references to component classes. The following example shows how to do so:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@ExtendWith(SpringExtension.class)\n// ApplicationContext will be loaded from AppConfig and TestConfig\n@ContextConfiguration(classes = {AppConfig.class, TestConfig.class}) "
                        },
                        {
                          "guard": "// ",
                          "icons": null,
                          "id": "CO1-1",
                          "kind": "callout",
                          "number": "1",
                          "src": "",
                          "xml": false
                        },
                        {
                          "kind": "text",
                          "value": "\nclass MyTest {\n\t// class body...\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    },
