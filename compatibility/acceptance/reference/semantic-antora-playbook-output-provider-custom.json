      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "provider"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key doesn’t specify a recognized built-in provider, Antora will attempt to require it as a Node.js module. This allows you to supply a custom provider."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the value begins with a dot ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), Antora will require the path relative to the playbook file. Otherwise, Antora will require the value as a Node.js module installed in the playbook project."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The custom provider is a JavaScript function that matches the following signature:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "async function (destConfig, files, playbook)"
              }
            ],
            "language": "js",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s a template you can use to get started."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "module.exports = async function (destConfig, files, playbook) {\n  const to = destConfig.path || '_site'\n  console.log(`Publishing files to ${to}`)\n  for await (const file of files) {\n    console.log(`Writing file to ${file.path}`)\n  }\n  return {}\n}"
              }
            ],
            "language": "js",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "custom-output-provider.js"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The destConfig argument is an object containing key-value pairs that correspond to the properties of the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "destination specification"
                  }
                ],
                "kind": "xref",
                "target": "configure-output.html#destinations-key"
              },
              {
                "kind": "text",
                "value": ". The files argument is a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ReadableStream"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " of virtual files (use "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "for await"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to iterate over it). Each file is a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Vinyl"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " object that contains the properties "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "contents"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "path"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "stat"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The playbook argument is the object containing key-value pairs from the playbook as a whole."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s how to configure Antora to use this destination provider:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "output:\n  destinations:\n  - provider: ./custom-output-provider.js"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you specify the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "path"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key, it will override the default location, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "_site"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
