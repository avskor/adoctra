        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This is the documentation for the Ruby-based AsciiDoc processor named Asciidoctor. Asciidoctor currently serves as the reference implementation for how to interpret the AsciiDoc language. If you’re looking for the documentation for the AsciiDoc language, see the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "AsciiDoc section"
                  }
                ],
                "kind": "xref",
                "target": "asciidoc::index.html"
              },
              {
                "kind": "text",
                "value": " of this website."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor is a fast, open source, text processor for parsing AsciiDoc into a document model, then converting it to output formats such as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "HTML 5"
                  }
                ],
                "kind": "span",
                "roles": [
                  "nowrap"
                ]
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DocBook 5"
                  }
                ],
                "kind": "span",
                "roles": [
                  "nowrap"
                ]
              },
              {
                "kind": "text",
                "value": ", man(ual) pages, PDF, and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "EPUB 3"
                  }
                ],
                "kind": "span",
                "roles": [
                  "nowrap"
                ]
              },
              {
                "kind": "text",
                "value": ". Asciidoctor is written in the Ruby programming language."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When we use the name “Asciidoctor” in this area of the documentation, we’re referring to the core Asciidoctor Ruby processor, abbreviated as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Asciidoctor core"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Asciidoctor Ruby"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". We add the qualifier “core” because Asciidoctor is also the name of the suite of projects that provides runtimes, extensions, and tools for processing AsciiDoc."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To simplify installation, Asciidoctor is packaged as a gem named "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://rubygems.org/gems/asciidoctor"
              },
              {
                "kind": "text",
                "value": " and published to the gem hosting service located at RubyGems.org. A "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "gem"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://guides.rubygems.org/what-is-a-gem/"
              },
              {
                "kind": "text",
                "value": " is a packaged Ruby application or library (in this case, both). The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " gem can be installed directly from RubyGems.org on all major operating systems using Ruby packaging tools (gem or bundle). Asciidoctor is also distributed as a Docker image, as a package for numerous Linux distributions, and as a package for macOS (via Homebrew and MacPorts)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor is open source software available under the terms of the MIT license and {url-org}[hosted on GitHub^]."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor is the successor to AsciiDoc.py, the legacy Python-based processor for the AsciiDoc language. If you’re using AsciiDoc.py, follow "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "migrate:asciidoc-py.html"
                  }
                ],
                "kind": "xref",
                "target": "migrate:asciidoc-py.html"
              },
              {
                "kind": "text",
                "value": " to learn how to upgrade to Asciidoctor."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_what_is_asciidoctor",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "What is Asciidoctor?"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor provides two interfaces for processing AsciiDoc documents, a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CLI"
                  }
                ],
                "kind": "xref",
                "target": "cli:index.html"
              },
              {
                "kind": "text",
                "value": " named "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Ruby API"
                  }
                ],
                "kind": "xref",
                "target": "api:index.html"
              },
              {
                "kind": "text",
                "value": " named "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Asciidoctor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The following table gives you an idea of how to use these interfaces."
              }
            ],
            "roles": [],
            "title": null
          },
