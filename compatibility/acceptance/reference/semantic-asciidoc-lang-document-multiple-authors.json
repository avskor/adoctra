            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "author line"
                  }
                ],
                "kind": "xref",
                "target": "author-line.html"
              },
              {
                "kind": "text",
                "value": " is the only way to assign more than one author to a document for display in the byline. Additionally, only the HTML 5 and Docbook converters can convert documents with multiple authors."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
