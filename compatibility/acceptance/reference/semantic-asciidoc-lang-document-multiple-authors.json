          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If an author name ends with with a character reference, you can preserve the semicolon in the character reference by adding a trailing attribute reference:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "AsciiDoc&#174;{empty} WG; Another Author"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Another solution entails moving the character reference to an attribute and inserting it using an attribute reference:"
