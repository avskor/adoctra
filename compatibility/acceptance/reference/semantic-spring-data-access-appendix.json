                        "value": "jdbc"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " elements let you quickly configure an embedded database or initialize an existing data source. These elements are documented in "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Embedded Database Support"
                      }
                    ],
                    "kind": "xref",
                    "target": "data-access/jdbc/embedded-database-support.html"
                  },
                  {
                    "kind": "text",
                    "value": " and "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Initializing a DataSource"
                      }
                    ],
                    "kind": "xref",
                    "target": "data-access/jdbc/initializing-datasource.html"
                  },
                  {
                    "kind": "text",
                    "value": ", respectively."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "To use the elements in the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "jdbc"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " schema, you need to have the following preamble at the top of your Spring XML configuration file. The text in the following snippet references the correct schema so that the elements in the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "jdbc"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " namespace are available to you:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<beans xmlns=\"http://www.springframework.org/schema/beans\"\n\txmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n\txmlns:jdbc=\"http://www.springframework.org/schema/jdbc\" "
                  },
                  {
                    "guard": null,
                    "icons": null,
                    "id": "CO2-1",
                    "kind": "callout",
                    "number": "1",
                    "src": "",
                    "xml": false
                  },
                  {
                    "kind": "text",
                    "value": "\n\txsi:schemaLocation=\"\n\t\thttp://www.springframework.org/schema/beans\n\t\thttps://www.springframework.org/schema/beans/spring-beans.xsd\n\t\thttp://www.springframework.org/schema/jdbc\n\t\thttps://www.springframework.org/schema/jdbc/spring-jdbc.xsd\"> "
                  },
                  {
                    "guard": null,
                    "icons": null,
                    "id": "CO2-2",
                    "kind": "callout",
                    "number": "2",
                    "src": "",
                    "xml": false
                  },
                  {
                    "kind": "text",
                    "value": "\n\n\t<!-- bean definitions here -->\n\n</beans>"
                  }
                ],
                "language": "xml",
                "roles": [],
                "title": null
              },
