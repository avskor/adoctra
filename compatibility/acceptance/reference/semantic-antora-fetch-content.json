    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Antora’s first step—​probably the most important—​is the fetching of the content. This is the step that makes Antora so versatile. Here’s how it works."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "olist",
        "id": null,
        "items": [
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The list of repositories is read from "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "a playbook"
                  }
                ],
                "kind": "xref",
                "target": "playbook:configure-playbook.html"
              },
              {
                "kind": "text",
                "value": " ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "site.yml"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": ")."
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "olist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Each time Antora is run, the clone is synchronized with the remote repository."
                      }
                    ]
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "The repositories are cloned bare, which means you won’t actually see any files inside these directories aside from the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": ".git"
                          }
                        ],
                        "kind": "emphasis",
                        "roles": [
                          "path"
                        ]
                      },
                      {
                        "kind": "text",
                        "value": " folder."
                      }
                    ]
                  }
                ],
                "roles": [],
                "style": "loweralpha",
                "title": null
              }
            ],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Using git (via isomorphic-git), these repositories are cloned or updated and stored under "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "build/sources"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Using the information from the playbook, Antora iterates over all the branches in these repositories and decides which ones to use."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Those branches are scanned and their files put into a vinyl collection. A vinyl collection is an in-memory set of virtual file objects."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Each file in a branch is associated with the component name and version defined in the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "component descriptor file"
                  }
                ],
                "kind": "xref",
                "target": "antora_yml.html"
              },
              {
                "kind": "text",
                "value": " ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "antora.yml"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": ") at the root of the branch."
              }
            ]
          }
        ],
        "roles": [],
        "style": "arabic",
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "From this point forward, the rest of Antora’s pipeline interfaces only with the virtual file collection, not the git repositories. This abstracts away the details of each file’s origin. However, the virtual files retain relevant metadata about each file provided by the git repository."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "build/sources"
              }
            ],
            "kind": "emphasis",
            "roles": [
              "path"
            ]
          },
          {
            "kind": "text",
            "value": " may change to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "build/pages"
              }
            ],
            "kind": "emphasis",
            "roles": [
              "path"
            ]
          },
          {
            "kind": "text",
            "value": " in the future."
          }
        ],
        "roles": [],
        "title": null,
        "type": "note"
      }
    ],
    "outline": null,
