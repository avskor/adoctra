    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "On this page, you’ll learn:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "How to install Node.js."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Since Antora is built on Node.js, you’ll need Node.js (commands: "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "node"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "npm"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "npx"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") installed on your machine to install and run Antora."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "We recommend using the active LTS version so that you benefit from the latest performance and security enhancements. The "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Node.js release schedule"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://nodejs.org/en/about/previous-releases"
              },
              {
                "kind": "text",
                "value": " shows the active Node.js LTS versions."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To see if you have Node.js installed, and which version, open a terminal and type:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ node --version"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You should see a version string, such as:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "v26.13.0"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "the command fails with an error"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", it means you don’t have Node.js installed. The best way to install Node.js is to use nvm (Node Version Manager). Skip to "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Install nvm and Node.js"
                  }
                ],
                "kind": "xref",
                "target": "#install-nvm"
              },
              {
                "kind": "text",
                "value": " to find instructions."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If your package manager provides Node.js and npm packages, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "and you’re familiar with using the tools installed system-wide"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", you may choose to go that route. However, we believe you’ll be more successful if you choose "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "nvm"
                  }
                ],
                "kind": "xref",
                "target": "#install-nvm"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "the command returns a version that isn’t an active LTS version"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", upgrade to the latest Node.js LTS version "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "using nvm"
                  }
                ],
                "kind": "xref",
                "target": "#upgrade-node"
              },
              {
                "kind": "text",
                "value": " (or your package manager)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "the command returns an active Node.js LTS version"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", make sure that version is set as your default version by typing the following command in your terminal:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ nvm alias default 26"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Now you’re ready to "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "install Antora"
                  }
                ],
                "kind": "xref",
                "target": "install-antora.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "node",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Node.js"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "We recommend using the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Node Version Manager (nvm)"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://github.com/nvm-sh/nvm"
              },
              {
                "kind": "text",
                "value": " to manage your Node.js installations, though this is not a requirement. Follow the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "nvm installation guide"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://github.com/nvm-sh/nvm#installation-and-update"
              },
              {
                "kind": "text",
                "value": " to set up nvm on your machine. Once you’ve successfully installed nvm, close your current terminal, open a new one, and return here."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you get "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "nvm: command not found"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " after running the install script, then it did not complete successfully. Be sure to follow all prompts issued by the install script. Consult the troubleshooting section in the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "install guide"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://github.com/nvm-sh/nvm#installation-and-update"
              },
              {
                "kind": "text",
                "value": " if you run into problems."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Many CI environments use nvm to manage the version of Node.js used in the build job. By using nvm, you can align your setup with the environment used to generate and publish your production site."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Once you’ve installed nvm, open a new terminal and install the active Node.js LTS release."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ nvm install --lts"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The above command will install the active LTS release of Node.js and automatically set it as your default alias."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Now that you have Node.js set up, you can "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "install Antora"
                  }
                ],
                "kind": "xref",
                "target": "install-antora.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "install-nvm",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Install nvm and Node.js"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you have nvm installed, but don’t have the active (i.e., latest) LTS version installed, type the following command in your terminal:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ nvm install --lts"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To set the latest version of Node.js as the default for any new terminal, type:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ nvm alias default 26"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Now that you’re on the latest LTS version of Node.js, you can "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "install Antora"
                  }
                ],
                "kind": "xref",
                "target": "install-antora.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "upgrade-node",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Upgrade Node.js using nvm"
          }
        ]
      }
    ],
