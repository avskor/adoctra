    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Spring also supports injection by using the JSR-250 "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Resource"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation ("
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "jakarta.annotation.Resource"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ") on fields or bean property setter methods. This is a common pattern in Jakarta EE: for example, in JSF-managed beans and JAX-WS endpoints. Spring supports this pattern for Spring-managed objects as well."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Resource"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " takes a name attribute. By default, Spring interprets that value as the bean name to be injected. In other words, it follows by-name semantics, as demonstrated in the following example:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "public class SimpleMovieLister {\n\n\tprivate MovieFinder movieFinder;\n\n\t@Resource(name=\"myMovieFinder\") "
                            },
                            {
                              "guard": "// ",
                              "icons": null,
                              "id": "CO1-1",
                              "kind": "callout",
                              "number": "1",
                              "src": "",
                              "xml": false
                            },
                            {
                              "kind": "text",
                              "value": "\n\tpublic void setMovieFinder(MovieFinder movieFinder) {\n\t\tthis.movieFinder = movieFinder;\n\t}\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        },
                        {
                          "context": "colist",
                          "id": null,
                          "items": [
