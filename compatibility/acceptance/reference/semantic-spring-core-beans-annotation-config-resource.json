                              "coids": [
                                "CO3-1"
                              ],
                              "icons": null,
                              "inlines": [
                                {
                                  "kind": "text",
                                  "value": "The "
                                },
                                {
                                  "id": null,
                                  "inlines": [
                                    {
                                      "kind": "text",
                                      "value": "context"
                                    }
                                  ],
                                  "kind": "monospace",
                                  "roles": []
                                },
                                {
                                  "kind": "text",
                                  "value": " field is injected based on the known resolvable dependency type: "
                                },
                                {
                                  "id": null,
                                  "inlines": [
                                    {
                                      "kind": "text",
                                      "value": "ApplicationContext"
                                    }
                                  ],
                                  "kind": "monospace",
                                  "roles": []
                                },
                                {
                                  "kind": "text",
                                  "value": "."
                                }
                              ],
                              "src": ""
                            }
                          ],
                          "roles": [],
                          "style": "arabic",
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
