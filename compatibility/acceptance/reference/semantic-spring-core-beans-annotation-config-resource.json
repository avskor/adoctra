      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If no name is explicitly specified, the default name is derived from the field name or setter method. In case of a field, it takes the field name. In case of a setter method, it takes the bean property name. The following example is going to have the bean named "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "movieFinder"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " injected into its setter method:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "public class SimpleMovieLister {\n\n\tprivate MovieFinder movieFinder;\n\n\t@Resource\n\tpublic void setMovieFinder(MovieFinder movieFinder) {\n\t\tthis.movieFinder = movieFinder;\n\t}\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "class SimpleMovieLister {\n\n\t@set:Resource\n\tprivate lateinit var movieFinder: MovieFinder\n\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
