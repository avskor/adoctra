                                "CO1-1"
                              ],
                              "icons": null,
                              "inlines": [
                                {
                                  "kind": "text",
                                  "value": "This line injects a "
                                },
                                {
                                  "id": null,
                                  "inlines": [
                                    {
                                      "kind": "text",
                                      "value": "@Resource"
                                    }
                                  ],
                                  "kind": "monospace",
                                  "roles": []
                                },
                                {
                                  "kind": "text",
                                  "value": "."
                                }
                              ],
                              "src": ""
                            }
                          ],
                          "roles": [],
