                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "class SimpleMovieLister {\n\n\t@Resource(name=\"myMovieFinder\") "
                            },
                            {
                              "guard": "// ",
                              "icons": null,
                              "id": "CO2-1",
                              "kind": "callout",
                              "number": "1",
                              "src": "",
                              "xml": false
                            },
                            {
                              "kind": "text",
                              "value": "\n\tprivate lateinit var movieFinder:MovieFinder\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        },
