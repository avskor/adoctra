{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "JmsTemplate"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " contains many convenience methods to send a message. Send methods specify the destination by using a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "jakarta.jms.Destination"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " object, and others specify the destination by using a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "String"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in a JNDI lookup. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "send"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method that takes no destination argument uses the default destination."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following example uses the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MessageCreator"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " callback to create a text message from the supplied "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Session"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " object:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "import jakarta.jms.ConnectionFactory;\nimport jakarta.jms.JMSException;\nimport jakarta.jms.Message;\nimport jakarta.jms.Queue;\nimport jakarta.jms.Session;\n\nimport org.springframework.jms.core.MessageCreator;\nimport org.springframework.jms.core.JmsTemplate;\n\npublic class JmsQueueSender {\n\n\tprivate JmsTemplate jmsTemplate;\n\tprivate Queue queue;\n\n\tpublic void setConnectionFactory(ConnectionFactory cf) {\n\t\tthis.jmsTemplate = new JmsTemplate(cf);\n\t}\n\n\tpublic void setQueue(Queue queue) {\n\t\tthis.queue = queue;\n\t}\n\n\tpublic void simpleSend() {\n\t\tthis.jmsTemplate.send(this.queue, new MessageCreator() {\n\t\t\tpublic Message createMessage(Session session) throws JMSException {\n\t\t\t\treturn session.createTextMessage(\"hello queue world\");\n\t\t\t}\n\t\t});\n\t}\n}"
              }
            ],
            "language": "java",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In the preceding example, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "JmsTemplate"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is constructed by passing a reference to a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ConnectionFactory"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". As an alternative, a zero-argument constructor and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "connectionFactory"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is provided and can be used for constructing the instance in JavaBean style (using a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "BeanFactory"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or plain Java code). Alternatively, consider deriving from Spring’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "JmsGatewaySupport"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " convenience base class, which provides pre-built bean properties for JMS configuration."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "send(String destinationName, MessageCreator creator)"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method lets you send a message by using the string name of the destination. If these names are registered in JNDI, you should set the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "destinationResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " property of the template to an instance of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "JndiDestinationResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you created the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "JmsTemplate"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and specified a default destination, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "send(MessageCreator c)"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " sends a message to that destination."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To facilitate the sending of domain model objects, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "JmsTemplate"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " has various send methods that take a Java object as an argument for a message’s data content. The overloaded methods "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "convertAndSend()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "receiveAndConvert()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " methods in "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "JmsTemplate"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " delegate the conversion process to an instance of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MessageConverter"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " interface. This interface defines a simple contract to convert between Java objects and JMS messages. The default implementation ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "SimpleMessageConverter"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") supports conversion between "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "String"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TextMessage"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "byte[]"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "BytesMessage"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "java.util.Map"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MapMessage"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". By using the converter, you and your application code can focus on the business object that is being sent or received through JMS and not be concerned with the details of how it is represented as a JMS message."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The sandbox currently includes a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MapMessageConverter"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", which uses reflection to convert between a JavaBean and a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MapMessage"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Other popular implementation choices you might implement yourself are converters that use an existing XML marshalling package (such as JAXB or XStream) to create a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TextMessage"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " that represents the object."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To accommodate the setting of a message’s properties, headers, and body that can not be generically encapsulated inside a converter class, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MessagePostProcessor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " interface gives you access to the message after it has been converted but before it is sent. The following example shows how to modify a message header and a property after a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "java.util.Map"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is converted to a message:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "public void sendWithConversion() {\n\tMap map = new HashMap();\n\tmap.put(\"Name\", \"Mark\");\n\tmap.put(\"Age\", new Integer(47));\n\tjmsTemplate.convertAndSend(\"testQueue\", map, new MessagePostProcessor() {\n\t\tpublic Message postProcessMessage(Message message) throws JMSException {\n\t\t\tmessage.setIntProperty(\"AccountID\", 1234);\n\t\t\tmessage.setJMSCorrelationID(\"123-00001\");\n\t\t\treturn message;\n\t\t}\n\t});\n}"
              }
            ],
            "language": "java",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This results in a message of the following form:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MapMessage={\n\tHeader={\n\t\t... standard headers ...\n\t\tCorrelationID={123-00001}\n\t}\n\tProperties={\n\t\tAccountID={Integer:1234}\n\t}\n\tFields={\n\t\tName={String:Mark}\n\t\tAge={Integer:47}\n\t}\n}"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "jms-msg-conversion",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Using Message Converters"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "While the send operations cover many common usage scenarios, you might sometimes want to perform multiple operations on a JMS "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Session"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MessageProducer"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "SessionCallback"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ProducerCallback"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " expose the JMS "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Session"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Session"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " / "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MessageProducer"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " pair, respectively. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "execute()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " methods on "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "JmsTemplate"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " run these callback methods."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "jms-callbacks",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Using "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "SessionCallback"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ProducerCallback"
              }
            ],
            "kind": "monospace",
            "roles": []
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Sending a Message"
      }
    ]
  }
}
