  "html": "<h1>Mark Category Keys</h1>\n<div class=\"paragraph\">\n<p>The keys in the <code>mark</code> category apply to an inline mark phrase.</p>\n</div>\n<table class=\"tableblock frame-none grid-rows stretch\">\n<colgroup>\n<col style=\"width: 25%;\">\n<col style=\"width: 33.3333%;\">\n<col style=\"width: 41.6667%;\">\n</colgroup>\n<thead>\n<tr>\n<th class=\"tableblock halign-left valign-top\">Key</th>\n<th class=\"tableblock halign-left valign-top\">Value Type</th>\n<th class=\"tableblock halign-left valign-top\">Example</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\">background-color</p></td>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\"><a href=\"color.html\">Color</a><br>\n(default: <code>'FFFF00'</code>)</p></td>\n<td class=\"tableblock halign-left valign-top\"><div class=\"content\"><div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-yaml\" data-lang=\"yaml\">mark:\n  background-color: #FCF8E3</code></pre>\n</div>\n</div></div></td>\n</tr>\n<tr>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\">border-offset</p></td>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\"><a href=\"language.html#values\">Number</a><br>\n(default: <code>1</code>)</p></td>\n<td class=\"tableblock halign-left valign-top\"><div class=\"content\"><div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-yaml\" data-lang=\"yaml\">mark:\n  border-offset: 2</code></pre>\n</div>\n</div></div></td>\n</tr>\n<tr>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\">font-color</p></td>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\"><a href=\"color.html\">Color</a><br>\n(default: <em>inherit</em>)</p></td>\n<td class=\"tableblock halign-left valign-top\"><div class=\"content\"><div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-yaml\" data-lang=\"yaml\">mark:\n  font-color: #333333</code></pre>\n</div>\n</div></div></td>\n</tr>\n<tr>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\">font-style</p></td>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\"><a href=\"text.html#font-style\">Font style</a><br>\n(default: <em>inherit</em>)</p></td>\n<td class=\"tableblock halign-left valign-top\"><div class=\"content\"><div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-yaml\" data-lang=\"yaml\">mark:\n  font-style: bold</code></pre>\n</div>\n</div></div></td>\n</tr>\n</tbody>\n</table>\n"
}
