      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following example shows an extension that executes all test methods in Swing’s Event Dispatch Thread."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "listing",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "public class SwingEdtInterceptor implements InvocationInterceptor {\n\n\t@Override\n\tpublic void interceptTestMethod(Invocation<Void> invocation,\n\t\t\tReflectiveInvocationContext<Method> invocationContext,\n\t\t\tExtensionContext extensionContext) throws Throwable {\n\n\t\tAtomicReference<Throwable> throwable = new AtomicReference<>();\n\n\t\tSwingUtilities.invokeAndWait(() -> {\n\t\t\ttry {\n\t\t\t\tinvocation.proceed();\n\t\t\t}\n\t\t\tcatch (Throwable t) {\n\t\t\t\tthrowable.set(t);\n\t\t\t}\n\t\t});\n\t\tThrowable t = throwable.get();\n\t\tif (t != null) {\n\t\t\tthrow t;\n\t\t}\n\t}\n}"
          }
        ],
        "language": "java",
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "An extension that executes tests in a user-defined thread"
          }
        ]
      },
