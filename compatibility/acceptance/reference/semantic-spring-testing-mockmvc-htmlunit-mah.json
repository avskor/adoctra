{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This section describes how to integrate MockMvc and HtmlUnit. Use this option if you want to use the raw HtmlUnit libraries."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "First, make sure that you have included a test dependency on "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "org.htmlunit:htmlunit"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "We can easily create an HtmlUnit "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "WebClient"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " that integrates with MockMvc by using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MockMvcWebClientBuilder"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", as follows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "WebClient webClient;\n\n@BeforeEach\nvoid setup(WebApplicationContext context) {\n\twebClient = MockMvcWebClientBuilder\n\t\t\t.webAppContextSetup(context)\n\t\t\t.build();\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "lateinit var webClient: WebClient\n\n@BeforeEach\nfun setup(context: WebApplicationContext) {\n\twebClient = MockMvcWebClientBuilder\n\t\t\t.webAppContextSetup(context)\n\t\t\t.build()\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This is a simple example of using "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MockMvcWebClientBuilder"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". For advanced usage, see "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Advanced "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "MockMvcWebClientBuilder"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ],
                "kind": "xref",
                "target": "testing/mockmvc/htmlunit/mah.html#spring-mvc-test-server-htmlunit-mah-advanced-builder"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This ensures that any URL that references "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "localhost"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " as the server is directed to our "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MockMvc"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instance without the need for a real HTTP connection. Any other URL is requested by using a network connection, as normal. This lets us easily test the use of CDNs."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "mockmvc-server-htmlunit-mah-setup",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "MockMvc and HtmlUnit Setup"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Now we can use HtmlUnit as we normally would but without the need to deploy our application to a Servlet container. For example, we can request the view to create a message with the following:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "HtmlPage createMsgFormPage = webClient.getPage(\"http://localhost/messages/form\");"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "val createMsgFormPage = webClient.getPage(\"http://localhost/messages/form\")"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The default context path is "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "\"\""
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Alternatively, we can specify the context path, as described in "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Advanced "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "MockMvcWebClientBuilder"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ],
                "kind": "xref",
                "target": "testing/mockmvc/htmlunit/mah.html#spring-mvc-test-server-htmlunit-mah-advanced-builder"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Once we have a reference to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "HtmlPage"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", we can then fill out the form and submit it to create a message, as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "HtmlForm form = createMsgFormPage.getHtmlElementById(\"messageForm\");\nHtmlTextInput summaryInput = createMsgFormPage.getHtmlElementById(\"summary\");\nsummaryInput.setValueAttribute(\"Spring Rocks\");\nHtmlTextArea textInput = createMsgFormPage.getHtmlElementById(\"text\");\ntextInput.setText(\"In case you didn't know, Spring Rocks!\");\nHtmlSubmitInput submit = form.getOneHtmlElementByAttribute(\"input\", \"type\", \"submit\");\nHtmlPage newMessagePage = submit.click();"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "val form = createMsgFormPage.getHtmlElementById(\"messageForm\")\nval summaryInput = createMsgFormPage.getHtmlElementById(\"summary\")\nsummaryInput.setValueAttribute(\"Spring Rocks\")\nval textInput = createMsgFormPage.getHtmlElementById(\"text\")\ntextInput.setText(\"In case you didn't know, Spring Rocks!\")\nval submit = form.getOneHtmlElementByAttribute(\"input\", \"type\", \"submit\")\nval newMessagePage = submit.click()"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Finally, we can verify that a new message was created successfully. The following assertions use the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "AssertJ"
                  }
                ],
                "kind": "link",
                "target": "https://assertj.github.io/doc"
              },
              {
                "kind": "text",
                "value": " library:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "assertThat(newMessagePage.getUrl().toString()).endsWith(\"/messages/123\");\nString id = newMessagePage.getHtmlElementById(\"id\").getTextContent();\nassertThat(id).isEqualTo(\"123\");\nString summary = newMessagePage.getHtmlElementById(\"summary\").getTextContent();\nassertThat(summary).isEqualTo(\"Spring Rocks\");\nString text = newMessagePage.getHtmlElementById(\"text\").getTextContent();\nassertThat(text).isEqualTo(\"In case you didn't know, Spring Rocks!\");"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "assertThat(newMessagePage.getUrl().toString()).endsWith(\"/messages/123\")\nval id = newMessagePage.getHtmlElementById(\"id\").getTextContent()\nassertThat(id).isEqualTo(\"123\")\nval summary = newMessagePage.getHtmlElementById(\"summary\").getTextContent()\nassertThat(summary).isEqualTo(\"Spring Rocks\")\nval text = newMessagePage.getHtmlElementById(\"text\").getTextContent()\nassertThat(text).isEqualTo(\"In case you didn't know, Spring Rocks!\")"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The preceding code improves on our "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MockMvc test"
                  }
                ],
                "kind": "xref",
                "target": "testing/mockmvc/htmlunit/why.html#spring-mvc-test-server-htmlunit-mock-mvc-test"
              },
              {
                "kind": "text",
                "value": " in a number of ways. First, we no longer have to explicitly verify our form and then create a request that looks like the form. Instead, we request the form, fill it out, and submit it, thereby significantly reducing the overhead."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Another important factor is that "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "HtmlUnit uses the Mozilla Rhino engine"
                  }
                ],
                "kind": "link",
                "target": "https://htmlunit.sourceforge.io/javascript.html"
              },
              {
                "kind": "text",
                "value": " to evaluate JavaScript. This means that we can also test the behavior of JavaScript within our pages."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "See the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "HtmlUnit documentation"
                  }
                ],
                "kind": "link",
                "target": "https://htmlunit.sourceforge.io/gettingStarted.html"
              },
              {
                "kind": "text",
                "value": " for additional information about using HtmlUnit."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "mockmvc-server-htmlunit-mah-usage",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "MockMvc and HtmlUnit Usage"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In the examples so far, we have used "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MockMvcWebClientBuilder"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in the simplest way possible, by building a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "WebClient"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " based on the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "WebApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " loaded for us by the Spring TestContext Framework. This approach is repeated in the following example:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "WebClient webClient;\n\n@BeforeEach\nvoid setup(WebApplicationContext context) {\n\twebClient = MockMvcWebClientBuilder\n\t\t\t.webAppContextSetup(context)\n\t\t\t.build();\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "lateinit var webClient: WebClient\n\n@BeforeEach\nfun setup(context: WebApplicationContext) {\n\twebClient = MockMvcWebClientBuilder\n\t\t\t.webAppContextSetup(context)\n\t\t\t.build()\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "We can also specify additional configuration options, as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "WebClient webClient;\n\n@BeforeEach\nvoid setup() {\n\twebClient = MockMvcWebClientBuilder\n\t\t// demonstrates applying a MockMvcConfigurer (Spring Security)\n\t\t.webAppContextSetup(context, springSecurity())\n\t\t// for illustration only - defaults to \"\"\n\t\t.contextPath(\"\")\n\t\t// By default MockMvc is used for localhost only;\n\t\t// the following will use MockMvc for example.com and example.org as well\n\t\t.useMockMvcForHosts(\"example.com\",\"example.org\")\n\t\t.build();\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "lateinit var webClient: WebClient\n\n@BeforeEach\nfun setup() {\n\twebClient = MockMvcWebClientBuilder\n\t\t// demonstrates applying a MockMvcConfigurer (Spring Security)\n\t\t.webAppContextSetup(context, springSecurity())\n\t\t// for illustration only - defaults to \"\"\n\t\t.contextPath(\"\")\n\t\t// By default MockMvc is used for localhost only;\n\t\t// the following will use MockMvc for example.com and example.org as well\n\t\t.useMockMvcForHosts(\"example.com\",\"example.org\")\n\t\t.build()\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "As an alternative, we can perform the exact same setup by configuring the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MockMvc"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instance separately and supplying it to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MockMvcWebClientBuilder"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", as follows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
