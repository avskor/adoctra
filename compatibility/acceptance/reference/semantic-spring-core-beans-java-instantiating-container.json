            "roles": []
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "WebApplicationContext"
