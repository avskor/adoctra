          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can instantiate an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "AnnotationConfigApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " by using a no-arg constructor and then configure it by using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "register()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method. This approach is particularly useful when programmatically building an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "AnnotationConfigApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The following example shows how to do so:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "public static void main(String[] args) {\n\tAnnotationConfigApplicationContext ctx = new AnnotationConfigApplicationContext();\n\tctx.register(AppConfig.class, OtherConfig.class);\n\tctx.register(AdditionalConfig.class);\n\tctx.refresh();\n\tMyService myService = ctx.getBean(MyService.class);\n\tmyService.doStuff();\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "import org.springframework.beans.factory.getBean\n\nfun main() {\n\tval ctx = AnnotationConfigApplicationContext()\n\tctx.register(AppConfig::class.java, OtherConfig::class.java)\n\tctx.register(AdditionalConfig::class.java)\n\tctx.refresh()\n\tval myService = ctx.getBean<MyService>()\n\tmyService.doStuff()\n}"
                            }
                          ],
