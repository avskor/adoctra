                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The preceding example assumes that "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MyServiceImpl"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Dependency1"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Dependency2"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " use Spring dependency injection annotations such as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Autowired"
                  }
                ],
                "kind": "monospace",
