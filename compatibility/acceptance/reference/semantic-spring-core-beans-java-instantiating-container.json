                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". You can use this implementation when configuring the Spring "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ContextLoaderListener"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " servlet listener, Spring MVC "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DispatcherServlet"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", and so forth. The following "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "web.xml"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " snippet configures a typical Spring MVC web application (note the use of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "contextClass"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " context-param and init-param):"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "<web-app>\n\t<!-- Configure ContextLoaderListener to use AnnotationConfigWebApplicationContext\n\t\tinstead of the default XmlWebApplicationContext -->\n\t<context-param>\n\t\t<param-name>contextClass</param-name>\n\t\t<param-value>\n\t\t\torg.springframework.web.context.support.AnnotationConfigWebApplicationContext\n\t\t</param-value>\n\t</context-param>\n\n\t<!-- Configuration locations must consist of one or more comma- or space-delimited\n\t\tfully-qualified @Configuration classes. Fully-qualified packages may also be\n\t\tspecified for component-scanning -->\n\t<context-param>\n\t\t<param-name>contextConfigLocation</param-name>\n\t\t<param-value>com.acme.AppConfig</param-value>\n\t</context-param>\n\n\t<!-- Bootstrap the root application context as usual using ContextLoaderListener -->\n\t<listener>\n\t\t<listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>\n\t</listener>\n\n\t<!-- Declare a Spring MVC DispatcherServlet as usual -->\n\t<servlet>\n\t\t<servlet-name>dispatcher</servlet-name>\n\t\t<servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>\n\t\t<!-- Configure DispatcherServlet to use AnnotationConfigWebApplicationContext\n\t\t\tinstead of the default XmlWebApplicationContext -->\n\t\t<init-param>\n\t\t\t<param-name>contextClass</param-name>\n\t\t\t<param-value>\n\t\t\t\torg.springframework.web.context.support.AnnotationConfigWebApplicationContext\n\t\t\t</param-value>\n\t\t</init-param>\n\t\t<!-- Again, config locations must consist of one or more comma- or space-delimited\n\t\t\tand fully-qualified @Configuration classes -->\n\t\t<init-param>\n\t\t\t<param-name>contextConfigLocation</param-name>\n\t\t\t<param-value>com.acme.web.MvcConfig</param-value>\n\t\t</init-param>\n\t</servlet>\n\n\t<!-- map all requests for /app/* to the dispatcher servlet -->\n\t<servlet-mapping>\n\t\t<servlet-name>dispatcher</servlet-name>\n\t\t<url-pattern>/app/*</url-pattern>\n\t</servlet-mapping>\n</web-app>"
              }
            ],
            "language": "xml",
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
