            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is used to store model attributes in the HTTP Servlet session between requests. It is a type-level annotation that declares the session attributes used by a specific controller. This typically lists the names of model attributes or types of model attributes that should be transparently stored in the session for subsequent requests to access."
          }
        ],
        "roles": [],
        "title": null
      },
