        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Class hierarchy with overridden context hierarchy configuration"
              }
            ],
            "kind": "strong",
            "roles": []
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In contrast to the previous example, this example demonstrates how to override the configuration for a given named level in a context hierarchy by setting the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "inheritLocations"
                  }
                ],
                "kind": "monospace",
