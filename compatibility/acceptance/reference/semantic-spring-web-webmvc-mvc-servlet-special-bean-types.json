            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "See equivalent in the Reactive stack"
                  }
                ],
                "kind": "xref",
                "target": "web/webflux/dispatcher-handler.html#webflux-special-bean-types"
              }
            ],
            "kind": "span",
            "roles": [
              "small"
            ]
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DispatcherServlet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " delegates to special beans to process requests and render the appropriate responses. By “special beans” we mean Spring-managed "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Object"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " instances that implement framework contracts. Those usually come with built-in contracts, but you can customize their properties and extend or replace them."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following table lists the special beans detected by the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DispatcherServlet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ":"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "autowidth": false,
        "body": [
          [
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "HandlerMapping"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            },
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "kind": "text",
                    "value": "Map a request to a handler along with a list of "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "interceptors"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc/mvc-servlet/handlermapping-interceptor.html"
                  },
                  {
                    "kind": "text",
                    "value": " for pre- and post-processing. The mapping is based on some criteria, the details of which vary by "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "HandlerMapping"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " implementation."
                  }
                ],
                [
                  {
                    "kind": "text",
                    "value": " The two main "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "HandlerMapping"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " implementations are "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "RequestMappingHandlerMapping"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " (which supports "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@RequestMapping"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " annotated methods) and "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "SimpleUrlHandlerMapping"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " (which maintains explicit registrations of URI path patterns to handlers)."
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            }
          ],
          [
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "HandlerAdapter"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            },
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "kind": "text",
                    "value": "Help the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "DispatcherServlet"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " to invoke a handler mapped to a request, regardless of how the handler is actually invoked. For example, invoking an annotated controller requires resolving annotations. The main purpose of a "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "HandlerAdapter"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " is to shield the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "DispatcherServlet"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " from such details."
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            }
          ],
          [
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "HandlerExceptionResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc/mvc-servlet/exceptionhandlers.html"
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            },
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "kind": "text",
                    "value": "Strategy to resolve exceptions, possibly mapping them to handlers, to HTML error views, or other targets. See "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Exceptions"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc/mvc-servlet/exceptionhandlers.html"
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            }
          ],
          [
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "ViewResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc/mvc-servlet/viewresolver.html"
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            },
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "kind": "text",
                    "value": "Resolve logical "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "String"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "-based view names returned from a handler to an actual "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "View"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " with which to render to the response. See "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "View Resolution"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc/mvc-servlet/viewresolver.html"
                  },
                  {
                    "kind": "text",
                    "value": " and "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "View Technologies"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc-view.html"
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            }
          ],
          [
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "LocaleResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc/mvc-servlet/localeresolver.html"
                  },
                  {
                    "kind": "text",
                    "value": ", "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "LocaleContextResolver"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc/mvc-servlet/localeresolver.html#mvc-timezone"
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            },
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "kind": "text",
                    "value": "Resolve the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Locale"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " a client is using and possibly their time zone, in order to be able to offer internationalized views. See "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Locale"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc/mvc-servlet/localeresolver.html"
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            }
          ],
          [
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "ThemeResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc/mvc-servlet/themeresolver.html"
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            },
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "kind": "text",
                    "value": "Resolve themes your web application can use — for example, to offer personalized layouts. See "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Themes"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc/mvc-servlet/themeresolver.html"
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            }
          ],
          [
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "MultipartResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc/mvc-servlet/multipart.html"
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            },
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "kind": "text",
                    "value": "Abstraction for parsing a multi-part request (for example, browser form file upload) with the help of some multipart parsing library. See "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Multipart Resolver"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc/mvc-servlet/multipart.html"
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            }
          ],
          [
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "FlashMapManager"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc/mvc-controller/ann-methods/flash-attributes.html"
                  }
                ]
              ],
              "rowspan": 1,
              "style": null,
              "valign": "top"
            },
            {
              "background": null,
              "colspan": 1,
              "halign": "left",
              "paragraphs": [
                [
                  {
                    "kind": "text",
                    "value": "Store and retrieve the “input” and the “output” "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "FlashMap"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " that can be used to pass attributes from one request to another, usually across a redirect. See "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Flash Attributes"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc/mvc-controller/ann-methods/flash-attributes.html"
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ]
              ],
