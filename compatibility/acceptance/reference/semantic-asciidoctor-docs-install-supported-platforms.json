            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Our general policy is to align Asciidoctor’s support of a platform version with the upstream project’s lifecycle schedule for that version. When a platform version reaches the end of active support by its maintainers or its end of life—​which ever comes first—​Asciidoctor no longer supports it."
              }
            ],
            "roles": [],
            "title": null
