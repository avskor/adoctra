          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "In the example above, we are overriding the bean with type "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "CustomService"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". If more than one bean of that type exists, the bean named "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "customService"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is considered. Otherwise, the test will fail, and you will need to provide a qualifier of some sort to identify which of the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "CustomService"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " beans you want to override."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following example uses a by-name lookup, rather than a by-type lookup:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "class OverrideBeanTests {\n\t@TestBean(name = \"service\", methodName = \"createCustomService\") "
                        },
                        {
                          "guard": "// ",
                          "icons": null,
                          "id": "CO2-1",
                          "kind": "callout",
                          "number": "1",
                          "src": "",
                          "xml": false
                        },
                        {
                          "kind": "text",
                          "value": "\n\tprivate CustomService customService;\n\n\t// test case body...\n\n\tprivate static CustomService createCustomService() { "
                        },
                        {
                          "guard": "// ",
                          "icons": null,
                          "id": "CO2-2",
                          "kind": "callout",
                          "number": "2",
                          "src": "",
                          "xml": false
                        },
                        {
                          "kind": "text",
                          "value": "\n\t\treturn new MyFakeCustomService();\n\t}\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    },
                    {
                      "context": "colist",
                      "id": null,
                      "items": [
                        {
                          "blocks": [],
                          "checkbox": null,
                          "coids": [
                            "CO2-1"
                          ],
                          "icons": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "Mark a field for overriding the bean with name "
                            },
                            {
                              "id": null,
                              "inlines": [
                                {
                                  "kind": "text",
                                  "value": "service"
                                }
                              ],
                              "kind": "monospace",
                              "roles": []
                            },
                            {
                              "kind": "text",
                              "value": ", and specify that the factory method is named "
                            },
                            {
                              "id": null,
                              "inlines": [
                                {
                                  "kind": "text",
                                  "value": "createCustomService"
                                }
                              ],
                              "kind": "monospace",
                              "roles": []
                            },
                            {
                              "kind": "text",
                              "value": "."
                            }
                          ],
                          "src": ""
                        },
                        {
                          "blocks": [],
                          "checkbox": null,
                          "coids": [
                            "CO2-2"
                          ],
                          "icons": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "The result of this static method will be used as the instance and injected into the field."
                            }
                          ],
                          "src": ""
                        }
                      ],
                      "roles": [],
