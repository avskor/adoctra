    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@TestBean"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is used on a field in a test class to override a specific bean in the test’s "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " with an instance provided by a factory method."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The associated factory method name is derived from the annotated field’s name, or the bean name if specified. The factory method must be "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "static"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", accept no arguments, and have a return type compatible with the type of the bean to override. To make things more explicit, or if you’d rather use a different name, the annotation allows for a specific method name to be provided."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "By default, the annotated field’s type is used to search for candidate beans to override. If multiple candidates match, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Qualifier"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " can be provided to narrow the candidate to override. Alternatively, a candidate whose bean name matches the name of the field will match."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "A bean will be created if a corresponding bean does not exist. However, if you would like for the test to fail when a corresponding bean does not exist, you can set the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "enforceOverride"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " attribute to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "true"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " – for example, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@TestBean(enforceOverride = true)"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "To use a by-name override rather than a by-type override, specify the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "name"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " attribute of the annotation."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Qualifiers, including the name of the field, are used to determine if a separate "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " needs to be created. If you are using this feature to override the same bean in several tests, make sure to name the field consistently to avoid creating unnecessary contexts."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "admonition",
        "id": null,
        "roles": [],
        "title": null,
        "type": "warning"
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following example shows how to use the default behavior of the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@TestBean"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "class OverrideBeanTests {\n\t@TestBean "
                        },
                        {
                          "guard": "// ",
                          "icons": null,
                          "id": "CO1-1",
                          "kind": "callout",
                          "number": "1",
                          "src": "",
                          "xml": false
                        },
                        {
                          "kind": "text",
                          "value": "\n\tprivate CustomService customService;\n\n\t// test case body...\n\n\tprivate static CustomService customService() { "
                        },
                        {
                          "guard": "// ",
                          "icons": null,
                          "id": "CO1-2",
                          "kind": "callout",
                          "number": "2",
                          "src": "",
                          "xml": false
                        },
                        {
                          "kind": "text",
                          "value": "\n\t\treturn new MyFakeCustomService();\n\t}\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    },
                    {
                      "context": "colist",
                      "id": null,
                      "items": [
                        {
                          "blocks": [],
                          "checkbox": null,
                          "coids": [
                            "CO1-1"
                          ],
                          "icons": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "Mark a field for overriding the bean with type "
                            },
                            {
                              "id": null,
                              "inlines": [
                                {
                                  "kind": "text",
                                  "value": "CustomService"
                                }
                              ],
                              "kind": "monospace",
                              "roles": []
                            },
                            {
                              "kind": "text",
                              "value": "."
                            }
                          ],
                          "src": ""
                        },
                        {
                          "blocks": [],
                          "checkbox": null,
                          "coids": [
                            "CO1-2"
                          ],
                          "icons": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "The result of this static method will be used as the instance and injected into the field."
                            }
                          ],
                          "src": ""
                        }
                      ],
                      "roles": [],
                      "style": "arabic",
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
