      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Spring searches for the factory method to invoke in the test class, in the test class hierarchy, and in the enclosing class hierarchy for a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Nested"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " test class."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Alternatively, a factory method in an external class can be referenced via its fully-qualified method name following the syntax "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<fully-qualified class name>#<method name>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " – for example, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "methodName = \"org.example.TestUtils#createCustomService\""
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "admonition",
        "id": null,
        "roles": [],
        "title": null,
        "type": "tip"
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Only "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "singleton"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " beans can be overridden. Any attempt to override a non-singleton bean will result in an exception."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When overriding a bean created by a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "FactoryBean"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "FactoryBean"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " will be replaced with a singleton bean corresponding to the value returned from the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@TestBean"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " factory method."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "admonition",
        "id": null,
        "roles": [],
        "title": null,
        "type": "tip"
      }
    ],
    "outline": null,
