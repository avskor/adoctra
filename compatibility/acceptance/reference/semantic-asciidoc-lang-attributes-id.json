{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can assign an identifier (i.e., unique name) to a block or inline element using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "id"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "id"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute is a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "named attribute"
                  }
                ],
                "kind": "xref",
                "target": "positional-and-named-attributes.html#named"
              },
              {
                "kind": "text",
                "value": ". Its purpose is to identify the element when linking, scripting, or styling. Thus, the identifier can only be used once in a document."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An ID:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "olist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "provides an internal link or cross reference anchor for an element"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "can be used for adding additional styling to specific elements (e.g., via a CSS ID selector)"
                  }
                ]
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can assign an ID to blocks using the shorthand hash ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "#"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") syntax, longhand ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "id="
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") syntax, or the legacy anchor ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[[]]"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") syntax. You can assign an ID to inline elements using the shorthand hash ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "#"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") syntax or by adding an anchor adjacent to the inline element using the anchor ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[[]]"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") syntax."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "AsciiDoc does not restrict the set of characters that can be used for an ID when the ID is defined using the named "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "id"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute. All the language requires in this case is that the value be non-empty. When the ID is defined using the shorthand hash syntax or the anchor syntax, the acceptable characters is more limited (for example, spaces are not permitted). Regardless, it’s not advisable to exploit the ability to use any characters the AsciiDoc syntax allows. The reason to be cautious is because the ID is passed through to the output, and not all output formats afford the same latitude. For example, XML is far more restrictive about which characters are permitted in an ID value."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To ensure portability of your IDs, it’s best to conform to a universal standard. The standard we recommend following is a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Name"
                  }
                ],
                "kind": "link",
                "target": "https://www.w3.org/TR/REC-xml/#NT-Name"
              },
              {
                "kind": "text",
                "value": " value as defined by the XML specification. At a high level, the first character of a Name must be a letter, colon, or underscore and the optional following characters must be a letter, colon, underscore, hyphen, period, or digit. You should not use any space characters in an ID. Starting the ID with a digit is less likely to be problematic, but still best to avoid. It’s best to use lowercase letters whenever possible as this solves portability problem when using case-insensitive platforms."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the AsciiDoc processor auto-generates IDs for section titles and discrete headings, it adheres to this standard."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here are examples of valid IDs (according to the recommendations above):"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "install\ndata-structures\nerror-handling\nsubject-and-body\nunset_an_attribute"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here are examples of invalid IDs:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "install the gem\n3 blind mice\n-about-the-author"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_valid_id_characters",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Valid ID characters"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can assign an ID to a block using the shorthand syntax, the longhand syntax, or a legacy block anchor."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In the shorthand syntax, you prefix the name with a hash ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "#"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") in the first position attribute."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[#goals]\n* Goal 1\n* Goal 2"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In the longhand syntax, you use a standard named attribute."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[id=goals]\n* Goal 1\n* Goal 2"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In the legacy block anchor syntax, you surround the name with double square brackets:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[[goals]]\n* Goal 1\n* Goal 2"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Let’s say you want to create a blockquote from an open block and assign it an ID and "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "role"
                  }
                ],
                "kind": "xref",
                "target": "role.html"
              },
              {
                "kind": "text",
                "value": ". You add "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "quote"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (the block style) in front of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "#"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (the ID) in the first attribute position, as this example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[quote.movie#roads,Dr. Emmett Brown]\n____\nRoads? Where we're going, we don't need roads.\n____"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The order of ID and role values in the shorthand syntax does not matter."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the ID contains a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", you must define it using either a longhand assignment (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "id=classname.propertyname"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") or the anchor shorthand (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[[classname.propertyname]]"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). This is necessary since the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " character in the shorthand syntax is the delimiter for a role, and thus gets misinterpreted as such."
              }
            ],
            "roles": [],
            "title": null,
            "type": "caution"
          }
        ],
        "context": "section",
        "id": "_block_assignment",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Block assignment"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The id ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "#"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") shorthand can be used on inline quoted text."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[#free_the_world]*free the world*"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Quoted text block with id assignment using shorthand syntax"
              }
            ]
          }
        ],
        "context": "section",
        "id": "_inline_assignment",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Inline assignment"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An anchor (aka ID) can be defined almost anywhere in the document, including on a section title, on a discrete heading, on a paragraph, on an image, on a delimited block, on an inline phrase, and so forth. The anchor is declared by enclosing a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "valid"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " XML Name in double square brackets (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[[idname]]"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") or using the shorthand ID syntax (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[#idname]"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") at the start of an attribute list. The shorthand form is the preferred syntax."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The double square bracket form requires the ID to start with a letter, an underscore, or a colon, ensuring the ID is portable. According to the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "XML Name"
                  }
                ],
                "kind": "link",
                "target": "https://www.w3.org/TR/REC-xml/#NT-Name"
              },
              {
                "kind": "text",
                "value": " rules, a portable ID may not begin with a number, even though a number is allowed elsewhere in the name. The shorthand form in an attribute list does not impose this restriction."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "To reference a block element, you must assign an ID to that block. You can define an ID using the shorthand syntax:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[#notice]\nThis paragraph gets a lot of attention."
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Assign an ID to a paragraph using shorthand syntax"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "or you can define it using the legacy block anchor syntax:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[[notice]]\nThis paragraph gets a lot of attention."
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Assign an ID to a paragraph using legacy block anchor syntax"
                  }
                ]
              }
            ],
            "context": "section",
            "id": "_on_block_element",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "On block element"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "You can also define an anchor anywhere in content that receives normal substitutions (specifically the macros substitution). You can enclose the ID in double square brackets:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[[bookmark-a]]Inline anchors make arbitrary content referenceable."
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Define an inline anchor"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "or using the shorthand ID syntax."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[#bookmark-b]#Inline anchors can be applied to a phrase like this one.#"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Define an inline anchor using shorthand syntax"
                  }
                ]
              }
            ],
            "context": "section",
            "id": "_as_an_inline_anchor",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "As an inline anchor"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In addition to being able to define anchors on sections and blocks, anchors can be defined inline wherever you can type normal text (anchors are a macros substitution). The anchors in the text get replaced with invisible anchor points in the output."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "For example, you would not put an anchor in front of a list item:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[[anchor-point]]* list item with invalid anchor"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Invalid"
                      }
                    ],
                    "kind": "strong",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " position for an anchor ID in front of a list item"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Instead, you would put it at the start of the text of the list item:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "* First item\n* [[step2]]Second item\n* Third item"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Define an inline anchor on a list item"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "For a description list, the anchor must be placed at the start of the term:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[[cpu,CPU]]Central Processing Unit (CPU)::\nThe brain of the computer.\n\n[[hard-drive]]Hard drive::\nPermanent storage for operating system and/or user files."
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Define an inline anchor on a description list item"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "You can add multiple anchors to a list item or description list term. However, only the first anchor is registered for use as an xref within the document. The remaining anchors are auxiliary and are used for making deep links (i.e., accessible from a URL fragment)."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "_on_a_list_item",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "On a list item"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "You cannot currently define an ID on an inline image. Instead you need to place an inline anchor adjacent to it."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[[tiger-image]]image:tiger.png[Image of a tiger]"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Placing an inline anchor adjacent to an inline image using shorthand"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Instead of the shorthand form, you can use the macro "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "anchor"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " to achieve the same goal."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "anchor:tiger-image[]image:tiger.png[Image of a tiger]"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Placing an inline anchor adjacent to an inline image using a macro"
                  }
                ]
              }
            ],
            "context": "section",
            "id": "_on_an_inline_image",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "On an inline image"
              }
            ]
          }
        ],
        "context": "section",
        "id": "anchor",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Use an ID as an anchor"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To add additional anchors to a section (with or without an autogenerated ID), place the anchors in front of the title (without any spaces)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[#version-4_9]\n=== [[current]][[latest]]Version 4.9"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Add additional anchors to a section using inline anchors"
              }
            ]
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You cannot use inline anchors in a section title to make internal references to that section. The processor will flag these as possible invalid references. These additional anchors are only intended for making deep links using an alternate ID."
              }
            ],
            "roles": [],
            "title": null,
            "type": "caution"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Remember that inline anchors are discovered wherever the macros substitution is applied (e.g., paragraph text). If text content doesn’t belong somewhere, neither does an inline anchor point."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_add_additional_anchors_to_a_section",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Add additional anchors to a section"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "It’s possible to customize the text that will be used in the cross reference link (called "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "xreflabel"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). If not defined, the AsciiDoc processor does it best to find suitable text (the solution differs from case to case). In case of an image, the image caption will be used. In case of a section header, the text of the section’s title will be used."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To define the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "xreflabel"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", add it in the anchor definition right after the ID (separated by a comma)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[[tiger-image,Image of a tiger]]\n.This image represents a Bengal tiger also called the Indian tiger\nimage::tiger.png[]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "An anchor ID with a defined xreflabel. The caption will not be used as link text."
              }
            ]
          }
        ],
        "context": "section",
        "id": "_customize_automatic_xreftext",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Customize automatic xreftext"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "ID Attribute"
      }
    ]
  }
}
