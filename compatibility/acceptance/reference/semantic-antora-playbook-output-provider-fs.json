              },
              {
                "kind": "text",
                "value": " category key provides a convenient way to specify an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fs"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " destination. However, it’s relationship to the destinations array can be tricky to understand."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For the first destination whose provider is set to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fs"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and whose "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "path"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is not specified, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "dir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key controls the value of that destination’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "path"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "output:\n  dir: ./public\n  destinations:\n  - provider: fs"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This allows the path for this destination to be controlled from the CLI using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--to-dir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If destinations is empty, or if all fs destinations specify a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "path"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key, then the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "dir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is effectively ignored."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "output:\n  dir: ./ignored\n  destinations:\n  - provider: fs\n    path: ./build/site-copy"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The way to think of it is that the output dir fills in the missing "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "path"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key for the first occurrence of an fs destination that does not specify a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "path"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want to output to both "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "./build/site"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "./build/site-copy"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": ", you need a slot for the output dir."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "output:\n  dir: ./build/site\n  destinations:\n  - provider: fs\n  - provider: fs\n    path: ./build/site-copy"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          }
        ],
        "context": "section",
        "id": "relationship-to-output-dir",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Relationship to output dir"
