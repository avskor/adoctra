        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The default Asciidoctor stylesheet wraps long lines in verbatim blocks by applying the CSS "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "white-space: pre-wrap"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "word-wrap: break-word"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The lines are wrapped at word boundaries, similar to how most text editors wrap lines. This prevents horizontal scrolling which some users considered a greater readability problem than line wrapping."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "However, this behavior is configurable because there are times when you don’t want the lines in listing and literal blocks to wrap."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "There are two ways to prevent lines from wrapping so that horizontal scrolling is used instead:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "nowrap"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " block option"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "unset the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "prewrap"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " document attribute (on by default)"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "nowrap"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option on literal or listing blocks to prevent lines from being wrapped in the HTML."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[%nowrap,java]\n----\npublic class ApplicationConfigurationProvider extends HttpConfigurationProvider\n{\n   @Override\n   public Configuration getConfiguration(ServletContext context)\n   {\n      return ConfigurationBuilder.begin()\n               .addRule()\n               .when(Direction.isInbound().and(Path.matches(\"/{path}\")))\n               .perform(Log.message(Level.INFO, \"Client requested path: {path}\"))\n               .where(\"path\").matches(\".*\");\n   }\n}\n----"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Listing block with nowrap option syntax"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the nowrap option is used, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "nowrap"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " class is added to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<pre>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " element. This class changes the CSS to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "white-space: pre"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "word-wrap: normal"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "public class ApplicationConfigurationProvider extends HttpConfigurationProvider\n{\n   @Override\n   public Configuration getConfiguration(ServletContext context)\n   {\n      return ConfigurationBuilder.begin()\n               .addRule()\n               .when(Direction.isInbound().and(Path.matches(\"/{path}\")))\n               .perform(Log.message(Level.INFO, \"Client requested path: {path}\"))\n               .where(\"path\").matches(\".*\");\n   }\n}"
              }
            ],
            "language": "java",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Result: Listing block with nowrap option applied"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To prevent lines from wrapping globally, unset the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "prewrap"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute on the document."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ":prewrap!:"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Disable prewrap globally (thus, enabling nowrap)"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the prewrap attribute is unset, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "nowrap"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " class is added to any "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<pre>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " elements."
              }
