                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@PostMapping(\"/\")\npublic String handle(@Valid @RequestPart(\"meta-data\") MetaData metadata, Errors errors) {\n\t// ...\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@PostMapping(\"/\")\nfun handle(@Valid @RequestPart(\"meta-data\") metadata: MetaData, errors: Errors): String {\n\t// ...\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If method validation applies because other parameters have "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Constraint"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotations, then "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "HandlerMethodValidationException"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is raised instead. For more details, see the section on "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Validation"
              }
            ],
            "kind": "xref",
            "target": "web/webmvc/mvc-controller/ann-validation.html"
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
