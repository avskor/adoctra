            ],
            "context": "open",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The preceding example sends a 304 (NOT_MODIFIED) response with an empty body if the comparison to the conditional request headers indicates the content has not changed. Otherwise, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ETag"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Cache-Control"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " headers are added to the response."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can also make the check against conditional request headers in the controller, as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "blocks": [
                  {
                    "context": "dlist",
                    "id": null,
                    "items": [
                      {
                        "description": {
                          "blocks": [
                            {
                              "context": "listing",
                              "id": null,
                              "inlines": [
                                {
                                  "kind": "text",
                                  "value": "@RequestMapping\npublic String myHandleMethod(ServerWebExchange exchange, Model model) {\n\n\tlong eTag = ... "
                                },
                                {
                                  "guard": "// ",
                                  "icons": null,
                                  "id": "CO1-1",
                                  "kind": "callout",
                                  "number": "1",
                                  "src": "",
                                  "xml": false
                                },
                                {
                                  "kind": "text",
                                  "value": "\n\n\tif (exchange.checkNotModified(eTag)) {\n\t\treturn null; "
                                },
                                {
                                  "guard": "// ",
                                  "icons": null,
                                  "id": "CO1-2",
                                  "kind": "callout",
                                  "number": "2",
                                  "src": "",
                                  "xml": false
                                },
                                {
                                  "kind": "text",
                                  "value": "\n\t}\n\n\tmodel.addAttribute(...); "
                                },
                                {
                                  "guard": "// ",
                                  "icons": null,
                                  "id": "CO1-3",
                                  "kind": "callout",
                                  "number": "3",
                                  "src": "",
                                  "xml": false
