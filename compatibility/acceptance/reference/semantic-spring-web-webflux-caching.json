          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "See equivalent in the Servlet stack"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc/mvc-caching.html#mvc-caching-etag-lastmodified"
                  }
                ],
                "kind": "span",
                "roles": [
                  "small"
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Controllers can add explicit support for HTTP caching. We recommend doing so, since the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "lastModified"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ETag"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " value for a resource needs to be calculated before it can be compared against conditional request headers. A controller can add an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ETag"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Cache-Control"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " settings to a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ResponseEntity"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "blocks": [
                  {
                    "context": "dlist",
                    "id": null,
                    "items": [
                      {
                        "description": {
                          "blocks": [
                            {
                              "context": "listing",
                              "id": null,
                              "inlines": [
                                {
                                  "kind": "text",
                                  "value": "@GetMapping(\"/book/{id}\")\npublic ResponseEntity<Book> showBook(@PathVariable Long id) {\n\n\tBook book = findBook(id);\n\tString version = book.getVersion();\n\n\treturn ResponseEntity\n\t\t\t.ok()\n\t\t\t.cacheControl(CacheControl.maxAge(30, TimeUnit.DAYS))\n\t\t\t.eTag(version) // lastModified is also available\n\t\t\t.body(book);\n}"
                                }
                              ],
                              "language": "java",
                              "roles": [],
                              "title": null
                            }
                          ],
                          "checkbox": null,
                          "inlines": []
                        },
                        "terms": [
                          [
                            {
                              "kind": "text",
                              "value": "Java"
                            }
                          ]
                        ]
                      },
                      {
                        "description": {
                          "blocks": [
                            {
                              "context": "listing",
                              "id": null,
                              "inlines": [
                                {
                                  "kind": "text",
                                  "value": "@GetMapping(\"/book/{id}\")\nfun showBook(@PathVariable id: Long): ResponseEntity<Book> {\n\n\tval book = findBook(id)\n\tval version = book.getVersion()\n\n\treturn ResponseEntity\n\t\t\t.ok()\n\t\t\t.cacheControl(CacheControl.maxAge(30, TimeUnit.DAYS))\n\t\t\t.eTag(version) // lastModified is also available\n\t\t\t.body(book)\n}"
                                }
                              ],
                              "language": "kotlin",
                              "roles": [],
                              "title": null
                            }
                          ],
                          "checkbox": null,
                          "inlines": []
                        },
                        "terms": [
                          [
                            {
                              "kind": "text",
                              "value": "Kotlin"
                            }
                          ]
                        ]
                      }
                    ],
                    "roles": [],
                    "title": null
                  }
                ],
                "context": "example",
                "id": null,
                "roles": [],
                "title": null
