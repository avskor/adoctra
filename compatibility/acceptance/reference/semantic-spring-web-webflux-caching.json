              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "See equivalent in the Servlet stack"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webmvc/mvc-caching.html#mvc-caching-cachecontrol"
                  }
                ],
                "kind": "span",
                "roles": [
                  "small"
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
