            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "HTTP caching can significantly improve the performance of a web application. HTTP caching revolves around the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Cache-Control"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " response header and subsequent conditional request headers, such as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Last-Modified"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ETag"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Cache-Control"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " advises private (for example, browser) and public (for example, proxy) caches how to cache and re-use responses. An "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ETag"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " header is used to make a conditional request that may result in a 304 (NOT_MODIFIED) without a body, if the content has not changed. "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ETag"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " can be seen as a more sophisticated successor to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Last-Modified"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " header."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This section describes the HTTP caching related options available in Spring WebFlux."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
