          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "There are three variants for checking conditional requests against "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "eTag"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " values, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "lastModified"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " values, or both. For conditional "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "GET"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "HEAD"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
