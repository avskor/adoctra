                "kind": "text",
                "value": "HandlerMapping"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " implementations support handler interception which is useful when you want to apply functionality across requests. A "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "HandlerInterceptor"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " can implement the following:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "ulist",
        "id": null,
        "items": [
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "preHandle(..)"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " — callback before the actual handler is run that returns a boolean. If the method returns "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "true"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", execution continues; if it returns "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "false"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", the rest of the execution chain is bypassed and the handler is not called."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "postHandle(..)"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " — callback after the handler is run."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "afterCompletion(..)"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " — callback after the complete request has finished."
              }
            ]
          }
        ],
        "roles": [],
        "style": null,
        "title": null
      },
