{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The Spring Framework also takes advantage of "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Kotlin null-safety"
              }
            ],
            "kind": "link",
            "target": "https://kotlinlang.org/docs/null-safety.html"
          },
          {
            "kind": "text",
            "value": " to determine if an HTTP parameter is required without having to explicitly define the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "required"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " attribute. That means "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestParam name: String?"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is treated as not required and, conversely, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestParam name: String"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is treated as being required. This feature is also supported on the Spring Messaging "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Header"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "In a similar fashion, Spring bean injection with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Autowired"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Bean"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Inject"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " uses this information to determine if a bean is required or not."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "For example, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Autowired lateinit var thing: Thing"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " implies that a bean of type "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Thing"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " must be registered in the application context, while "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Autowired lateinit var thing: Thing?"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " does not raise an error if such a bean does not exist."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Following the same principle, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Bean fun play(toy: Toy, car: Car?) = Baz(toy, Car)"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " implies that a bean of type "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Toy"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " must be registered in the application context, while a bean of type "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Car"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " may or may not exist. The same behavior applies to autowired constructor parameters."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If you use bean validation on classes with properties or a primary constructor parameters, you may need to use "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "annotation use-site targets"
              }
            ],
            "kind": "link",
            "target": "https://kotlinlang.org/docs/annotations.html#annotation-use-site-targets"
          },
          {
            "kind": "text",
            "value": ", such as "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@field:NotNull"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@get:Size(min=5, max=15)"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", as described in "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "this Stack Overflow response"
              }
            ],
            "kind": "link",
            "target": "https://stackoverflow.com/a/35853200/1092077"
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null,
        "type": "note"
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Annotations"
      }
    ]
  }
}
