            "kind": "text",
            "value": "sample-with-uri-include.adoc"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "class UriIncludeProcessor < Asciidoctor::Extensions::IncludeProcessor\n  def handles? target\n    target.start_with? 'https://', 'https://'\n  end\n\n  def process doc, reader, target, attributes\n    content = (::OpenURI.open_uri target).readlines\n    reader.push_include content, target, target, 1, attributes\n    reader\n  end\nend"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_uriincludeprocessor",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "UriIncludeProcessor"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor::Extensions.register do\n  include_processor UriIncludeProcessor\nend\n\nAsciidoctor.convert_file 'sample-with-uri-include.adoc', safe: :safe"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": null
