    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To save you from having to type the same value in your theme over and over, or to allow you to base one value on another, the theme language supports variables."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Variables consist of the key name preceded by a dollar sign ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "$"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "$base-font-size"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). Any qualified key that has already been defined can be referenced in the value of another key. In order words, as soon as the key is assigned, it’s available to be used as a variable."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Variables are defined from top to bottom (i.e., in document order). Therefore, a variable must be defined before it is referenced. In other words, the path the variable refers to must be "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "above"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " the usage of that variable."
              }
            ],
            "roles": [],
            "title": null,
            "type": "important"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For example, once the following line is processed,"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "base:\n  font-color: #333333"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "the variable "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "$base-font-color"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " will be available for use in subsequent lines and will resolve to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "#333333"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Let’s say you want to make the font color of the sidebar title the same as the heading font color. Just assign the value "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "$heading-font-color"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "$sidebar-title-font-color"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "heading:\n  font-color: #191919\nsidebar:\n  title:\n    font-color: $heading-font-color"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "define",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Define a variable"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can also use variables in math expressions to use one value to build another. This is commonly done to set font sizes proportionally. It also makes it easy to test different values very quickly."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "base:\n  font-size: 12\n  font-size-large: $base-font-size * 1.25\n  font-size-small: $base-font-size * 0.85"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "We’ll cover more about math expressions later."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "use-a-variable-in-a-math-expression",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Use a variable in a math expression"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can define arbitrary key names to make custom variables. This is one way to group reusable values at the top of your theme file. If you are going to do this, it’s recommended that you organize the keys under a custom namespace, such as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "brand"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For instance, here’s how you can define your brand colors:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "brand:\n  primary-color: #E0162B "
              },
              {
                "guard": "# ",
                "icons": null,
                "id": "CO1-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\n  secondary-color: '#FFFFFF' "
              },
              {
                "guard": "# ",
                "icons": null,
                "id": "CO1-2",
                "kind": "callout",
                "number": "2",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\n  alert-color: '0052A5' "
              },
              {
                "guard": "# ",
                "icons": null,
                "id": "CO1-3",
                "kind": "callout",
                "number": "3",
                "src": "",
                "xml": false
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          },
          {
            "context": "colist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-1"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "To align with CSS, you may add "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "#"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " in front of the hex color value to coerce it to a string. A YAML preprocessor is used to ensure the value is not treated as a comment as would normally be the case in YAML."
                  }
                ],
                "src": ""
              },
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-2"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "You may put single quotes around the CSS-style hex value to make it friendly to a YAML editor or validation tool."
                  }
                ],
                "src": ""
              },
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-3"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The leading "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "#"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " on a hex value is entirely optional. However, we recommend that you always use either a leading "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "#"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " or surrounding quotes (or both) to prevent YAML from mangling the value (for example, 000000 would become 0, so use '000000' or #000000 instead)."
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can now use these custom variables later in the theme file:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "base:\n  font-color: $brand-primary-color"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "custom",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Custom variables"
          }
        ]
      }
    ],
    "outline": null,
