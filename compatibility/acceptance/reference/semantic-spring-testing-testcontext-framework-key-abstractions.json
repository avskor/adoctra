    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The core of the framework consists of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TestContextManager"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " class and the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TestContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TestExecutionListener"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "SmartContextLoader"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " interfaces. A "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TestContextManager"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is created for each test class (for example, for the execution of all test methods within a single test class in JUnit Jupiter). The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TestContextManager"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", in turn, manages a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TestContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " that holds the context of the current test. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TestContextManager"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " also updates the state of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TestContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " as the test progresses and delegates to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TestExecutionListener"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " implementations, which instrument the actual test execution by providing dependency injection, managing transactions, and so on. A "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "SmartContextLoader"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is responsible for loading an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " for a given test class. See the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "javadoc"
                  }
                ],
                "kind": "link",
                "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/test/context/package-summary.html"
              },
              {
                "kind": "text",
                "value": " and the Spring test suite for further information and examples of various implementations."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TestContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " encapsulates the context in which a test is run (agnostic of the actual testing framework in use) and provides context management and caching support for the test instance for which it is responsible. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TestContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " also delegates to a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "SmartContextLoader"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to load an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " if requested."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "testcontext",
        "level": 1,
        "roles": [],
        "title": [
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
