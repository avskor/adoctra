{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Images are resolved at the time the converter runs. That means they need to be located where the converter can find them and be in a format it can read."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Relative image paths in a document are resolved relative to the value of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "imagesdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute. This is effectively the same as how the built-in HTML converter works when the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "data-uri"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute is set. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "imagesdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is blank by default, which means relative images paths are resolved relative to the input document. Relative images paths in the theme are resolved relative to the value of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf-themesdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute (which defaults to the directory of the theme file). The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "imagesdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute is not used when resolving an image path in the theme file. Absolute image paths are used as is."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the image is an SVG, and the SVG includes a nested raster image (PNG or JPG) with a relative path, that path is resolved relative to the directory that contains the SVG."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The converter will refuse to embed an image if the target is a URI (including image references in an SVG) unless the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "allow-uri-read"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute is enabled via the CLI or API."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you use a linked image in an SVG, the width and height of that image must be specified. Otherwise, the SVG library will fail to process it."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "imagesdir",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "imagesdir attribute"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor PDF provides seamless integration with Asciidoctor Diagram."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This integration works because Asciidoctor PDF sets the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "data-uri"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " document attribute internally. When Asciidoctor Diagram detects that this attribute is set, it passes through the absolute path of the generated image, allowing Asciidoctor PDF to locate it. Although the generated image is written to a file as an interim step, Asciidoctor PDF still embeds that image into the generated document. Thus, this behavior is consistent with the definition of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "data-uri"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When using Asciidoctor Diagram with Asciidoctor PDF, the input directory ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "docdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") and the output directory ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "outdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and, in turn, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "imagesoutdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") can differ and Asciidoctor PDF will still be able to find and embed the generated images."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor Diagram builds the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "imagesoutdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " from the intrinsic "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "outdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute. This works if Asciidoctor PDF is writing the output to a file. If the output is not being written to a file, you can set the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "outdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "imagesoutdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attributes explicitly."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can change the display size of the image in the PDF using the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdfwidth"
                  }
                ],
                "kind": "xref",
                "target": "image-scaling.html#pdfwidth"
              },
              {
                "kind": "text",
                "value": " attribute on the diagram block or macro."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "asciidoctor-diagram-integration",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Asciidoctor Diagram integration"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following image types (and corresponding file extensions) are supported:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "PNG (.png)"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "JPEG (.jpg)"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "SVG (.svg)"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The GIF (.gif), WebP (.webp), TIFF (.tiff), BMP (.bmp), and interlaced PNG formats are not supported unless you install prawn-gmagick. See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Support for additional image file formats"
                  }
                ],
                "kind": "xref",
                "target": "#other-image-formats"
              },
              {
                "kind": "text",
                "value": " for details."
              }
            ],
            "roles": [],
            "title": null,
            "type": "caution"
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The SVG must declare the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "viewBox"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute on the root "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<svg>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " element. Without that information, the converter does not know how to properly interpret the SVG data and portions of the image may get cut off. Make sure that the SVG does not define width and height attributes on the root "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<svg>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " element. (A width of 100% is particularly problematic as it can add empty space above and below the visible image). The width should be controlled using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdfwidth"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute on the image macro instead."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In order to embed an image into a PDF, Asciidoctor PDF must understand how to decode it. To perform this work, Asciidoctor delegates to the underlying libraries. "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Prawn"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://prawnpdf.org"
              },
              {
                "kind": "text",
                "value": " provides support for decoding JPG and PNG images. "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "prawn-svg"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://github.com/mogest/prawn-svg"
              },
              {
                "kind": "text",
                "value": " brings support for translating SVG images to PDF commands. Without any additional libraries, those are the only image file formats supported by Asciidoctor PDF."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If you need support for additional image formats, such as GIF, TIFF, WebP, or "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "interlaced"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " PNG—​and you don’t want to convert those images to a supported format like JPG—​you must install the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "prawn-gmagick"
                      }
                    ],
                    "kind": "link",
                    "metadata": {
                      "rel": "noopener",
                      "window": "_blank"
                    },
                    "target": "https://github.com/packetmonkey/prawn-gmagick"
                  },
                  {
                    "kind": "text",
                    "value": " Ruby gem. prawn-gmagick is an extension for Prawn (Linux and macOS only) that delegates image decoding to "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "GraphicsMagick"
                      }
                    ],
                    "kind": "link",
                    "metadata": {
                      "rel": "noopener",
                      "window": "_blank"
                    },
                    "target": "https://www.graphicsmagick.org"
                  },
                  {
                    "kind": "text",
                    "value": " to add support for all image formats recognized by that library."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "prawn-gmagick has the additional benefit of "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "significantly"
                      }
                    ],
                    "kind": "strong",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " reducing the processing time, power, and memory necessary to generate a PDF that contains a lot of PNG images. For large books (such as Pro Git), you might see the conversion time drop by as much as half. Uncompressing PNG image data (specifically zlib inflating) requires a lot of mathematical computation, a task Ruby is not particularly efficient at performing. That’s why adding the prawn-gmagick gem to the converter makes such a substantial difference."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "As an alternative to using prawn-gmagick, you could optimize the images you pass into Asciidoctor PDF, either by scaling them down or converting them to an uncompressed format like JPG."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The prawn-gmagick gem uses native extensions to compile against GraphicsMagick. This system prerequisite limits installation to C Ruby running on Linux and macOS. Please refer to the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "README for prawn-gmagick"
                      }
                    ],
                    "kind": "link",
                    "metadata": {
                      "rel": "noopener",
                      "window": "_blank"
                    },
                    "target": "https://github.com/packetmonkey/prawn-gmagick"
                  },
                  {
                    "kind": "text",
                    "value": " to learn how to install it."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "literal",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "$ gem install prawn-gmagick"
                  }
                ],
                "language": null,
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "When this gem is installed, Asciidoctor automatically detects and loads it, then delegates all image decoding to GraphicsMagick by way of the bridge it provides. We highly recommend using this gem with Asciidoctor PDF if you’re able to install it."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "blocks": [
                  {
                    "context": "paragraph",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "In rare cases, GraphicsMagick (the backend library for prawn-gmagick) can misread the bit depth of certain PNG images. If this happens, you can instruct Asciidoctor PDF to not delegate to GraphicsMagick."
                      }
                    ],
                    "roles": [],
                    "title": null
                  },
                  {
                    "context": "paragraph",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "You can configure Asciidoctor PDF to not delegate to GraphicsMagick when loading PNG images by requiring "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "asciidoctor/pdf/nopngmagick"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " when calling Asciidoctor PDF, as follows:"
                      }
                    ],
                    "roles": [],
                    "title": null
                  },
                  {
                    "context": "literal",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "$ asciidoctor-pdf -r asciidoctor/pdf/nopngmagick doc.adoc"
                      }
                    ],
                    "language": null,
                    "roles": [],
                    "title": null
                  },
                  {
                    "context": "paragraph",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Alternately, you can tell Asciidoctor PDF not to delegate to GraphicsMagick at all by requiring "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "asciidoctor/pdf/nogmagick"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " when calling Asciidoctor PDF, as follows:"
                      }
                    ],
                    "roles": [],
                    "title": null
                  },
                  {
                    "context": "literal",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "$ asciidoctor-pdf -r asciidoctor/pdf/nogmagick doc.adoc"
                      }
                    ],
                    "language": null,
                    "roles": [],
                    "title": null
                  },
                  {
                    "context": "paragraph",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Bypassing prawn-gmagick means you no longer get support for additional image formats that Prawn cannot handle and/or the PNG acceleration it provides."
                      }
                    ],
                    "roles": [],
                    "title": null
                  }
                ],
                "context": "section",
                "id": "unregister-prawn-gmagick",
                "level": 3,
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Unregister prawn-gmagick"
                  }
                ]
              }
            ],
            "context": "section",
            "id": "other-image-formats",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Support for additional image file formats"
              }
            ]
          }
        ],
        "context": "section",
        "id": "image-formats",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Image formats"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor PDF uses "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "prawn-svg"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://github.com/mogest/prawn-svg"
              },
              {
                "kind": "text",
                "value": " to embed SVGs in the PDF document, including SVGs generated by Asciidoctor Diagram."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Actually, it’s not accurate to say that prawn-svg embeds the SVG. Rather, prawn-svg is an SVG "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "renderer"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". prawn-svg translates an SVG into native PDF text and graphic objects. You can think of the SVG as a sequence of drawing commands. The result becomes indistinguishable from other PDF objects."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "What that means for text is that any font family used for text in the SVG "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "must"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " be registered in the Asciidoctor PDF theme file (and thus with Prawn). Otherwise, Prawn will fall back to using the closest matching built-in (afm) font from PDF (e.g., sans-serif becomes Helvetica). Recall that afm fonts only support basic Latin. As we like to say, PDF is "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "bring your own font"
                  }
                ],
                "kind": "xref",
                "target": "theme:font-support.html#built-in"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you’re using Asciidoctor Diagram to generate SVGs to embed in the PDF, you likely need to specify the default font the diagramming tool uses. Let’s assume you are making a plantuml diagram."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To set the font used in the diagram, first create a file named "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "plantuml.cfg"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " and populate it with the following content:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "skinparam defaultFontName Noto Serif"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can choose any font name that is registered in your Asciidoctor PDF theme file. When using the default theme, your options are \"Noto Serif\", \"M+ 1mn\", and \"M+ 1p Fallback\"."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Next, pass that path to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "plantumlconfig"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute in your AsciiDoc document (or set the attribute via the CLI or API):"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ":plantumlconfig: plantuml.cfg"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Clear the cache of your diagrams and run Asciidoctor PDF with Asciidoctor Diagram enabled. The diagrams will be generated using Noto Serif as the default font, and Asciidoctor PDF will know what to do."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An alternative approach is to remap the font family that the diagram tool selects. For example, in your theme file, you might override the definition of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sans-serif"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " font."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "extends: default\nfont:\n  catalog:\n    merge: true\n    sans-serif: GEM_FONTS_DIR/mplus1p-regular-fallback.ttf"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The bottom line is this: If you’re using fonts in your SVG, and you want those fonts to be preserved, those fonts must be defined in the Asciidoctor PDF theme file."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "svg",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Fonts in SVG images"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In order to generate a PDF, the converter must read all image files in order to embed the image data in the PDF. This is a requirement of the PDF format. The task that the PDF converter must perform is roughly equivalent to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "data-uri"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " mode of the HTML converter."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By default, Asciidoctor will not read images from a URI. Therefore, if the target of one or more images in the document is a URI, you must also set the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "allow-uri-read"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute when calling Asciidoctor PDF from the CLI or API. For example:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor-pdf -a allow-uri-read document.adoc"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When this attribute is not set, you may enounter the following warning:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "asciidoctor: WARNING: cannot embed remote image: https://example.org/image.png (allow-uri-read attribute not enabled)"
              }
            ],
            "language": null,
            "roles": [
              "output"
            ],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Since "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "allow-uri-read"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is a secure attribute, setting it in the document has no impact."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "remote-images",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Remote images"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Image Paths and Formats"
      }
    ]
  }
}
