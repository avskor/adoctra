          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Antora uses the value assigned to the optional "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "navtitle attribute"
                  }
                ],
                "kind": "xref",
                "target": "page:reftext-and-navtitle.html#navtitle"
              },
              {
                "kind": "text",
                "value": " in the target page when the link text is unspecified. When "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "navtitle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " isn’t set in the target page’s header, Antora automatically assigns it the value of the page’s reference text, which may either be the target page’s "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "default reference text"
                  }
                ],
                "kind": "xref",
                "target": "page:link-content.html#default"
              },
              {
                "kind": "text",
                "value": " or text assigned to the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "reftext attribute"
                  }
                ],
                "kind": "xref",
                "target": "page:reftext-and-navtitle.html#navtitle"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Antora doesn’t populate the link text of an xref when a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fragment is appended to the resource ID of a page"
                  }
                ],
                "kind": "xref",
                "target": "page:xref.html#id-fragment"
              },
              {
                "kind": "text",
                "value": ". In such cases, you still need to explicitly specify the link text."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          }
