      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The JUnit Platform provides opt-in support for generating Flight Recorder events. "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "JEP 328"
                  }
                ],
                "kind": "link",
                "target": "https://openjdk.java.net/jeps/328"
              },
              {
                "kind": "text",
                "value": " describes the Java Flight Recorder (JFR) as follows."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "attribution": null,
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Flight Recorder records events originating from applications, the JVM, and the OS. Events are stored in a single file that can be attached to bug reports and examined by support engineers, allowing after-the-fact analysis of issues in the period leading up to a problem."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "citetitle": null,
            "context": "quote",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In order to record Flight Recorder events generated while running tests, you need to start flight recording when launching a test suite via the following java command line option."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "-XX:StartFlightRecording:filename=..."
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Please consult the manual of your build tool for the appropriate commands."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To analyze the recorded events, use the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "jfr"
                  }
                ],
                "kind": "link",
                "target": "https://docs.oracle.com/en/java/javase/17/docs/specs/man/jfr.html"
              },
              {
                "kind": "text",
                "value": " command line tool shipped with recent JDKs or open the recording file with "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "JDK Mission Control"
                  }
                ],
                "kind": "link",
                "target": "https://jdk.java.net/jmc/"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
