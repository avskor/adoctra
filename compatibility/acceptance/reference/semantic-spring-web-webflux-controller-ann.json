          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RestController"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "composed annotation"
                  }
                ],
                "kind": "xref",
                "target": "core/beans/classpath-scanning.html#beans-meta-annotations"
              },
              {
                "kind": "text",
                "value": " that is itself meta-annotated with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Controller"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@ResponseBody"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", indicating a controller whose every method inherits the type-level "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@ResponseBody"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotation and, therefore, writes directly to the response body versus view resolution and rendering with an HTML template."
              }
            ],
