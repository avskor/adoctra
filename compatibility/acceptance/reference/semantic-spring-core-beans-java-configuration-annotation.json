{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Configuration"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is a class-level annotation indicating that an object is a source of bean definitions. "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Configuration"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " classes declare beans through "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Bean"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "-annotated methods. Calls to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Bean"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " methods on "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Configuration"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " classes can also be used to define inter-bean dependencies. See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Basic Concepts: "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@Bean"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " and "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@Configuration"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ],
                "kind": "xref",
                "target": "core/beans/java/basic-concepts.html"
              },
              {
                "kind": "text",
                "value": " for a general introduction."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When beans have dependencies on one another, expressing that dependency is as simple as having one bean method call another, as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Configuration\npublic class AppConfig {\n\n\t@Bean\n\tpublic BeanOne beanOne() {\n\t\treturn new BeanOne(beanTwo());\n\t}\n\n\t@Bean\n\tpublic BeanTwo beanTwo() {\n\t\treturn new BeanTwo();\n\t}\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Configuration\nclass AppConfig {\n\n\t@Bean\n\tfun beanOne() = BeanOne(beanTwo())\n\n\t@Bean\n\tfun beanTwo() = BeanTwo()\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In the preceding example, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "beanOne"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " receives a reference to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "beanTwo"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " through constructor injection."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This method of declaring inter-bean dependencies works only when the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Bean"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method is declared within a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Configuration"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " class. You cannot declare inter-bean dependencies by using plain "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Component"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " classes."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          }
        ],
        "context": "section",
        "id": "beans-java-injecting-dependencies",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Injecting Inter-bean Dependencies"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "As noted earlier, "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "lookup method injection"
                  }
                ],
                "kind": "xref",
                "target": "core/beans/dependencies/factory-method-injection.html"
              },
              {
                "kind": "text",
                "value": " is an advanced feature that you should use rarely. It is useful in cases where a singleton-scoped bean has a dependency on a prototype-scoped bean. Using Java for this type of configuration provides a natural means for implementing this pattern. The following example shows how to use lookup method injection:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "public abstract class CommandManager {\n\tpublic Object process(Object commandState) {\n\t\t// grab a new instance of the appropriate Command interface\n\t\tCommand command = createCommand();\n\t\t// set the state on the (hopefully brand new) Command instance\n\t\tcommand.setState(commandState);\n\t\treturn command.execute();\n\t}\n\n\t// okay... but where is the implementation of this method?\n\tprotected abstract Command createCommand();\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "abstract class CommandManager {\n\tfun process(commandState: Any): Any {\n\t\t// grab a new instance of the appropriate Command interface\n\t\tval command = createCommand()\n\t\t// set the state on the (hopefully brand new) Command instance\n\t\tcommand.setState(commandState)\n\t\treturn command.execute()\n\t}\n\n\t// okay... but where is the implementation of this method?\n\tprotected abstract fun createCommand(): Command\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By using Java configuration, you can create a subclass of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CommandManager"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " where the abstract "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "createCommand()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method is overridden in such a way that it looks up a new (prototype) command object. The following example shows how to do so:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Bean\n@Scope(\"prototype\")\npublic AsyncCommand asyncCommand() {\n\tAsyncCommand command = new AsyncCommand();\n\t// inject dependencies here as required\n\treturn command;\n}\n\n@Bean\npublic CommandManager commandManager() {\n\t// return new anonymous implementation of CommandManager with createCommand()\n\t// overridden to return a new prototype Command object\n\treturn new CommandManager() {\n\t\tprotected Command createCommand() {\n\t\t\treturn asyncCommand();\n\t\t}\n\t}\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Bean\n@Scope(\"prototype\")\nfun asyncCommand(): AsyncCommand {\n\tval command = AsyncCommand()\n\t// inject dependencies here as required\n\treturn command\n}\n\n@Bean\nfun commandManager(): CommandManager {\n\t// return new anonymous implementation of CommandManager with createCommand()\n\t// overridden to return a new prototype Command object\n\treturn object : CommandManager() {\n\t\toverride fun createCommand(): Command {\n\t\t\treturn asyncCommand()\n\t\t}\n\t}\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "beans-java-method-injection",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Lookup Method Injection"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Consider the following example, which shows a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Bean"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotated method being called twice:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Configuration\npublic class AppConfig {\n\n\t@Bean\n\tpublic ClientService clientService1() {\n\t\tClientServiceImpl clientService = new ClientServiceImpl();\n\t\tclientService.setClientDao(clientDao());\n\t\treturn clientService;\n\t}\n\n\t@Bean\n\tpublic ClientService clientService2() {\n\t\tClientServiceImpl clientService = new ClientServiceImpl();\n\t\tclientService.setClientDao(clientDao());\n\t\treturn clientService;\n\t}\n\n\t@Bean\n\tpublic ClientDao clientDao() {\n\t\treturn new ClientDaoImpl();\n\t}\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Configuration\nclass AppConfig {\n\n\t@Bean\n\tfun clientService1(): ClientService {\n\t\treturn ClientServiceImpl().apply {\n\t\t\tclientDao = clientDao()\n\t\t}\n\t}\n\n\t@Bean\n\tfun clientService2(): ClientService {\n\t\treturn ClientServiceImpl().apply {\n\t\t\tclientDao = clientDao()\n\t\t}\n\t}\n\n\t@Bean\n\tfun clientDao(): ClientDao {\n\t\treturn ClientDaoImpl()\n\t}\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "clientDao()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " has been called once in "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "clientService1()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and once in "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "clientService2()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Since this method creates a new instance of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ClientDaoImpl"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and returns it, you would normally expect to have two instances (one for each service). That definitely would be problematic: In Spring, instantiated beans have a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "singleton"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " scope by default. This is where the magic comes in: All "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Configuration"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " classes are subclassed at startup-time with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CGLIB"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". In the subclass, the child method checks the container first for any cached (scoped) beans before it calls the parent method and creates a new instance."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The behavior could be different according to the scope of your bean. We are talking about singletons here."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "It is not necessary to add CGLIB to your classpath because CGLIB classes are repackaged under the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "org.springframework.cglib"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " package and included directly within the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "spring-core"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " JAR."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "admonition",
            "id": null,
            "roles": [],
            "title": null,
            "type": "note"
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "There are a few restrictions due to the fact that CGLIB dynamically adds features at startup-time. In particular, configuration classes must not be final. However, any constructors are allowed on configuration classes, including the use of "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@Autowired"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " or a single non-default constructor declaration for default injection."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If you prefer to avoid any CGLIB-imposed limitations, consider declaring your "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@Bean"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " methods on non-"
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@Configuration"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " classes (for example, on plain "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@Component"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " classes instead) or by annotating your configuration class with "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@Configuration(proxyBeanMethods = false)"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ". Cross-method calls between "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@Bean"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " methods are then not intercepted, so you have to exclusively rely on dependency injection at the constructor or method level there."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "admonition",
            "id": null,
            "roles": [],
            "title": null,
            "type": "tip"
          }
        ],
        "context": "section",
        "id": "beans-java-further-information-java-config",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Further Information About How Java-based Configuration Works Internally"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Using the "
      },
      {
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "@Configuration"
          }
        ],
        "kind": "monospace",
        "roles": []
      },
      {
        "kind": "text",
        "value": " annotation"
      }
    ]
  }
}
