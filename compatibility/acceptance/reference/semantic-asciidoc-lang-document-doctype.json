    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The document type (aka doctype) declares the expected structure of an AsciiDoc document. AsciiDoc defines a fixed set of document types. Each document type provides a slight variation on the permitted structure of an AsciiDoc document to accommodate different uses cases."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The default doctype is "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "article"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", which provides the foundation structure on which other doctypes build. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "book"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " doctype permits multiple level-0 sections that act as part sections. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "manpage"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " doctype provides an extended header for defining standard metadata of a manpage, such as the volume number, man, and purpose. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "inline"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " doctype is intended for embedded scenarios."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "The default doctype. In DocBook, this includes the appendix, abstract, bibliography, glossary, and index sections. Unless you are making a book or a man page, you don’t need to worry about the doctype. The default will suffice."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Article ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "article"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ")"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Builds on the article doctype with the additional ability to use a top-level title as part titles, includes the appendix, dedication, preface, bibliography, glossary, index, and colophon. There’s also the concept of a multi-part book, but the distinction from a regular book is determined by the content. A book only has chapters and special sections, whereas a multi-part book is divided by parts that each contain one or more chapters or special sections."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Book ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "book"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ")"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Used for producing a roff or HTML-formatted manual page (man page) for Unix and Unix-like operating systems. This doctype instructs the parser to recognize a special document header and section naming conventions for organizing the AsciiDoc content as a man page. See "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "asciidoctor:manpage-backend:index.html"
                        }
                      ],
                      "kind": "xref",
                      "target": "asciidoctor:manpage-backend:index.html"
                    },
                    {
                      "kind": "text",
                      "value": " for details on how structure a man page using AsciiDoc and generate it using Asciidoctor."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Man page ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "manpage"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ")"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "There may be cases when you only want to apply inline AsciiDoc formatting to input text without wrapping it in a block element. For example, in the Asciidoclet project (AsciiDoc in Javadoc), only the inline formatting is needed for the text in Javadoc tags."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Inline ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "inline"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ")"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
