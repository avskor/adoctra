            "inlines": [
              {
                "kind": "text",
                "value": "You can use a comment line or comment block when you want to add text to an AsciiDoc source file, but don’t want that text to be displayed when the file is converted to an HTML page. Comments inside blocks that have the verbatim (e.g., listing) or raw (e.g., pass) content model are not interpreted."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A comment line is denoted by two consecutive forward slashes ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "//"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
