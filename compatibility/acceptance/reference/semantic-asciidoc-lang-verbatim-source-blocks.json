        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A source block is a specialization of a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "listing block"
                  }
                ],
                "kind": "xref",
                "target": "listing-blocks.html"
              },
              {
                "kind": "text",
                "value": ". Developers are accustomed to seeing source code colorized to emphasize the code’s structure (i.e., keywords, types, delimiters, etc.). This technique is known as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "syntax highlighting"
                  }
                ],
                "kind": "strong",
                "roles": [
                  "term"
                ]
              },
              {
                "kind": "text",
                "value": ". Since this technique is so prevalent, AsciiDoc processors will integrate at least one library to syntax highlight the source code blocks in your document. For example, Asciidoctor provides integration with Rouge, CodeRay, Pygments, and highlight.js, as well as an adapter API to add support for additional libraries."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 1"
                  }
                ],
                "kind": "xref",
                "target": "#ex-source"
              },
              {
                "kind": "text",
                "value": " shows a listing block with the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "source"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " style and language "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ruby"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " applied to its content, hence a source block."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-source",
            "inlines": [
              {
                "kind": "text",
                "value": "[source,ruby]\n----\nrequire 'sinatra'\n\nget '/hi' do\n  \"Hello World!\"\nend\n----"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Source block syntax"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The result of "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 1"
                  }
                ],
                "kind": "xref",
                "target": "#ex-source"
              },
              {
                "kind": "text",
                "value": " is rendered below."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "require 'sinatra'\n\nget '/hi' do\n  \"Hello World!\"\nend"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Since a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "source"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " block is most often used to designate a block with source code of a particular language, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "source"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " style itself is optional. The mere presence of the language on a listing block automatically promotes it to a source block."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 2"
                  }
                ],
                "kind": "xref",
                "target": "#ex-implied-source"
              },
              {
                "kind": "text",
                "value": " shows a listing block implied to be a source block because a language is specified."
