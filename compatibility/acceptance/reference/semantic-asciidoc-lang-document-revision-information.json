              {
                "kind": "text",
                "value": "A document’s revision information is assigned to three built-in attributes: "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "revnumber"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "revdate"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "revremark"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". These optional attributes can be set and assigned values "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "using the revision line"
                  }
                ],
                "kind": "xref",
                "target": "revision-line.html"
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "using attribute entries"
                  }
                ],
                "kind": "xref",
                "target": "revision-attribute-entries.html"
              },
              {
                "kind": "text",
                "value": " in a document header."
              }
            ],
