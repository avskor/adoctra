        "context": "section",
        "id": "_assign_rouge_to_source_highlighter",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Assign rouge to source-highlighter"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can further customize the source block output with additional Rouge attributes."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Controls what method is used for applying CSS to the tokens. Can be "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "class"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " or "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "style"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ". Default: "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "class"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": "."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "rouge-css"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Controls how line numbers are laid out. Can be "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "table"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " or "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "inline"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ". If line wrapping is enabled on preformatted blocks (i.e., "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "prewrap"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": "), and you want to use line numbering on source blocks, you must set the value of this attribute to "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "inline"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " in order for the numbers to line up properly with their target lines. Default: "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "table"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": "."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "rouge-linenums-mode"
                        }
                      ],
                      "kind": "span",
                      "roles": [
                        "line-through"
                      ]
                    },
                    {
                      "kind": "text",
                      "value": " (not currently implemented, see "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "#3641"
                        }
                      ],
                      "kind": "link",
                      "target": "https://github.com/asciidoctor/asciidoctor/issues/3641"
                    },
                    {
                      "kind": "text",
                      "value": ")"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Controls the color theme used to for highlighting. You can find the list of themes in the "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Rouge code repository"
                        }
                      ],
                      "kind": "link",
                      "metadata": {
                        "rel": "noopener",
                        "window": "_blank"
                      },
                      "target": "https://github.com/rouge-ruby/rouge/tree/HEAD/lib/rouge/themes"
                    },
                    {
                      "kind": "text",
                      "value": "."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "rouge-style"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Typically, you set these attributes using the CLI or API (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-a source-highlighter=rouge -a rouge-style=colorful"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") so you don’t have to define them in each document. However, you can define them per document as shown in the following example."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ":source-highlighter: rouge\n:rouge-style: monokai\n\n[,ruby]\n----\nputs \"Hello, Rouge!\"\n----"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Activating the Rouge syntax highlighter and applying a different style"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can enable line numbering using the linenums option on the block."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ":source-highlighter: rouge\n\n[%linenums,ruby]\n----\nORDERED_LIST_KEYWORDS = {\n  'loweralpha' => 'a',\n  'lowerroman' => 'i',\n  'upperalpha' => 'A',\n  'upperroman' => 'I'\n   #'lowergreek' => 'a'\n   #'arabic'     => '1'\n   #'decimal'    => '1'\n}\n----"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Customizing a source block with Rouge line numbers"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "It’s also possible to enable linenums for all source blocks by setting the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "source-linenums-option"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute on the document."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
