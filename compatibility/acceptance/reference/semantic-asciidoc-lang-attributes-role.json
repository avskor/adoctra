                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Sidebar with two roles assigned using the formal syntax"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In this form, the value of the role attribute is already in the right form to be passed through to the output. No additional processing is done on it."
