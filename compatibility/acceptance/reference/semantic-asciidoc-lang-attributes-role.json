                "kind": "xref",
                "target": "positional-and-named-attributes.html#named"
              },
              {
                "kind": "text",
                "value": ". Even though the attribute name is singular, it may contain multiple (space-separated) roles. Roles may also be defined using a shorthand (dot-prefixed) syntax."
              }
            ],
            "roles": [],
            "title": null
          },
