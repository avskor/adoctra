                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "WebClient client = WebClient.builder()\n\t\t.filter((request, next) -> {\n\n\t\t\tClientRequest filtered = ClientRequest.from(request)\n\t\t\t\t\t.header(\"foo\", \"bar\")\n\t\t\t\t\t.build();\n\n\t\t\treturn next.exchange(filtered);\n\t\t})\n\t\t.build();"
                        }
                      ],
                      "language": "java",
                      "roles": [],
