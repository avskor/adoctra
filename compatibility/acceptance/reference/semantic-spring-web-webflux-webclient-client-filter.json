        "inlines": [
          {
            "kind": "text",
            "value": "You can register a client filter ("
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ExchangeFilterFunction"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ") through the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebClient.Builder"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " in order to intercept and modify requests, as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
