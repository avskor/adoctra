                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "val client = WebClient.builder()\n\t\t.filter { request, next ->\n\n\t\t\tval filtered = ClientRequest.from(request)\n\t\t\t\t\t.header(\"foo\", \"bar\")\n\t\t\t\t\t.build()\n\n\t\t\tnext.exchange(filtered)\n\t\t}\n\t\t.build()"
                        }
                      ],
