      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "This can be used for cross-cutting concerns, such as authentication. The following example uses a filter for basic authentication through a static factory method:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "import static org.springframework.web.reactive.function.client.ExchangeFilterFunctions.basicAuthentication;\n\nWebClient client = WebClient.builder()\n\t\t.filter(basicAuthentication(\"user\", \"password\"))\n\t\t.build();"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "import org.springframework.web.reactive.function.client.ExchangeFilterFunctions.basicAuthentication\n\nval client = WebClient.builder()\n\t\t.filter(basicAuthentication(\"user\", \"password\"))\n\t\t.build()"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
