      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Filters can be added or removed by mutating an existing "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebClient"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " instance, resulting in a new "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebClient"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " instance that does not affect the original one. For example:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "import static org.springframework.web.reactive.function.client.ExchangeFilterFunctions.basicAuthentication;\n\nWebClient client = webClient.mutate()\n\t\t.filters(filterList -> {\n\t\t\tfilterList.add(0, basicAuthentication(\"user\", \"password\"));\n\t\t})\n\t\t.build();"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "val client = webClient.mutate()\n\t\t.filters { it.add(0, basicAuthentication(\"user\", \"password\")) }\n\t\t.build()"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
