          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Each list item is preceded by a marker. An unordered AsciiDoc list’s marker can range from one asterisk ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "*"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") to five asterisks ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "*****"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can separate list items with blank lines or comment lines. The blank lines are removed from the HTML when the list is published as a component version page menu, and the comments aren’t visible to site visitors."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The top-level list item in a single list navigation file is marked by either a single asterisk ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "*"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ") or, when the first item is a list title, a dot ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "."
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "). A list title is optional. Unlike list items, there must be "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "no spaces"
                      }
                    ],
                    "kind": "strong",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " between the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "."
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " and the content of the title."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".List title "
                  },
                  {
                    "guard": null,
                    "icons": null,
                    "id": "CO2-1",
                    "kind": "callout",
                    "number": "1",
                    "src": "",
                    "xml": false
                  },
                  {
                    "kind": "text",
                    "value": "\n* List item\n* Another list item\n** A nested list item"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "colist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "coids": [
                      "CO2-1"
                    ],
                    "icons": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "A list title becomes the top-level item for the entire list."
                      }
                    ],
                    "src": ""
                  }
                ],
                "roles": [],
                "style": "arabic",
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "When converted into a component version page menu, the list title becomes the top-level item for all of the other list items ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "*"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " through "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "*****"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ") in that file. Therefore, all of the other list items will be nested beneath the title."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "When a list doesn’t have a title, each item with a single asterisk marker ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "*"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ") becomes a top-level item to any list items that are nested directly under it."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "* List item "
                  },
                  {
                    "guard": null,
                    "icons": null,
                    "id": "CO3-1",
                    "kind": "callout",
                    "number": "1",
                    "src": "",
                    "xml": false
                  },
                  {
                    "kind": "text",
                    "value": "\n** A nested list item "
                  },
                  {
                    "guard": null,
                    "icons": null,
                    "id": "CO3-2",
                    "kind": "callout",
                    "number": "2",
                    "src": "",
                    "xml": false
                  },
                  {
                    "kind": "text",
                    "value": "\n* Another list item "
                  },
                  {
                    "guard": null,
