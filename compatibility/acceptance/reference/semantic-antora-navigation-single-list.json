      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Let’s create a navigation file named "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "nav.adoc"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " that defines a single navigation list for the pages in a module. The most common items in a navigation list are xrefs to pages "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "that belong to the same module as the navigation file"
                  }
                ],
                "kind": "xref",
                "target": "organize-files.html"
              },
              {
                "kind": "text",
                "value": ". The exercise below assumes that the navigation file will belong to the same component version and module as the pages it is referencing. That means the resource IDs won’t need to specify version, component, or module coordinates."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "olist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Open a new file in the text editor or IDE of your choice."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "listing",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "* xref:get-started.adoc"
                      }
                    ],
                    "language": "asciidoc",
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "On the first line, type an asterisk ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "*"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), directly followed by a blank space. Then type an xref macro prefix and the resource ID of the target page."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "blocks": [
                      {
                        "context": "listing",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "* xref:get-started.adoc[]"
                          }
                        ],
                        "language": "asciidoc",
                        "roles": [],
                        "title": null
                      },
                      {
                        "context": "paragraph",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Since there isn’t any link text specified inside the square brackets, Antora will use the value of the target page’s "
                          },
                          {
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "default link text"
                              }
                            ],
                            "kind": "xref",
                            "target": "xrefs-and-link-text.html#default-link-text"
                          },
                          {
                            "kind": "text",
                            "value": " when it generates the site."
                          }
                        ],
                        "roles": [],
                        "title": null
                      }
                    ],
                    "context": "open",
                    "id": null,
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "At the end of the resource ID, complete the macro with a set of square brackets ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "[]"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "). Press "
                  },
                  {
                    "keys": [
                      [
                        {
                          "kind": "text",
                          "value": "Enter"
                        }
                      ]
                    ],
                    "kind": "kbd"
                  },
                  {
                    "kind": "text",
                    "value": " to go to the next line."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "blocks": [
                      {
                        "context": "listing",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "* xref:get-started.adoc[]\n** xref:install.adoc[Installation Setup and Steps]"
                          }
                        ],
                        "language": "asciidoc",
                        "roles": [],
                        "title": null
                      },
                      {
                        "context": "paragraph",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "The link text, "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "Installation Setup and Steps"
                              }
                            ],
                            "kind": "emphasis",
                            "roles": []
                          },
                          {
                            "kind": "text",
                            "value": ", will be displayed in the component version page menu."
                          }
                        ],
                        "roles": [],
                        "title": null
                      }
                    ],
                    "context": "open",
                    "id": null,
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Let’s add a nested list item. Type two asterisks ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "**"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), followed by a blank space, and then an xref. This time, enter link text inside the set of square brackets ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "[]"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ")."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "listing",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "* xref:get-started.adoc[]\n** xref:install.adoc[Installation Setup and Steps]\n* CLI Commands and Options"
                      }
                    ],
                    "language": "asciidoc",
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Let’s create another top-level item that’s only text, i.e., it isn’t a page reference. On the next line, type an asterisk ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "*"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), a blank space, and then your text."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "listing",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "* xref:get-started.adoc[]\n** xref:install.adoc[Installation Setup and Steps]\n* CLI Commands and Options\n** xref:commands.adoc[]"
                      }
                    ],
                    "language": "asciidoc",
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Now, nest a list item under the previous top-level item. This item is a cross reference that will use the target page’s default link text."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "listing",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "* xref:get-started.adoc[]\n** xref:install.adoc[Installation Setup and Steps]\n* CLI Commands and Options\n** xref:commands.adoc[]\n*** xref:commands-in-action.adoc[]"
                      }
                    ],
                    "language": "asciidoc",
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Finally, nest a list item under the previous item. Type three asterisks ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "***"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), followed by a blank space, and then an xref."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "blocks": [
                      {
                        "context": "listing",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "📂 modules\n  📂 a-module\n    📂 pages\n    📄 nav.adoc"
                          }
                        ],
                        "language": null,
                        "roles": [],
                        "title": null
                      },
                      {
                        "context": "paragraph",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "You can also save the file with the filename of your choice, as long as the extension is "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": ".adoc"
                              }
                            ],
