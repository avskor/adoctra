            "inlines": [
              {
                "kind": "text",
                "value": "Verbatim blocks often have long lines that don’t fit within the fixed width of the PDF canvas. And unlike on the web, the PDF reader cannot scroll horizontally to reveal the overflow text. Therefore, the long lines are forced to wrap. Wrapped lines can make the verbatim blocks hard to read or even cause confusion."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To help address this problem, Asciidoctor PDF provides the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "autofit"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option on all verbatim—​literal, listing and source—​blocks to attempt to fit the text within the available width."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "autofit"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option is enabled, Asciidoctor PDF will decrease the font size as much as it can until the longest line fits without wrapping."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The converter won’t shrink the font size beyond the value of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "base-font-size-min"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key specified in the PDF theme. If that threshold is reached, lines may still wrap. To allow "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "autofit"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to handle all cases, set "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "base-font-size-min"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to "
              },
