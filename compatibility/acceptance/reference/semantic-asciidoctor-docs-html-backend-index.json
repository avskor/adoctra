                            ],
                            "roles": [],
                            "title": null
                          }
                        ],
                        "context": "open",
                        "id": null,
                        "roles": [],
                        "title": null
                      }
                    ],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "You won’t see any messages printed to the console. Type "
                      },
                      {
                        "id": null,
                        "inlines": [
