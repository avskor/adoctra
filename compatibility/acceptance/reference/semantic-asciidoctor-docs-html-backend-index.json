                            "kind": "text",
                            "value": "$ asciidoctor my-document.adoc -o - | w3m - -T text/html"
                          }
                        ],
                        "language": null,
                        "roles": [],
                        "title": null
                      }
                    ],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "If you want to preview the HTML in the terminal, you can use this command instead:"
                      }
                    ]
                  }
                ],
