    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor’s default output format is HTML (specifically HTML 5). That means when you run Asciidoctor without any parameters, it will produce HTML. This page explains how to use Asciidoctor to convert AsciiDoc to HTML."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor’s built-in HTML converter is registered for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "html"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "html5"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " backends. The HTML converter generates HTML 5 that’s styled with CSS3. It may include JavaScript to support additional integrations, such as client-side syntax highlighting."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "html"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ", "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "html5"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Backend names"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Asciidoctor::Converter::Html5Converter"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Converter class"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "HTML"
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Output format"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": ".html"
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Output file extension"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A standalone HTML document generated by the built-in HTML converter loads web fonts from Google Fonts, which are then referenced by the default stylesheet. The "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "default stylesheet"
                  }
                ],
                "kind": "xref",
                "target": "default-stylesheet.html"
              },
              {
                "kind": "text",
                "value": " makes use of web fonts to ensure the document renders consistently across platforms. Concerns have been raised that Google Fonts do not comply with GDPR. If this presents a problem, you can "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "opt out of the use of Google Fonts"
                  }
                ],
                "kind": "xref",
                "target": "default-stylesheet.html#disable-or-modify-the-web-fonts"
              },
              {
                "kind": "text",
                "value": ". When this is done, the default stylesheet reverts to using generic font families (e.g., sans-serif), which are mapped to system fonts by your browser. The consequence is that the appearance of the document will be different and system dependent due to a reliance on system fonts."
              }
            ],
            "roles": [],
            "title": null,
            "type": "warning"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the backend name is prefixed with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "x"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "xhtml"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), the converter will "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "generate XHTML"
                  }
                ],
                "kind": "xref",
                "target": "#xhtml"
              },
              {
                "kind": "text",
                "value": ", the XML variant of HTML."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
