                              {
                                "kind": "text",
                                "value": "my document"
                              }
                            ],
                            "attributes": {},
                            "caption": null,
                            "context": "image",
                            "id": null,
                            "roles": [],
                            "src": "my-document.png",
                            "svg": null,
