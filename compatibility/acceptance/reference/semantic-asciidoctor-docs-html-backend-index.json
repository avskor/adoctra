                "inlines": [
                  {
                    "kind": "text",
                    "value": "To convert "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "my-document.adoc"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": [
                      "path"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": " to HTML from the command line:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "olist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Open a terminal."
                      }
                    ]
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Switch to the directory that contains the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "my-document.adoc"
                          }
                        ],
                        "kind": "emphasis",
                        "roles": [
                          "path"
                        ]
                      },
                      {
                        "kind": "text",
                        "value": " document"
                      }
                    ]
                  },
                  {
                    "blocks": [
                      {
                        "blocks": [
                          {
                            "context": "literal",
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "$ asciidoctor my-document.adoc"
                              }
                            ],
                            "language": null,
                            "roles": [],
                            "title": null
                          },
                          {
                            "context": "paragraph",
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "Remember, Asciidoctor’s default converter is html5, so it isn’t necessary to specify it with the "
                              },
                              {
                                "id": null,
                                "inlines": [
                                  {
                                    "kind": "text",
                                    "value": "-b"
                                  }
                                ],
                                "kind": "monospace",
                                "roles": []
                              },
                              {
                                "kind": "text",
                                "value": " command."
                              }
                            ],
                            "roles": [],
                            "title": null
                          }
                        ],
                        "context": "open",
                        "id": null,
                        "roles": [],
                        "title": null
                      }
                    ],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Call the Asciidoctor processor with the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "asciidoctor"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " command, followed by the name of the document."
                      }
                    ]
                  },
                  {
                    "blocks": [
                      {
                        "blocks": [
                          {
                            "context": "literal",
                            "id": null,
                            "inlines": [
                              {
