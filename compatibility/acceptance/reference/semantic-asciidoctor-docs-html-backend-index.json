                          },
                          {
                            "context": "paragraph",
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "The document’s text, titles, and link are styled by the default Asciidoctor stylesheet, which is embedded in the HTML output. As a result, you could save "
                              },
                              {
                                "id": null,
                                "inlines": [
                                  {
                                    "kind": "text",
