                                  }
                                ],
                                "kind": "emphasis",
                                "roles": [
                                  "path"
                                ]
                              },
                              {
                                "kind": "text",
                                "value": " to any computer and it will look the same."
                              }
                            ],
                            "roles": [],
                            "title": null
                          }
                        ],
                        "context": "open",
                        "id": null,
                        "roles": [],
                        "title": null
                      }
                    ],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Open "
                      },
                      {
                        "id": null,
                        "inlines": [
