                            "kind": "text",
                            "value": "ls"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " to view the files in the directory or navigate to the directory in a file manager. You should see a new file named "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "my-document.html"
                          }
                        ],
                        "kind": "emphasis",
                        "roles": [
                          "path"
                        ]
                      },
                      {
                        "kind": "text",
