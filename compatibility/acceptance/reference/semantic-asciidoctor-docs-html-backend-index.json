        "context": "section",
        "id": "_generate_html",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Generate HTML"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "xhtml"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ", "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "xhtml5"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Backend names"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Asciidoctor::Converter::Html5Converter"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Converter class"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "XML variant of HTML"
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Output format"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": ".html"
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Output file extension"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor -b xhtml5 my-document.adoc"
              }
            ],
            "language": null,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Produce XHTML using the xhtml5 backend option"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To produce XHTML instead of HTML when using converter templates, set the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "htmlsyntax"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "xml"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in addition to the backend option:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor -T /path/to/templates -b slides -a htmlsyntax=xml my-document.adoc"
              }
            ],
            "language": null,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Produce XHTML using custom templates"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "XHTML output is a special mode of the built-in HTML5 converter. It is activated by prefixing the backend value with "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "x"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " (e.g., "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "xhtml"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " or "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "xhtml5"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "). This hint implicitly assigns the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "htmlsyntax"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " attribute to the value "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "xml"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", which normally has the value "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "html"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "For all other converters, the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "htmlsyntax"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " attribute is not set explicitly. If you want a converter template that’s written in Slim or Haml to output XHTML instead of the default HTML, you need to set the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "htmlsyntax"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " attribute to "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "xml"
                      }
                    ],
