        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "See equivalent in the Reactive stack"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webflux/controller/ann.html"
                  }
                ],
                "kind": "span",
                "roles": [
                  "small"
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can define controller beans by using a standard Spring bean definition in the Servlet’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "WebApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Controller"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " stereotype allows for auto-detection, aligned with Spring general support for detecting "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Component"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " classes in the classpath and auto-registering bean definitions for them. It also acts as a stereotype for the annotated class, indicating its role as a web component."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To enable auto-detection of such "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Controller"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " beans, you can add component scanning to your Java configuration, as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "include-code::./WebConfiguration[tag=snippet,indent=0]"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RestController"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "composed annotation"
                  }
                ],
                "kind": "xref",
                "target": "core/beans/classpath-scanning.html#beans-meta-annotations"
              },
              {
                "kind": "text",
                "value": " that is itself meta-annotated with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Controller"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@ResponseBody"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to indicate a controller whose every method inherits the type-level "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@ResponseBody"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotation and, therefore, writes directly to the response body versus view resolution and rendering with an HTML template."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "See equivalent in the Reactive stack"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webflux/controller/ann.html#webflux-ann-requestmapping-proxying"
                  }
                ],
                "kind": "span",
                "roles": [
                  "small"
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In some cases, you may need to decorate a controller with an AOP proxy at runtime. One example is if you choose to have "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Transactional"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotations directly on the controller. When this is the case, for controllers specifically, we recommend using class-based proxying. This is automatically the case with such annotations directly on the controller."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the controller implements an interface, and needs AOP proxying, you may need to explicitly configure class-based proxying. For example, with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@EnableTransactionManagement"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " you can change to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@EnableTransactionManagement(proxyTargetClass = true)"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", and with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<tx:annotation-driven/>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " you can change to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<tx:annotation-driven proxy-target-class=\"true\"/>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Keep in mind that as of 6.0, with interface proxying, Spring MVC no longer detects controllers based solely on a type-level "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RequestMapping"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotation on the interface. Please, enable class based proxying, or otherwise the interface must also have an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Controller"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotation."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          }
        ],
        "context": "section",
        "id": "mvc-ann-requestmapping-proxying",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "AOP Proxies"
          }
        ]
      }
