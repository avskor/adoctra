        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Alternatively, as of 6.2, there is a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Fallback"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation for demarcating any beans other than the regular ones to be injected. If only one regular bean is left, it is effectively primary as well:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
