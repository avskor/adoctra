      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "With both variants of the preceding configuration, the following "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MovieRecommender"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
