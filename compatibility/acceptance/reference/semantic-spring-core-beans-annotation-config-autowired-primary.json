                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@Configuration\npublic class MovieConfiguration {\n\n\t@Bean\n\tpublic MovieCatalog firstMovieCatalog() { ... }\n\n\t@Bean\n\t@Fallback\n\tpublic MovieCatalog secondMovieCatalog() { ... }\n\n\t// ...\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
