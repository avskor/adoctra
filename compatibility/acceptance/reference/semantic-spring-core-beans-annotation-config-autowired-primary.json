      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The corresponding bean definitions follow:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "listing",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<beans xmlns=\"http://www.springframework.org/schema/beans\"\n\txmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n\txmlns:context=\"http://www.springframework.org/schema/context\"\n\txsi:schemaLocation=\"http://www.springframework.org/schema/beans\n\t\thttps://www.springframework.org/schema/beans/spring-beans.xsd\n\t\thttp://www.springframework.org/schema/context\n\t\thttps://www.springframework.org/schema/context/spring-context.xsd\">\n\n\t<context:annotation-config/>\n\n\t<bean class=\"example.SimpleMovieCatalog\" primary=\"true\">\n\t\t<!-- inject any dependencies required by this bean -->\n\t</bean>\n\n\t<bean class=\"example.SimpleMovieCatalog\">\n\t\t<!-- inject any dependencies required by this bean -->\n\t</bean>\n\n\t<bean id=\"movieRecommender\" class=\"example.MovieRecommender\"/>\n\n</beans>"
          }
        ],
        "language": "xml",
        "roles": [],
        "title": null
      }
