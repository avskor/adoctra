                          "kind": "text",
                          "value": "public class MovieRecommender {\n\n\t@Autowired\n\tprivate MovieCatalog movieCatalog;\n\n\t// ...\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
