            "kind": "text",
            "value": " is autowired with the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "firstMovieCatalog"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ":"
          }
        ],
        "roles": [],
        "title": null
      },
      {
