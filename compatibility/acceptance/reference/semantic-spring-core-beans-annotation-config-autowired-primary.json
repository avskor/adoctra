                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@Configuration\nclass MovieConfiguration {\n\n\t@Bean\n\t@Primary\n\tfun firstMovieCatalog(): MovieCatalog { ... }\n\n\t@Bean\n\tfun secondMovieCatalog(): MovieCatalog { ... }\n\n\t// ...\n}"
                        }
                      ],
