              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "auto"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Except for the aforementioned cases, the TOC is inserted in the flow of text. If a placement is not specified, that location is between the document title and the first block of content."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
