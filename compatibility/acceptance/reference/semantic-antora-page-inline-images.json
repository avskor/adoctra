                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Inline image macro"
                  }
                ]
              },
              {
                "context": "colist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "coids": [
                      "CO1-1"
                    ],
                    "icons": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "An inline image is entered into the flow of the content. It’s designated by a single colon ("
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": ":"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": ") after the macro name."
                      }
                    ],
                    "src": ""
                  }
                ],
                "roles": [],
                "style": "arabic",
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "At a minimum, an inline image macro consists of the macro’s prefix ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "image:"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), the resource ID of the target image, and a set of square brackets ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "[]"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "). "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "image-resource-id-examples.adoc"
                      }
                    ],
                    "kind": "link",
                    "metadata": {
                      "role": "bare include"
                    },
                    "target": "image-resource-id-examples.adoc"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Each part of the inline image macro shown in "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Example 1"
                      }
                    ],
                    "kind": "xref",
