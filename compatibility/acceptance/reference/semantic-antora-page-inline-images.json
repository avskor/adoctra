          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An AsciiDoc inline image macro is used to embed the source file of an image into a partial or page. The inline image macro accepts the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Antora resource ID"
                  }
                ],
                "kind": "xref",
                "target": "resource-id.html"
              },
              {
                "kind": "text",
                "value": " of PNG, JPG, SVG, and GIF (static and animated) image files as a value."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When Antora runs, the image file referenced by the inline image macro is embedded in the flow of another element, such as a sidebar block, and displayed in the published page. For example, this is an SVG image "
              },
              {
                "alt": [
                  {
                    "kind": "text",
                    "value": "blue dot"
                  }
                ],
                "attributes": {},
                "id": null,
                "kind": "image",
                "roles": [],
                "src": "blue-dot.svg",
                "svg": null,
                "target": "blue-dot.svg"
              },
              {
                "kind": "text",
                "value": " that’s embedded in this paragraph using the inline image macro."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Example 1"
                      }
                    ],
                    "kind": "xref",
                    "target": "#ex-inline-base"
                  },
                  {
                    "kind": "text",
                    "value": " shows the structure of an inline image macro."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": "ex-inline-base",
                "inlines": [
                  {
                    "kind": "text",
                    "value": "This sentence contains an inline image:resource-id-of-target-image.ext[optional attribute,optional attribute] image. "
                  },
                  {
                    "guard": null,
                    "icons": null,
                    "id": "CO1-1",
                    "kind": "callout",
                    "number": "1",
                    "src": "",
                    "xml": false
