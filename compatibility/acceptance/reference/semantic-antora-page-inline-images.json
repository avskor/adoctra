                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [],
                      "checkbox": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "An inline image macro begins with the macro’s name, "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "image"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": ", followed by a single colon ("
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": ":"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": ")."
                        }
                      ]
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "image:"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [],
                      "checkbox": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "The image macro accepts the resource ID of an image source file as its value. The value is entered directly after the colon that follows the macro’s name ("
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "image:"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": "). How many of the target image’s "
                        },
                        {
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "resource ID coordinates"
                            }
                          ],
                          "kind": "xref",
                          "target": "resource-id-coordinates.html"
                        },
                        {
                          "kind": "text",
                          "value": " you need to specify depends on the component version and module of the target image in relation to the current page. When referencing an image from an image macro, you don’t need to include the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "image$"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " family coordinate in the target image’s resource ID. It’s applied automatically at runtime."
                        }
                      ]
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "resource ID of target image"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "dlist",
                "id": "attribute",
                "items": [
