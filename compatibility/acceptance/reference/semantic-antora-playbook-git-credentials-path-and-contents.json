                  {
                    "kind": "text",
                    "value": ")."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "admonition",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "We don’t recommend directly entering your git host username/password pair or access token into a playbook! You could accidentally expose them by pushing your playbook to a remote repository or CI server."
                  }
                ],
                "roles": [],
                "title": null,
                "type": "warning"
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In the example below, a reference to an environment variable named "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "GITHUB_TOKEN"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " is placed where the host GitHub expects to locate an access token. The "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "credentials structure and location"
                      }
                    ],
                    "kind": "xref",
                    "target": "private-repository-auth.html#host-credential-structure"
                  },
                  {
                    "kind": "text",
                    "value": " depends on the git host. For instance, GitHub requires a colon ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": ":"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ") be placed at the end of the token."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "git:\n  credentials:\n    contents: https://$GITHUB_TOKEN:@github.com"
                  }
                ],
                "language": "yaml",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "antora-playbook.yml"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Unfortunately, Antora does not yet support resolving environment variables located in the playbook file. However, you can emulate this behavior by using the following script to substitute the environment variable reference with a value prior to invoking Antora:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "literal",
                "id": null,
                "inlines": [
