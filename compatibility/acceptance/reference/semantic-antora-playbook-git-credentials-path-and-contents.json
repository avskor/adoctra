            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In order for Antora to access private repositories, you must supply it with authentication credentials in order to access these private repositories. By default, Antora will look for these authentication credentials in the default git credentials store. When you’re using an alternate git credential store location or haven’t populated the default store with credentials, you can use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "credentials.path"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "credentials.contents"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " keys to pass your credentials to Antora."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When a git host requests authentication for a private "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "content source repository"
                  }
                ],
                "kind": "xref",
                "target": "content-source-url.html"
              },
              {
                "kind": "text",
                "value": ", Antora’s built-in credential manager automatically checks for credentials in the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "default git credential store"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://git-scm.com/docs/git-credential-store"
              },
              {
                "kind": "text",
                "value": ". The default path for the git credential store is "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "$HOME/.git-credentials"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "$XDG_CONFIG_HOME/git/credentials"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", if the previous location doesn’t exist)."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "default",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Default git credentials store and path"
          }
        ]
      },
