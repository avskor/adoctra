    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "To configure an "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " for your tests by using context initializers, annotate your test class with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ContextConfiguration"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and configure the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "initializers"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " attribute with an array that contains references to classes that implement "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationContextInitializer"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". The declared context initializers are then used to initialize the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ConfigurableApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " that is loaded for your tests. Note that the concrete "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ConfigurableApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " type supported by each declared initializer must be compatible with the type of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " created by the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "SmartContextLoader"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " in use (typically a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "GenericApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "). Furthermore, the order in which the initializers are invoked depends on whether they implement Spring’s "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Ordered"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " interface or are annotated with Spring’s "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Order"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation or the standard "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Priority"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation. The following example shows how to use initializers:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@ExtendWith(SpringExtension.class)\n// ApplicationContext will be loaded from TestConfig\n// and initialized by TestAppCtxInitializer\n@ContextConfiguration(\n\tclasses = TestConfig.class,\n\tinitializers = TestAppCtxInitializer.class) "
                        },
                        {
                          "guard": "// ",
                          "icons": null,
                          "id": "CO1-1",
                          "kind": "callout",
                          "number": "1",
                          "src": "",
                          "xml": false
                        },
                        {
                          "kind": "text",
                          "value": "\nclass MyTest {\n\t// class body...\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    },
                    {
