      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can also omit the declaration of XML configuration files, Groovy scripts, or component classes in "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ContextConfiguration"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " entirely and instead declare only "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationContextInitializer"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " classes, which are then responsible for registering beans in the context — for example, by programmatically loading bean definitions from XML files or configuration classes. The following example shows how to do so:"
          }
        ],
        "roles": [],
        "title": null
      },
