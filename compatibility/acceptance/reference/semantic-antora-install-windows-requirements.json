            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you have nvm installed but your Node.js version is not an active LTS release, type the following command in your terminal:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
