              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When using nvm for Windows, you must enter the full version of Node.js (i.e., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "nvm install 26.13.0"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null,
            "type": "important"
          }
        ],
