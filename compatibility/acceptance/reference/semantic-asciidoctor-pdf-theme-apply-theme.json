{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "After creating a theme, you’ll need to tell Asciidoctor PDF where to find it. This is done using AsciiDoc attributes."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "There are three AsciiDoc attributes that tell Asciidoctor PDF how to locate and apply your theme."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "paragraph",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "If the value of the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "pdf-theme"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " attribute ends with "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": ".yml"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " (e.g., "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "custom-theme.yml"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": "), the name is assumed to be an absolute or relative file path. If the path is relative, it’s resolved starting from the value of the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "pdf-themesdir"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " attribute. If the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "pdf-themesdir"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " attribute is not specified, it is resolved from the current working directory instead."
                        }
                      ],
                      "roles": [],
                      "title": null
                    },
                    {
                      "context": "paragraph",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "If the value of the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "pdf-theme"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " attribute doesn’t end with "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": ".yml"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " (e.g., "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "base"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": "), the suffix "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "-theme.yml"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " is automatically appended to build a valid absolute or relative file path (i.e., "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "<name>-theme.yml"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": "). The value is then treated as a relative path (even if it’s absolute) and resolved starting from the value of the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "pdf-themesdir"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " attribute. If the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "pdf-themesdir"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " is not specified, the built-in themes directory is used as the starting point instead (rather than the current working directory)."
                        }
                      ],
                      "roles": [],
                      "title": null
                    },
                    {
                      "context": "admonition",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "The theme file "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "must"
                            }
                          ],
                          "kind": "strong",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " end in .yml, not .yaml. When the theme path specified does not end in .yml, Asciidoctor PDF appends the suffix "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "-theme.yml"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " and looks for the resulting file."
                        }
                      ],
                      "roles": [],
                      "title": null,
                      "type": "important"
                    },
                    {
                      "context": "paragraph",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "You can use the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "{docdir}"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " token as the first path segment in the name to build an absolute path starting from the directory of the source document."
                        }
                      ],
                      "roles": [],
                      "title": null
                    },
                    {
                      "context": "paragraph",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "The theme name or file path can be specified using the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "--theme"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " CLI option as a shorthand."
                        }
                      ],
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "The name or file path of the theme to load. Can be set using the "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "--theme"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " CLI option. When using JRuby, the file path may begin with "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "uri:classloader:"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " to reference a location on the classpath."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "pdf-theme"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "paragraph",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "If the path is relative, the value is resolved starting from the current working directory. You can use the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "{docdir}"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " token as the first path segment to build an absolute path starting from the directory of the source document."
                        }
                      ],
                      "roles": [],
                      "title": null
                    },
                    {
                      "context": "paragraph",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "If not specified, the value of this attribute will default to the absolute directory of the theme file (as specified by the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "pdf-theme"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " attribute). If you want to use an ancestory directory instead, you must specify both the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "pdf-themesdir"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " attribute and the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "pdf-theme"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " attribute, and the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "pdf-theme"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " attribute must be a path (at any depth) relative to the value of "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "pdf-themesdir"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": "."
                        }
                      ],
                      "roles": [],
                      "title": null
                    },
                    {
                      "context": "paragraph",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Relative image paths in your theme (such as image targets) are resolved starting from this location."
                        }
                      ],
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "The directory path where the theme file is located. When using JRuby, the directory path may begin with "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "uri:classloader:"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " to reference a location on the classpath."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "pdf-themesdir"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "paragraph",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Multiple entries must be separated by either a comma or a semicolon. To reference a file inside a JAR file on the classpath, prefix with the path with "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "uri:classloader:"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " (JRuby only). If the path is relative, the value is resolved starting from the current working directory."
                        }
                      ],
                      "roles": [],
                      "title": null
                    },
                    {
                      "context": "paragraph",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "You can use the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "{docdir}"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " token as the first path segment to create an absolute path starting from the directory of the document."
                        }
                      ],
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "The directory path or paths where the fonts used by your theme, if any, are located. When using JRuby, each path may begin with "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "uri:classloader:"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " to reference a location on the classpath."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "pdf-fontsdir"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "theme-and-font-directories",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Theme and font directories"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Let’s assume that you’ve put your theme files inside a directory named "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "resources"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " with the following layout:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "doc.adoc\nresources/\n  themes/\n    basic-theme.yml\n  fonts/\n    roboto-normal.ttf\n    roboto-italic.ttf\n    roboto-bold.ttf\n    roboto-bold_italic.ttf"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s the formal way of loading your theme when calling Asciidoctor PDF:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor-pdf -a pdf-theme=basic -a pdf-themesdir=resources/themes -a pdf-fontsdir=resources/fonts doc.adoc"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can replace the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf-theme"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute assignment with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--theme"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", which does the same thing:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor-pdf --theme basic -a pdf-themesdir=resources/themes -a pdf-fontsdir=resources/fonts doc.adoc"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If all goes well, Asciidoctor PDF will convert your document without any errors or warnings."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You only need to specify the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf-fontsdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " if you’re using custom fonts in your theme. By default, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf-fontsdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " resolves to the directory of the bundled fonts."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can skip setting the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf-themesdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute by passing the relative path of your theme file to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "theme"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor-pdf --theme resources/themes/basic-theme.yml -a pdf-fontsdir=resources/fonts doc.adoc"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In this case, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf-themesdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " will be set automatically to the directory of the theme path specified either by the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf-theme"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute or the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--theme"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "resources/themes"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " in the previous example)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If a relative path is specified for "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf-themesdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf-fontsdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf-theme"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " when "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf-themesdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is not specified, that path is resolved starting from the current working directory. Alternately, you can use "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "{docdir}"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " as the first path segment to anchor them to the directory of the source document instead."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you’re having difficulty getting the converter to locate your theme or fonts, you can specify absolute paths instead, which are used as is."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor-pdf --theme /path/to/resources/themes/basic-theme.yml -a pdf-fontsdir=/path/to/resources/fonts doc.adoc"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Relative font paths in the theme are resolved starting from the directory resolved from the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf-fontsdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute. All other paths in the theme are resolved starting from the value of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf-themesdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute. You can prefix paths in the theme using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "{docdir}"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "{docimagesdir}"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute references."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "load-a-theme",
        "level": 1,
