            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "As usual, you can also use build tools like Maven and Gradle to build a themed PDF. The only thing you need to add to an existing build is the attributes mentioned above."
              }
            ],
            "roles": [],
            "title": null
          },
