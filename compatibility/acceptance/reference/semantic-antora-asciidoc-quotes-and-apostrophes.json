                  ]
                ],
                "kind": "kbd"
              },
              {
                "kind": "text",
                "value": " key, an apostrophe that is directly preceded and followed by a character, such as in contractions and possessive singular forms, is automatically output as a curved apostrophe."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "However, an apostrophe directly followed by white space, such as the possessive plural form, is not curved by default."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To output an apostrophe as curved when it is not bound by two characters, mark it as you would a single curved quote."
              }
            ],
            "roles": [],
            "title": null
          },
