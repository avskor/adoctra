            "id": "context-introduction-ctx-vs-beanfactory-feature-matrix",
            "options": [],
            "roles": [],
            "stripes": "odd",
            "title": [
              {
                "kind": "text",
                "value": "Feature Matrix"
              }
            ],
            "width": 100
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To explicitly register a bean post-processor with a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DefaultListableBeanFactory"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", you need to programmatically call "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "addBeanPostProcessor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "DefaultListableBeanFactory factory = new DefaultListableBeanFactory();\n// populate the factory with bean definitions\n\n// now register any needed BeanPostProcessor instances\nfactory.addBeanPostProcessor(new AutowiredAnnotationBeanPostProcessor());\nfactory.addBeanPostProcessor(new MyBeanPostProcessor());\n\n// now start using the factory"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "val factory = DefaultListableBeanFactory()\n// populate the factory with bean definitions\n\n// now register any needed BeanPostProcessor instances\nfactory.addBeanPostProcessor(AutowiredAnnotationBeanPostProcessor())\nfactory.addBeanPostProcessor(MyBeanPostProcessor())\n\n// now start using the factory"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To apply a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "BeanFactoryPostProcessor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to a plain "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DefaultListableBeanFactory"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", you need to call its "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "postProcessBeanFactory"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method, as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "DefaultListableBeanFactory factory = new DefaultListableBeanFactory();\nXmlBeanDefinitionReader reader = new XmlBeanDefinitionReader(factory);\nreader.loadBeanDefinitions(new FileSystemResource(\"beans.xml\"));\n\n// bring in some property values from a Properties file\nPropertySourcesPlaceholderConfigurer cfg = new PropertySourcesPlaceholderConfigurer();\ncfg.setLocation(new FileSystemResource(\"jdbc.properties\"));\n\n// now actually do the replacement\ncfg.postProcessBeanFactory(factory);"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "val factory = DefaultListableBeanFactory()\nval reader = XmlBeanDefinitionReader(factory)\nreader.loadBeanDefinitions(FileSystemResource(\"beans.xml\"))\n\n// bring in some property values from a Properties file\nval cfg = PropertySourcesPlaceholderConfigurer()\ncfg.setLocation(FileSystemResource(\"jdbc.properties\"))\n\n// now actually do the replacement\ncfg.postProcessBeanFactory(factory)"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In both cases, the explicit registration steps are inconvenient, which is why the various "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " variants are preferred over a plain "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DefaultListableBeanFactory"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in Spring-backed applications, especially when relying on "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "BeanFactoryPostProcessor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "BeanPostProcessor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instances for extended container functionality in a typical enterprise setup."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "An "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "AnnotationConfigApplicationContext"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " has all common annotation post-processors registered and may bring in additional processors underneath the covers through configuration annotations, such as "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@EnableTransactionManagement"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ". At the abstraction level of Spring’s annotation-based configuration model, the notion of bean post-processors becomes a mere internal container detail."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "admonition",
