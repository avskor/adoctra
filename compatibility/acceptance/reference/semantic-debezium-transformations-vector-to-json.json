          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Debezium’s logical semantic types consist either of an array of values or a data structure that not only contains the array of values, but additional attributes that describe the vector’s SQL representation. The following illustrates the JSON output based on the Debezium logical semantic type."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "{\n  \"values\": [1, 2, 3]\n}"
              }
            ],
            "language": "json",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "DoubleVector after conversion to JSON"
              }
            ]
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "{\n  \"values\": [1, 2, 3]\n}"
              }
            ],
            "language": "json",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "FloatVector after conversion to JSON"
              }
            ]
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "{\n  \"dimensions\": 25,\n  \"vector\": {\n    \"1\": 10,\n    \"5\": 25,\n    \"10\": 100,\n    \"25\": 10000\n  }\n}"
              }
            ],
            "language": "json",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "SparseVector after conversion to JSON"
              }
            ]
          }
        ],
        "context": "section",
        "id": "_examples_of_json_by_semantic_type",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Examples of JSON by semantic type"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To convert vector data types to JSON, configure the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "VectorToJsonConverter"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in the Kafka Connect configuration for the Debezium connector."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The connector configuration in the following example will convert all PostgreSQL vector logical field types to JSON:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "transforms=vectortojson\ntransforms.vectortojson.type=io.debezium.transforms.VectorToJsonConverter"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
