{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you aren’t familiar with command line interfaces, the following sections provide some basic information about command line and terminal concepts used in this documentation."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The Antora CLI accepts command inputs in the form of a base call, a command (for the program), options, and arguments. Once entered in a terminal, the command is executed using the specified inputs."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ antora <command> [options] <arguments>"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "The Antora CLI command starts with the "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "base call"
                        }
                      ],
                      "kind": "xref",
                      "target": "index.html#usage"
                    },
                    {
                      "kind": "text",
                      "value": ", which is the name of the program (i.e., "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "antora"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": "). This tells the command interpreter to execute the Antora CLI. If the system cannot find the program name by itself, you must specify the path to the "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "antora"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " bin script instead (e.g., "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "npx antora"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ")."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "base call"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "A "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "command"
                        }
                      ],
                      "kind": "xref",
                      "target": "index.html#commands"
                    },
                    {
                      "kind": "text",
                      "value": " tells Antora what operation to perform. Only one command can be specified at a time."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "command"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "paragraph",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Some options toggle behavior on or off and others accept values. Options that accept values can be written using a single space between the option’s name and value ("
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "--option value"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": ") or using an equals sign between the name and value ("
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "--option=value"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": ")."
                        }
                      ],
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "One or more "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "options"
                        }
                      ],
                      "kind": "xref",
                      "target": "options.html"
                    },
                    {
                      "kind": "text",
                      "value": " can be specified after a command. The full name of an option is prefixed with two hyphens ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "--"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": "); a shorthand name is prefixed with one hyphen ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "-"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ")."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "option"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "An argument is entered after the base call and any options. You can think of an argument as an anonymous options. The "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "generate"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " command only accepts a single argument, which is the "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "path to the playbook file"
                        }
                      ],
                      "kind": "xref",
                      "target": "index.html#specify-playbook"
                    },
                    {
                      "kind": "text",
                      "value": "."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "argument"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Environment variables"
                        }
                      ],
                      "kind": "xref",
                      "target": "playbook:environment-variables.html"
                    },
                    {
                      "kind": "text",
                      "value": " (which are not present in the command itself) are read from your terminal’s state. An environment variable overrides the corresponding key in the playbook file, but is itself overridden by the corresponding CLI option."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "environment variable"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "command-inputs-and-structure",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Command inputs and structure"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you’re new to terminal applications, here are the common conventions used in this documentation that represent a terminal and describe how you’ll interact with it."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "The terminal command prompt is shown as a dollar sign ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "$"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ") in the examples throughout this documentation. The prompt you see when you open your terminal depends on the terminal application you use. "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Don’t include the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "$"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " prompt when you type or copy commands."
                        }
                      ],
                      "kind": "strong",
                      "roles": []
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Prompt ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "$"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ")"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "blocks": [
                        {
                          "context": "paragraph",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "Every command is run from a current working directory. The processes associated with a command’s inputs are interpreted relative to the working directory. Your current working directory is often displayed directly to the left of the terminal’s command prompt ("
                            },
                            {
                              "id": null,
                              "inlines": [
                                {
                                  "kind": "text",
                                  "value": "$"
                                }
                              ],
                              "kind": "monospace",
                              "roles": []
                            },
                            {
                              "kind": "text",
                              "value": "), however, this is dependent on the terminal application you’re using and how its configured."
                            }
                          ],
                          "roles": [],
                          "title": null
                        },
                        {
                          "context": "paragraph",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "A few examples in this documentation show the name of the working directory in front of the prompt as a helpful hint."
                            }
                          ],
                          "roles": [],
                          "title": null
                        },
                        {
                          "context": "literal",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "name-of-working-directory $ antora antora-playbook"
                            }
                          ],
                          "language": null,
                          "roles": [],
                          "title": null
                        },
                        {
                          "context": "paragraph",
                          "id": null,
                          "inlines": [
                            {
                              "id": null,
                              "inlines": [
                                {
                                  "kind": "text",
                                  "value": "Don’t include this text or the prompt when copying the command."
                                }
                              ],
                              "kind": "strong",
                              "roles": []
                            }
                          ],
                          "roles": [],
                          "title": null
                        }
                      ],
                      "context": "open",
                      "id": null,
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "id": "working-directory",
                      "kind": "anchor"
                    },
                    {
                      "kind": "text",
                      "value": "Working directory"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Many options are defined according to your content, environment, and site requirements. Some command line examples in this documentation call out the input you define with a set of angle brackets ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "< >"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": "). The text inside the brackets describes the input or represents a common input format, e.g., "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "--require <path/to/library-script>"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ", "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "--title '<Title of Your Site>'"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ". When composing the command in your terminal, replace the representative text with your input and don’t enclose it in angle brackets ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "< >"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ")."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Replaceable input"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "If a command returns information, the output is displayed in your terminal on the lines beneath the executed command. The command prompt ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "$"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ") is not displayed on the output lines."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Command output"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "terminal-conventions",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Terminal conventions"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "CLI Primer"
      }
    ]
  }
}
