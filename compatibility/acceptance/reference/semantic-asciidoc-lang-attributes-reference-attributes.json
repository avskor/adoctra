    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You’ll likely want to insert the value of a user-defined or built-in document attribute in various locations throughout a document. To reference a document attribute for insertion, enclose the attribute’s name in curly brackets (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "{name-of-attribute}"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). This inline element is called an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "attribute reference"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The AsciiDoc processor replaces the attribute reference with the value of the attribute. To prevent this replacement, you can prefix the element with a backslash (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "\\{name-of-attribute}"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Before you can reference a custom (i.e., user-defined) attribute in a document, it must first be declared using an attribute entry in the document header. In "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 1"
                  }
                ],
                "kind": "xref",
                "target": "#ex-set-custom"
              },
              {
                "kind": "text",
                "value": ", we declare two user-defined attributes that we’ll later be able to reference."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-set-custom",
            "inlines": [
              {
                "kind": "text",
                "value": "= Ops Manual\n:disclaimer: Don't pet the wild Wolpertingers. We're not responsible for any loss of hair, chocolate, or purple socks.\n:url-repo: https://github.com/asciidoctor/asciidoctor"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Custom attributes set in the document header"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Once you’ve set and assigned a value to a document attribute, you can reference that attribute throughout your document. In "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 2"
                  }
                ],
                "kind": "xref",
                "target": "#ex-reference"
              },
              {
                "kind": "text",
                "value": ", the attribute "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "url-repo"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is referenced twice and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "disclaimer"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is referenced once."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-reference",
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor is {url-repo}[open source]. "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO1-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\n\nWARNING: {disclaimer} "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO1-2",
                "kind": "callout",
                "number": "2",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\nIf you're missing a lime colored sock, file a ticket in\nthe {url-repo}/issues[Asciidoctor issue tracker]. "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO1-3",
                "kind": "callout",
                "number": "3",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\n(Actually, please don't)."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Custom attributes referenced in the document body"
              }
            ]
          },
          {
            "context": "colist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-1"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Attribute references can be used in macros."
                  }
                ],
                "src": ""
              },
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-2"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Attribute references can be used in blocks, such as "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "admonitions"
                      }
                    ],
                    "kind": "xref",
                    "target": "blocks:admonitions.html"
                  },
                  {
                    "kind": "text",
                    "value": ", and inline. Since there isn’t an empty line between the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "disclaimer"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " reference and the next sentence, the sentence will be directly appended to the end of the attribute’s value when it’s processed."
                  }
                ],
                "src": ""
              },
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-3"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The reference to the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "url-repo"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " attribute is inserted to build the complete URL address, which is interpreted as a "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "URL macro"
                      }
                    ],
                    "kind": "xref",
                    "target": "macros:url-macro.html"
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "As you can see below, the attribute references are replaced with the corresponding attribute value when the document is processed."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Asciidoctor is "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "open source"
                      }
                    ],
                    "kind": "link",
                    "target": "https://github.com/asciidoctor/asciidoctor"
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "admonition",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Don’t pet the wild Wolpertingers. We’re not responsible for any loss of hair, chocolate, or purple socks. If you’re missing a lime colored sock, file a ticket in the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Asciidoctor issue tracker"
                      }
                    ],
                    "kind": "link",
                    "target": "https://github.com/asciidoctor/asciidoctor/issues"
                  },
                  {
                    "kind": "text",
                    "value": ". Actually, please don’t."
                  }
                ],
                "roles": [],
                "title": null,
                "type": "warning"
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "reference-custom",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Reference a custom attribute"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A built-in document attribute (i.e., a document attribute which is automatically set by the processor) is referenced the same way as a custom (i.e., user-defined) document attribute. For instance, an AsciiDoc processor automatically sets these supported "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "character replacement attributes"
                  }
                ],
                "kind": "xref",
                "target": "character-replacement-ref.html"
              },
              {
                "kind": "text",
                "value": ". That means that you can reference them throughout your document without having to create an attribute entry in its header."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "TIP: Wolpertingers don't like temperatures above 100{deg}C. "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO2-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\nOur servers don't like them either."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "colist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO2-1"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Reference the character replacement attribute "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "deg"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " by enclosing its name in a pair of curly brackets ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "{"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " and "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "}"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ")."
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "As you can see below, the attribute reference is replaced with the attribute’s value when the document is processed."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Wolpertingers don’t like temperatures above 100°C. Our servers don’t like them either."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          }
        ],
        "context": "section",
        "id": "reference-built-in",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Reference a built-in attribute"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You may have a situation where a sequence of characters occurs in your content that matches the syntax of an AsciiDoc attribute reference, but is not, in fact, an AsciiDoc attribute reference. For example, if you’re documenting path templating, you may need to reference a replaceable section of a URL path, which is also enclosed in curly braces (e.g., /items/{id}). In this case, you need a way to escape the attribute reference so the AsciiDoc processor knows to skip over it. Otherwise, the processor could warn about a missing attribute reference or perform an unexpected replacement. AsciiDoc provides several ways to escape an attribute reference."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "You can escape an attribute reference by prefixing it with a backslash. When the processor encounters this syntax, it will remove the backslash and pass through the remainder of what looks to be an attribute reference as written."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Example 3"
                      }
                    ],
                    "kind": "xref",
                    "target": "#ex-backslash-escape"
                  },
                  {
                    "kind": "text",
                    "value": ", the attribute reference is escaped using a backslash."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": "ex-backslash-escape",
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In the path /items/\\{id}, id is a path parameter."
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "An attribute reference escaped using a backslash"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In the output of "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Example 3"
                      }
                    ],
                    "kind": "xref",
                    "target": "#ex-backslash-escape"
                  },
                  {
                    "kind": "text",
                    "value": ", we can see that the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "{id}"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " expression in the path is preserved."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "blocks": [
                  {
                    "context": "paragraph",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "In the path /items/{id}, id is a path parameter."
                      }
                    ],
                    "roles": [],
                    "title": null
                  }
                ],
                "context": "example",
                "id": null,
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Keep in mind that the backslash will only be recognized if the text between the curly braces is a valid attribute name. If the syntax that follows the backslash does not match an attribute reference, the backslash will not be removed during processing."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "_prefix_with_a_backslash",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Prefix with a backslash"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "You can also escape an attribute reference by enclosing it in an inline passthrough. In this case, the processor uses the normal substitution rules for the passthrough type you have chosen."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Example 4"
                      }
                    ],
                    "kind": "xref",
                    "target": "#ex-passthrough-escape"
                  },
                  {
                    "kind": "text",
                    "value": ", the attribute reference is escaped by enclosing it in an inline passthrough."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": "ex-passthrough-escape",
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In the path +/items/{id}+, id is a path parameter."
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "An attribute reference escaped by enclosing it in an inline passthrough"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In the output of "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Example 4"
                      }
                    ],
                    "kind": "xref",
                    "target": "#ex-passthrough-escape"
                  },
                  {
                    "kind": "text",
                    "value": ", we can see that the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "{id}"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " expression in the path is preserved."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "blocks": [
                  {
                    "context": "paragraph",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "In the path /items/{id}, id is a path parameter."
                      }
                    ],
                    "roles": [],
                    "title": null
                  }
                ],
                "context": "example",
                "id": null,
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "When using an inline passthrough, you don’t have to worry whether the curly braces form an attribute reference or not. All the text between the passthrough enclosure will get passed through to the output."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "_enclose_in_a_passthrough",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Enclose in a passthrough"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Attribute references are replaced by the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "attributes substitution"
                      }
                    ],
                    "kind": "xref",
                    "target": "subs:attributes.html"
                  },
                  {
                    "kind": "text",
                    "value": ". Therefore, wherever you can control substitutions, you can prevent attribute references from being replaced. This includes the inline pass macro as well as the subs attribute on a block. See "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "using passthroughs to prevent substitutions"
                      }
                    ],
                    "kind": "xref",
                    "target": "subs:prevent.html#passthroughs"
                  },
                  {
                    "kind": "text",
                    "value": " for more details."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "_alternative_escape_mechanisms",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Alternative escape mechanisms"
              }
            ]
          }
        ],
        "context": "section",
        "id": "_escape_an_attribute_reference",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Escape an attribute reference"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Reference Document Attributes"
      }
    ]
  }
