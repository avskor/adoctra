                "value": " key is set in the component descriptor. When a component only has prerelease versions, then the value of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "latest_version_segment"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is used instead. This behavior may change in the future."
              }
            ],
            "roles": [],
            "title": null,
            "type": "warning"
          }
        ],
