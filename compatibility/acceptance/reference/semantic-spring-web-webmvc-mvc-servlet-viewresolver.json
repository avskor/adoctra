    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "See equivalent in the Reactive stack"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webflux/dispatcher-handler.html#webflux-viewresolution"
                  }
                ],
                "kind": "span",
                "roles": [
                  "small"
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Spring MVC defines the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ViewResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "View"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " interfaces that let you render models in a browser without tying you to a specific view technology. "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ViewResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " provides a mapping between view names and actual views. "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "View"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " addresses the preparation of data before handing over to a specific view technology."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following table provides more details on the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ViewResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " hierarchy:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "autowidth": false,
            "body": [
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "AbstractCachingViewResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "Subclasses of "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "AbstractCachingViewResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " cache view instances that they resolve. Caching improves performance of certain view technologies. You can turn off the cache by setting the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "cache"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " property to "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "false"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": ". Furthermore, if you must refresh a certain view at runtime (for example, when a FreeMarker template is modified), you can use the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "removeFromCache(String viewName, Locale loc)"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " method."
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ],
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "UrlBasedViewResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "Simple implementation of the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "ViewResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " interface that effects the direct resolution of logical view names to URLs without an explicit mapping definition. This is appropriate if your logical names match the names of your view resources in a straightforward manner, without the need for arbitrary mappings."
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ],
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "InternalResourceViewResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "Convenient subclass of "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "UrlBasedViewResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " that supports "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "InternalResourceView"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " (in effect, Servlets and JSPs) and subclasses such as "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "JstlView"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": ". You can specify the view class for all views generated by this resolver by using "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "setViewClass(..)"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": ". See the "
                      },
                      {
                        "inlines": [
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "UrlBasedViewResolver"
                              }
                            ],
                            "kind": "monospace",
                            "roles": []
                          }
                        ],
                        "kind": "link",
                        "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/web/reactive/result/view/UrlBasedViewResolver.html"
                      },
                      {
                        "kind": "text",
                        "value": " javadoc for details."
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ],
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "FreeMarkerViewResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "Convenient subclass of "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "UrlBasedViewResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " that supports "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "FreeMarkerView"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " and custom subclasses of them."
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ],
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "ContentNegotiatingViewResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "Implementation of the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "ViewResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " interface that resolves a view based on the request file name or "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Accept"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " header. See "
                      },
                      {
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Content Negotiation"
                          }
                        ],
                        "kind": "xref",
                        "target": "web/webmvc/mvc-servlet/viewresolver.html#mvc-multiple-representations"
                      },
                      {
                        "kind": "text",
                        "value": "."
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ],
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "BeanNameViewResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "Implementation of the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "ViewResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " interface that interprets a view name as a bean name in the current application context. This is a very flexible variant which allows for mixing and matching different view types based on distinct view names. Each such "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "View"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " can be defined as a bean, for example, in XML or in configuration classes."
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ]
            ],
            "caption": [
              {
                "kind": "text",
                "value": "Table 1. "
              }
            ],
            "columns": [
              {
                "autowidth": false,
                "halign": "left",
                "style": null,
                "valign": "top",
                "width": "50"
              },
              {
                "autowidth": false,
                "halign": "left",
                "style": null,
                "valign": "top",
                "width": "50"
              }
            ],
            "context": "table",
            "explicit_width": false,
            "float": null,
            "foot": [],
            "frame": "all",
            "grid": "all",
            "head": [
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "ViewResolver"
                    }
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Description"
                    }
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ]
            ],
            "id": "mvc-view-resolvers-tbl",
            "options": [],
            "roles": [],
            "stripes": "odd",
            "title": [
              {
                "kind": "text",
                "value": "ViewResolver implementations"
              }
            ],
            "width": 100
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "See equivalent in the Reactive stack"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webflux/dispatcher-handler.html#webflux-viewresolution-handling"
                  }
                ],
                "kind": "span",
                "roles": [
                  "small"
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can chain view resolvers by declaring more than one resolver bean and, if necessary, by setting the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "order"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " property to specify ordering. Remember, the higher the order property, the later the view resolver is positioned in the chain."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The contract of a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ViewResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " specifies that it can return null to indicate that the view could not be found. However, in the case of JSPs and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "InternalResourceViewResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", the only way to figure out if a JSP exists is to perform a dispatch through "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "RequestDispatcher"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Therefore, you must always configure an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "InternalResourceViewResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to be last in the overall order of view resolvers."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Configuring view resolution is as simple as adding "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ViewResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " beans to your Spring configuration. The "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MVC Config"
                  }
                ],
                "kind": "xref",
                "target": "web/webmvc/mvc-config.html"
              },
              {
                "kind": "text",
                "value": " provides a dedicated configuration API for "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "View Resolvers"
                  }
                ],
                "kind": "xref",
                "target": "web/webmvc/mvc-config/view-resolvers.html"
              },
              {
                "kind": "text",
                "value": " and for adding logic-less "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "View Controllers"
                  }
                ],
                "kind": "xref",
                "target": "web/webmvc/mvc-config/view-controller.html"
              },
              {
                "kind": "text",
                "value": " which are useful for HTML template rendering without controller logic."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "mvc-viewresolver-handling",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Handling"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "See equivalent in the Reactive stack"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webflux/dispatcher-handler.html#webflux-redirecting-redirect-prefix"
                  }
                ],
                "kind": "span",
                "roles": [
                  "small"
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The special "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "redirect:"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " prefix in a view name lets you perform a redirect. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "UrlBasedViewResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (and its subclasses) recognize this as an instruction that a redirect is needed. The rest of the view name is the redirect URL."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The net effect is the same as if the controller had returned a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "RedirectView"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", but now the controller itself can operate in terms of logical view names. A logical view name (such as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "redirect:/myapp/some/resource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") redirects relative to the current Servlet context, while a name such as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "redirect:https://myhost.com/some/arbitrary/path"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " redirects to an absolute URL."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "mvc-redirecting-redirect-prefix",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Redirecting"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can also use a special "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "forward:"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " prefix for view names that are ultimately resolved by "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "UrlBasedViewResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and subclasses. This creates an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "InternalResourceView"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", which does a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "RequestDispatcher.forward()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Therefore, this prefix is not useful with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "InternalResourceViewResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "InternalResourceView"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (for JSPs), but it can be helpful if you use another view technology but still want to force a forward of a resource to be handled by the Servlet/JSP engine. Note that you may also chain multiple view resolvers, instead."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "mvc-redirecting-forward-prefix",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Forwarding"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "See equivalent in the Reactive stack"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webflux/dispatcher-handler.html#webflux-multiple-representations"
                  }
                ],
                "kind": "span",
                "roles": [
                  "small"
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "ContentNegotiatingViewResolver"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ],
                "kind": "link",
                "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/web/servlet/view/ContentNegotiatingViewResolver.html"
              },
              {
                "kind": "text",
                "value": " does not resolve views itself but rather delegates to other view resolvers and selects the view that resembles the representation requested by the client. The representation can be determined from the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Accept"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " header or from a query parameter (for example, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "\"/path?format=pdf\""
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ContentNegotiatingViewResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " selects an appropriate "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "View"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to handle the request by comparing the request media types with the media type (also known as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Content-Type"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") supported by the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "View"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " associated with each of its "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ViewResolvers"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The first "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "View"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in the list that has a compatible "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Content-Type"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " returns the representation to the client. If a compatible view cannot be supplied by the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ViewResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " chain, the list of views specified through the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DefaultViews"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " property is consulted. This latter option is appropriate for singleton "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Views"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " that can render an appropriate representation of the current resource regardless of the logical view name. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Accept"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " header can include wildcards (for example "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "text/*"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), in which case a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "View"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " whose "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Content-Type"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "text/xml"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is a compatible match."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "View Resolvers"
                  }
                ],
                "kind": "xref",
                "target": "web/webmvc/mvc-config/view-resolvers.html"
              },
              {
                "kind": "text",
                "value": " under "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MVC Config"
                  }
                ],
                "kind": "xref",
                "target": "web/webmvc/mvc-config.html"
              },
              {
                "kind": "text",
                "value": " for configuration details."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "mvc-multiple-representations",
        "level": 1,
        "roles": [],
