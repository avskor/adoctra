                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "cols"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute and assign it a list of comma-separated column specifiers using integers."
              }
            ],
            "roles": [],
            "title": null
          },
          {
