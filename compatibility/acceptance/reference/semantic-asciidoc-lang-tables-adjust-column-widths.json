            "inlines": [
              {
                "kind": "text",
                "value": "The width of a column is assigned by its "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "column specifier"
                  }
                ],
                "kind": "xref",
                "target": "add-columns.html#col-specifier"
              },
              {
                "kind": "text",
                "value": ". The value of a column’s width is either an integer or a percentage. The default column width is "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "1"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The integer or percentage represents the width of the column in proportion to the other columns within the total width of the table. The total width of a table is backend dependent. When using the HTML5 backend with the default Asciidoctor stylesheet, tables stretch the width of the page body unless the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "table width attribute"
                  }
                ],
                "kind": "xref",
                "target": "width.html"
              },
              {
                "kind": "text",
                "value": " is explicitly set."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
