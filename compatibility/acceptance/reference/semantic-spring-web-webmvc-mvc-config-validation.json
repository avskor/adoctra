      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "By default, if "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Bean Validation"
              }
            ],
            "kind": "xref",
            "target": "core/validation/beanvalidation.html#validation-beanvalidation-overview"
          },
          {
            "kind": "text",
            "value": " is present on the classpath (for example, Hibernate Validator), the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "LocalValidatorFactoryBean"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is registered as a global "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Validator"
              }
            ],
            "kind": "xref",
            "target": "core/validation/validator.html"
          },
          {
            "kind": "text",
            "value": " for use with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Valid"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Validated"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " on controller method arguments."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can customize the global "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Validator"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " instance, as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./WebConfiguration[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Note that you can also register "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Validator"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " implementations locally, as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./MyController[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If you need to have a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
