      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Built-in and custom attributes can be "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
