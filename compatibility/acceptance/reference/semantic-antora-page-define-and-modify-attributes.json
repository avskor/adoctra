                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If you don’t want to explicitly assign a value to the attribute, press "
                  },
                  {
                    "keys": [
                      [
                        {
                          "kind": "text",
                          "value": "Enter"
                        }
