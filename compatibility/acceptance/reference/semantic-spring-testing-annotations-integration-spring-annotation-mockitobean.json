            ],
            "kind": "xref",
            "target": "testing/testcontext-framework/bean-overriding.html#testcontext-bean-overriding-custom"
          },
          {
            "kind": "text",
            "value": ". If no existing bean matches, a new bean is created on the fly. As mentioned previously, you can switch to the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "REPLACE"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " strategy by setting the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "enforceOverride"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " attribute to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "true"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@MockitoSpyBean"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation uses the "
          },
          {
            "id": null,
