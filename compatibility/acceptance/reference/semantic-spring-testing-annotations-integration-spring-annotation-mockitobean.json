                "value": "@MockitoSpyBean"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " are used on fields in test classes to override beans in the test’s "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " with a Mockito "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "mock"
              }
            ],
            "kind": "emphasis",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "spy"
              }
            ],
            "kind": "emphasis",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", respectively. In the latter case, an early instance of the original bean is captured and wrapped by the spy."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "By default, the annotated field’s type is used to search for candidate beans to override. If multiple candidates match, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Qualifier"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " can be provided to narrow the candidate to override. Alternatively, a candidate whose bean name matches the name of the field will match."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "When using "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@MockitoBean"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", a new bean will be created if a corresponding bean does not exist. However, if you would like for the test to fail when a corresponding bean does not exist, you can set the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "enforceOverride"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " attribute to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "true"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " – for example, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@MockitoBean(enforceOverride = true)"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "To use a by-name override rather than a by-type override, specify the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "name"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " attribute of the annotation."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Qualifiers, including the name of the field, are used to determine if a separate "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " needs to be created. If you are using this feature to mock or spy the same bean in several tests, make sure to name the field consistently to avoid creating unnecessary contexts."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "admonition",
        "id": null,
        "roles": [],
        "title": null,
        "type": "warning"
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Each annotation also defines Mockito-specific attributes to fine-tune the mocking details."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "By default, the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@MockitoBean"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation uses the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "REPLACE_OR_CREATE"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "strategy for test bean overriding"
