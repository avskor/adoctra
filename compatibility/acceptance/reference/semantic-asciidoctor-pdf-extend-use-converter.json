        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To use an extended converter, require it by passing the path to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-r"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " flag when calling the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor-pdf"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " command:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor-pdf -r ./extended-pdf-converter.rb doc.adoc"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The converter will self-register with the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " backend and thus get used as the Asciidoctor PDF converter."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you’re using Asciidoctor PDF via the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctorj"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " command provided by AsciidoctorJ, you’ll need to first require the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor-pdf"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " gem. This step is necessary since the extended converter assumes that Asciidoctor PDF has already been required by the time it’s required itself."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctorj -b pdf -r asciidoctor-pdf -r ./extended-pdf-converter.rb doc.adoc"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "That’s all there is to it!"
              }
            ],
            "roles": [],
            "title": null
          }
        ],
