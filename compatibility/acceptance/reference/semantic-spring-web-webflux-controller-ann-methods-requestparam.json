      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The Servlet API “request parameter” concept conflates query parameters, form data, and multiparts into one. However, in WebFlux, each is accessed individually through "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ServerWebExchange"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". While "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestParam"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " binds to query parameters only, you can use data binding to apply query parameters, form data, and multiparts to a "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "command object"
              }
            ],
            "kind": "xref",
            "target": "web/webflux/controller/ann-methods/modelattrib-method-args.html"
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null,
        "type": "tip"
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Method parameters that use the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestParam"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation are required by default, but you can specify that a method parameter is optional by setting the required flag of a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestParam"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "false"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or by declaring the argument with a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "java.util.Optional"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " wrapper."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Type conversion is applied automatically if the target method parameter type is not "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "String"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". See "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Type Conversion"
              }
            ],
            "kind": "xref",
            "target": "web/webflux/controller/ann-methods/typeconversion.html"
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "When a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestParam"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation is declared on a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Map<String, String>"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MultiValueMap<String, String>"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " argument, the map is populated with all query parameters."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Note that use of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestParam"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is optional — for example, to set its attributes. By default, any argument that is a simple value type (as determined by "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "BeanUtils#isSimpleProperty"
              }
            ],
            "kind": "link",
            "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/beans/BeanUtils.html#isSimpleProperty-java.lang.Class-"
          },
          {
            "kind": "text",
            "value": ") and is not resolved by any other argument resolver is treated as if it were annotated with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestParam"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      }
    ],
    "outline": null,
