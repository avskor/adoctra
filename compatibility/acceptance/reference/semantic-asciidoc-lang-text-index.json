{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Just as we emphasize certain words and phrases when we speak, we emphasize words and phrases in text using formatting and punctuation. AsciiDoc provides an assortment of formatting marks for applying visual emphasis and typographic punctuation to your document. You can build on these basic formatting marks using built-in and user-defined roles. This page covers the formatting marks that AsciiDoc provides and the rules for applying and customizing them."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "A "
                  },
                  {
                    "id": "def-format-mark",
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "formatting mark"
                      }
                    ],
                    "kind": "strong",
                    "roles": [
                      "term"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": " is a symbolic character, such as "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "*"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "_"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", or "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "~"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", that indicates the inline style you want the AsciiDoc converter to apply to the text. Formatting marks come in pairs."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "A "
                  },
                  {
                    "id": "def-format-pair",
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "formatting pair"
                      }
                    ],
                    "kind": "strong",
                    "roles": [
                      "term"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": " consists of an identical opening mark and closing mark that encloses the text you want to style. The formatted text (i.e., the text enclosed by a formatting pair) can span multiple, contiguous lines."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The "
                  },
                  {
                    "id": "def-open-mark",
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "opening mark"
                      }
                    ],
                    "kind": "strong",
                    "roles": [
                      "term"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": " specifies where you want the style to start. The "
                  },
                  {
                    "id": "def-close-mark",
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "closing mark"
                      }
                    ],
                    "kind": "strong",
                    "roles": [
                      "term"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": " specifies where you want the style to end."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Formatting pairs can be nested, but they cannot be overlapped. If the pairs are overlapped, the behavior is unspecified and the AsciiDoc processor may produce malformed output."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "A formatting pair is defined as either constrained or unconstrained, depending on where it’s allowed to be applied. An unconstrained pair can be applied anywhere, whereas the application of a constrained pair is more limited."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "_formatting_marks_and_pairs",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Formatting marks and pairs"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "When a space-like character directly precedes the text to format, and a space-like character or punctuation mark ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": ","
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": ";"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "\""
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "."
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "?"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", or "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "!"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ") directly follows the text, and the text does not start or end with a space-like character, a "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "constrained formatting pair"
                      }
                    ],
                    "kind": "strong",
                    "roles": [
                      "term"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": " can be used. A constrained pair uses a single opening mark and a single closing mark to enclose the text to be styled (e.g., "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "*strong*"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ")."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "For example, you use this form to format a word that stands alone,"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "That is *strong* stuff!"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "to format a sequence of words,"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "That is *really strong* stuff!"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "or to format a word adjacent to punctuation, like an exclamation mark."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "This stuff is *strong*!"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "As you can see, the constrained pair offers a more succinct markup at the tradeoff of having more limited (constrained) use. However, it should suffice in most cases, so the abbreviated markup is a benefit. You can think of a constrained pair as being a weaker markup than an unconstrained pair."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "constrained",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Constrained formatting pair"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "An "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "unconstrained formatting pair"
                      }
                    ],
                    "kind": "strong",
                    "roles": [
                      "term"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": " can be used anywhere in the text. When the conditions are not met for a constrained formatting pair, the situation calls for an unconstrained formatting pair. An unconstrained pair consists of a double opening mark and a double closing mark that encloses the text to be styled (e.g., "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Sara**h**"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ")."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "For example, you’d use an unconstrained pair to format one or more letters in a word."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The man page, short for **man**ual page, is a form of software documentation."
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The unconstrained pair provides a more brute force approach to formatting at the tradeoff of being more verbose. You’ll typically switch to an unconstrained pair when a constrained pair doesn’t do the trick. See "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "When should I use an unconstrained pair?"
                      }
                    ],
                    "kind": "xref",
                    "target": "troubleshoot-unconstrained-formatting.html#use-unconstrained"
                  },
                  {
                    "kind": "text",
                    "value": " for more examples of when to use an unconstrained pair."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "unconstrained",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Unconstrained formatting pair"
              }
            ]
          }
        ],
        "context": "section",
        "id": "_formatting_terms_and_concepts",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Formatting terms and concepts"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "AsciiDoc provides six inline text styles and one punctuation style that are applied solely with formatting marks."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Text that is bold will stand out against the regular, surrounding text due to the application of a thicker and/or darker font. Bold is useful when the text needs to catch the attention of a person visually scanning a page. The formatting mark for bold is an asterisk ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "*"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ")."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Bold"
                        }
                      ],
                      "kind": "xref",
                      "target": "bold.html"
                    },
                    {
                      "kind": "text",
                      "value": " (type: strong)"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Text is often italicized in order to stress a word or phrase, quote a speaker, or introduce a term. Italic type slants slightly to the right, and depending on the font, may have cursive swashes and flourishes. The formatting mark for italic is an underscore ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "_"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ")."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Italic"
                        }
                      ],
                      "kind": "xref",
                      "target": "italic.html"
                    },
                    {
                      "kind": "text",
                      "value": " (type: emphasis)"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Technical content often requires text to be styled in a way that indicates a command or source code. Such text is usually emphasized using a fixed-width (i.e., monospace) font. The formatting mark for monospace is a backtick ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "`"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ")."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Monospace"
                        }
                      ],
                      "kind": "xref",
                      "target": "monospace.html"
                    },
                    {
                      "kind": "text",
                      "value": " (type: monospaced)"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Another way to draw attention to text is to highlight it. This semantic style is used for reference or notation purposes, or to mark the importance of a key subject or point. The formatting mark for highlight is a hash ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "#"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ")."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Highlight"
                        }
                      ],
                      "kind": "xref",
                      "target": "highlight.html"
                    },
                    {
                      "kind": "text",
                      "value": " (type: mark)"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Adding a role to a span of text that uses the highlight formatting mark ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "#"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ") converts to generic phrase that can be styled. AsciiDoc defines several built-in roles that you can use to style text, and the style/theming system of the converter can allow you to define styles for a custom role."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Styled phrase"
                        }
                      ],
                      "kind": "xref",
                      "target": "custom-inline-styles.html"
                    },
                    {
                      "kind": "text",
                      "value": " (type: unquoted)"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Subscript and superscript text is common in mathematical expressions and chemical formulas. The formatting mark for subscript is a tilde ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "~"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": "). The formatting mark for superscript is a caret ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "^"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ")."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Subscript and superscript"
                        }
                      ],
                      "kind": "xref",
                      "target": "subscript-and-superscript.html"
                    },
                    {
                      "kind": "text",
                      "value": " (type: subscript/superscript)"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "By default, the AsciiDoc processor outputs straight quotation marks and apostrophes. They can be changed to curved by adding backticks ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "`"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ") as a formatting hint."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Curved quotation marks and apostrophes"
                        }
                      ],
                      "kind": "xref",
                      "target": "quotation-marks-and-apostrophes.html"
                    },
                    {
                      "kind": "text",
                      "value": " (type: double/single)"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_inline_text_and_punctuation_styles",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Inline text and punctuation styles"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the AsciiDoc processor encounters text enclosed by designated formatting marks, those marks are replaced by the start and end tags of the corresponding HTML or XML element, depending on your backend, during the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "quotes substitution step"
                  }
                ],
                "kind": "xref",
                "target": "subs:quotes.html"
              },
              {
                "kind": "text",
                "value": ". You can control when inline formatting is applied to inline text, macros, or blocks with the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "quotes substitution value"
                  }
                ],
                "kind": "xref",
                "target": "subs:quotes.html#quotes-value"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_quotes_substitution",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Quotes substitution"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Text Formatting and Punctuation"
      }
    ]
  }
}
