                "kind": "xref",
                "target": "ruby-packaging.html"
              },
              {
                "kind": "text",
                "value": " instead of the package manager."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Your Linux system may be configured to automatically update packages, in which case the latest Asciidoctor package will be installed as soon as it becomes available. No further action is required by you."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
