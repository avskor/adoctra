      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "On Debian and Debian-based distributions such as Ubuntu, use APT to install Asciidoctor. To install the package, open a terminal and type:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ sudo apt-get install -y asciidoctor"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the gem installed successfully, Asciidoctor’s "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "command line interface (CLI)"
                  }
                ],
                "kind": "xref",
                "target": "cli:index.html"
              },
              {
                "kind": "text",
                "value": " will be available on your PATH. To confirm that Asciidoctor is available, execute:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor --version"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You should see information about the Asciidoctor version and your Ruby environment printed in the terminal."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor 2.0.23 [https://asciidoctor.org]\nRuntime Environment (ruby 3.3.0 [x86_64-linux]) (lc:UTF-8 fs:UTF-8 in:- ex:UTF-8)"
              }
            ],
            "language": null,
            "roles": [
