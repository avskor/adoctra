            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Some Linux distributions may not have the latest stable version of Asciidoctor packaged immediately after a release of a new gem. If you need to upgrade to the latest version immediately, use "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "gem install"
                  }
