                  }
                ],
                "kind": "xref",
                "target": "advanced-topics/junit-platform-suite-engine.html"
              },
              {
                "kind": "text",
                "value": " for running a custom test suite using one or more test engines on the platform. First-class support for the JUnit Platform also exists in popular IDEs (see "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "IntelliJ IDEA"
                  }
