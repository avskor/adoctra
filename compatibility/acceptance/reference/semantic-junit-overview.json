                  }
                ],
                "kind": "xref",
                "target": "advanced-topics/launcher-api.html"
              },
              {
                "kind": "text",
                "value": " on the JVM. It also defines the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "TestEngine"
