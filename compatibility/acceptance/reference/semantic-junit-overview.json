                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " API for developing a testing framework that runs on the platform. Furthermore, the platform provides a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Console Launcher"
                  }
                ],
                "kind": "xref",
                "target": "running-tests/console-launcher.html"
              },
              {
                "kind": "text",
