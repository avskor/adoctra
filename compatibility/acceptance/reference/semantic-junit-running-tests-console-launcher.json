              {
                "kind": "text",
                "value": "Discovering tests"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "admonition",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "On successful runs, the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "ConsoleLauncher"
                          }
                        ],
                        "kind": "xref",
                        "target": "attachment$api/org.junit.platform.console/org/junit/platform/console/ConsoleLauncher.html"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " exits with a status code of "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "0"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ". All non-zero codes indicate an error of some sort. For example, status code "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "1"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " is returned if any containers or tests failed. If no tests are discovered and the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "--fail-if-no-tests"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " command-line option is supplied, the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "ConsoleLauncher"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " exits with a status code of "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "2"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ". Unexpected or invalid user input yields a status code of "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "3"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ". An exit code of "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "-1"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " indicates an unspecified error condition."
                  }
                ],
                "roles": [],
