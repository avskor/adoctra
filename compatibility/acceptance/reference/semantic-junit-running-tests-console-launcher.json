        "context": "section",
        "id": "options",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Subcommands and Options"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "On some platforms you may run into system limitations on the length of a command line when creating a command line with lots of options or with long arguments."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ConsoleLauncher"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " supports "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "argument files"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", also known as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@-files"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Argument files are files that themselves contain arguments to be passed to the command. When the underlying "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "picocli"
                  }
                ],
                "kind": "link",
                "target": "https://github.com/remkop/picocli"
              },
              {
                "kind": "text",
                "value": " command line parser encounters an argument beginning with the character "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", it expands the contents of that file into the argument list."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The arguments within a file can be separated by spaces or newlines. If an argument contains embedded whitespace, the whole argument should be wrapped in double or single quotes — for example, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "\"-f=My Files/Stuff.java\""
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the argument file does not exist or cannot be read, the argument will be treated literally and will not be removed. This will likely result in an \"unmatched argument\" error message. You can troubleshoot such errors by executing the command with the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "picocli.trace"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " system property set to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DEBUG"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Multiple "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@-files"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " may be specified on the command line. The specified path may be relative to the current directory or absolute."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can pass a real parameter with an initial "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " character by escaping it with an additional "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " symbol. For example, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@@somearg"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " will become "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@somearg"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and will not be subject to expansion."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "argument-files",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Argument Files (@-files)"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can redirect the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "System.out"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (stdout) and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "System.err"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (stderr) output streams to files using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--redirect-stdout"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--redirect-stderr"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " options:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ java -jar junit-platform-console-standalone-{version}.jar <OPTIONS> \\\n  --redirect-stdout=stdout.txt \\\n  --redirect-stderr=stderr.txt"
              }
            ],
            "language": "console",
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "--redirect-stdout"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " and "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
