    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "ConsoleLauncher"
                      }
                    ],
                    "kind": "xref",
                    "target": "attachment$api/org.junit.platform.console/org/junit/platform/console/ConsoleLauncher.html"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is a command-line Java application that lets you launch the JUnit Platform from the console. For example, it can be used to run JUnit Vintage and JUnit Jupiter tests and print test execution results to the console."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An executable "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Fat JAR"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "junit-platform-console-standalone-{version}.jar"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") that contains the contents of all of its dependencies is published in the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Maven Central"
                  }
                ],
                "kind": "link",
                "target": "https://central.sonatype.com/"
              },
              {
                "kind": "text",
                "value": " repository under the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "junit-platform-console-standalone"
                  }
                ],
                "kind": "link",
                "target": "https://repo1.maven.org/maven2/org/junit/platform/junit-platform-console-standalone"
              },
              {
                "kind": "text",
                "value": " directory. It contains the contents of the following artifacts:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "partial$console-launcher-standalone-shadowed-artifacts.adoc"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "role": "bare include"
                },
                "target": "partial$console-launcher-standalone-shadowed-artifacts.adoc"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Since the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "junit-platform-console-standalone"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " JAR contains the contents of all of its dependencies, its Maven POM does not declare any dependencies."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Furthermore, it is not very likely that you would need to include a dependency on the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "junit-platform-console-standalone"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " artifact in your project’s Maven POM or Gradle build script. On the contrary, the executable "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "junit-platform-console-standalone"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " JAR is typically invoked directly from the command line or a shell script without a build script."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If you need to declare dependencies in your build script on some of the artifacts contained in the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "junit-platform-console-standalone"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " artifact, you should declare dependencies only on the JUnit artifacts that are used in your project. To simplify dependency management of JUnit artifacts in your build, you may wish to use the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "junit-jupiter"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " aggregator artifact or "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "junit-bom"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ". See "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Dependency Metadata"
                      }
                    ],
                    "kind": "xref",
                    "target": "appendix.html#dependency-metadata"
                  },
                  {
                    "kind": "text",
                    "value": " for details."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "admonition",
            "id": null,
            "roles": [],
            "title": null,
            "type": "note"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "run"
                  }
                ],
                "kind": "link",
                "target": "https://docs.oracle.com/javase/tutorial/deployment/jar/run.html"
              },
              {
                "kind": "text",
                "value": " the standalone "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ConsoleLauncher"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " as shown below."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ java -jar junit-platform-console-standalone-{version}.jar execute <OPTIONS>\n\n├─ JUnit Vintage\n│  └─ example.JUnit4Tests\n│     └─ standardJUnit4Test ✔\n└─ JUnit Jupiter\n   ├─ StandardTests\n   │  ├─ succeedingTest() ✔\n   │  └─ skippedTest() ↷ for demonstration purposes\n   └─ A special test case\n      ├─ Custom test name containing spaces ✔\n      ├─ ╯°□°)╯ ✔\n      └─ 😱 ✔\n\nTest run finished after 64 ms\n[         5 containers found      ]\n[         0 containers skipped    ]\n[         5 containers started    ]\n[         0 containers aborted    ]\n[         5 containers successful ]\n[         0 containers failed     ]\n[         6 tests found           ]\n[         1 tests skipped         ]\n[         5 tests started         ]\n[         0 tests aborted         ]\n[         5 tests successful      ]\n[         0 tests failed          ]"
              }
            ],
            "language": "console",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can also run the standalone "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ConsoleLauncher"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " as shown below (for example, to include all jars in a directory):"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ java -cp classes:testlib/* org.junit.platform.console.ConsoleLauncher <OPTIONS>"
              }
            ],
            "language": "console",
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
