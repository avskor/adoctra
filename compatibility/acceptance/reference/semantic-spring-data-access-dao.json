                              "kind": "callout",
                              "number": "1",
                              "src": "",
                              "xml": false
                            },
                            {
                              "kind": "text",
                              "value": "\npublic class SomeMovieFinder implements MovieFinder {\n\t// ...\n}"
                            }
                          ],
