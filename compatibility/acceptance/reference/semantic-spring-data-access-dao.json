          }
        ],
        "context": "section",
        "id": "dao-exceptions",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Consistent Exception Hierarchy"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The best way to guarantee that your Data Access Objects (DAOs) or repositories provide exception translation is to use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Repository"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotation. This annotation also lets the component scanning support find and configure your DAOs and repositories without having to provide XML configuration entries for them. The following example shows how to use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Repository"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotation:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
