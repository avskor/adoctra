              },
              {
                "kind": "text",
                "value": "). Its closing delimiter must also be four asterisks ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "****"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
