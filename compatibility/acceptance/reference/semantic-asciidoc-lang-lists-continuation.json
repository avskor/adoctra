                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "A list with complex content"
              }
            ]
          }
        ],
        "context": "section",
        "id": "drop-principal-text",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Drop the principal text"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Instead of attaching a block to the current list item, you may need to end that list and attach a block to its ancestor instead. There are two ways to express this composition in the AsciiDoc syntax. You can either enclose the child list in an open block, or you can use insert empty lines above the list continuation to first escape from the nesting. Let’s look at enclosing the child list in an open block first, since that is the preferred method."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If you plan to attach blocks to a list item as a sibling of a nested list, the most robust way of creating that structure is to enclose the nested list in an open block. That way, it’s clear where the nested list ends and the current list item continues."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Here’s an example of a list item with a nested list followed by an attached paragraph. The open block makes the boundaries of the nested list clear."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "* grandparent list item\n+\n--\n** parent list item\n*** child list item\n--\n+\nparagraph attached to grandparent list item"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Here’s how the source is rendered:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "blocks": [
                  {
                    "context": "ulist",
                    "id": null,
                    "items": [
                      {
