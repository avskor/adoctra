                "title": [
                  {
                    "kind": "text",
                    "value": "A block attached to the parent list item"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Each empty line that precedes the list continuation signals a move up one level of nesting. Here’s an example that shows how to attach a paragraph to a grandparent list item using two leading empty lines:"
                  }
                ],
                "roles": [],
                "title": null
