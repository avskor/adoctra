                    "kind": "text",
                    "value": "SECURE"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". You can change the safe mode using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ":safe"
                  }
                ],
                "kind": "monospace",
