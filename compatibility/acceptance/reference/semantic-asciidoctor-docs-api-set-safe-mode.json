            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The safe mode can be controlled from the API using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ":safe"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ":safe"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option is accepted by all "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "entrypoint methods"
                  }
                ],
                "kind": "xref",
                "target": "index.html#entrypoints"
              },
              {
                "kind": "text",
                "value": " (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Asciidoctor#convert_file"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
