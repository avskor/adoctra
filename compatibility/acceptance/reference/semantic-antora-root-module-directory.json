                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " module directory is present, it must contain at least one "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "family directory"
                  }
                ],
                "kind": "xref",
                "target": "family-directories.html"
              },
              {
                "kind": "text",
                "value": " with at least one source file. It can also contain an optional navigation file."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The source files stored in a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ROOT"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " directory become part of a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ROOT module"
                  }
                ],
                "kind": "xref",
                "target": "#root-module"
              },
              {
                "kind": "text",
                "value": " in a component version. We recommended that you create a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ROOT"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " module directory because Antora applies special preset behavior to the publishable resources in a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ROOT module"
                  }
                ],
                "kind": "xref",
                "target": "#root-module"
              },
              {
                "kind": "text",
                "value": ". For example, the source file "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "index.adoc"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " in the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pages"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " directory becomes the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "default start page"
                  }
                ],
                "kind": "xref",
                "target": "component-start-page.html#default-start-page"
              },
              {
                "kind": "text",
                "value": " for a component version. Those familiar with the terminology of HTML web hosting will recognize this as the index page for a component version."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Small documentation projects may never need more than a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ROOT"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " module directory. However, as your project grows, you can easily add more module directories and gradually reorganize your source files. While the extra structure seems like overkill now, in the long run, you’ll be glad you gave your content the space to grow."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If the content source root (i.e., the location of antora.yml) does not have a "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "modules"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": [
                      "path"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": " directory, then the content source root is assumed to be the ROOT module. In other words, you can put the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "pages"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": [
                      "path"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": " directory and other family directories directly adjacent to the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "antora.yml"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": [
                      "path"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": " file."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "📒 repository\n  📂 docs "
                  },
                  {
                    "guard": null,
                    "icons": null,
                    "id": "CO2-1",
                    "kind": "callout",
                    "number": "1",
                    "src": "",
                    "xml": false
                  },
                  {
                    "kind": "text",
                    "value": "\n    📄 antora.yml\n    📂 pages\n      📄 index.adoc"
                  }
                ],
                "language": null,
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "This alternate layout is available per content source root (per origin in Antora lingo). In other words, the content source roots that make up a distributed component version may use different layouts for the ROOT module. It does not have to be uniform for each content source root for distributed component version."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If you later add the modules directory, then the files (e.g., pages) for the ROOT module must be moved to "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "modules/ROOT"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": [
                      "path"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "implicit-root-module",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Implicit ROOT module"
              }
            ]
          }
        ],
        "context": "section",
        "id": "root-dir",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "What’s a ROOT module directory?"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Source files that are stored in a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ROOT"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " directory become part of a module named "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ROOT"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "component version"
                  }
                ],
                "kind": "xref",
                "target": "component-version.html"
              },
              {
                "kind": "text",
                "value": ". A ROOT module’s pages become the top-level pages of a component version. In other words, unlike other modules, the name of the ROOT module does not get used in the generated site."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can think of the name “ROOT” as an alias for a blank module name (i.e., no module segment). Using this special value allows all modules to be siblings."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "It’s important to carefully consider what files you store in a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ROOT"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " module directory since there is a potential for them to conflict with files in the named module directories. Generally, the ROOT module doesn’t use topic folders for this reason."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "root-module",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "What’s a ROOT module?"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When you reference content that belongs to a ROOT module from another module or component version, you’ll specify the module name "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ROOT"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "resource IDs"
                  }
                ],
                "kind": "xref",
                "target": "page:resource-id.html"
              },
              {
                "kind": "text",
                "value": " for pages, attachments, images, examples, and partials. "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ROOT"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is always written in uppercase letters when it’s specified."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Since Antora considers the pages in a ROOT module to be top-level component version pages, the module name "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ROOT"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " isn’t displayed in the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "module segment of its page URLs"
                  }
                ],
                "kind": "xref",
                "target": "module-url-segment.html#root-module-urls"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "where-root-name-is-used",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Where’s the ROOT module name used?"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "ROOT Module Directory"
      }
    ]
  }
