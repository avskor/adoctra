              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " for details."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An extension context store is bound to its extension context lifecycle. When an extension context lifecycle ends it closes its associated store."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "All stored values that are instances of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "AutoCloseable"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " are notified by an invocation of their "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "close()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method in the inverse order they were added in (unless the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "junit.jupiter.extensions.store.close.autocloseable.enabled"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "configuration parameter"
                  }
                ],
                "kind": "xref",
                "target": "running-tests/configuration-parameters.html"
              },
              {
                "kind": "text",
                "value": " is set to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "false"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          },
