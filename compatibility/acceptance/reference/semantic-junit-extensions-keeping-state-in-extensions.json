                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "class HttpServerResource(\n    port: Int\n) : AutoCloseable {\n    val httpServer: HttpServer\n\n    init {\n        val loopbackAddress = InetAddress.getLoopbackAddress()\n        httpServer = HttpServer.create(InetSocketAddress(loopbackAddress, port), 0)\n    }\n\n    fun start() {\n        // Example handler\n        httpServer.createContext(\"/example\") { exchange ->\n            val body = \"This is a test\"\n            exchange.sendResponseHeaders(200, body.length.toLong())\n            exchange.responseBody.use { os ->\n                os.write(body.toByteArray(Charsets.UTF_8))\n            }\n        }\n        httpServer.executor = null\n        httpServer.start()\n    }\n\n    override fun close() {\n        httpServer.stop(0)\n    }\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
