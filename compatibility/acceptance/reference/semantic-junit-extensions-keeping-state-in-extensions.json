                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "class HttpServerResource implements AutoCloseable {\n\n\tprivate final HttpServer httpServer;\n\n\tHttpServerResource(int port) throws IOException {\n\t\tInetAddress loopbackAddress = InetAddress.getLoopbackAddress();\n\t\tthis.httpServer = HttpServer.create(new InetSocketAddress(loopbackAddress, port), 0);\n\t}\n\n\tHttpServer getHttpServer() {\n\t\treturn httpServer;\n\t}\n\n\tvoid start() {\n\t\t// Example handler\n\t\thttpServer.createContext(\"/example\", exchange -> {\n\t\t\tString body = \"This is a test\";\n\t\t\texchange.sendResponseHeaders(200, body.length());\n\t\t\ttry (OutputStream os = exchange.getResponseBody()) {\n\t\t\t\tos.write(body.getBytes(UTF_8));\n\t\t\t}\n\t\t});\n\t\thttpServer.setExecutor(null);\n\t\thttpServer.start();\n\t}\n\n\t@Override\n\tpublic void close() {\n\t\thttpServer.stop(0);\n\t}\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "context": "open",
