      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "As illustrated by the diagram above, stores are hierarchical in nature. When looking up a value, if no value is stored in the current "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ExtensionContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " for the supplied key, the stores of the context’s ancestors will be queried for a value with the same key in the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Namespace"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " used to create this store. The root "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ExtensionContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " represents the engine level so its "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Store"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " may be used to store or cache values that are used by multiple test classes or extension. The "
          },
          {
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "StoreScope"
                  }
                ],
                "kind": "xref",
                "target": "attachment$api/org.junit.jupiter.api/org/junit/jupiter/api/extension/ExtensionContext.StoreScope.html"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " enum allows to go beyond even that and access the stores on the level of the current "
          },
          {
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "LauncherExecutionRequest"
                  }
                ],
                "kind": "xref",
                "target": "attachment$api/org.junit.platform.launcher/org/junit/platform/launcher/LauncherExecutionRequest.html"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "LauncherSession"
                  }
                ],
                "kind": "xref",
                "target": "attachment$api/org.junit.platform.launcher/org/junit/platform/launcher/LauncherSession.html"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " which can be used to share data across test engines or inject data from a registered "
          },
          {
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "LauncherSessionListener"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "kind": "xref",
            "target": "advanced-topics/launcher-api.html#launcher-session-listeners-custom"
          },
          {
            "kind": "text",
            "value": ", respectively. Please consult the Javadoc of "
          },
          {
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ExtensionContext"
                  }
                ],
                "kind": "xref",
                "target": "attachment$api/org.junit.jupiter.api/org/junit/jupiter/api/extension/ExtensionContext.html"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Store"
                  }
                ],
                "kind": "xref",
                "target": "attachment$api/org.junit.jupiter.api/org/junit/jupiter/api/extension/ExtensionContext.Store.html"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
