        "inlines": [
          {
            "kind": "text",
            "value": "Usually, an extension is instantiated only once. So the question becomes relevant: How do you keep the state from one invocation of an extension to the next? The "
          },
          {
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ExtensionContext"
                  }
                ],
                "kind": "xref",
                "target": "attachment$api/org.junit.jupiter.api/org/junit/jupiter/api/extension/ExtensionContext.html"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " API provides a "
          },
          {
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Store"
                  }
                ],
                "kind": "xref",
                "target": "attachment$api/org.junit.jupiter.api/org/junit/jupiter/api/extension/ExtensionContext.Store.html"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " exactly for this purpose. Extensions may put values into a store for later retrieval."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "See the "
          },
          {
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TimingExtension"
                  }
                ],
                "kind": "xref",
                "target": "extensions/test-lifecycle-callbacks.html#timing-extension"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " for an example of using the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Store"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " with a method-level scope."
          }
        ],
        "roles": [],
        "title": null,
