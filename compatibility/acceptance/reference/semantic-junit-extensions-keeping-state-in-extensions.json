                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@ExtendWith(HttpServerExtension.class)\npublic class HttpServerDemo {\n\n\t@Test\n\tvoid httpCall(HttpServer server) throws Exception {\n\t\tString hostName = server.getAddress().getHostName();\n\t\tint port = server.getAddress().getPort();\n\t\tString rawUrl = \"http://%s:%d/example\".formatted(hostName, port);\n\t\tURL requestUrl = URI.create(rawUrl).toURL();\n\n\t\tString responseBody = sendRequest(requestUrl);\n\n\t\tassertEquals(\"This is a test\", responseBody);\n\t}\n\n\tprivate static String sendRequest(URL url) throws IOException {\n\t\tHttpURLConnection connection = (HttpURLConnection) url.openConnection();\n\t\tint contentLength = connection.getContentLength();\n\t\ttry (InputStream response = url.openStream()) {\n\t\t\tbyte[] content = new byte[contentLength];\n\t\t\tassertEquals(contentLength, response.read(content));\n\t\t\treturn new String(content, UTF_8);\n\t\t}\n\t}\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "context": "open",
                      "id": null,
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@ExtendWith(HttpServerExtension::class)\nclass HttpServerDemo {\n    @Test\n    fun httpCall(server: HttpServer) {\n        val address = server.address\n        val requestUrl = URI(\"http://${address.hostName}:${address.port}/example\").toURL()\n\n        val responseBody = sendRequest(requestUrl)\n\n        assertEquals(\"This is a test\", responseBody)\n    }\n\n    private fun sendRequest(url: URL): String {\n        val connection = url.openConnection() as HttpURLConnection\n        val contentLength = connection.contentLength\n        url.openStream().use { response ->\n            val content = ByteArray(contentLength)\n            assertEquals(contentLength, response.read(content))\n            return String(content, Charsets.UTF_8)\n        }\n    }\n}"
                            }
