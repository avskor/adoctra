    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The built-in simple message broker handles subscription requests from clients, stores them in memory, and broadcasts messages to connected clients that have matching destinations. The broker supports path-like destinations, including subscriptions to Ant-style destination patterns."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Applications can also use dot-separated (rather than slash-separated) destinations. See "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Dots as Separators"
              }
            ],
            "kind": "xref",
            "target": "web/websocket/stomp/destination-separator.html"
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null,
        "type": "note"
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If configured with a task scheduler, the simple broker supports "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "STOMP heartbeats"
              }
            ],
            "kind": "link",
            "target": "https://stomp.github.io/stomp-specification-1.2.html#Heart-beating"
          },
          {
            "kind": "text",
            "value": ". To configure a scheduler, you can declare your own "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "TaskScheduler"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " bean and set it through the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MessageBrokerRegistry"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". Alternatively, you can use the one that is automatically declared in the built-in WebSocket configuration, however, you’ll need "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Lazy"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " to avoid a cycle between the built-in WebSocket configuration and your "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebSocketMessageBrokerConfigurer"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". For example:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./WebSocketConfiguration[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Simple Broker"
      }
    ]
  }
