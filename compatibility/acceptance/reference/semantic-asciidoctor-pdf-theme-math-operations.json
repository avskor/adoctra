          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example of a math expression with fixed values."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "conum:\n  line-height: 4 / 3"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Operators must always be surrounded by a space on either side (e.g., 2 + 2, not 2+2)."
              }
            ],
            "roles": [],
            "title": null,
            "type": "important"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Variables may be used in place of numbers anywhere in the expression:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "base:\n  font-size: 12\n  font-size-large: $base-font-size * 1.25"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Values used in a math expression are automatically coerced to a float value before the operation. If the result of the expression is an integer, the value is coerced to an integer afterwards."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Numeric values less than 1 must have a 0 before the decimal point (e.g., 0.85)."
              }
            ],
            "roles": [],
            "title": null,
            "type": "important"
          }
        ],
        "context": "section",
        "id": "expressions",
        "level": 1,
