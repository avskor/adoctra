          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The theme language also supports several functions for rounding the result of a math expression. The following functions may be used if they surround the whole value or expression for a key."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Rounds the number to the nearest half integer."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "round(…​)"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Rounds the number up to the next integer."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "floor(…​)"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Rounds the number down the previous integer."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "ceil(…​)"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You might use these functions in font size calculations so that you get more exact values."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "base:\n  font-size: 12.5\n  font-size-large: ceil($base-font-size * 1.25)"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
