            "inlines": [
              {
                "kind": "text",
                "value": "The UI files are published to a directory labeled with a single underscore, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "_"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " , located relative to the site’s "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "output directory"
                  }
                ],
                "kind": "xref",
                "target": "output-dir.html"
              },
              {
                "kind": "text",
                "value": ". For instance, when the site is published to the default site output directory ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "./build/site"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": "), and no UI "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "output_dir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is specified, the UI files are written to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "build/site/_"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
