            "kind": "text",
            "value": "Default UI output directory"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "output_dir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key allows you to specify an alternate directory where Antora should publish the UI files. The path is relative to the root of the published site."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ui:\n  bundle:\n    url: /home/user/projects/docs-ui/build/ui-bundle-with-themes.zip\n    start_path: dark\n  output_dir: _/dark"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Relative UI output path"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In this example, the site will be written to the default destination directory, therefore, the UI files will be published "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "build/site/_/dark"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Antora will automatically reconfigure all references to the UI files, regardless of what value you use. This is thanks in part to the use of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "{{uiRootPath}}"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " placeholder in the UI templates."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In the next example, the site’s output directory ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "dir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") is specified in addition to the UI output directory."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ui:\n  bundle:\n    url: /home/user/projects/docs-ui/build/ui-bundle-with-themes.zip\n    start_path: dark\n  output_dir: _/dark\noutput:\n  dir: ./public"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
