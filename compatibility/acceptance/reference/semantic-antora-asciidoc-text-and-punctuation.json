                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Quotation marks and apostrophes can be explicitly marked as straight or curved."
                    }
                  ]
                },
                "terms": [
                  [
                    {
