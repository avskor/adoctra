            "inlines": [
              {
                "kind": "text",
                "value": "AsciiDoc provides multiple ways to visually emphasize inline text (words, phrases, and characters)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Text that is bold will stand out against the regular, surrounding text due to the application of a thicker and/or darker font. Bold is useful when the text needs to catch the attention of a person visually scanning a page."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Bold"
                        }
                      ],
                      "kind": "xref",
                      "target": "bold.html"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Text is often italicized in order to stress a word or phrase, quote a speaker, or introduce a term. Italic type slants slightly to the right, and depending on the font, may have cursive swashes and flourishes."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Italic"
                        }
                      ],
                      "kind": "xref",
                      "target": "italic.html"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Technical content often requires text to be styled in a way that indicates a command or source code. Such text is usually emphasized using a fixed-width (i.e., monospace) font."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Monospace"
                        }
                      ],
                      "kind": "xref",
                      "target": "monospace.html"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Another way to draw attention to text is to highlight (or mark) it. This semantic style is used for reference or notation purposes, or to mark the importance of a key subject or point."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Highlight"
                        }
                      ],
                      "kind": "xref",
                      "target": "highlight.html"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
