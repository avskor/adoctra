      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To install "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pydebeziumai"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " with Chroma vector store support:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "pip install \"pydebeziumai[chroma,debezium]\""
              }
            ],
            "language": "bash",
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "from pydebeziumai import LiveContext\n\n# Initialize real-time CDC sync context\nrag = LiveContext(\n    debezium_config={\n        \"name\": \"mysql-connector\",\n        \"connector.class\": \"io.debezium.connector.mysql.MySqlConnector\",\n        \"database.hostname\": \"localhost\",\n        \"database.port\": \"3306\",\n        \"database.user\": \"debezium\",\n        \"database.password\": \"dbz\",\n        \"topic.prefix\": \"myserver\",\n        \"table.include.list\": \"inventory.products\",\n    },\n    vector_store=\"chroma\",\n    embedding_model=\"local\",  # sentence-transformers (offline)\n    id_strategy=\"table_pk\",\n)\n\n# Start real-time background sync loop\nrag.start()\n\n# Use as a standard LangChain retriever\nretriever = rag.as_retriever(search_kwargs={\"k\": 5})\ndocs = retriever.invoke(\"Find products under $100\")"
                  }
                ],
                "language": "python",
                "roles": [],
                "title": null
              }
            ],
