          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Real-time Change Data Capture (CDC) is essential for keeping generative AI applications, search indexes, and Retrieval-Augmented Generation (RAG) pipelines synchronized with transactional databases."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Debezium provides an official Python package, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pydebeziumai"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", designed to streamline real-time CDC event streaming from relational databases into vector stores and AI agent frameworks."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Unlike traditional Kafka-centric streaming pipelines that require deploying separate Kafka Connect clusters, Schema Registries, and consumer workers, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pydebeziumai"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " runs the Debezium embedded engine directly inside your Python application process using high-performance JVM bindings."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "PostgreSQL / MySQL ──► Embedded Debezium Engine (in-process) ──► PyDebeziumAI ──► Vector Store"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Every database "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "INSERT"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "UPDATE"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DELETE"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " transaction is captured from the source database binary log, converted into Python-native events, transformed into LangChain "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Document"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " objects, and immediately upserted or deleted from the target vector database in real time."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_overview_architecture",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Overview & Architecture"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "In-Process CDC Engine"
                      }
                    ],
                    "kind": "strong",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ": Runs the embedded Debezium engine directly within Python using JVM bindings, eliminating Kafka broker and Connect overhead for lightweight Python services."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "LangChain & LangGraph Native"
                      }
                    ],
                    "kind": "strong",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ": Maps CDC change events to standard "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "langchain_core.documents.Document"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " instances and provides retriever nodes for LangGraph agents."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Deterministic ID Strategies"
                      }
                    ],
                    "kind": "strong",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ": Generates idempotent, primary-key-based UUID document identifiers to ensure database updates and deletes map correctly to existing vector embeddings without duplicates."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Pluggable Vector DB Adapters"
                      }
                    ],
                    "kind": "strong",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ": Built-in adapters for Chroma, PGVector, and Milvus."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Pluggable Embedding Providers"
                      }
                    ],
                    "kind": "strong",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ": Compatible with any LangChain embedding model provider, including "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "OpenAIEmbeddings"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "HuggingFaceEmbeddings"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "OllamaEmbeddings"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "CohereEmbeddings"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", and "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "VertexAIEmbeddings"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Event Compaction"
                      }
                    ],
                    "kind": "strong",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ": Automatically compacts batches under high write loads to collapse redundant mutations to identical primary keys before flushing."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          }
