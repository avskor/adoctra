      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Spring WebFlux has built-in "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Validation"
              }
            ],
            "kind": "xref",
            "target": "core/validation/validator.html"
          },
          {
            "kind": "text",
            "value": " for "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestMapping"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " methods, including "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Java Bean Validation"
              }
            ],
            "kind": "xref",
            "target": "core/validation/beanvalidation.html"
          },
          {
            "kind": "text",
            "value": ". Validation may be applied at one of two levels:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "olist",
        "id": null,
        "items": [
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@ModelAttribute"
                  }
                ],
                "kind": "xref",
                "target": "web/webflux/controller/ann-methods/modelattrib-method-args.html"
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RequestBody"
                  }
                ],
                "kind": "xref",
                "target": "web/webflux/controller/ann-methods/requestbody.html"
              },
              {
                "kind": "text",
                "value": ", and "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RequestPart"
                  }
                ],
                "kind": "xref",
                "target": "web/webflux/controller/ann-methods/multipart-forms.html"
              },
              {
                "kind": "text",
                "value": " argument resolvers validate a method argument individually if the method parameter is annotated with Jakarta "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Valid"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or Spring’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Validated"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "AND"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " there is no "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Errors"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "BindingResult"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " parameter immediately after, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "AND"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method validation is not needed (to be discussed next). The exception raised in this case is "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "WebExchangeBindException"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Constraint"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotations such as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Min"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@NotBlank"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and others are declared directly on method parameters, or on the method (for the return value), then method validation must be applied, and that supersedes validation at the method argument level because method validation covers both method parameter constraints and nested constraints via "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Valid"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The exception raised in this case is "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "HandlerMethodValidationException"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ]
          }
        ],
        "roles": [],
        "style": "arabic",
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Applications must handle both "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebExchangeBindException"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "HandlerMethodValidationException"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " as either may be raised depending on the controller method signature. The two exceptions, however are designed to be very similar, and can be handled with almost identical code. The main difference is that the former is for a single object while the latter is for a list of method parameters."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Valid"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is not a constraint annotation, but rather for nested constraints within an Object. Therefore, by itself "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Valid"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " does not lead to method validation. "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@NotNull"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " on the other hand is a constraint, and adding it to an "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Valid"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " parameter leads to method validation. For nullability specifically, you may also use the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "required"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " flag of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestBody"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ModelAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null,
        "type": "note"
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Method validation may be used in combination with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Errors"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "BindingResult"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method parameters. However, the controller method is called only if all validation errors are on method parameters with an "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Errors"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " immediately after. If there are validation errors on any other method parameter then "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "HandlerMethodValidationException"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is raised."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can configure a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Validator"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " globally through the "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "WebFlux config"
              }
            ],
            "kind": "xref",
            "target": "web/webflux/config.html#webflux-config-validation"
          },
          {
            "kind": "text",
            "value": ", or locally through an "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "@InitBinder"
              }
            ],
            "kind": "xref",
            "target": "web/webflux/controller/ann-initbinder.html"
          },
          {
            "kind": "text",
            "value": " method in an "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Controller"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ControllerAdvice"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". You can also use multiple validators."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If a controller has a class level "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Validated"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", then "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "method validation is applied"
              }
            ],
            "kind": "xref",
            "target": "core/validation/beanvalidation.html#validation-beanvalidation-spring-method"
          },
          {
            "kind": "text",
            "value": " through an AOP proxy. In order to take advantage of the Spring MVC built-in support for method validation added in Spring Framework 6.1, you need to remove the class level "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Validated"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation from the controller."
          }
        ],
        "roles": [],
        "title": null,
        "type": "note"
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Error Responses"
              }
            ],
            "kind": "xref",
            "target": "web/webflux/ann-rest-exceptions.html"
          },
          {
            "kind": "text",
            "value": " section provides further details on how "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebExchangeBindException"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "HandlerMethodValidationException"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " are handled, and also how their rendering can be customized through a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MessageSource"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and locale and language specific resource bundles."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "For further custom handling of method validation errors, you can extend "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ResponseEntityExceptionHandler"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or use an "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ExceptionHandler"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method in a controller or in a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ControllerAdvice"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", and handle "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "HandlerMethodValidationException"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " directly. The exception contains a list of"
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ParameterValidationResult"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "s that group validation errors by method parameter. You can either iterate over those, or provide a visitor with callback methods by controller method parameter type:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "HandlerMethodValidationException ex = ... ;\n\nex.visitResults(new HandlerMethodValidationException.Visitor() {\n\n\t@Override\n\tpublic void requestHeader(RequestHeader requestHeader, ParameterValidationResult result) {\n\t\t\t// ...\n\t}\n\n\t@Override\n\tpublic void requestParam(@Nullable RequestParam requestParam, ParameterValidationResult result) {\n\t\t\t// ...\n\t}\n\n\t@Override\n\tpublic void modelAttribute(@Nullable ModelAttribute modelAttribute, ParameterErrors errors) {\n\n\t// ...\n\n\t@Override\n\tpublic void other(ParameterValidationResult result) {\n\t\t\t// ...\n\t}\n});"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
