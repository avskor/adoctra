    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The AsciiDoc processor will detect common URLs (unless escaped) wherever the macros substitution step is applied and automatically convert them into links. This page documents the recognized URL schemes and how to disable this behavior on a case-by-case basis."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "AsciiDoc recognizes the following common URL schemes without the help of any markup:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": "schemes",
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "http"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "https"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ftp"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "irc"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "mailto"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The URL in the following example begins with a recognized protocol (i.e., https), so the AsciiDoc processor will automatically turn it into a hyperlink."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The homepage for the Asciidoctor Project is https://www.asciidoctor.org. "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO1-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "colist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-1"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The trailing period will not get caught up in the link."
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The URL is also used as the link text. If you want to use "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "custom link text"
                  }
                ],
                "kind": "xref",
                "target": "url-macro.html#link-text"
              },
              {
                "kind": "text",
                "value": ", you must use the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "URL macro"
                  }
                ],
                "kind": "xref",
                "target": "url-macro.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In plain text documents, a bare URL is often enclosed in angle brackets."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You'll often see <https://example.org> used in examples."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To accommodate this convention, the AsciiDoc processor will still recognize the URL as an autolink, but will discard the angle brackets in the output (as they are not deemed significant)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Any link created from a bare URL (i.e., an autolink) automatically gets assigned the \"bare\" role. This allows the theming system (e.g., CSS) to recognize autolinks (and other bare URLs) and style them distinctly."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_url_schemes_for_autolinks",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "URL schemes for autolinks"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "AsciiDoc also detects and autolinks most email addresses."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Email us at hello@example.com to say hello."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In order for this to work, the domain suffix must be between 2 and 5 characters (e.g., .com) and only common symbols like period ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), hyphen ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), and plus ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "+"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") are permitted. For email address which do not conform to these restriction, you can use the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "email macro"
                  }
                ],
                "kind": "xref",
                "target": "mailto-macro.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_email_autolinks",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Email autolinks"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To prevent automatic linking of a URL or email address, you can add a single backslash ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "\\"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") in front of it."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Once launched, the site will be available at \\https://example.org.\n\nIf you cannot access the site, email \\help@example.org for assistance."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The backslash in front of the URL and email address will not appear in the output. The URL and email address will both be shown in plain text."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Since autolinks are a feature of the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "macros substitution"
                  }
                ],
                "kind": "xref",
                "target": "subs:macros.html"
              },
              {
                "kind": "text",
                "value": ", another way to prevent automatic linking of a URL or email address is to turn off the macros substitution using "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "incremental subs"
                  }
                ],
                "kind": "xref",
                "target": "subs:apply-subs-to-blocks.html#incremental"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[subs=-macros]\nOnce launched, the site will be available at https://example.org."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "subs"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute is only recognized on a leaf block, such as a paragraph."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_escaping_urls_and_email_addresses",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Escaping URLs and email addresses"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Autolinks"
      }
    ]
  }
}
