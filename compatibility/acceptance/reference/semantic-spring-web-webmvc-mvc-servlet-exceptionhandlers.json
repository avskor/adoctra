                    "inlines": [
                      {
                        "kind": "text",
                        "value": "See equivalent in the Reactive stack"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webflux/dispatcher-handler.html#webflux-dispatcher-exceptions"
                  }
                ],
                "kind": "span",
                "roles": [
