      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can form an exception resolver chain by declaring multiple "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "HandlerExceptionResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " beans in your Spring configuration and setting their "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "order"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " properties as needed. The higher the order property, the later the exception resolver is positioned."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The contract of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "HandlerExceptionResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " specifies that it can return:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "a "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "ModelAndView"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " that points to an error view."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "An empty "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "ModelAndView"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " if the exception was handled within the resolver."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "null"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " if the exception remains unresolved, for subsequent resolvers to try, and, if the exception remains at the end, it is allowed to bubble up to the Servlet container."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MVC Config"
                  }
                ],
                "kind": "xref",
                "target": "web/webmvc/mvc-config.html"
              },
              {
                "kind": "text",
                "value": " automatically declares built-in resolvers for default Spring MVC exceptions, for "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@ResponseStatus"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotated exceptions, and for support of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@ExceptionHandler"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " methods. You can customize that list or replace it."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "mvc-exceptionhandlers-handling",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Chain of Resolvers"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If an exception remains unresolved by any "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "HandlerExceptionResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and is, therefore, left to propagate or if the response status is set to an error status (that is, 4xx, 5xx), Servlet containers can render a default error page in HTML. To customize the default error page of the container, you can declare an error page mapping in "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "web.xml"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The following example shows how to do so:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "<error-page>\n\t<location>/error</location>\n</error-page>"
              }
            ],
            "language": "xml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Given the preceding example, when an exception bubbles up or the response has an error status, the Servlet container makes an ERROR dispatch within the container to the configured URL (for example, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "/error"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). This is then processed by the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DispatcherServlet"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", possibly mapping it to a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Controller"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", which could be implemented to return an error view name with a model or to render a JSON response, as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@RestController\npublic class ErrorController {\n\n\t@RequestMapping(path = \"/error\")\n\tpublic Map<String, Object> handle(HttpServletRequest request) {\n\t\tMap<String, Object> map = new HashMap<>();\n\t\tmap.put(\"status\", request.getAttribute(\"jakarta.servlet.error.status_code\"));\n\t\tmap.put(\"reason\", request.getAttribute(\"jakarta.servlet.error.message\"));\n\t\treturn map;\n\t}\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@RestController\nclass ErrorController {\n\n\t@RequestMapping(path = [\"/error\"])\n\tfun handle(request: HttpServletRequest): Map<String, Any> {\n\t\tval map = HashMap<String, Any>()\n\t\tmap[\"status\"] = request.getAttribute(\"jakarta.servlet.error.status_code\")\n\t\tmap[\"reason\"] = request.getAttribute(\"jakarta.servlet.error.message\")\n\t\treturn map\n\t}\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The Servlet API does not provide a way to create error page mappings in Java. You can, however, use both a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "WebApplicationInitializer"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and a minimal "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "web.xml"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          }
        ],
        "context": "section",
        "id": "mvc-ann-customer-servlet-container-error-page",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Container Error Page"
          }
        ]
      }
    ],
    "outline": null,
