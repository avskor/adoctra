                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If an exception occurs during request mapping or is thrown from a request handler (such as a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Controller"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DispatcherServlet"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " delegates to a chain of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "HandlerExceptionResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " beans to resolve the exception and provide alternative handling, which is typically an error response."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following table lists the available "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "HandlerExceptionResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " implementations:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "autowidth": false,
            "body": [
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "SimpleMappingExceptionResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "A mapping between exception class names and error view names. Useful for rendering error pages in a browser application."
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ],
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "inlines": [
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "DefaultHandlerExceptionResolver"
                              }
                            ],
                            "kind": "monospace",
                            "roles": []
                          }
                        ],
                        "kind": "link",
                        "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/web/servlet/mvc/support/DefaultHandlerExceptionResolver.html"
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "Resolves exceptions raised by Spring MVC and maps them to HTTP status codes. See also alternative "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "ResponseEntityExceptionHandler"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " and "
                      },
                      {
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Error Responses"
                          }
                        ],
                        "kind": "xref",
                        "target": "web/webmvc/mvc-ann-rest-exceptions.html"
                      },
                      {
                        "kind": "text",
                        "value": "."
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ],
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "ResponseStatusExceptionResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "Resolves exceptions with the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "@ResponseStatus"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " annotation and maps them to HTTP status codes based on the value in the annotation."
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ],
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "ExceptionHandlerExceptionResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "Resolves exceptions by invoking an "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "@ExceptionHandler"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " method in a "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "@Controller"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " or a "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "@ControllerAdvice"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " class. See "
                      },
                      {
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "@ExceptionHandler methods"
                          }
                        ],
                        "kind": "xref",
                        "target": "web/webmvc/mvc-controller/ann-exceptionhandler.html"
                      },
                      {
                        "kind": "text",
                        "value": "."
                      }
                    ]
                  ],
