        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Test methods and lifecycle methods may be written in Kotlin and may optionally use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "suspend"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " keyword for testing code using coroutines."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "import org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\n\nclass KotlinCoroutinesDemo {\n    @BeforeEach\n    fun regularSetUp() {\n    }\n\n    @BeforeEach\n    suspend fun coroutineSetUp() {\n    }\n\n    @Test\n    fun regularTest() {\n    }\n\n    @Test\n    suspend fun coroutineTest() {\n    }\n}"
              }
            ],
            "language": "kotlin",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "A test class written in Kotlin"
              }
            ]
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Using suspending functions as test or lifecycle methods requires "
              },
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "kotlin-stdlib"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ],
                "kind": "link",
                "target": "https://central.sonatype.com/artifact/org.jetbrains.kotlin/kotlin-stdlib"
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "kotlin-reflect"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ],
                "kind": "link",
                "target": "https://central.sonatype.com/artifact/org.jetbrains.kotlin/kotlin-reflect"
              },
              {
                "kind": "text",
                "value": ", and "
              },
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "kotlinx-coroutines-core"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ],
                "kind": "link",
                "target": "https://central.sonatype.com/artifact/org.jetbrains.kotlinx/kotlinx-coroutines-core"
              },
              {
                "kind": "text",
                "value": " to be present on the classpath or module path."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When using "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "suspend"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " test or lifecycle methods, JUnit internally uses "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "runBlocking"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to execute them. This is sufficient for simple coroutine-based tests."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "However, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "runBlocking"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " does not support skipping calls to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "delay"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and does not provide control over virtual time or dispatchers."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "As an alternative, tests can be written as regular "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Test"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " methods and wrapped in "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "runTest"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " from "
              },
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "kotlinx-coroutines-test"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ],
                "kind": "link",
                "target": "https://central.sonatype.com/artifact/org.jetbrains.kotlinx/kotlinx-coroutines-test"
              },
              {
                "kind": "text",
                "value": " to support skipping delays during tests and gain control over virtual time and dispatchers."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "import kotlinx.coroutines.test.runTest\nimport org.junit.jupiter.api.Test\n\nclass KotlinCoroutinesRunTestDemo {\n    @Test\n    fun coroutineTestUsingRunTest() = runTest {\n        // ...\n    }\n}"
              }
            ],
