          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example of how to place a background image at the top center of a page:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Document Title\n:page-background-image: image:bg.png[position=top]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s how to move it to the bottom right:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Document Title\n:page-background-image: image:bg.png[fit=none,pdfwidth=50%,position=bottom right]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If an image dimension matches the height or width of the page, the positioning keyword for that axis has no effect."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "position",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "position attribute"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If a background image is assigned to the recto pages (right-hand, odd-numbered pages) or verso pages (left-hand, even-numbered pages), the background will be used only for that side."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Document Title\n:page-background-image-recto: image:bg.png[fit=none,pdfwidth=20%,position=bottom right]\n:page-background-image-verso: image:bg.png[fit=none,pdfwidth=20%,position=bottom left]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If a background image isn’t specified for a side, the converter will use the default page background image ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "page-background-image"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), if specified. To turn off the background image for a side, assign the value "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "none"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "recto-verso",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Recto and verso background images"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can configure any background image to be selected per page layout by including the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "escaped"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "{page-layout}"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute reference in the image path. The reference has to be escaped so it’s not expanded until the converter resolves the image for a given page layout."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Document Title\n:page-background-image: image:bg-\\{page-layout}.png[]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The image is resolved the first time a given page layout is used in the document. Using this technique requires that the page layout value be included in the filename of the image (e.g., footer-bg-landscape.png)."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "page-layout",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Per page layout"
          }
        ]
      }
