                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "The image is scaled down while retaining its aspect ratio to fit within the available space. If the image already fits, it is not scaled."
