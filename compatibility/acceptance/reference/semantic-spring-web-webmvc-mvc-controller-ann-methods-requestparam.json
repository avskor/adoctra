                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@Controller\n@RequestMapping(\"/pets\")\nclass EditPetForm {\n\n\t// ...\n\n\t@PostMapping(path = \"/process\", consumes = MediaType.APPLICATION_FORM_URLENCODED_VALUE)\n\tpublic String processForm(@RequestParam MultiValueMap<String, String> params) {\n\t\t// ...\n\t}\n\n\t// ...\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
