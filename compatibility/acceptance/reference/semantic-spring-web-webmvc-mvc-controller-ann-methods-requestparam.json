                        {
                          "kind": "text",
                          "value": "@Controller\n@RequestMapping(\"/pets\")\nclass EditPetForm {\n\n\t// ...\n\n\t@PostMapping(\"/process\", consumes = [MediaType.APPLICATION_FORM_URLENCODED_VALUE])\n\tfun processForm(@RequestParam params: MultiValueMap<String, String>): String {\n\t\t// ...\n\t}\n\n\t// ...\n\n}"
                        }
                      ],
