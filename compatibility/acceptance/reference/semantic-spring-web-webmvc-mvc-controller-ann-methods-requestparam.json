                "value": "@RequestParam"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation to bind Servlet request parameters (that is, query parameters or form data) to a method argument in a controller."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following example shows how to do so:"
