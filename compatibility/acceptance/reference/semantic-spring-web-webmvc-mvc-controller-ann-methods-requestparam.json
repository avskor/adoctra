      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Note that use of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestParam"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is optional (for example, to set its attributes). By default, any argument that is a simple value type (as determined by "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "BeanUtils#isSimpleProperty"
              }
            ],
            "kind": "link",
            "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/beans/BeanUtils.html#isSimpleProperty-java.lang.Class-"
          },
          {
            "kind": "text",
            "value": ") and is not resolved by any other argument resolver, is treated as if it were annotated with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestParam"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
