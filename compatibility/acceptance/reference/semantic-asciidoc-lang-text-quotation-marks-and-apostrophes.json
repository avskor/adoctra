          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you don’t want a straight apostrophe that’s bounded by two word characters to be rendered as a curved apostrophe, escape it by preceding it with a backslash ("
