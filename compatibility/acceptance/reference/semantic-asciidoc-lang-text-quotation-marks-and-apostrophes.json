            "inlines": [
              {
                "kind": "text",
                "value": "This page describes how to insert curved quotation marks and apostrophes using the AsciiDoc syntax. It covers the shorthand syntax, the limitations of that syntax, and when it’s necessary to input these characters directly."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "AsciiDoc does not assign special meaning to single or double quotation marks when used as constrained formatting pairs (e.g., around a word or phrase). In this case, the kbd:['] and kbd:[\"] characters are taken to be straight quotation marks (also known as dumb, vertical, or typewriter quotation marks). When an AsciiDoc processor encounters straight quotation marks in this context, it outputs them as entered."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-straight-quotes",
            "inlines": [
              {
                "kind": "text",
                "value": "In Ruby, '\\n' represents a backslash followed by the letter n.\nSingle quotes prevent escape sequences from being interpreted.\nIn contrast, \"\\n\" represents a newline."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Single and double straight quotation marks syntax"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The result of "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 1"
