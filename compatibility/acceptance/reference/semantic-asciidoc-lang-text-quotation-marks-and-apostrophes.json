            "inlines": [
              {
                "kind": "text",
                "value": "An apostrophe directly followed by a space or punctuation, such as the possessive plural form, is not curved by default. To render a curved apostrophe when not bounded by two word characters, mark it as you would the second half of single curved quote (i.e., "
              },
              {
