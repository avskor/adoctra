        "context": "section",
        "id": "_the_subs_attribute",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "The subs attribute"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You should always prefer to use "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "incremental substitutions"
                  }
                ],
                "kind": "xref",
                "target": "#incremental"
              },
              {
                "kind": "text",
                "value": ", and only revert to exact substitutions when you require the additional control."
              }
            ],
            "roles": [],
            "title": null,
            "type": "caution"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Let’s look at an example where you want to process inline formatting markup in a source block. By default, source blocks (as well as other verbatim blocks) are only subject to the verbatim substitution group (specialchars and callouts). You can change this behavior by setting the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "subs"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute in the block’s attribute list."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[source,java,subs=\"verbatim,quotes\"] "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO1-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\n----\nSystem.out.println(\"Hello *<name>*\") "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO1-2",
                "kind": "callout",
                "number": "2",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\n----"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "colist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-1"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "subs"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " attribute is set in the attribute list and assigned the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "verbatim"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " and "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "quotes"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " values. It’s important to reinstate the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "verbatim"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " substitution step to ensure special characters are encoded (which, for source blocks, also enables syntax highlighting)."
                  }
                ],
                "src": ""
              },
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-2"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The formatting markup in this line will be replaced when the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "quotes"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " substitution step runs."
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s the result."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "System.out.println(\"Hello "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "<name>"
                      }
                    ],
                    "kind": "strong",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "\") "
                  },
                  {
                    "guard": "// ",
                    "icons": null,
                    "id": "CO2-1",
                    "kind": "callout",
                    "number": "1",
                    "src": "",
                    "xml": false
                  },
                  {
                    "kind": "text",
                    "value": " "
                  },
                  {
                    "guard": null,
                    "icons": null,
                    "id": "CO2-2",
                    "kind": "callout",
                    "number": "2",
                    "src": "",
                    "xml": false
                  }
                ],
                "language": "java",
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "colist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO2-1"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "verbatim"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " value enables any special characters and callouts to be processed."
                  }
                ],
                "src": ""
              },
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO2-2"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "quotes"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " value enables the bold text formatting to be processed."
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If enabling the quotes substitution step on the whole block causes problems, you can instead enable the macros substitution step, then use the pass macro to enable the quotes substitution step locally."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[source,java,subs=\"verbatim,macros\"]\n----\nSystem.out.println(\"No bold *here*\");\npass:c,q[System.out.println(\"Hello *<name>*\");] "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO3-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\n----"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "colist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO3-1"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The pass macro with the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "c,q"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " target applies the specialchars and quotes substitution steps to the enclosed text."
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You may be wondering why "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "verbatim"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is specified in the previous examples since it’s applied to literal blocks by default. The reason is that when you specify substitutions without a modifier, it replaces all existing substitutions. Therefore, it’s necessary to start with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "verbatim"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in order to restore the default substitutions. You can avoid having to do this by using incremental substitutions instead, which is covered in the next section."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_set_the_subs_attribute_on_a_block",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Set the subs attribute on a block"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When you set the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "subs"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute on a block, you automatically "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "remove"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " all of its default substitutions. For example, if you set "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "subs"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " on a literal block, and assign it a value of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "attributes"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", only attribute references are substituted. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "verbatim"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " substitution group will not be applied. To remedy this situation, AsciiDoc provides a syntax to append or remove substitutions instead of replacing them outright."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can add or remove a substitution type from the default substitution group using the plus ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "+"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") and minus ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") modifiers. These are known as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "incremental substitutions"
                  }
                ],
                "kind": "strong",
                "roles": [
                  "term"
                ]
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Prepends the substitution to the default list."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "<substitution>+"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Appends the substitution to the default list."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "+<substitution>"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Removes the substitution from the default list."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "-<substitution>"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For example, you can add the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "attributes"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " substitution to the beginning of a listing block’s default substitution group by placing the plus ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "+"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") modifier at the end of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "attributes"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " value."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[source,xml,subs=\"attributes+\"]\n----\n<version>{version}</version>\n----"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Add attributes substitution to default substitution group"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Similarly, you can remove the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "callouts"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " substitution from a block’s default substitution group by placing the minus ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") modifier in front of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "callouts"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " value."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[source,xml,subs=\"-callouts\"]\n.An illegal XML tag\n----\n<1>\n  content inside \"1\" tag\n</1>\n----"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Remove callouts substitution from default substitution group"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can also specify whether the substitution type is added to the end of the substitution group. If a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "` comes before the name of the substitution, then it's added to the end of the existing list, whereas if a `"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " comes after the name, it’s added to the beginning of the list."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[source,xml,subs=\"attributes+,+replacements,-callouts\"]\n----\n<version>{version}</version>\n<copyright>(C) ACME</copyright>\n<1>\n  content inside \"1\" tag\n</1>\n----"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In the above example, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "attributes"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " substitution step is added to the beginning of the default substitution group, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "replacements"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " step is added to the end of the group, and the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "callouts"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " step is removed from the group."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If you are applying the same set of substitutions to numerous blocks, you should consider making them an attribute entry to ensure consistency."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
