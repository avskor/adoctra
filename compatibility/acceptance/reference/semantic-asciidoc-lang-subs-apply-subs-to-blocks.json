                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "+"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " modifier is added to a step, the existing substitutions are modified accordingly (see "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "incremental subs"
                  }
                ],
                "kind": "xref",
                "target": "#incremental"
              },
              {
                "kind": "text",
                "value": "). Otherwise, the existing substitutions are replaced. The value also specifies the order in which the substitutions are applied."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "subs"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " element attribute does not inherit to nested blocks. It can only be applied to a leaf block, which is any block that cannot have child blocks (e.g., a paragraph or a listing block)."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          }
