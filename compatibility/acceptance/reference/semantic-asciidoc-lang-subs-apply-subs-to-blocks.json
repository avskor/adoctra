                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Substitution group that performs all substitution types except callouts."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
