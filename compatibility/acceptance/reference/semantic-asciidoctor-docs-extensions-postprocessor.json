            "inlines": [
              {
                "kind": "text",
                "value": "class CopyrightFooterPostprocessor < Asciidoctor::Extensions::Postprocessor\n  def process document, output\n    content = (document.attr 'copyright') || 'Copyright Acme, Inc.'\n    if document.basebackend? 'html'\n      replacement = %(<div id=\"footer-text\">\\\\1<br>\\n#{content}\\n</div>)\n      output = output.sub(/<div id=\"footer-text\">(.*?)<\\/div>/m, replacement)\n    elsif document.basebackend? 'docbook'\n      replacement = %(<simpara>#{content}</simpara>\\n\\\\1)\n      output = output.sub(/(<\\/(?:article|book)>)/, replacement)\n    end\n    output\n  end\nend"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_copyrightfooterpostprocessor",
        "level": 1,
