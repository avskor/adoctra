        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the Asciidoctor gem is installed successfully, the Asciidoctor command line interface (CLI) named "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " will be available on your PATH."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To confirm that the CLI is available, execute the following command in your terminal application:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor --version"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If this command completes successfully, information about Asciidoctor and the runtime environment will be printed to the standard output of your terminal:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor 2.0.23 [https://asciidoctor.org]\nRuntime Environment (ruby 3.3.0 [x86_64-linux]) (lc:UTF-8 fs:UTF-8 in:UTF-8 ex:UTF-8)"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The runtime environment information varies based on the version of Ruby you’re using and the encoding settings of your operating system."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_version_and_runtime",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Version and runtime"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To invoke Asciidoctor from the CLI and convert an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".adoc"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " file, execute:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor <asciidoc-file>"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This will use the built-in defaults for options and create a new file in the same directory as the input file, with the same base name, but with the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".html"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " extension."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CLI Options"
                  }
                ],
                "kind": "xref",
                "target": "man1/asciidoctor.html#options"
              },
              {
                "kind": "text",
                "value": " describes the available options and parameters for the Asciidoctor CLI."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_convert_an_asciidoc_file",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Convert an AsciiDoc file"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--help"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option provides self-describing documentation for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " command, grouped by topic. If you don’t specify a topic, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--help"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option prints the usage statement for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " command:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor --help"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can generate the full documentation (i.e., man page) for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " command by passing the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "manpage"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " topic to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--help"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option. You can pipe that output to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "man"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " pager to view it:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor --help manpage | man -l -"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can also find the man page for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " command rendered as HTML in this documentation, which you can view in a browser instead. See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor(1)"
                  }
                ],
                "kind": "xref",
                "target": "man1/asciidoctor.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can print an AsciiDoc syntax crib sheet by passing the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "syntax"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " topic to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--help"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor --help syntax"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The crib sheet itself is composed in AsciiDoc. You can convert it to HTML by piping the output back into the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " command."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor --help syntax | asciidoctor -o syntax.html -"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Navigate to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "syntax.html"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " file in your browser to see what the examples in the crib sheet look like when converted to HTML."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
