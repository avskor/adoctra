      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Another possible application of this feature is to write tests for interface contracts. For example, you can write tests for how implementations of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Object.equals"
              }
            ],
            "kind": "monospace",
