                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "class TestInterfaceDemo implements TestLifecycleLogger,\n\t\tTimeExecutionLogger, TestInterfaceDynamicTestsDemo {\n\n\t@Test\n\tvoid isEqualValue() {\n\t\tassertEquals(1, \"a\".length(), \"is always equal\");\n\t}\n\n}"
                            }
