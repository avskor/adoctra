            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Comparable.compareTo"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " should behave as follows."
          }
        ],
        "roles": [],
        "title": null
