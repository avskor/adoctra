{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Before you can use a document attribute in your document, you have to declare it. An "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "attribute entry"
                  }
                ],
                "kind": "strong",
                "roles": [
                  "term"
                ]
              },
              {
                "kind": "text",
                "value": " is the primary mechanism for defining a document attribute in an AsciiDoc document. You can think of an attribute entry as a global variable assignment for AsciiDoc. The document attribute it creates becomes available from that point forward in the document. Attribute entries are also frequently used to toggle features."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An attribute entry consists of two parts: an attribute "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "name"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and an attribute "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "value"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The attribute name comes first, followed by the optional value. Each attribute entry must be entered on its own line. An attribute entry starts with an opening colon ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ":"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), directly followed by the attribute’s name, and then a closing colon ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ":"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). This "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sets"
                  }
                ],
                "kind": "strong",
                "roles": [
                  "term"
                ]
              },
              {
                "kind": "text",
                "value": " — that is, turns on — the document attribute so you can use it in your document."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ":name-of-an-attribute: "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO1-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "colist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-1"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The attribute’s name is directly preceded with a opening colon ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": ":"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ") and directly followed by a closing colon ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": ":"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ")."
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In many cases, you explicitly assign a value to a document attribute by entering information after its name in the attribute entry. The value must be offset from the closing colon ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ":"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") by at least one space."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ":name-of-an-attribute: value of the attribute "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO2-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "colist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO2-1"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "An explicitly assigned value is offset from the closing colon ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": ":"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ") by at least one space. At the end of the value, press kbd:[Enter]."
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Take note that "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "header substitutions"
                  }
                ],
                "kind": "xref",
                "target": "attribute-entry-substitutions.html"
              },
              {
                "kind": "text",
                "value": " automatically get applied to the value by default. That means you don’t need to escape special characters such in an HTML tag. It also means you can reference the value of attributes which have already been defined when defining the value of an attribute. Attribute references in the value of an attribute entry are resolved immediately."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ":url-org: https://example.org/projects\n:url-project: {url-org}/project-name "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO3-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "colist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO3-1"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "You can reuse the value of an attribute which has already been set using using an attribute reference in the value."
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Some built-in attributes don’t require a value to be explicitly assigned in an attribute entry because they’re a boolean attribute or have an implied value."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ":name-of-an-attribute: "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO4-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "colist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO4-1"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If you don’t want to explicitly assign a value to the attribute, press kbd:[Enter] after the closing colon ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": ":"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ")."
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When set, the value of a built-in boolean attribute is always empty (i.e., an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "empty string"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). If you set a built-in attribute and leave its value empty, the AsciiDoc processor may infer a value at processing time."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_what_is_an_attribute_entry",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "What is an attribute entry?"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An attribute entry is most often declared in the document header. For attributes that allow it (which includes general purpose attributes), the attribute entry can alternately be declared between blocks in the document body (i.e., the portion of the document below the header)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An attribute entry should not be declared inside the boundaries of a delimited block. When an attribute entry is declared inside a delimited block, the behavior is undefined."
              }
            ],
            "roles": [],
            "title": null,
            "type": "warning"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When an attribute is defined in the document header using an attribute entry, that’s referred to as a header attribute. A header attribute is available to the entire document until it is unset. A header attribute is also accessible from the document metadata for use by built-in behavior, extensions, and other applications that need to consult its value (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "source-highlighter"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When an attribute is defined in the document body using an attribute entry, that’s simply referred to as a document attribute. For any attribute defined in the body, the attribute is available from the point it is set until it is unset. Attributes defined in the body are not available via the document metadata."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Unless the attribute is unlocked, it can be unset or assigned a new value in the document header or body. However, note that unsetting or redefining a header attribute that controls behavior in the document body usually has no affect. See the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "document-attributes-ref.html"
                  }
                ],
                "kind": "xref",
                "target": "document-attributes-ref.html"
              },
              {
                "kind": "text",
                "value": " for where in a document each attribute can be set."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_where_can_an_attribute_entry_be_declared",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Where can an attribute entry be declared?"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Document attributes can also be declared (set with an optional value or unset) outside the document via the CLI and API. The attribute entry syntax is not used in these cases. Rather, they are declared using the provided option. For the API, attributes are declared using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ":attributes"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option (which supports various entry formats). For the CLI, the attribute is declared using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-a"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When an attribute is assigned a value outside of the document, the value is stored as is, meaning substitutions are not applied to it. That also means that the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "special characters and quote substitutions"
                  }
                ],
                "kind": "xref",
                "target": "subs:index.html"
              },
              {
                "kind": "text",
                "value": " are not applied to the value of that attribute when it is referenced in the document. However, subsequent substitutions, such as the macro substitution, do get applied. This behavior is due to that fact that the attributes substitution is applied after the special characters and quote substitutions. In order to force these substitutions to be applied to the value of the attribute, you must alter the substitution order at the point of reference. Here’s an example using the inline pass macro."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "pass:a,q[{attribute-with-formatted-text}]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When an attribute is declared from the command line or API, it is implicitly a document header attribute. By default, the attribute becomes locked (i.e., hard set or unset) and thus cannot be changed by the document. This behavior can be changed by adding an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to the end of the attribute name or value (i.e., the soft set modifier). See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "assignment-precedence.html"
                  }
                ],
                "kind": "xref",
                "target": "assignment-precedence.html"
              },
              {
                "kind": "text",
                "value": " for more information."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The one exception to this rule is the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sectnums"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute, which can always be changed."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_defining_document_attributes_without_an_attribute_entry",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Defining document attributes without an attribute entry"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Attribute Entries"
      }
    ]
  }
}
