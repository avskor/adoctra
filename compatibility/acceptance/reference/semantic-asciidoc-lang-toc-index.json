            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To enable the autogenerated TOC, set the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "toc"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " document attribute. The "
