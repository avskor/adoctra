{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This page explains how to load and convert AsciiDoc files using the API."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When you load AsciiDoc using the API, you’re telling Asciidoctor to parse the document (down to the block level) and return an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Asciidoctor::Document"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " object. This object contains the full block structure of the AsciiDoc document."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Loading a document currently does not parse the inline content. That processing is deferred until the parsed document is converted."
              }
            ],
            "roles": [],
            "title": null,
            "type": "caution"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Let’s assume we’re working with the following AsciiDoc document:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Document Title\n\nThe main content."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "document.adoc"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To parse this source file into an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Asciidoctor::Document"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " object, use the following API call:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "doc = Asciidoctor.load_file 'document.adoc', safe: :safe"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Using the object assigned to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "doc"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " variable, you can get information about the document, such as the document title."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "puts doc.doctitle\n# => \"Document Title\""
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can also inspect all the document attributes:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "pp doc.attributes"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Going deeper, you can find blocks in the document, such as all the paragraph blocks, using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "find_by"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "puts doc.find_by context: :paragraph\n# => #<Asciidoctor::Block@1001 {context: :paragraph, content_model: :simple, style: nil, lines: 1}>"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "However, if you’re only interested in converting the AsciiDoc source when using the API, then it’s better to use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "convert_file"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " entrypoint."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_load_an_asciidoc_file",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Load an AsciiDoc file"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When you convert AsciiDoc using the API, you’re telling Asciidoctor to parse and convert the document to the output format determined by the specified backend. If you don’t specify a backend, like with the CLI, Asciidoctor will produce HTML."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Let’s again assume we’re working with the following AsciiDoc document:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Document Title\n\nThe main content."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "document.adoc"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To convert this source file to HTML5, use the following API call:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor.convert_file 'document.adoc', safe: :safe"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The command will output HTML to the file "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "my-sample.html"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " in the same directory. If you want Asciidoctor to output to a different file, you can specify it using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ":to_file"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor.convert_file 'document.adoc', safe: :safe, to_file: 'out.html'"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can convert the file to DocBook by setting the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ":backend"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "'docbook'"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ":"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor.convert_file 'document.adoc', safe: :safe, backend: 'docbook'"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In this case, Asciidoctor will output DocBook to the file "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "my-sample.xml"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " in the same directory. As before, you can use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ":to_file"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option to control the output file."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor.convert_file 'document.adoc', safe: :safe, backend: 'docbook', to_file: 'out.html'"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "That covers the basics of loading and converting AsciiDoc using the API."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_convert_an_asciidoc_file",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Convert an AsciiDoc file"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Load and Convert Files Using the API"
      }
    ]
  }
}
