            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "destinations"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key accepts a list of specifications that tell Antora which provider(s) to use to publish the site and where the generated files should be saved. When "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "destinations"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is set, each entry must at least specify the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "provider"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want to support the primary fs destination, you must include an entry for it without defining the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "path"
                  }
                ],
                "kind": "monospace",
