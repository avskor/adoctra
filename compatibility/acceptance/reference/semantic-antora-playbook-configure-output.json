              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "destinations"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key, which hosts the destination specifications. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "destinations"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is required if you want to "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "publish the site files as an archive"
                  }
                ],
                "kind": "xref",
                "target": "output-provider-archive.html"
              },
              {
                "kind": "text",
                "value": ", publish a site to "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "multiple destinations"
                  }
                ],
                "kind": "xref",
                "target": "output-provider-fs.html#publish-to-multiple-destinations"
              },
              {
                "kind": "text",
                "value": ", or publish the site using a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "custom provider"
                  }
                ],
                "kind": "xref",
                "target": "output-provider-custom.html"
