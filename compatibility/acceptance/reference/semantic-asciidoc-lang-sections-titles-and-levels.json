          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Section levels must be nested logically. There are two rules you must follow:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "olist",
            "id": null,
            "items": [
              {
                "blocks": [
                  {
                    "context": "ulist",
                    "id": null,
                    "items": [
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "The first level 0 section is the document title; subsequent level 0 sections represent parts."
                          }
                        ]
                      }
                    ],
                    "roles": [],
                    "style": null,
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "A document can only have multiple level 0 sections if the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "doctype"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " is set to "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "book"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Section levels cannot be skipped when nesting sections (e.g., you can’t nest a level 5 section directly inside a level 3 section; an intermediary level 4 section is required)."
                  }
                ]
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For example, the following syntax is illegal:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Document Title\n\n= Illegal Level 0 Section (violates rule #1)\n\n== First Section\n\n==== Illegal Nested Section (violates rule #2)"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Content above the first section title is designated as the document’s preamble. Once the first section title is reached, content is associated with the section it is nested in."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "== First Section\n\nContent of first section\n\n=== Nested Section\n\nContent of nested section\n\n== Second Section\n\nContent of second section"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In addition to the equals sign marker used for defining section titles, Asciidoctor recognizes the hash symbol ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "#"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") from Markdown. That means the outline of a Markdown document will be converted just fine as an AsciiDoc document."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          }
        ],
