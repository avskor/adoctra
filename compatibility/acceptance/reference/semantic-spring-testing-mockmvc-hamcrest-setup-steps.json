                      "inlines": [
                        {
                          "kind": "text",
                          "value": "// static import of SharedHttpSessionConfigurer.sharedHttpSession\n\nMockMvc mockMvc = MockMvcBuilders.standaloneSetup(new TestController())\n\t\t.apply(sharedHttpSession())\n\t\t.build();\n\n// Use mockMvc to perform requests..."
                        }
