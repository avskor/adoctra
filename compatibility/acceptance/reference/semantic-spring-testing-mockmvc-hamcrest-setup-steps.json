            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MockMvcConfigurer"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". The Spring Framework has one such built-in implementation that helps to save and re-use the HTTP session across requests. You can use it as follows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
