    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Examples are useful for storing source code, queries, configuration parameters, terminal output, logs, data sets, and other non-AsciiDoc files, that you reuse in one or more pages throughout your site. Changes you make to an example file will disseminate to all of the pages where you referenced the example the next time you build your site."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "reusable-single-source-examples",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Reusable, single source examples"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Example files are usually non-AsciiDoc files. They’re stored in an "
              },
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "examples"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " directory"
                  }
                ],
                "kind": "xref",
                "target": "ROOT:examples-directory.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When saving a new example file, keep the following filename requirements and recommendations in mind:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Spaces aren’t recommended"
                      }
                    ],
                    "kind": "strong",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " in example filenames. While the AsciiDoc include directive does accept spaces in the target, some editing tools may not support it and is thus not recommended."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Uppercase letters and spaces aren’t recommended"
                      }
                    ],
                    "kind": "strong",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " in example filenames. Some file systems aren’t case sensitive. Therefore, file conflicts could occur when using git depending on the file system a writer is using."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Save an example file with a valid file extension except when it’s common industry practice for that specific file type, such as "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Dockerfile"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": [
                      "path"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": ", to not have an extension. Not using the correct file extension when saving an example file may limit your ability to apply some Antora extensions or upgrade to future capabilities."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Unlike publishable resources, an example file without a file extension isn’t treated as a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "hidden file"
                  }
                ],
                "kind": "xref",
                "target": "ROOT:standard-directories.html#hidden-files"
              },
              {
                "kind": "text",
                "value": ". Antora will load an example that doesn’t have a file extension into its content catalog and assign the example a resource ID for referencing."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Antora doesn’t publish example files as individual site pages. An "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "example must be referenced by an include directive"
                  }
                ],
                "kind": "xref",
                "target": "include-an-example.html"
              },
              {
                "kind": "text",
                "value": " from a page, or resource that’s eventually included in a page, for the example’s content to be published."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "example-filenames-and-file-extensions",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Example filenames and file extensions"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Typically, content from an example file is inserted into source, listing, and literal blocks. Regardless of the component version an example file belongs to, it can be referenced by any page or partial in your site. An example is referenced using its resource ID and the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "AsciiDoc include directive"
                  }
                ],
                "kind": "xref",
                "target": "include-an-example.html"
              },
              {
                "kind": "text",
                "value": ". You can even select regions or lines from an example, instead of all of the example’s content, and insert only those regions or lines using the include directive’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "tag"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "tags"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "lines"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attributes."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Examples shouldn’t be confused with the AsciiDoc example block, though content from an example file can be inserted into an example block using an include directive."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          }
        ],
        "context": "section",
        "id": "example-file-usage",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Example file usage"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Examples"
      }
    ]
  }
}
