            "inlines": [
              {
                "kind": "text",
                "value": "Spring Framework comes with two different web stacks: "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Spring MVC"
                  }
                ],
                "kind": "xref",
