{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can include content from another file into the current AsciiDoc document using the include directive. The included content can be AsciiDoc or it can be any other text format. Where that content is included in the document determines how it will be processed."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "include directive"
                  }
                ],
                "kind": "strong",
                "roles": [
                  "term"
                ]
              },
              {
                "kind": "text",
                "value": " imports content from a separate file or URL into the content of the current document. When the current document is processed, the include directive syntax is replaced by the contents of the include file. Think of the include directive like a file expander. The include directive is a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "preprocessor directive"
                  }
                ],
                "kind": "xref",
                "target": "#include-processing"
              },
              {
                "kind": "text",
                "value": ", which means it has no awareness of the surrounding context."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_what_is_an_include_directive",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "What is an include directive?"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The include directive is useful when you want to:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Partition a large document into smaller files for better organization and to make restructuring simpler."
                  },
                  {
                    "id": null,
                    "index": "1",
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Always separate consecutive include directives by an empty line unless your intent is to adjoin the content in the include files so it becomes contiguous."
                      }
                    ],
                    "kind": "footnote",
                    "type": "definition"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Insert source code from the external files where the code is maintained."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Populate tables with output, such as CSV data, from other programs."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Create document variants by combining the include directive with "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "conditional preprocessor directives"
                      }
                    ],
                    "kind": "xref",
                    "target": "conditionals.html"
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Reuse content snippets and boilerplate content, such as term definitions, disclaimers, etc., multiple times within the same document."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Define a common set of attributes across multiple documents (typically included into the document header)."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          }
        ],
        "context": "section",
        "id": "_when_is_an_include_directive_useful",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "When is an include directive useful?"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An include directive must be placed on a line by itself with the following syntax:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "include::target[leveloffset="
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "offset"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ",lines="
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ranges"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ",tag(s)="
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "name(s)"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ",indent="
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "depth"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ",encoding="
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "encoding"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ",opts=optional]"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The target is required. The target may be an absolute path, a path relative to the current document, or a URL. Since the include directive is a line-oriented expression, the target may contain space characters. However, the target must not start with a space character (since that would turn it into a description list term). An absolute or relative path outside the directory of the outermost document will only be honored if the safe mode is unsafe. A URL target will only be resolved if the security settings on the processor allows it (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "allow-uri-read"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "include-uri.html"
                  }
                ],
                "kind": "xref",
                "target": "include-uri.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The leveloffset, lines, tag(s), indent, encoding, and opts attributes are optional, thus reducing the simplest case to the following:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "include::partial.adoc[]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Specifying the encoding is essential if the include file is not encoded in UTF-8. The value of this attribute must be an encoding recognized by Ruby (e.g., utf-8, iso-8859-1, windows-1252, etc), case insenstive. If the include file is already encoded in UTF-8 (or contains a BOM), this attribute is unnecessary."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When using consecutive include directives, you should always separate them by an empty line unless your intention is to adjoin the content in the include files so it becomes contiguous."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For example, if you’re using the include directive to include individual chapters, the include directives should be offset from each other by an empty line. This strategy avoids relying on empty lines imported from the include file to keep the chapters separated. That separation should be encoded in the parent document instead."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "include::chapter01.adoc[]\n\ninclude::chapter02.adoc[]\n\ninclude::chapter03.adoc[]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "On the other hand, if you’re using the include directive to lay down contiguous lines, such as common document attribute entries, then you would put the include directives on adjacent lines to avoid inserting empty lines."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Document Title\nAuthor Name\ninclude::attributes-settings.adoc[]\ninclude::attributes-urls.adoc[]\n:url-example: https://example.org\n\nDocument body."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In either case, don’t rely on the empty lines at the boundaries of the include file. And mind where empty lines are used in that include file."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "include-syntax",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Include directive syntax"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Although the include directive looks like a block macro, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "it’s not a macro and therefore isn’t processed like one"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". It’s a preprocessor directive; it’s important to understand the distinction."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A "
              },
              {
                "id": "def-preprocessor",
                "inlines": [
                  {
                    "kind": "text",
                    "value": "preprocessor directive"
                  }
                ],
                "kind": "strong",
                "roles": [
                  "term"
                ]
              },
              {
                "kind": "text",
                "value": " is processed when the lines of a document are read, but before the document structure is parsed. Therefore, it’s not aware of the surrounding document structure. A preprocessor directive merely adds lines to the reader or takes lines away. The include directive is a preprocessor directive that always adds lines."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The best way to think of the include directive is to imagine that it is being replaced by the lines from the include file (i.e., the imported lines). Only after the lines from the target of the include directive are added to the current document does the parser read and interpret those lines."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The include directive is disabled when Asciidoctor is run in secure mode. In secure mode, the include directive is converted to a link in the output document. See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor::safe-modes.html"
                  }
                ],
                "kind": "xref",
                "target": "asciidoctor::safe-modes.html"
              },
              {
                "kind": "text",
                "value": " to learn more."
              }
            ],
            "roles": [],
            "title": null,
            "type": "important"
          }
        ],
        "context": "section",
        "id": "include-processing",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Include processing"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you don’t want the include directive to be processed, you must escape it using a backslash."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "\\include::just-an-example.ext[]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Escaping the directive is necessary "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "even if it appears in a verbatim block"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " since it’s not aware of the surrounding document structure."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_escaping_an_include_directive",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Escaping an include directive"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The path used in an include directive can be relative or absolute."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the path is relative, the processor resolves the path using the following rules:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If the include directive is used in the primary (top-level) document, relative paths are resolved relative to the base directory. (The base directory defaults to the directory of the primary document and can be overridden from the CLI or API)."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If the include directive is used in a file that has itself been included, the path is resolved relative to the including (i.e., current) file."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "These defaults make it easy to reason about how the path to the include file is resolved."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the processor cannot locate the file (perhaps because you mistyped the path), you’ll still be able to convert the document. However, you’ll get the following warning message during conversion:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "asciidoctor: WARNING: my-document.adoc: line 3: include file not found: /.../content.adoc"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following message will also be inserted into the output:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Unresolved directive in my-document.adoc - include::content.adoc[]"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To fix the problem, edit the file path and run the converter again. If you don’t want the AsciiDoc processor to emit a warning, but rather drop the include that cannot be found, add the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "opts=optional"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute to the include directive."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you store your AsciiDoc files in nested folders at different levels, relative file paths can quickly become awkward and inflexible. A common pattern to help here is to define the paths in attributes defined in the header, then prefix all include paths with a reference to one of these attributes:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ":includedir: _includes\n:sourcedir: ../src/main/java\n\ninclude::{includedir}/fragment1.adoc[]\n\n[source,java]\n----\ninclude::{sourcedir}/org/asciidoctor/Asciidoctor.java[]\n----"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Keep in mind that no matter how Asciidoctor resolves the path to the file, access to that file is limited by the safe mode setting under which Asciidoctor is run. If a path violates the security restrictions, it may be truncated."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "include-resolution",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Include file resolution"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The include directive performs a simple file merge, so it works with any text file. The content of all included content goes through some form of normalization."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The content of each include file is encoded to UTF-8. If the encoding attribute is specified on the include directive, the content is reencoded from that encoding to UTF-8. If the encoding attribute is not specified, the processor will look for the presence of a BOM and reencode the content from that encoding to UTF-8 accordingly. If neither of those conditions are met, the encoding is forced to UTF-8."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the file is recognized as an AsciiDoc file (i.e., it has one of the following extensions: "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".asciidoc"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".adoc"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".ad"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".asc"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".txt"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") additional normalization and processing is performed. First, all trailing whitespace and endlines are removed from each line and replaced with a Unix line feed. This normalization is important to how an AsciiDoc processor works. Next, the AsciiDoc processor runs the preprocessor on the lines, looking for and interpreting the following directives:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "includes"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "preprocessor conditionals (e.g., "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "ifdef"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ")"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Running the preprocessor on the included content allows includes to be nested, thus provides lot of flexibility in constructing radically different documents with a single primary document and a few command line attributes."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Including non-AsciiDoc files is normally done to merge output from other programs or populate table data:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ".2016 Sales Results\n,===\ninclude::sales/2016/results.csv[]\n,==="
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In this case, the include directive does not do any processing of AsciiDoc directives. The content is inserted as is (after being normalized)."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "include-nonasciidoc",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "AsciiDoc vs non-AsciiDoc files"
          }
        ]
      }
    ],
    "footnotes": [
      {
        "id": null,
        "index": "1",
        "inlines": [
          {
            "kind": "text",
            "value": "Always separate consecutive include directives by an empty line unless your intent is to adjoin the content in the include files so it becomes contiguous."
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Includes"
      }
