                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This key is only relevant if the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "file"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is specified as the path of a local file."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By default, Antora will write log messages to the destination immediately. You can control this behavior using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "buffer_size"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sync"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " keys."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "append-key",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "append key"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "buffer_size"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is configured under the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "destination"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " category key of the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "log category key"
                  }
                ],
                "kind": "xref",
                "target": "configure-runtime.html#log-key"
              },
              {
                "kind": "text",
                "value": " in a playbook. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "buffer_size"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is optional. The value of this key can be 0 or a positive integer. The value represents the number of bytes to buffer (e.g., 4096 is 4K)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By default, the value is 0, which means Antora does not buffer log messages. If the value is greater than 0, then Antora will batch log messages until they reach the specified size in bytes. Once the resident size of the buffered log messages meet or exceed this value, Antora will flush the buffer to the destination."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "runtime:\n  log:\n    destination:\n      buffer_size: 4096"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you’re routing log messages to a file, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "buffer_size"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key provides a way to avoid an excessive number of writes. You usually only need to use this key if you are encountering a resource problem when running Antora."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sync"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key offers an additional way to control writes."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "buffer-size-key",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "buffer_size key"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sync"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is configured under the "
              },
              {
