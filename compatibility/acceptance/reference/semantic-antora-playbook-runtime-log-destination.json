                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " category provides keys that allow you to control where Antora writes log messages. You can configure Antora to write messages to a standard stream or a file. You can also control when and how Antora writes those log messages."
              }
            ],
            "roles": [],
            "title": null
          }
