              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "file"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is configured under the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "destination"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " category key of the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
