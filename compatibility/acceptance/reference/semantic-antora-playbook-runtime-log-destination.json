          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "append"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is configured under the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "destination"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " category key of the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "log category key"
                  }
                ],
                "kind": "xref",
                "target": "configure-runtime.html#log-key"
              },
              {
                "kind": "text",
                "value": " in a playbook. The "
