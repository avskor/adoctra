      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The default destination file is correlated with the log format. If the log format is "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pretty"
                  }
                ],
                "kind": "xref",
                "target": "runtime-log-format.html#pretty"
              },
              {
                "kind": "text",
                "value": ", the default destination is the standard error stream (stderr). If the log format is "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "json"
                  }
                ],
                "kind": "xref",
                "target": "runtime-log-format.html#json"
              },
              {
                "kind": "text",
                "value": ", the default destination is the standard output stream (stdout). In either case, the messages will appear in the output of your terminal."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "file"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key allows you to control which standard stream Antora selects or to configure Antora to route the log messages to a local file."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "default",
        "level": 1,
        "roles": [],
        "title": [
