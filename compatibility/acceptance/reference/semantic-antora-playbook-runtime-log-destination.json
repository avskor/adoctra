              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "append"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is optional. The value of this key can either be "
