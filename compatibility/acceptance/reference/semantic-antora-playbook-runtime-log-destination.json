              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "file"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is optional. The value of this key can be a path to a local file, the value "
