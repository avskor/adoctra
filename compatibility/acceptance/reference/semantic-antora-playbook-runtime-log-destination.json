              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "stderr"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (or 2) for the standard error stream."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "runtime:\n  log:\n    destination:\n      file: ./antora.log"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If this key is set, the specified destination is used instead of the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "default destination"
                  }
                ],
                "kind": "xref",
