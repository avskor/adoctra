                "kind": "text",
                "value": "spring-webflux"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " depends on "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "reactor-core"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and uses it internally to compose asynchronous logic and to provide Reactive Streams support. Generally, WebFlux APIs return "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Flux"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Mono"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " (since those are used internally) and leniently accept any Reactive Streams "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Publisher"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " implementation as input. When a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Publisher"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is provided, it can be treated only as a stream with unknown semantics (0..N). If, however, the semantics are known, you should wrap it with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Flux"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Mono.from(Publisher)"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " instead of passing the raw "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Publisher"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". The use of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Flux"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " versus "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Mono"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is important, because it helps to express cardinality — for example, whether a single or multiple asynchronous values are expected, and that can be essential for making decisions (for example, when encoding or decoding HTTP messages)."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "For annotated controllers, WebFlux transparently adapts to the reactive library chosen by the application. This is done with the help of the "
          },
          {
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ReactiveAdapterRegistry"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "kind": "link",
            "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/core/ReactiveAdapterRegistry.html"
          },
          {
            "kind": "text",
            "value": ", which provides pluggable support for reactive library and other asynchronous types. The registry has built-in support for RxJava 3, Kotlin coroutines and SmallRye Mutiny, but you can register others, too."
          }
        ],
        "roles": [],
        "title": null
      }
    ],
    "outline": null,
