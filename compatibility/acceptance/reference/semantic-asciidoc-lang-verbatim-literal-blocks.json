            "inlines": [
              {
                "kind": "text",
                "value": "When a line begins with one or more spaces it is displayed as a literal block. This method is an easy way to insert simple code snippets."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-indent",
            "inlines": [
              {
                "kind": "text",
                "value": " ~/secure/vault/defops"
              }
