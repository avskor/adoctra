              {
                "kind": "text",
                "value": "Literal blocks display the text you write exactly as you see it in the source. Literal text is treated as preformatted text. The text is presented in a fixed-width font and endlines are preserved. Only "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "special characters"
                  }
                ],
                "kind": "xref",
                "target": "subs:special-characters.html"
              },
              {
                "kind": "text",
                "value": " and callouts are replaced when the document is converted."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The literal style can be applied to content using any of the following methods:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "indenting the first line of a paragraph by one or more spaces,"
