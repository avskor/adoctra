                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "literal"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " style on a block using an attribute list, or"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "enclosing the content within a pair of literal block delimiters ("
                  },
                  {
                    "id": null,
