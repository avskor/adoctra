      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If you omit both the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "locations"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "value"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " attributes from the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ContextConfiguration"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation, the TestContext framework tries to detect a default Groovy script. Specifically, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "GenericGroovyXmlContextLoader"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "GenericGroovyXmlWebContextLoader"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " detect a default location based on the name of the test class. If your class is named "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "com.example.MyTest"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", the Groovy context loader loads your application context from "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "\"classpath:com/example/MyTestContext.groovy\""
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". The following example shows how to use the default:"
          }
        ],
