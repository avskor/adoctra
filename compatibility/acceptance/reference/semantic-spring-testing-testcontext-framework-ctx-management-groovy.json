      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can declare both XML configuration files and Groovy scripts simultaneously by using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "locations"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "value"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@ContextConfiguration"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". If the path to a configured resource location ends with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".xml"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", it is loaded by using an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "XmlBeanDefinitionReader"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Otherwise, it is loaded by using a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "GroovyBeanDefinitionReader"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following listing shows how to combine both in an integration test:"
              }
            ],
