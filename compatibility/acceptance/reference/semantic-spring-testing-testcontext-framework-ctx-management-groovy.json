    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "To load an "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " for your tests by using Groovy scripts that use the "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Groovy Bean Definition DSL"
              }
            ],
            "kind": "xref",
            "target": "core/beans/basics.html#beans-factory-groovy"
          },
          {
            "kind": "text",
            "value": ", you can annotate your test class with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ContextConfiguration"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and configure the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "locations"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "value"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " attribute with an array that contains the resource locations of Groovy scripts. Resource lookup semantics for Groovy scripts are the same as those described for "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "XML configuration files"
              }
            ],
            "kind": "xref",
            "target": "testing/testcontext-framework/ctx-management/xml.html"
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Support for using Groovy scripts to load an "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " in the Spring TestContext Framework is enabled automatically if Groovy is on the classpath."
          }
        ],
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Enabling Groovy script support"
          }
        ],
        "type": "tip"
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following example shows how to specify Groovy configuration files:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@ExtendWith(SpringExtension.class)\n// ApplicationContext will be loaded from \"/AppConfig.groovy\" and\n// \"/TestConfig.groovy\" in the root of the classpath\n@ContextConfiguration({\"/AppConfig.groovy\", \"/TestConfig.Groovy\"}) "
                        },
                        {
                          "guard": null,
                          "icons": null,
                          "id": "CO1-1",
                          "kind": "callout",
                          "number": "1",
                          "src": "",
