        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following pages list the keys and acceptable values or value types that are available when creating a custom theme. The keys are organized by category key. Each category represents a common prefix under which the (property) keys are typically nested."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Keys can be divided and nested wherever an underscore ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "_"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") or hyphen ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") appears in the name. For example, the key "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "base-text-align"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " can be expressed as the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "text-align"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key under the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "base"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " category key. This nested structure is for organizational purposes and not required. All keys are flatted when the theme is loaded. Although the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "title-page"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " category key contains a hyphen, it’s never split since "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "title"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is not a designated category key."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The converter uses the values of these keys to control how most elements are arranged and styled in the PDF. The default values listed in this section get inherited from the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "base theme"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://github.com/asciidoctor/asciidoctor-pdf/blob/{page-origin-refname}/data/themes/base-theme.yml"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The default theme has a different set of values from the base theme. Those values are not reflected in this guide. Consult the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "default theme"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://github.com/asciidoctor/asciidoctor-pdf/blob/{page-origin-refname}/data/themes/default-theme.yml"
              },
              {
                "kind": "text",
                "value": " to see what values it uses."
              }
            ],
            "roles": [],
            "title": null,
            "type": "important"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When creating a theme that extends the base theme, all keys are optional. Required keys are provided by the base theme. Therefore, you only have to declare keys that you want to override."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "category-keys",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Category keys"
          }
        ]
      }
    ],
