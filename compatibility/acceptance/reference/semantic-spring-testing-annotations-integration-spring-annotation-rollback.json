        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "When declared as a class-level annotation, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Rollback"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " defines the default rollback semantics for all test methods within the test class hierarchy. When declared as a method-level annotation, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Rollback"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " defines rollback semantics for the specific test method, potentially overriding class-level "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Rollback"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Commit"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " semantics."
          }
