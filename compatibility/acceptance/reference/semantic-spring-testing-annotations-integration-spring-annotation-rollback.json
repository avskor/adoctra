          },
          {
            "kind": "text",
            "value": " indicates whether the transaction for a transactional test method should be rolled back after the test method has completed. If "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "true"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", the transaction is rolled back. Otherwise, the transaction is committed (see also "
          },
          {
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Commit"
                  }
