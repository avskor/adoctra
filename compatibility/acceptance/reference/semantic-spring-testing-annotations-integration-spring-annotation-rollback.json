                "roles": []
              }
            ],
            "kind": "xref",
            "target": "testing/annotations/integration-spring/annotation-commit.html"
          },
          {
            "kind": "text",
            "value": "). Rollback for integration tests in the Spring TestContext Framework defaults to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "true"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " even if "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Rollback"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is not explicitly declared."
          }
        ],
