            "items": [
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "When you should use a URL versus a cross reference."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "How to create links with and without link text."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "How to escape a URL."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "How to handle complex URLs."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Use AsciiDoc’s URL syntax when you need to create a link to an external URL. External URLs are links to web pages that aren’t built as part of your documentation site by your Antora pipeline."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When you want to link to a page, image, or attachment that is part of your documentation site, use the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "AsciiDoc xref macro and the resource’s resource ID"
                  }
                ],
                "kind": "xref",
                "target": "page:xref.html"
              },
              {
                "kind": "text",
                "value": " instead."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "url-or-cross-reference",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "URL or cross reference?"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To create a link to an external URL, all you need to do is add the URL prefixed with its scheme."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": "ex-raw",
            "inlines": [
              {
                "kind": "text",
                "value": "Chat with other documentation writers at "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "chat.antora.org"
                  }
                ],
                "kind": "link",
                "target": "https://chat.antora.org"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Raw URL syntax"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Links that begin with official schemes, such as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "https"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ftp"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "mailto"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", etc., are automatically turned into hyperlinks when they’re processed. Here’s the result of "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Raw URL syntax"
                  }
                ],
                "kind": "xref",
                "target": "#ex-raw"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Chat with other documentation writers at "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "chat.antora.org"
                      }
                    ],
                    "kind": "link",
                    "target": "https://chat.antora.org"
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To attach a URL to text, enclose the text in square brackets ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[]"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") at the end of the URL."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-text",
            "inlines": [
              {
                "kind": "text",
                "value": "Looking for help?\nVisit the https://chat.antora.org[Antora chat room]."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "URL with link text syntax"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The result of "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 1"
                  }
                ],
                "kind": "xref",
