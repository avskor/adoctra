        "title": [
          {
            "kind": "text",
            "value": "URL syntax"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When you want to display a URL but you don’t want it to be active, you can escape it by prepending it with a backslash ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "\\"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-escape",
            "inlines": [
              {
                "kind": "text",
                "value": "This URL is displayed, \\https://gitlab.com, but isn't clickable."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Escape syntax"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s the result of "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 2"
                  }
                ],
                "kind": "xref",
                "target": "#ex-escape"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "This URL is displayed, https://gitlab.com, but isn’t clickable."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "escape-a-url",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Escape a URL"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A URL may not display correctly when it contains characters such as underscores ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "_"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") or carets ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "^"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") because these characters get interpreted as text formatting markup."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "There are two ways to solve this situation."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Option 1: Create a custom attribute for the URL."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Option 2: Use the inline pass macro with "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "macros"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " enabled."
                  }
                ]
              }
            ],
            "roles": [],
            "style": "no-bullet",
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Let’s make an "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "attribute"
                      }
                    ],
                    "kind": "xref",
                    "target": "page:define-and-modify-attributes.html#custom-attribute"
                  },
                  {
                    "kind": "text",
                    "value": " for a complex URL. Creating an attribute for a URL is also a good strategy when the URL is long; it keeps the source text clean for writers and editors."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": "ex-attribute",
                "inlines": [
                  {
                    "kind": "text",
                    "value": "= Page Title\n:url-peak: https://www.google.com/maps/place/Antora+Peak/@38.3249976,-106.2355882,14z/data=!3m1!4b1!4m5!3m4!1s0x871572433f469bd7:0xd2bdf15e615cd269!8m2!3d38.3249994!4d-106.2180786!5m1!1e4 "
                  },
                  {
                    "guard": null,
                    "icons": null,
                    "id": "CO1-1",
                    "kind": "callout",
                    "number": "1",
                    "src": "",
                    "xml": false
                  },
                  {
                    "kind": "text",
                    "value": "\n\n{url-peak}[This URL] was complicated, but a page attribute came to our rescue! "
                  },
                  {
                    "guard": null,
                    "icons": null,
                    "id": "CO1-2",
                    "kind": "callout",
                    "number": "2",
                    "src": "",
                    "xml": false
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Custom AsciiDoc attribute syntax"
                  }
                ]
              },
              {
                "context": "colist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "coids": [
                      "CO1-1"
                    ],
                    "icons": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Create an attribute, with the name of your choice, in the header of your source file. Assign the URL to it."
                      }
                    ],
                    "src": ""
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "coids": [
                      "CO1-2"
                    ],
                    "icons": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "When you want to create a link to that URL in your text, use the attribute (i.e., reference that attribute), as you would have used the URL."
                      }
                    ],
                    "src": ""
                  }
                ],
                "roles": [],
                "style": "arabic",
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The result of "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Example 3"
                      }
                    ],
                    "kind": "xref",
                    "target": "#ex-attribute"
                  },
                  {
                    "kind": "text",
                    "value": " is displayed below."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "blocks": [
                  {
                    "context": "paragraph",
                    "id": null,
                    "inlines": [
                      {
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "This URL"
                          }
                        ],
                        "kind": "link",
                        "metadata": {
                          "rel": "noopener",
                          "window": "_blank"
                        },
                        "target": "https://www.google.com/maps/place/Antora+Peak/@38.3249976,-106.2355882,14z/data=!3m1!4b1!4m5!3m4!1s0x871572433f469bd7:0xd2bdf15e615cd269!8m2!3d38.3249994!4d-106.2180786!5m1!1e4"
                      },
                      {
                        "kind": "text",
                        "value": " was complicated, but a page attribute came to our rescue!"
                      }
                    ],
                    "roles": [],
                    "title": null
                  }
                ],
                "context": "example",
                "id": null,
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "create-custom-attribute",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Create an attribute for a URL"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If you want to display a complex URL and ensure it doesn’t get caught up in any text formatting, put it inside a pass macro and enable the macros substitution, which is what substitutes links."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Here’s how a pass macro with the macros substitution enabled is constructed:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pass:macros[URL goes between these brackets]"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Here’s a pass macro in action:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": "ex-pass",
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Anyone want to climb this 13er with me? (pass:macros[https://www.14ers.com/13ers/peak.php?peakkey=4740])"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
