            "language": "asciidoc",
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_sample_with_man_link_adoc",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "sample-with-man-link.adoc"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "class ManInlineMacro < Asciidoctor::Extensions::InlineMacroProcessor\n  use_dsl\n\n  named :man\n  name_positional_attributes 'volnum'\n\n  def process parent, target, attrs\n    doc = parent.document\n    text = manname = target\n    suffix = (volnum = attrs['volnum']) ? %((#{volnum})) : ''\n    if doc.basebackend? 'html'\n      target = %(#{manname}#{doc.outfilesuffix})\n      doc.register :links, target\n      node = create_anchor parent, text, type: :link, target: target\n    elsif doc.backend == 'manpage'\n      node = create_inline parent, :quoted, manname, type: :strong\n    else\n      node = create_inline parent, :quoted, manname\n    end\n    create_inline parent, :quoted, %(#{node.convert}#{suffix})\n  end\nend"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_manpageinlinemacro",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "ManpageInlineMacro"
          }
        ]
      },
      {
