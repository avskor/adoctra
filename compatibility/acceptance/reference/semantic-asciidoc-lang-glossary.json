    },
    "blocks": [
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "This glossary is a work in progress. It does not include all the terms in AsciiDoc."
          }
        ],
        "roles": [],
        "title": null,
        "type": "caution"
      },
      {
        "context": "dlist",
        "id": null,
        "items": [
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "an expression for dereferencing the value of a document attribute."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "attribute reference"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "the source text that defines attributes for an element (i.e., block, block macro, inline macro) or an include directive."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "attrlist"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "a callout paragraph or block that has a label or icon indicating its priority."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "admonition"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "a moniker for the expected output format; used as a key to select which converter to use; often used interchangeably with the name of a converter (i.e., the \"html5\" backend\")."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "backend"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "a line-oriented chunk of content in an AsciiDoc document."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "block element"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "an attribute associated with a delimited block or paragraph; these attributes can affect processing of the block, and are available to block processors, but cannot be referenced using an attribute reference."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "block attribute"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "used to refer to custom blocks, which can map an arbitrary name to one or more contexts; has a similar role as the style for a built-in block, such as an admonition block"
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "block name"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "a modifier that specializes the context of a block"
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "block style"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "a document attribute that controls processing, integrations, styling, and localization."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "built-in attribute"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "determines how the content of a block is parsed and processed (e.g., simple, compound, verbatim, raw, etc.)"
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "content model"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "the element’s type; describes the primary function of an element (e.g., sidebar, listing, example)"
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "context"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "a software component that an AsciiDoc processor calls to convert a parsed AsciiDoc document to a given output format; the converter and output format are correlated using a backend identifier."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "converter"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "a link from one location in the document to another location marked by an anchor."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "cross reference"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "an attribute associated with the document (node); in other words, an attribute in the global document attributes dictionary; the value of these attributes can be referenced using an attribute reference; if defined in the header, the document attribute is known as a header attribute."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "document attribute"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "discrete content in the source or output document. May be a branch (contains child elements) or a leaf (does not contain child elements)."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "element"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "an attribute associated with a block, macro, formatted text, or the include directive; these attributes can affect processing of the element (or include directive) and are available in the document model; however, the value of these attributes cannot be resolved using an attribute reference."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "element attribute"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "a dynamic document attribute that pertains to, or gives information about, the runtime environment."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "environment attribute"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "a document attribute defined in the document header; visible from all nodes in the document; often required for global settings such as the source highlighter or icons mode."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "header attribute"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "a phrase (i.e., span of content) within a block element or one of its attributes in an AsciiDoc document."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "inline element"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "a plus sign ("
                },
                {
                  "id": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "+"
                    }
                  ],
                  "kind": "monospace",
                  "roles": []
                },
                {
                  "kind": "text",
                  "value": ") on a line by itself that connects adjacent lines of text to a list item."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "list continuation"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "a syntax for representing non-text elements or that expands into text using the provided metadata."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "macro"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "an attribute associated with a block or inline macro; these attributes can affect processing of the macro, and are available to macro processors, but cannot be referenced using an attribute reference."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "macro attribute"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "an in-memory representation of a block or inline element in the parsed document model."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "node"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "a document attribute defined for convenience; often used for inserting special content characters."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "predefined attribute"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "the fixed set of reusable block enclosures (delimited regions) defined by the AsciiDoc language; implies the block’s content model; characterized by a pair of matching delimited lines defining the boundaries of the block’s content"
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "structural container"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "text which is enclosed in special punctuation to give it emphasis or special meaning."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "quoted text"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "a document attribute defined by the content author; used for storing reusable content, and controlling conditional inclusion."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "user-defined attribute"
                }
              ]
            ]
          }
        ],
        "roles": [],
        "title": null
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Glossary of Terms"
      }
    ]
  }
}
