            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor::Extensions.register do\n  docinfo_processor GoogleAnalyticsDocinfoProcessor\nend\n\nAsciidoctor.convert_file 'sample.adoc', safe: :safe, attributes: 'UA-ABCXYZ123'"
              }
