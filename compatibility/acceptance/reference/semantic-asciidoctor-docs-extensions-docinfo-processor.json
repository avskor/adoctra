            "inlines": [
              {
                "kind": "text",
                "value": "class GoogleAnalyticsDocinfoProcessor < Asciidoctor::Extensions::DocinfoProcessor\n  use_dsl\n  at_location :footer\n  def process document\n    return unless (ga_account_id = document.attr 'google-analytics-account')\n    %(<script>\n(function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){\n(i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),\nm=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)\n})(window,document,'script','https://www.google-analytics.com/analytics.js','ga');\nga('create','#{ga_account_id}','auto');\nga('send','pageview');\n</script>)\n  end\nend"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_googleanalyticsdocinfoprocessor",
        "level": 1,
        "roles": [],
        "title": [
