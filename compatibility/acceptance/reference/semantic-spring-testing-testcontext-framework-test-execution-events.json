                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " offers an alternative approach to implementing a custom "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TestExecutionListener"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Components in the test’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " can listen to the following events published by the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "EventPublishingTestExecutionListener"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
