{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The Spring TestContext Framework provides basic support for executing tests in parallel within a single JVM. In general, this means that most test classes or test methods can be run in parallel without any changes to test code or configuration."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "For details on how to set up parallel test execution, see the documentation for your testing framework, build tool, or IDE."
          }
        ],
        "roles": [],
        "title": null,
        "type": "tip"
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Keep in mind that the introduction of concurrency into your test suite can result in unexpected side effects, strange runtime behavior, and tests that fail intermittently or seemingly randomly. The Spring Team therefore provides the following general guidelines for when not to run tests in parallel."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Do not run tests in parallel if the tests:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "ulist",
        "id": null,
        "items": [
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Use Spring Framework’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@DirtiesContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " support."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Use Spring Framework’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@MockitoBean"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@MockitoSpyBean"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " support."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Use Spring Boot’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@MockBean"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@SpyBean"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " support."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Use JUnit 4’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@FixMethodOrder"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " support or any testing framework feature that is designed to ensure that test methods run in a particular order. Note, however, that this does not apply if entire test classes are run in parallel."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Change the state of shared services or systems such as a database, message broker, filesystem, and others. This applies to both embedded and external systems."
              }
            ]
          }
        ],
        "roles": [],
        "style": null,
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If parallel test execution fails with an exception stating that the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " for the current test is no longer active, this typically means that the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " was removed from the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ContextCache"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in a different thread."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This may be due to the use of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@DirtiesContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or due to automatic eviction from the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ContextCache"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". If "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@DirtiesContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is the culprit, you either need to find a way to avoid using "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@DirtiesContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or exclude such tests from parallel execution. If the maximum size of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ContextCache"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " has been exceeded, you can increase the maximum size of the cache. See the discussion on "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "context caching"
                  }
                ],
                "kind": "xref",
                "target": "testing/testcontext-framework/ctx-management/caching.html"
              },
              {
                "kind": "text",
                "value": " for details."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "admonition",
        "id": null,
        "roles": [],
        "title": null,
        "type": "tip"
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Parallel test execution in the Spring TestContext Framework is only possible if the underlying "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "TestContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " implementation provides a copy constructor, as explained in the javadoc for "
          },
          {
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TestContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "kind": "link",
            "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/test/context/TestContext.html"
          },
          {
            "kind": "text",
            "value": ". The "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DefaultTestContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " used in Spring provides such a constructor. However, if you use a third-party library that provides a custom "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "TestContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " implementation, you need to verify that it is suitable for parallel test execution."
          }
        ],
        "roles": [],
        "title": null,
        "type": "warning"
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Parallel Test Execution"
      }
    ]
  }
}
