                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), and then the span operator ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "+"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
