                    "kind": "text",
                    "value": "span factor"
                  }
                ],
                "kind": "strong",
                "roles": [
                  "term"
                ]
              },
              {
                "kind": "text",
                "value": " indicates the number columns, rows, or columns and rows a cell should span."
              }
            ],
            "roles": [],
            "title": null
          },
