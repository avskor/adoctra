                    "kind": "text",
                    "value": "span"
                  }
                ],
                "kind": "strong",
                "roles": [
                  "term"
                ]
              },
              {
                "kind": "text",
                "value": " a table cell can stretch across adjacent columns, rows, or a block of adjacent columns and rows. A span consists of a span factor and a span operator."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
