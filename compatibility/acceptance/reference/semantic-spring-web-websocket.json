    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This part of the reference documentation covers support for Servlet stack, WebSocket messaging that includes raw WebSocket interactions, WebSocket emulation through SockJS, and publish-subscribe messaging through STOMP as a sub-protocol over WebSocket."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The WebSocket protocol, "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "RFC 6455"
                  }
                ],
                "kind": "link",
                "target": "https://datatracker.ietf.org/doc/html/rfc6455"
              },
              {
                "kind": "text",
                "value": ", provides a standardized way to establish a full-duplex, two-way communication channel between client and server over a single TCP connection. It is a different TCP protocol from HTTP but is designed to work over HTTP, using ports 80 and 443 and allowing re-use of existing firewall rules."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A WebSocket interaction begins with an HTTP request that uses the HTTP "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Upgrade"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " header to upgrade or, in this case, to switch to the WebSocket protocol. The following example shows such an interaction:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "GET /spring-websocket-portfolio/portfolio HTTP/1.1\nHost: localhost:8080\nUpgrade: websocket "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO1-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\nConnection: Upgrade "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO1-2",
                "kind": "callout",
                "number": "2",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\nSec-WebSocket-Key: Uc9l9TMkWGbHFD2qnFHltg==\nSec-WebSocket-Protocol: v10.stomp, v11.stomp\nSec-WebSocket-Version: 13\nOrigin: http://localhost:8080"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          },
          {
            "context": "colist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-1"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Upgrade"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " header."
                  }
                ],
                "src": ""
              },
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-2"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Using the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Upgrade"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " connection."
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Instead of the usual 200 status code, a server with WebSocket support returns output similar to the following:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "HTTP/1.1 101 Switching Protocols "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO2-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\nUpgrade: websocket\nConnection: Upgrade\nSec-WebSocket-Accept: 1qVdfYHU9hPOl4JYYNXF623Gzn0=\nSec-WebSocket-Protocol: v10.stomp"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          },
          {
            "context": "colist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO2-1"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Protocol switch"
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "After a successful handshake, the TCP socket underlying the HTTP upgrade request remains open for both the client and the server to continue to send and receive messages."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A complete introduction of how WebSockets work is beyond the scope of this document. See RFC 6455, the WebSocket chapter of HTML5, or any of the many introductions and tutorials on the Web."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Note that, if a WebSocket server is running behind a web server (for example, nginx), you likely need to configure it to pass WebSocket upgrade requests on to the WebSocket server. Likewise, if the application runs in a cloud environment, check the instructions of the cloud provider related to WebSocket support."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Even though WebSocket is designed to be HTTP-compatible and starts with an HTTP request, it is important to understand that the two protocols lead to very different architectures and application programming models."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In HTTP and REST, an application is modeled as many URLs. To interact with the application, clients access those URLs, request-response style. Servers route requests to the appropriate handler based on the HTTP URL, method, and headers."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "By contrast, in WebSockets, there is usually only one URL for the initial connect. Subsequently, all application messages flow on that same TCP connection. This points to an entirely different asynchronous, event-driven, messaging architecture."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "WebSocket is also a low-level transport protocol, which, unlike HTTP, does not prescribe any semantics to the content of messages. That means that there is no way to route or process a message unless the client and the server agree on message semantics."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "WebSocket clients and servers can negotiate the use of a higher-level, messaging protocol (for example, STOMP), through the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Sec-WebSocket-Protocol"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " header on the HTTP handshake request. In the absence of that, they need to come up with their own conventions."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "http-versus-websocket",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "HTTP Versus WebSocket"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "WebSockets can make a web page be dynamic and interactive. However, in many cases, a combination of AJAX and HTTP streaming or long polling can provide a simple and effective solution."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "For example, news, mail, and social feeds need to update dynamically, but it may be perfectly okay to do so every few minutes. Collaboration, games, and financial apps, on the other hand, need to be much closer to real-time."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Latency alone is not a deciding factor. If the volume of messages is relatively low (for example, monitoring network failures) HTTP streaming or polling can provide an effective solution. It is the combination of low latency, high frequency, and high volume that make the best case for the use of WebSocket."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Keep in mind also that over the Internet, restrictive proxies that are outside of your control may preclude WebSocket interactions, either because they are not configured to pass on the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Upgrade"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " header or because they close long-lived connections that appear idle. This means that the use of WebSocket for internal applications within the firewall is a more straightforward decision than it is for public facing applications."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "when-to-use-websockets",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "When to Use WebSockets"
              }
            ]
          }
        ],
        "context": "section",
        "id": "introduction-to-websocket",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Introduction to WebSocket"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "WebSockets"
      }
    ]
  }
