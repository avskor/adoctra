{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Like programming languages, AsciiDoc provides a way to add commentary to your document that’s not carried over into the published document. This artifact is collectively known as a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "comment"
                  }
                ],
                "kind": "strong",
                "roles": [
                  "term"
                ]
              },
              {
                "kind": "text",
                "value": ". Putting text in a comment is often referred to as “commenting it out”."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A comment is often used to insert a writer-facing notation or to hide draft content that’s not ready for publishing. In general, you can use comments anytime you want to hide lines from the processor. Comments can also be useful as a processor hint to keep adjacent blocks of content separate."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The AsciiDoc processor will ignore comments during parsing and, thus, will not include them in the parsed document. It will, however, account for the lines when mapping line numbers back to the source document."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "AsciiDoc supports two styles of comments, line and block. A line comment is for making comments line-by-line (i.e., comment line). A block comment is for enclosing an arbitrary range of lines as a comment (i.e., comment block)."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A comment line is any line outside of a verbatim block that begins with a double forward slash ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "//"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") that’s not immediately followed by a third forward slash. Following this prefix, the line may contain an arbitrary number of characters. It’s customary to insert a single space between the prefix and the comment text (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "// line comment"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "// A single-line comment."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Line comment syntax"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the processor encounters a line comment, it ignores the line and continues processing as though the line is not there. Line comments are processed as lines are read, so they can be used where paragraph text is not permitted, such as between attribute entries in the document header."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Line comments can be used strategically to separate blocks that otherwise have affinity, such as two adjacent lists."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "* first list\n\n//\n\n* second list"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Line comment separating two lists"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In this case, the single line comment effectively acts as an empty paragraph that’s dropped from the parsed document. But before then, it will have served its purpose as a block boundary."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "comment-lines",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Comment lines"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A comment block is a specialized delimited block. It consists of an arbitrary number of lines bounded on either side by "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "////"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " delimiter lines."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A comment block can be used anywhere a delimited block is normal accepted. The main difference is that once the block is read, it’s dropped from the parsed document (effectively ignored). Additionally, no AsciiDoc syntax within the delimited lines is interpreted, not even preprocessor directives."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "////\nA comment block.\n\nNotice it's a delimited block.\n////"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Block comment syntax"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A comment block can also be written as an open block with the comment style:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[comment]\n--\nA comment block.\n\nNotice it's a delimited block.\n--"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Alternate block comment syntax"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A comment block that can consists of a single paragraph can be written as a paragraph with the comment style:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[comment]\nA paragraph comment.\nLike all paragraphs, the lines must be contiguous.\n\nNot a comment."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Comment paragraph syntax"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If comment blocks are used in a list item, they must be attached to the list item just like any other block."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "* first item\n+\n////\nA comment block in a list.\n\nNotice it's attached to the preceding list item.\n////\n\n* second item"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Block comment attached to list item"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Within a table, a comment block can only be used in an AsciiDoc table cell."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "|===\na|\ncell text\n\n////\nA comment block in a table.\n\nNotice the cell has the \"a\" (AsciiDoc) style.\n////\n|==="
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Block comment within a table"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Comment blocks can be very effective for commenting out sections of the document that are not ready for publishing or that provide background material or an outline for the text being drafted."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_comment_blocks",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Comment blocks"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Comments"
      }
    ]
  }
}
