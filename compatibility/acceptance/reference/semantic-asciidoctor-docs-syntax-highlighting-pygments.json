      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can further customize the source block output with additional Pygments attributes."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Sets the name of the color theme Pygments uses. To see the list of available style names, see "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Available Pygments style names"
                        }
                      ],
                      "kind": "xref",
                      "target": "#listing-pygments-style-names"
                    },
                    {
                      "kind": "text",
                      "value": ". Default: "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "pastie"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": "."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "pygments-style"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Controls what method is used for applying CSS to the tokens. Can be "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "class"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " (CSS classes) or "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "style"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " (inline styles). See the "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Pygments stylesheet section"
                        }
                      ],
                      "kind": "xref",
                      "target": "html-backend:source-highlighting-stylesheets.html#pygments"
                    },
                    {
                      "kind": "text",
                      "value": " to learn more about how the value "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "class"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " is handled. Default: "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "class"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": "."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "pygments-css"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Controls how line numbers are arranged when line numbers are enabled on the source block. Can be "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "table"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " or "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "inline"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ". If line wrapping is enabled on preformatted blocks (i.e., "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "prewrap"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": "), and you want to use line numbering on source blocks, you must set the value of this attribute to "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "inline"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " in order for the numbers to line up properly with their target lines. Default: "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "table"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": "."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "pygments-linenums-mode"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ":source-highlighter: pygments\n:pygments-style: manni\n:pygments-linenums-mode: inline\n\n[%linenums,ruby]\n----\nORDERED_LIST_KEYWORDS = {\n  'loweralpha' => 'a',\n  'lowerroman' => 'i',\n  'upperalpha' => 'A',\n  'upperroman' => 'I'\n   #'lowergreek' => 'a'\n   #'arabic'     => '1'\n   #'decimal'    => '1'\n}\n----"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Customizing a source block with Pygments attributes"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "To list the available Pygments styles, run the following command in a terminal:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "literal",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "$ $(dirname $(gem which pygments.rb))/../vendor/pygments-main/pygmentize -L styles"
                  }
                ],
                "language": null,
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The pygments.rb gem uses a bundled version of Pygments (often ahead of the latest release). This command ensures that you are invoking the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "pygmentize"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " command from the Pygments used by that gem."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "listing-pygments-style-names",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Available Pygments style names"
              }
            ]
          }
        ],
        "context": "section",
        "id": "_pygments_attributes",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Pygments attributes"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you’re using pygments.rb 1.x, you may need to adjust the timeout. This configuration step is not necessary if you’re using pygments.rb 2.x with Python 3."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Since Pygments is an external program, the call to that command in pygments.rb 1.x is managed by a timeout to safeguard against a hanging process. By default, this timeout is 8 seconds. If you discover that the call is failing to complete within this timeout period, you can increase the timeout (in seconds) by setting the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MENTOS_TIMEOUT"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " environment variable."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "export MENTOS_TIMEOUT=30"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Now the call to Pygments (via pygments.rb 1.x) will be allocated up to 30 seconds to complete."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "pygments-timeout",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Pygments timeout (pygments.rb 1.x only)"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you already have Pygments installed on your system, you want to use your own fork, or you want to customize how Pygments is configured, you can get Asciidoctor to use a custom version of Pygments instead of the one bundled with the pygments.rb gem."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "First, install your own version of Pygments. You can do this, for instance, by cloning the upstream Pygments repository:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ hg clone https://bitbucket.org/birkenfeld/pygments-main pygments"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Find the directory that contains the file "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pygmentize"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " or the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Makefile"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": ". That’s your Pygments installation path. Make note of it."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Next, create a script to run "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "before"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " invoking Asciidoctor for the first time. Let’s call it "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pygments_init.rb"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": ". Populate the script with the following content:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "require 'pygments'\n\n# use a custom Pygments installation (directory that contains pygmentize)\nPygments.start '/path/to/pygments'\n\n# example of registering a missing or additional lexer\n#Pygments::Lexer.create name: 'Turtle', aliases: ['turtle'],\n#    filenames: ['*.ttl'], mimetypes: ['text/turtle', 'application/x-turtle']"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "pygments_init.rb"
              }
            ]
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You could enhance this script to read the Pygments installation path from an environment variable (or configuration file)."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Now just require this script before your invoke Asciidoctor the first time. When using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " command, pass the script using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-r"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " flag:"
              }
