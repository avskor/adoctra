                "value": "extends"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " key should always be the first key in the theme file. The key accepts either a single value or an array of values. Each value is interpreted as a filename with an implicit "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "-theme.yml"
              }
            ],
            "kind": "monospace",
            "roles": []
