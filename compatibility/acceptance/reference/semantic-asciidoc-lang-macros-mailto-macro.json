{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The mailto macro is a specialization of the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "URL macro"
                  }
                ],
                "kind": "xref",
                "target": "url-macro.html"
              },
              {
                "kind": "text",
                "value": " that adds support for defining an email link with text and augmenting it with additional metadata, such as a subject and body."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Using an attribute list, you can specify link text as well as named attributes such as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "id"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "role"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Unlike other URL macros, you must add the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "mailto:"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " prefix in front of the email address in order to append an attribute list."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example of an email link with explicit link text."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "mailto:join@discuss.example.org[Subscribe]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want to add a role to this link, you can do so by appending the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "role"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute after a comma."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "mailto:join@discuss.example.org[Subscribe,role=email]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the link text contains a comma, you must enclose the text in double quotes. Otherwise, the portion of the text that follows the comma will be interpreted as additional attribute list entries."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "mailto:join@discuss.example.org[\"Click, subscribe, and participate!\"]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To learn more about how the attributes are parsed, refer to "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "attribute parsing"
                  }
                ],
                "kind": "xref",
                "target": "link-macro-attribute-parsing.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_link_text_and_named_attributes",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Link text and named attributes"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Like with other URL macros, the first positional attribute of the email macro is the link text. If a comma is present in the text, and the text is not enclosed in quotes, or the comma comes after the closing quote, the next positional attribute is treated as the subject line."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For example, you can configure the email link to populate the subject line when the reader clicks the link as follows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "mailto:join@discuss.example.org[Subscribe,Subscribe me]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the reader clicks the link, a conforming email client will fill in the subject line with “Subscribe me”."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want the body of the email to also be populated, specify the body text in the third positional argument."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "mailto:join@discuss.example.org[Subscribe,Subscribe me,I want to participate.]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the reader clicks the link, a conforming email client will fill in the body with “I want to participate.”"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want to reuse the email address as the link text, leave the first positional attribute empty."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "mailto:join@discuss.example.org[,Subscribe me,I want to participate.]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you only want to specify a subject, leave off the body."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "mailto:join@discuss.example.org[,Subscribe me]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If either the subject or body contains a comma, that value must be enclosed in double quotes."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "mailto:join@discuss.example.org[Subscribe,\"I want to participate, so please subscribe me\"]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To learn more about how the attributes are parsed, refer to "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "attribute parsing"
                  }
                ],
                "kind": "xref",
                "target": "link-macro-attribute-parsing.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_subject_and_body",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Subject and body"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Mailto Macro"
      }
    ]
  }
}
