            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An RGB array is automatically converted to a hex string internally, so there’s no difference between ff0000 and [255, 0, 0]."
