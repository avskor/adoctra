          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Spring WebFlux provides built-in support for "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Jackson’s Serialization Views"
                  }
                ],
                "kind": "link",
                "target": "https://www.baeldung.com/jackson-json-view-annotation"
              },
              {
                "kind": "text",
                "value": ", which allows rendering only a subset of all fields in an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Object"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". To use it with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@ResponseBody"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ResponseEntity"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " controller methods, you can use Jackson’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@JsonView"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotation to activate a serialization view class, as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@RestController\npublic class UserController {\n\n\t@GetMapping(\"/user\")\n\t@JsonView(User.WithoutPasswordView.class)\n\tpublic User getUser() {\n\t\treturn new User(\"eric\", \"7!jd#h23\");\n\t}\n}\n\npublic class User {\n\n\tpublic interface WithoutPasswordView {};\n\tpublic interface WithPasswordView extends WithoutPasswordView {};\n\n\tprivate String username;\n\tprivate String password;\n\n\tpublic User() {\n\t}\n\n\tpublic User(String username, String password) {\n\t\tthis.username = username;\n\t\tthis.password = password;\n\t}\n\n\t@JsonView(WithoutPasswordView.class)\n\tpublic String getUsername() {\n\t\treturn this.username;\n\t}\n\n\t@JsonView(WithPasswordView.class)\n\tpublic String getPassword() {\n\t\treturn this.password;\n\t}\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
