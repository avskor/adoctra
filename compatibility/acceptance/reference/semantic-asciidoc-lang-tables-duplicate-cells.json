        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To duplicate a cell, enter the duplication factor and duplication operator ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<n>*"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") in the cell specifier. Don’t insert any spaces between the duplication, any alignment or style operators (if present), and the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "cell’s separator"
                  }
                ],
                "kind": "xref",
                "target": "add-cells-and-rows.html#cell-separator"
              },
              {
                "kind": "text",
                "value": " ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "|"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          },
