    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The Asciidoctor PDF converter introduces a dedicated title page at the start of the document. The title page contains the doctitle, author, date, and revision info. The title page can be styled using the theme and reserved page attributes."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The title page is enabled if one of these conditions is met:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "doctype"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " document attribute is set to "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "book"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", or"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "title-page"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " document attribute is set with an empty value in the document header."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The title page is only enabled by default for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "book"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " doctype. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "doctype"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is set and assigned "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "book"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " either in the document header or using the CLI."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Document Title\n:doctype: book"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To force the title page to be used for other doctypes, set the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "title-page"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute in the document header."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Document Title\n:title-page:"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If a front cover image is specified, the title page comes after the front cover. When the title page is enabled, the table of contents also gets its own page (or pages, if necessary)."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "activate",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Activate the title page"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For documents that declare the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "book"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " doctype, the title page can be omitted by setting the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "notitle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute in the AsciiDoc document header. (Its counterpart, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ":!showtitle:"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", does not work with Asciidoctor PDF.)"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Document Title\n:doctype: book\n:notitle:"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The title page can also be "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "deactivated from the theme"
                  }
                ],
                "kind": "xref",
                "target": "theme:title-pages.html#deactivate"
              },
              {
                "kind": "text",
                "value": " by setting the value of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "title-page"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " category key to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "false"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". For all other doctypes, the title page is not added by default. In that case, setting the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ":notitle:"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute only removes the document title from the first page of content."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "notitle-attribute",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Deactivate with notitle attribute"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The author and revision information is displayed on the title page by default. If the document does not have a title page, you must use explicit references to this information in the text in order for it to be displayed."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example of how to display the author and revision information in an article without a title page."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Article Title\nAuthor Name\nv1.0, 2020-02-20\n\n[.metadata]\n{author} -- version {revnumber}, {revdate}\n\nBegin main content."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can style this line by "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "defining a role"
                  }
                ],
                "kind": "xref",
                "target": "roles.html#custom"
              },
              {
                "kind": "text",
                "value": " in a custom theme."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "author-and-revision-information",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Author and revision information"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can place a logo image on the title page using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "title-logo-image"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " document attribute. Using an inline image macro, you can specify attributes to position and resize the image. The special "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "top"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute is recognized in this context for setting the vertical position of the image."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Document Title\nAuthor Name\n:title-logo-image: image:logo.png[top=25%,align=center,pdfwidth=0.5in]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The value of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "top"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute is the distance from the top of the content area (just below the top margin). It can either be a fixed value (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "1in"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") or relative value ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "10%"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). A fixed value is converted to a point value. A percentage value is multiplied by the height of the content area (the area inside the top and bottom margins). The advantage of a fixed value is that it gives you precision. The advantage of a relative value is that it automatically adjusts for different page sizes."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "logo",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Logo image"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can place a background image on the title page using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "title-page-background-image"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " document attribute."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Document Title\nAuthor Name\n:title-page-background-image: image:title-bg.png[]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By default, page background images are automatically scaled to fit the bounds of the page (i.e., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fit=contain"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") and centered (i.e., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "position=center"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "background-images.html"
                  }
                ],
                "kind": "xref",
                "target": "background-images.html"
              },
              {
                "kind": "text",
                "value": " to learn more."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you need to add two images to the title page, you can add one as a background image and the other as a logo image. To position the image added using a background image, you can either use "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fit=none"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in combination with the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "position"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute on the macro, or you can position the image on an image canvas matching the size of the page. When using the canvas technique, the background image could contributed several images to the page. You can then position the image added as a logo image as described in "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Logo image"
                  }
                ],
                "kind": "xref",
                "target": "#logo"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "background",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Background image"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Title Page"
      }
    ]
  }
}
