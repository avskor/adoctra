                          "inlines": [
                            {
                              "kind": "text",
                              "value": "Inventor tesla = new Inventor(\"Nikola Tesla\", \"Serbian\");\n\nEvaluationContext context = SimpleEvaluationContext.forReadWriteDataBinding().build();\ncontext.setVariable(\"newName\", \"Mike Tesla\");\n\nparser.parseExpression(\"name = #newName\").getValue(context, tesla);\nSystem.out.println(tesla.getName());  // \"Mike Tesla\""
                            }
                          ],
