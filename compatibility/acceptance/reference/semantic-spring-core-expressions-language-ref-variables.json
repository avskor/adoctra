                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "// Create a list of prime integers.\nList<Integer> primes = List.of(2, 3, 5, 7, 11, 13, 17);\n\n// Create parser and set variable 'primes' as the list of integers.\nExpressionParser parser = new SpelExpressionParser();\nEvaluationContext context = SimpleEvaluationContext.forReadWriteDataBinding().build();\ncontext.setVariable(\"primes\", primes);\n\n// Select all prime numbers > 10 from the list (using selection ?{...}).\nString expression = \"#primes.?[#this > 10]\";\n\n// Evaluates to a list containing [11, 13, 17].\nList<Integer> primesGreaterThanTen =\n\t\tparser.parseExpression(expression).getValue(context, List.class);"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
