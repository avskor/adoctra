            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Keys almost always require a value of a specific type. The reference page for each "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "key category"
                  }
                ],
                "kind": "xref",
                "target": "keys.html"
              },
              {
