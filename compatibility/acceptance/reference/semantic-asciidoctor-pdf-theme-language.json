                "value": " specifies the acceptable values or value types per key."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "values",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Key values"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Keys may be nested to an arbitrary depth to eliminate redundant prefixes. Once the theme is loaded, all keys are flattened into a single map of qualified keys. Nesting is simply a shorthand way of organizing the keys. In the end, a theme is just a map of key/value pairs."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Nested keys are adjoined to their parent key with an underscore ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "_"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") or hyphen ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). This means the selector part (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "link"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") is combined with the property name (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "font-color"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") into a single, qualified key (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "link_font_color"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "link-font-color"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For example, let’s assume we want to set the base (i.e., global) font size and color. These keys may be written longhand:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "base-font-color: #333333\nbase-font-family: Times-Roman\nbase-font-size: 12"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Or, to avoid having to type the prefix "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "base-"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " multiple times, the keys may be written as a hierarchy:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "base:\n  font-color: #333333\n  font-family: Times-Roman\n  font-size: 12"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Or even:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "base:\n  font:\n    color: #333333\n    family: Times-Roman\n    size: 12"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Each level of nesting must be indented by two spaces from the indentation of the parent level. Also note the presence of the colon ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ":"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") after each key name."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "key-nesting",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Key nesting"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Like CSS, inheritance is a principal feature in the Asciidoctor PDF theme language. For many of the properties, if a key is not specified, the key inherits the value applied to the parent content in the content hierarchy. This behavior saves you from having to specify properties unless you want to override the inherited value."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following keys are inherited:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "font-family"
                      }
                    ],
