        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Typically, the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ExceptionHandler"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@InitBinder"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ModelAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " methods apply within the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Controller"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " class (or class hierarchy) in which they are declared. If you want such methods to apply more globally (across controllers), you can declare them in a class annotated with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ControllerAdvice"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RestControllerAdvice"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ControllerAdvice"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is annotated with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Component"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", which means that such classes can be registered as Spring beans through "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "component scanning"
              }
            ],
            "kind": "xref",
            "target": "core/beans/java/instantiating-container.html#beans-java-instantiating-container-scan"
          },
          {
            "kind": "text",
            "value": " . "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RestControllerAdvice"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is a composed annotation that is annotated with both "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ControllerAdvice"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ResponseBody"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", which essentially means "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ExceptionHandler"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " methods are rendered to the response body through message conversion (versus view resolution or template rendering)."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "On startup, the infrastructure classes for "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestMapping"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ExceptionHandler"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " methods detect Spring beans annotated with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ControllerAdvice"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and then apply their methods at runtime. Global "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ExceptionHandler"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " methods (from a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ControllerAdvice"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ") are applied "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "after"
              }
            ],
            "kind": "emphasis",
            "roles": []
          },
          {
            "kind": "text",
            "value": " local ones (from the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Controller"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "). By contrast, global "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ModelAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@InitBinder"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " methods are applied "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "before"
              }
            ],
            "kind": "emphasis",
            "roles": []
          },
          {
            "kind": "text",
            "value": " local ones."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "By default, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ControllerAdvice"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " methods apply to every request (that is, all controllers), but you can narrow that down to a subset of controllers by using attributes on the annotation, as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "// Target all Controllers annotated with @RestController\n@ControllerAdvice(annotations = RestController.class)\npublic class ExampleAdvice1 {}\n\n// Target all Controllers within specific packages\n@ControllerAdvice(\"org.example.controllers\")\npublic class ExampleAdvice2 {}\n\n// Target all Controllers assignable to specific classes\n@ControllerAdvice(assignableTypes = {ControllerInterface.class, AbstractController.class})\npublic class ExampleAdvice3 {}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "// Target all Controllers annotated with @RestController\n@ControllerAdvice(annotations = [RestController::class])\npublic class ExampleAdvice1 {}\n\n// Target all Controllers within specific packages\n@ControllerAdvice(\"org.example.controllers\")\npublic class ExampleAdvice2 {}\n\n// Target all Controllers assignable to specific classes\n@ControllerAdvice(assignableTypes = [ControllerInterface::class, AbstractController::class])\npublic class ExampleAdvice3 {}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
