        "title": [
          {
            "kind": "text",
            "value": "Pointcut Superclasses"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Because pointcuts in Spring AOP are Java classes rather than language features (as in AspectJ), you can declare custom pointcuts, whether static or dynamic. Custom pointcuts in Spring can be arbitrarily complex. However, we recommend using the AspectJ pointcut expression language, if you can."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Later versions of Spring may offer support for “semantic pointcuts” as offered by JAC — for example, “all methods that change instance variables in the target object.”"
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          }
