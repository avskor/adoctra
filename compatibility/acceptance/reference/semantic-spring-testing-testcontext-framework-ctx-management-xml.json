    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "To load an "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " for your tests by using XML configuration files, annotate your test class with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ContextConfiguration"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and configure the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "locations"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " attribute with an array that contains the resource locations of XML configuration metadata. A plain or relative path (for example, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "context.xml"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ") is treated as a classpath resource that is relative to the package in which the test class is defined. A path starting with a slash is treated as an absolute classpath location (for example, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "/org/example/config.xml"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "). A path that represents a resource URL (i.e., a path prefixed with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "classpath:"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "file:"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "http:"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", etc.) is used "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "as is"
              }
            ],
            "kind": "emphasis",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
