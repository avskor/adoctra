                "value": "locations"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " attribute through the standard Java "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "value"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " attribute. Thus, if you do not need to declare additional attributes in "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ContextConfiguration"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", you can omit the declaration of the "
