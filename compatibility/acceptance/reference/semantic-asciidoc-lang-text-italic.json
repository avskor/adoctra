              {
                "kind": "text",
                "value": "Text is often italicized in order to stress a word or phrase, quote a speaker, or introduce a term. Italic text slants slightly to the right, and depending on the font, may have cursive swashes and flourishes."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The italic presentation of text maps to the formatted text type known as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "emphasis"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in the AsciiDoc language."
