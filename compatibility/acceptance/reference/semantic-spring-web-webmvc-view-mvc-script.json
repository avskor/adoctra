                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ": The view model"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "RenderingContext renderingContext"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ": The "
                  },
                  {
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "RenderingContext"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ],
                    "kind": "link",
                    "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/web/servlet/view/script/RenderingContext.html"
                  },
                  {
                    "kind": "text",
                    "value": " that gives access to the application context, the locale, the template loader, and the URL (since 5.0)"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Mustache.render()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is natively compatible with this signature, so you can call it directly."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If your templating technology requires some customization, you can provide a script that implements a custom render function. For example, "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Handlerbars"
                  }
                ],
                "kind": "link",
                "target": "https://handlebarsjs.com"
              },
              {
                "kind": "text",
                "value": " needs to compile templates before using them and requires a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "polyfill"
                  }
                ],
                "kind": "link",
                "target": "https://en.wikipedia.org/wiki/Polyfill"
              },
              {
                "kind": "text",
                "value": " to emulate some browser facilities that are not available in the server-side script engine."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following example shows how to do so:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Configuration\n@EnableWebMvc\npublic class WebConfig implements WebMvcConfigurer {\n\n\t@Override\n\tpublic void configureViewResolvers(ViewResolverRegistry registry) {\n\t\tregistry.scriptTemplate();\n\t}\n\n\t@Bean\n\tpublic ScriptTemplateConfigurer configurer() {\n\t\tScriptTemplateConfigurer configurer = new ScriptTemplateConfigurer();\n\t\tconfigurer.setEngineName(\"nashorn\");\n\t\tconfigurer.setScripts(\"polyfill.js\", \"handlebars.js\", \"render.js\");\n\t\tconfigurer.setRenderFunction(\"render\");\n\t\tconfigurer.setSharedEngine(false);\n\t\treturn configurer;\n\t}\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Configuration\n@EnableWebMvc\nclass WebConfig : WebMvcConfigurer {\n\n\toverride fun configureViewResolvers(registry: ViewResolverRegistry) {\n\t\tregistry.scriptTemplate()\n\t}\n\n\t@Bean\n\tfun configurer() = ScriptTemplateConfigurer().apply {\n\t\tengineName = \"nashorn\"\n\t\tsetScripts(\"polyfill.js\", \"handlebars.js\", \"render.js\")\n\t\trenderFunction = \"render\"\n\t\tisSharedEngine = false\n\t}\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Setting the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sharedEngine"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " property to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "false"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is required when using non-thread-safe script engines with templating libraries not designed for concurrency, such as Handlebars or React running on Nashorn. In that case, Java SE 8 update 60 is required, due to "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "this bug"
                  }
                ],
                "kind": "link",
                "target": "https://bugs.openjdk.java.net/browse/JDK-8076099"
              },
              {
                "kind": "text",
                "value": ", but it is generally recommended to use a recent Java SE patch release in any case."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "polyfill.js"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " defines only the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "window"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " object needed by Handlebars to run properly, as follows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "var window = {};"
              }
            ],
            "language": "javascript",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This basic "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "render.js"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " implementation compiles the template before using it. A production-ready implementation should also store any reused cached templates or pre-compiled templates. You can do so on the script side (and handle any customization you need — managing template engine configuration, for example). The following example shows how to do so:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "function render(template, model) {\n\tvar compiledTemplate = Handlebars.compile(template);\n\treturn compiledTemplate(model);\n}"
              }
            ],
            "language": "javascript",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Check out the Spring Framework unit tests, "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Java"
                  }
                ],
                "kind": "link",
                "target": "https://github.com/spring-projects/spring-framework/tree/main/spring-webmvc/src/test/java/org/springframework/web/servlet/view/script"
              },
              {
                "kind": "text",
                "value": ", and "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "resources"
                  }
                ],
                "kind": "link",
                "target": "https://github.com/spring-projects/spring-framework/tree/main/spring-webmvc/src/test/resources/org/springframework/web/servlet/view/script"
              },
              {
                "kind": "text",
                "value": ", for more configuration examples."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
