                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "See equivalent in the Reactive stack"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webflux-view.html#webflux-view-script-dependencies"
