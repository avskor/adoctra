            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You need to have the script engine on your classpath, the details of which vary by script engine:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Nashorn"
                      }
                    ],
                    "kind": "link",
                    "target": "https://openjdk.java.net/projects/nashorn/"
                  },
                  {
                    "kind": "text",
                    "value": " JavaScript engine is provided with Java 8+. Using the latest update release available is highly recommended."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "JRuby"
                      }
                    ],
                    "kind": "link",
                    "target": "https://www.jruby.org"
                  },
                  {
                    "kind": "text",
                    "value": " should be added as a dependency for Ruby support."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Jython"
                      }
                    ],
                    "kind": "link",
                    "target": "https://www.jython.org"
                  },
                  {
                    "kind": "text",
                    "value": " should be added as a dependency for Python support."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "org.jetbrains.kotlin:kotlin-script-util"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " dependency and a "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "META-INF/services/javax.script.ScriptEngineFactory"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " file containing a "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "org.jetbrains.kotlin.script.jsr223.KotlinJsr223JvmLocalScriptEngineFactory"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " line should be added for Kotlin script support. See "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "this example"
                      }
                    ],
                    "kind": "link",
                    "target": "https://github.com/sdeleuze/kotlin-script-templating"
                  },
                  {
                    "kind": "text",
                    "value": " for more details."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You need to have the script templating library. One way to do that for JavaScript is through "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "WebJars"
                  }
                ],
                "kind": "link",
                "target": "https://www.webjars.org/"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "mvc-view-script-dependencies",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Requirements"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "See equivalent in the Reactive stack"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webflux-view.html#webflux-view-script"
                  }
                ],
                "kind": "span",
                "roles": [
                  "small"
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can declare a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ScriptTemplateConfigurer"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " bean to specify the script engine to use, the script files to load, what function to call to render templates, and so on. The following example uses Mustache templates and the Nashorn JavaScript engine:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Configuration\n@EnableWebMvc\npublic class WebConfig implements WebMvcConfigurer {\n\n\t@Override\n\tpublic void configureViewResolvers(ViewResolverRegistry registry) {\n\t\tregistry.scriptTemplate();\n\t}\n\n\t@Bean\n\tpublic ScriptTemplateConfigurer configurer() {\n\t\tScriptTemplateConfigurer configurer = new ScriptTemplateConfigurer();\n\t\tconfigurer.setEngineName(\"nashorn\");\n\t\tconfigurer.setScripts(\"mustache.js\");\n\t\tconfigurer.setRenderObject(\"Mustache\");\n\t\tconfigurer.setRenderFunction(\"render\");\n\t\treturn configurer;\n\t}\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Configuration\n@EnableWebMvc\nclass WebConfig : WebMvcConfigurer {\n\n\toverride fun configureViewResolvers(registry: ViewResolverRegistry) {\n\t\tregistry.scriptTemplate()\n\t}\n\n\t@Bean\n\tfun configurer() = ScriptTemplateConfigurer().apply {\n\t\tengineName = \"nashorn\"\n\t\tsetScripts(\"mustache.js\")\n\t\trenderObject = \"Mustache\"\n\t\trenderFunction = \"render\"\n\t}\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following example shows the same arrangement in XML:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "<mvc:annotation-driven/>\n\n<mvc:view-resolvers>\n\t<mvc:script-template/>\n</mvc:view-resolvers>\n\n<mvc:script-template-configurer engine-name=\"nashorn\" render-object=\"Mustache\" render-function=\"render\">\n\t<mvc:script location=\"mustache.js\"/>\n</mvc:script-template-configurer>"
              }
            ],
            "language": "xml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The controller would look no different for the Java and XML configurations, as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Controller\npublic class SampleController {\n\n\t@GetMapping(\"/sample\")\n\tpublic String test(Model model) {\n\t\tmodel.addAttribute(\"title\", \"Sample title\");\n\t\tmodel.addAttribute(\"body\", \"Sample body\");\n\t\treturn \"template\";\n\t}\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Controller\nclass SampleController {\n\n\t@GetMapping(\"/sample\")\n\tfun test(model: Model): String {\n\t\tmodel[\"title\"] = \"Sample title\"\n\t\tmodel[\"body\"] = \"Sample body\"\n\t\treturn \"template\"\n\t}\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following example shows the Mustache template:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "<html>\n\t<head>\n\t\t<title>{{title}}</title>\n\t</head>\n\t<body>\n\t\t<p>{{body}}</p>\n\t</body>\n</html>"
              }
            ],
            "language": "html",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The render function is called with the following parameters:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
