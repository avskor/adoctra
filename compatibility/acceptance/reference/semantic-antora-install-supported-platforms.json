            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Our general policy is to align Antora’s support of a platform version with the upstream project’s lifecycle schedule for that version. When a platform version reaches the end of active support by its maintainers or its end of life (EOL)—​which ever comes first—​Antora no longer supports it."
              }
            ],
            "roles": [],
            "title": null
          },
