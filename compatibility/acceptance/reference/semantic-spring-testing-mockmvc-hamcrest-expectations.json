{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can define expectations by appending one or more "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "andExpect(..)"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " calls after performing a request, as the following example shows. As soon as one expectation fails, no other expectations will be asserted."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "// static import of MockMvcRequestBuilders.* and MockMvcResultMatchers.*\n\nmockMvc.perform(get(\"/accounts/1\")).andExpect(status().isOk());"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "import org.springframework.test.web.servlet.get\n\nmockMvc.get(\"/accounts/1\").andExpect {\n\tstatus { isOk() }\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can define multiple expectations by appending "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "andExpectAll(..)"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " after performing a request, as the following example shows. In contrast to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "andExpect(..)"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "andExpectAll(..)"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " guarantees that all supplied expectations will be asserted and that all failures will be tracked and reported."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "// static import of MockMvcRequestBuilders.* and MockMvcResultMatchers.*\n\nmockMvc.perform(get(\"/accounts/1\")).andExpectAll(\n\tstatus().isOk(),\n\tcontent().contentType(\"application/json;charset=UTF-8\"));"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "import org.springframework.test.web.servlet.get\n\nmockMvc.get(\"/accounts/1\").andExpectAll {\n\tstatus { isOk() }\n\tcontent { contentType(APPLICATION_JSON) }\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MockMvcResultMatchers.*"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " provides a number of expectations, some of which are further nested with more detailed expectations."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Expectations fall in two general categories. The first category of assertions verifies properties of the response (for example, the response status, headers, and content). These are the most important results to assert."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The second category of assertions goes beyond the response. These assertions let you inspect Spring MVC specific aspects, such as which controller method processed the request, whether an exception was raised and handled, what the content of the model is, what view was selected, what flash attributes were added, and so on. They also let you inspect Servlet specific aspects, such as request and session attributes."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following test asserts that binding or validation failed:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "mockMvc.perform(post(\"/persons\"))\n\t.andExpect(status().isOk())\n\t.andExpect(model().attributeHasErrors(\"person\"));"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "import org.springframework.test.web.servlet.post\n\nmockMvc.post(\"/persons\").andExpect {\n\tstatus { isOk() }\n\tmodel {\n\t\tattributeHasErrors(\"person\")\n\t}\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Many times, when writing tests, it is useful to dump the results of the performed request. You can do so as follows, where "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "print()"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is a static import from "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MockMvcResultHandlers"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ":"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "mockMvc.perform(post(\"/persons\"))\n\t.andDo(print())\n\t.andExpect(status().isOk())\n\t.andExpect(model().attributeHasErrors(\"person\"));"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "import org.springframework.test.web.servlet.post\n\nmockMvc.post(\"/persons\").andDo {\n\t\tprint()\n\t}.andExpect {\n\t\tstatus { isOk() }\n\t\tmodel {\n\t\t\tattributeHasErrors(\"person\")\n\t\t}\n\t}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "As long as request processing does not cause an unhandled exception, the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "print()"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method prints all the available result data to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "System.out"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". There is also a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "log()"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method and two additional variants of the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "print()"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method, one that accepts an "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "OutputStream"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and one that accepts a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Writer"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". For example, invoking "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "print(System.err)"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " prints the result data to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "System.err"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", while invoking "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "print(myWriter)"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " prints the result data to a custom writer. If you want to have the result data logged instead of printed, you can invoke the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "log()"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method, which logs the result data as a single "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DEBUG"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " message under the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "org.springframework.test.web.servlet.result"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " logging category."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "In some cases, you may want to get direct access to the result and verify something that cannot be verified otherwise. This can be achieved by appending "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ".andReturn()"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " after all other expectations, as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "MvcResult mvcResult = mockMvc.perform(post(\"/persons\")).andExpect(status().isOk()).andReturn();\n// ..."
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "var mvcResult = mockMvc.post(\"/persons\").andExpect { status { isOk() } }.andReturn()\n// ..."
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If all tests repeat the same expectations, you can set up common expectations once when building the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MockMvc"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " instance, as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "standaloneSetup(new SimpleController())\n\t.alwaysExpect(status().isOk())\n\t.alwaysExpect(content().contentType(\"application/json;charset=UTF-8\"))\n\t.build()"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "// Not possible in Kotlin until {kotlin-issues}/KT-22208 is fixed"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Note that common expectations are always applied and cannot be overridden without creating a separate "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MockMvc"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " instance."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "When a JSON response content contains hypermedia links created with "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Spring HATEOAS"
              }
            ],
            "kind": "link",
            "target": "https://github.com/spring-projects/spring-hateoas"
          },
          {
            "kind": "text",
            "value": ", you can verify the resulting links by using JsonPath expressions, as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "mockMvc.perform(get(\"/people\").accept(MediaType.APPLICATION_JSON))\n\t.andExpect(jsonPath(\"$.links[?(@.rel == 'self')].href\").value(\"http://localhost:8080/people\"));"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "mockMvc.get(\"/people\") {\n\taccept(MediaType.APPLICATION_JSON)\n}.andExpect {\n\tjsonPath(\"$.links[?(@.rel == 'self')].href\") {\n\t\tvalue(\"http://localhost:8080/people\")\n\t}\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "When XML response content contains hypermedia links created with "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Spring HATEOAS"
              }
            ],
            "kind": "link",
            "target": "https://github.com/spring-projects/spring-hateoas"
          },
          {
            "kind": "text",
            "value": ", you can verify the resulting links by using XPath expressions:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Map<String, String> ns = Collections.singletonMap(\"ns\", \"http://www.w3.org/2005/Atom\");\nmockMvc.perform(get(\"/handle\").accept(MediaType.APPLICATION_XML))\n\t.andExpect(xpath(\"/person/ns:link[@rel='self']/@href\", ns).string(\"http://localhost:8080/people\"));"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
