                    }
                  ],
                  "sections": []
                }
              ],
              "title": [
                {
                  "kind": "text",
                  "value": "Table of Contents"
                }
              ]
            },
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "EnforceRecordSize"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " SMT estimates the serialized size of each record and, if it exceeds the configured maximum, truncates eligible string and bytes columns proportionally to bring the record within the size limit."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Some downstream systems, such as Apache Kafka brokers or sink connectors, impose a maximum message size limit. When Debezium captures a change event for a row that contains large string or bytes columns, the serialized record can exceed that limit, causing the connector to fail."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The SMT truncates larger columns aggressively to comply with the threshold. If does not modify columns if their sizes are at or below the configured threshold."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You apply the SMT to a connector by adding its details to the connector’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "transforms"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " configuration. The following example shows a configuration for the SMT that limits records to 1 MB:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "transforms=EnforceRecordSize\ntransforms.EnforceRecordSize.type=io.debezium.transforms.EnforceRecordSize\ntransforms.EnforceRecordSize.max.bytes=1048576"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When this configuration is active, if the estimated serialized size of a record exceeds 1,048,576 bytes (1 MB), its large string and bytes fields are truncated proportionally until the record conforms to the configured limit."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "example-basic-enforce-record-size-configuration",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Example: Basic configuration"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The SMT uses an approximate size calculation that examines the key, value, headers, and topic of the record. For string fields, it uses "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "String.length()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " as a constant-time proxy for byte size. The string size calculation assumes one byte per character, which understates multi-byte UTF-8 content but avoids the performance cost of encoding each string."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the estimated size (adjusted by the optional "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "compression.ratio"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") exceeds "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "max.bytes"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", the SMT identifies all string and bytes fields in the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "before"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "after"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " sections of the envelope that are larger than "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "min.field.size"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". It then distributes the excess bytes proportionally across those fields, truncating larger fields more than smaller fields."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "enforce-record-size-how-it-works",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "How the SMT estimates record size"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If your Kafka producer uses compression, for example, LZ4 or Snappy, the actual size of a record as transmitted over the network is smaller than its raw serialized size. You can account for the use of compression by setting a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "compression.ratio"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in the configuration with a value of less than 1.0."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For example, if Kafka producer metrics show an average compression rate of 0.6, set the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "compression.ratio"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " as in the following example:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "transforms=EnforceRecordSize\ntransforms.EnforceRecordSize.type=io.debezium.transforms.EnforceRecordSize\ntransforms.EnforceRecordSize.max.bytes=1048576\ntransforms.EnforceRecordSize.compression.ratio=0.6"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "With this configuration, the SMT multiplies the estimated raw size by 0.6 before comparing it to the 1 MB limit. As a result, the SMT only truncates columns if the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "compressed"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " size would exceed the limit, avoiding unnecessary truncation."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can determine the effective compression ratio by examining Kafka producer metrics: "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "kafka.producer:type=producer-metrics,client-id=<id>/compression-rate-avg"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "enforce-record-size-compression-ratio-example",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Example: Configuration with compression ratio"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By default, the SMT only truncates fields larger than 25,000 bytes (25 KB). By acting only on these large fields, the SMT protects small fields, which are unlikely to contribute meaningfully to size reduction, from being truncated."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can modify the default threshold by setting the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "min.field.size"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attributes in the configuration, as in the following example:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "transforms=EnforceRecordSize\ntransforms.EnforceRecordSize.type=io.debezium.transforms.EnforceRecordSize\ntransforms.EnforceRecordSize.max.bytes=1048576\ntransforms.EnforceRecordSize.min.field.size=10000"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you set "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "min.field.size=10000"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", the SMT only truncates fields larger than 10 KB. To make all string and bytes fields eligible for truncation, set "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "min.field.size=0"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "enforce-record-size-min-field-size-example",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Example: Protecting small fields from truncation"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The enforce record size SMT evaluates only Debezium change event records and applies truncation to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "before"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "after"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " fields of the event envelope. Size estimates are approximate; the actual serialized size depends on the converter you use."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "During processing, the enforce record size transformation applies the following constraints and behaviors."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The SMT processes only records whose value contains a Debezium change event envelope, that is, a Struct with "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "before"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " and "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "after"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " fields. It passes non-envelope records, such as schema change events or tombstones, unchanged."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The SMT applies truncation to both the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "before"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " and "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "after"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " sections of the envelope and distributes the excess between the two sections in proportion to their truncatable content."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The SMT does not guarantee that the final serialized record is exactly at or below "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "max.bytes"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", because it estimates size approximately and the actual serialized size depends on the converter (JSON, Avro, or Protobuf) and its associated overhead. To provide a safety margin, configure a conservative "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "max.bytes"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " value or adjust the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "compression.ratio"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " setting."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          }
        ],
        "context": "section",
        "id": "enforce-record-size-behavior",
        "level": 1,
        "roles": [],
        "title": [
