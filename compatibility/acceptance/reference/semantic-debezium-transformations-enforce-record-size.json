                },
                {
                  "background": null,
                  "colspan": 1,
                  "document": {
                    "blocks": [
                      {
                        "context": "paragraph",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "(Required) The maximum record size in bytes. If the estimated serialized size of a record (adjusted by "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "compression.ratio"
                              }
                            ],
                            "kind": "monospace",
                            "roles": []
                          },
                          {
                            "kind": "text",
                            "value": ") exceeds the specified limit, the transformation proportionally truncates values in string and bytes columns to conform to the limit"
                          }
                        ],
                        "roles": [],
                        "title": null
                      }
                    ],
                    "title": null
                  },
                  "halign": "left",
                  "rowspan": 1,
                  "style": "asciidoc",
                  "valign": "top"
                }
              ],
