                        "blocks": [
                          {
                            "context": "paragraph",
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "Empty if a message with full envelope should be deserialized, "
                              },
                              {
                                "id": null,
                                "inlines": [
                                  {
                                    "kind": "text",
                                    "value": "before"
                                  }
                                ],
                                "kind": "monospace",
                                "roles": []
                              },
                              {
                                "kind": "text",
                                "value": "/"
                              },
                              {
                                "id": null,
                                "inlines": [
                                  {
                                    "kind": "text",
                                    "value": "after"
                                  }
                                ],
                                "kind": "monospace",
                                "roles": []
                              },
                              {
                                "kind": "text",
                                "value": " if only data values before or after the change are required."
                              }
                            ],
                            "roles": [],
