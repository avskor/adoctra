    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Similar to the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "git-fetch-concurrency.html"
                  }
                ],
                "kind": "xref",
                "target": "git-fetch-concurrency.html"
              },
              {
                "kind": "text",
                "value": ", the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "read_concurrency"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key tells Antora how many content repositories (local or managed) to read from at once. This key effectively controls how many git indexes are loaded into memory at once (a git index is the backing storage for files in a git repository)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Antora only reads repositories once all fetch/clone operations on those repositories are complete. Thus, the fetch and read are separate steps."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By default, Antora does not limit the read concurrency (value "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "0"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), which means it will load all repositories into memory at once when scanning for and collecting files. Loading a lot of large repositories at once can consume a lot of memory. To alleviate this situation, Antora allows you to tune the read concurrency limit."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The read concurrency does not impact the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fetch concurrency"
                  }
                ],
                "kind": "xref",
                "target": "git-fetch-concurrency.html"
              },
              {
                "kind": "text",
                "value": " or the network traffic."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          }
        ],
        "context": "section",
        "id": "default-read-concurrency",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Default read concurrency"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The optional "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "read_concurrency"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is set under the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "git category"
                  }
                ],
                "kind": "xref",
                "target": "configure-git.html"
              },
              {
                "kind": "text",
                "value": " in the playbook. This key accepts a positive integer value or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "0"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " for no limit."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "git:\n  read_concurrency: 4"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When working with a lot of repositories, an optimal value is somewhere between 2 and 5."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The purpose of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "read_concurrency"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is to allow you to control how much memory is consumed when reading files from the content repositories. Once a git index is loaded into memory, Antora uses unlimited concurrency to read the tree of each reference to collect files into the precursor of the content catalog (creating the content catalog is a subsequent step)."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "read-concurrency-key",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "read_concurrency key"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "While the residual memory will equate to the size of all content files collected, the git index that contains those files could be substantially larger. This is especially true when the documentation is co-located with the source files of a software project. Antora has to load the git index even if it is only taking a fraction of the files."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You may find that by limiting the number of concurrent operations, it reduces the time it takes the content aggregator to complete. This is presumably because Antora has to do less context switching. You will need to experiment with this value to find the setting that works best for your site."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "related-to-memory-usage",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Related to memory usage"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Git Read Concurrency Limit"
      }
    ]
  }
}
