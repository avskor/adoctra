                    "kind": "xref",
                    "target": "attachment$api/org.junit.jupiter.api/org/junit/jupiter/api/extension/ParameterResolver.html"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". While not intended to be production-ready, it demonstrates the simplicity and expressiveness of both the extension model and the parameter resolution process. "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MyRandomParametersTest"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " demonstrates how to inject random values into a constructor and a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Test"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "blocks": [
                            {
                              "context": "listing",
                              "id": null,
                              "inlines": [
                                {
                                  "kind": "text",
                                  "value": "class MyRandomParametersTest {\n\n\tMyRandomParametersTest(@Random int randomNumber) {\n\t\t// Use randomNumber in constructor.\n\t}\n\n\t@Test\n\tvoid injectsInteger(@Random int i, @Random int j) {\n\t\tassertNotEquals(i, j);\n\t}\n}"
                                }
                              ],
                              "language": "java",
                              "roles": [],
                              "title": null
