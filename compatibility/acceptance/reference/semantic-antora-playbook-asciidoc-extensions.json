{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoc"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key can be used to register Asciidoctor extensions."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Before registering an extension in your playbook, you need to install the extension code. You can install it globally, declare it as a dependency of the project, or add the extension script to the playbook project."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "install-extension-code",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Install extension code"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An Asciidoctor extension is registered using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "extensions"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "extensions"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key accepts a list of node module names (i.e., npm package names) and relative or absolute filesystem paths."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When registering an Asciidoctor extension, make sure you’re using the nested key "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoc.extensions"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and not "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "antora.extensions"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The latter key is for registering Antora extensions, which use a different extension facility."
              }
            ],
            "roles": [],
            "title": null,
            "type": "important"
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "asciidoc:\n  extensions:\n  - name-of-node-module\n  - ./path/to/extension"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you’re trying to require a Node.js module (e.g., a package installed from npmjs.com) whose name ends with a file extension, such as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".js"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", you must append a trailing forward slash. For example, the Node.js module "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "highlight.js"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " must be written as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "highlight.js/"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". This suffix tells Antora to resolve the request as the name of a module, not as a local file. Without this suffix, Antora assumes the request is a local file. If it’s not a local file, this can result in the error message "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Cannot find module"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". If the request is already a local file, the suffix is not needed."
              }
            ],
            "roles": [],
            "title": null,
            "type": "important"
          }
        ],
        "context": "section",
        "id": "extensions-key",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "extensions key"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Global extensions are registered once, before any pages are converted. These extensions are shared by all documents Antora converts using Asciidoctor (including navigation files). A global extension is a node module or script that exports a function when required. Antora passes this function directly to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "register"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method of Asciidoctor’s static extension registry."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To register a global extension, all you need to do is reference its name (if it’s a node module on the require path) or path (if it’s a local script) in the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "extensions"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "asciidoc:\n  extensions:\n  - asciidoctor-emoji-macro"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Register a global extension provided by a node module"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In this case, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor-emoji-macro"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is the name of an installed node module and is thus available on the require path (either in the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "node_modules"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " directory in the playbook project or in the global "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "node_modules"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " directory)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "asciidoc:\n  extensions:\n  - ./lib/shout-block"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Register a global extension from a local script"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In this case, the extension is a script located at the path "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "lib/shout-block.js"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " relative to the playbook file."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example that shows how to register multiple global extensions:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "asciidoc:\n  extensions:\n  - asciidoctor-emoji-macro\n  - ./lib/shout-block"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Register multiple global extensions"
              }
            ]
          }
        ],
        "context": "section",
        "id": "global-extensions",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Global Asciidoctor extensions"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Rather than requiring an extension globally, you may want to register an extension per instance of the AsciiDoc processor. The benefit of this approach is that it allows the extension to hook into the Antora lifecycle. The other difference is that scoped extensions are only registered and used for pages, not for navigation files."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In order to register a scoped extension, the extension must support this mode of usage. Specifically, the extension must export a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "register"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " function that accepts an extension registry on which it self registers. The function is called with a scoped (per-processor) extension registry and a context object. The context object includes the current file, the content catalog, and the AsciiDoc configuration object from the playbook."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example of a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "register"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " function for a scoped extension:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "module.exports.register = function (registry, context) {\n  registry.block('shout', createShoutBlock(context))\n}"
              }
            ],
            "language": "js",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Scoped Asciidoctor extension register function"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A scoped extension is registered in the playbook in exactly the same way as a global extension."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "asciidoc:\n  extensions:\n  - asciidoctor-kroki"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Register a scoped extension from the require path"
              }
            ]
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "asciidoc:\n  extensions:\n  - ./lib/equation-macro"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Register a scoped extension from a local script"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The main difference is that if the extension exports the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "register"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " function, it gets scoped to the processor instance instead of being registered globally."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "scoped-extensions",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Scoped Asciidoctor extensions"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Instead of registering extensions using the playbook, you can preload extensions using the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-r or --require CLI option"
                  }
                ],
                "kind": "xref",
                "target": "cli:options.html#require"
              },
              {
                "kind": "text",
                "value": ". The value of this option may be either a path to a file (relative to the current directory), or a node module name. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-r"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option may be specified multiple times."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This option gives site authors the ability to load additional code into the runtime before Antora begins executing, in fact, before Antora is even loaded. The option follows the module resolution rules of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "require()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " function in Node.js. A common use case for this option is to register Asciidoctor extensions globally."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the node module or script is an Asciidoctor extension, it must self-register with Asciidoctor’s static extension registry when required in order for the extension to be used. (Antora merely requires the script. It does not invoke its exported function)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example showing how to use the Antora CLI to preload multiple Asciidoctor extensions:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ antora -r ./lib/shout-block -r asciidoctor-emoji-macro antora-playbook.yml"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-r"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option can also be used for other purposes, such as to alter global state or override Antora components."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For more information about the CLI, see "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "cli:index.html"
                  }
                ],
                "kind": "xref",
                "target": "cli:index.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "preload-extensions",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Preloading extensions"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Refer to the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "antora-asciidoctor-extensions"
                  }
                ],
                "kind": "link",
                "target": "https://gitlab.com/antora/antora-asciidoctor-extensions"
              },
              {
                "kind": "text",
                "value": " project to find a collection of example Asciidoctor extensions to use with Antora. Among them is a custom include processor that provides support for remote (URL) includes in Antora."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "extension-examples",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Extension examples"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Asciidoctor Extensions"
      }
    ]
  }
}
