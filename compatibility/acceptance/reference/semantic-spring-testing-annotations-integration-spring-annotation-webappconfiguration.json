                "kind": "text",
                "value": "@WebAppConfiguration"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is an annotation that can be applied to a test class to declare that the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " loaded for an integration test should be a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". The mere presence of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@WebAppConfiguration"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " on a test class ensures that a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is loaded for the test, using the default value of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "\"file:src/main/webapp\""
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " for the path to the root of the web application (that is, the resource base path). The resource base path is used behind the scenes to create a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MockServletContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", which serves as the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ServletContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " for the test’s "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
