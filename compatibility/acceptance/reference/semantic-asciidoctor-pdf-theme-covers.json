                    "kind": "text",
                    "value": "Specify a background image in the theme"
                  }
                ],
                "kind": "xref",
                "target": "images.html#specify"
              },
              {
                "kind": "text",
                "value": " for learn how to configure a path that’s not relative to the value of "
