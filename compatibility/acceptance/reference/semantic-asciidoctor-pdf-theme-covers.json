            "inlines": [
              {
                "kind": "text",
                "value": "You can specify an image or a PDF page to use as either cover of the document directly in your theme. The front cover image is assigned using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "front-image"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key, and the back cover image using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "back-image"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key. Both keys are set on the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "cover category"
                  }
                ],
                "kind": "xref",
                "target": "cover.html"
              },
