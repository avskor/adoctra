          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Specifying the path as the target of an inline image macro allows you to specify parameters for that image, as shown here:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "cover:\n  front:\n    image: image:cover.pdf[page=2]\n  back:\n    image: image:splash.png[fit=fill]"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A cover image is handled like a "
              },
