                      {
                        "kind": "text",
                        "value": "attachments"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": [
                      "path"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": " directory into the Antora content catalog, except for files "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "marked as hidden or missing a file extension"
