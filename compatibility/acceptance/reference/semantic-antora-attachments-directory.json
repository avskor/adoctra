            "inlines": [
              {
                "kind": "text",
                "value": "An attachment is typically a file a site visitor views or downloads using their browser, such as a PDF or the ZIP archive of a sample project."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "At runtime, Antora automatically:"
