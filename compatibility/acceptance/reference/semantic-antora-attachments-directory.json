                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Assigns each loaded attachment file to the attachment family"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Assigns each loaded attachment a "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "unique resource ID"
                      }
                    ],
                    "kind": "xref",
                    "target": "page:resource-id.html"
                  },
                  {
                    "kind": "text",
                    "value": " for source-to-source referencing"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Publishes each loaded attachment file as an individual page in a site, except for files "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "marked as unpublished"
                      }
                    ],
                    "kind": "xref",
                    "target": "standard-directories.html#unpublished"
