                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "attachments"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": "-relative directory path (if present), filename, and file extension of the attachment when "
