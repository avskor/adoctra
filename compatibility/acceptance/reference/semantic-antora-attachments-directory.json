          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Using an attachment’s resource ID, you can "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "cross reference an attachment"
                  }
                ],
                "kind": "xref",
                "target": "page:attachments.html"
              },
              {
                "kind": "text",
                "value": " from other pages, resources, or navigation files in your site. Antora uses the family directory, "
