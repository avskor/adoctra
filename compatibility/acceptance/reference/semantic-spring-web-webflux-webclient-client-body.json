              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ReactiveAdapterRegistry"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", like "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Mono"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or Kotlin Coroutines "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Deferred"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "Mono<Person> personMono = ... ;\n\nMono<Void> result = client.post()\n\t\t.uri(\"/persons/{id}\", id)\n\t\t.contentType(MediaType.APPLICATION_JSON)\n\t\t.body(personMono, Person.class)\n\t\t.retrieve()\n\t\t.bodyToMono(Void.class);"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "val personDeferred: Deferred<Person> = ...\n\nclient.post()\n\t\t.uri(\"/persons/{id}\", id)\n\t\t.contentType(MediaType.APPLICATION_JSON)\n\t\t.body<Person>(personDeferred)\n\t\t.retrieve()\n\t\t.awaitBody<Unit>()"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
