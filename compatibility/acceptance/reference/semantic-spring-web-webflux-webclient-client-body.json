          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can also supply form data in-line by using "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "BodyInserters"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "import static org.springframework.web.reactive.function.BodyInserters.*;\n\nMono<Void> result = client.post()\n\t\t.uri(\"/path\", id)\n\t\t.body(fromFormData(\"k1\", \"v1\").with(\"k2\", \"v2\"))\n\t\t.retrieve()\n\t\t.bodyToMono(Void.class);"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "import org.springframework.web.reactive.function.BodyInserters.*\n\nclient.post()\n\t\t.uri(\"/path\", id)\n\t\t.body(fromFormData(\"k1\", \"v1\").with(\"k2\", \"v2\"))\n\t\t.retrieve()\n\t\t.awaitBody<Unit>()"
                            }
                          ],
