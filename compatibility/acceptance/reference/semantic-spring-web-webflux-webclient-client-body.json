                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "val person: Person = ...\n\nclient.post()\n\t\t.uri(\"/persons/{id}\", id)\n\t\t.contentType(MediaType.APPLICATION_JSON)\n\t\t.bodyValue(person)\n\t\t.retrieve()\n\t\t.awaitBody<Unit>()"
                            }
