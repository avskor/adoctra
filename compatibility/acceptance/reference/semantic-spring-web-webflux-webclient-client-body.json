            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MultiValueMap"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " contains at least one non-"
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "String"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " value, which could also represent regular form data (that is, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "application/x-www-form-urlencoded"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), you need not set the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Content-Type"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "multipart/form-data"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". This is always the case when using "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MultipartBodyBuilder"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", which ensures an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "HttpEntity"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " wrapper."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "As an alternative to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MultipartBodyBuilder"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", you can also provide multipart content, inline-style, through the built-in "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "BodyInserters"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "import static org.springframework.web.reactive.function.BodyInserters.*;\n\nMono<Void> result = client.post()\n\t\t.uri(\"/path\", id)\n\t\t.body(fromMultipartData(\"fieldPart\", \"value\").with(\"filePart\", resource))\n\t\t.retrieve()\n\t\t.bodyToMono(Void.class);"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "import org.springframework.web.reactive.function.BodyInserters.*\n\nclient.post()\n\t\t.uri(\"/path\", id)\n\t\t.body(fromMultipartData(\"fieldPart\", \"value\").with(\"filePart\", resource))\n\t\t.retrieve()\n\t\t.awaitBody<Unit>()"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "To stream multipart data sequentially, you can provide multipart content through "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "PartEvent"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " objects."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "ulist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Form fields can be created via "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "FormPartEvent::create"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": "."
                      }
                    ]
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "File uploads can be created via "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "FilePartEvent::create"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": "."
                      }
                    ]
                  }
                ],
                "roles": [],
                "style": null,
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "You can concatenate the streams returned from methods via "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Flux::concat"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", and create a request for the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "WebClient"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "For instance, this sample will POST a multipart form containing a form field and a file."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "blocks": [
                  {
                    "context": "dlist",
                    "id": null,
                    "items": [
                      {
                        "description": {
                          "blocks": [
                            {
                              "context": "listing",
                              "id": null,
                              "inlines": [
                                {
                                  "kind": "text",
                                  "value": "Resource resource = ...\nMono<String> result = webClient\n    .post()\n    .uri(\"https://example.com\")\n    .body(Flux.concat(\n            FormPartEvent.create(\"field\", \"field value\"),\n            FilePartEvent.create(\"file\", resource)\n    ), PartEvent.class)\n    .retrieve()\n    .bodyToMono(String.class);"
                                }
                              ],
                              "language": "java",
                              "roles": [],
                              "title": null
                            }
                          ],
                          "checkbox": null,
                          "inlines": []
                        },
                        "terms": [
                          [
                            {
                              "kind": "text",
                              "value": "Java"
                            }
                          ]
                        ]
                      },
                      {
                        "description": {
                          "blocks": [
                            {
                              "context": "listing",
                              "id": null,
                              "inlines": [
                                {
                                  "kind": "text",
                                  "value": "var resource: Resource = ...\nvar result: Mono<String> = webClient\n\t.post()\n\t.uri(\"https://example.com\")\n\t.body(\n\t\tFlux.concat(\n\t\t\tFormPartEvent.create(\"field\", \"field value\"),\n\t\t\tFilePartEvent.create(\"file\", resource)\n\t\t)\n\t)\n\t.retrieve()\n\t.bodyToMono()"
                                }
                              ],
                              "language": "kotlin",
                              "roles": [],
                              "title": null
                            }
                          ],
                          "checkbox": null,
                          "inlines": []
                        },
                        "terms": [
                          [
                            {
                              "kind": "text",
                              "value": "Kotlin"
                            }
                          ]
                        ]
                      }
                    ],
                    "roles": [],
                    "title": null
                  }
                ],
                "context": "example",
                "id": null,
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "On the server side, "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "PartEvent"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " objects that are received via "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@RequestBody"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " or "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "ServerRequest::bodyToFlux(PartEvent.class)"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " can be relayed to another service via the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "WebClient"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "partevent",
