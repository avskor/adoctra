        "context": "section",
        "id": "webflux-client-body-form",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Form Data"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To send multipart data, you need to provide a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MultiValueMap<String, ?>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " whose values are either "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Object"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instances that represent part content or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "HttpEntity"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instances that represent the content and headers for a part. "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MultipartBodyBuilder"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " provides a convenient API to prepare a multipart request. The following example shows how to create a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MultiValueMap<String, ?>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ":"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "MultipartBodyBuilder builder = new MultipartBodyBuilder();\nbuilder.part(\"fieldPart\", \"fieldValue\");\nbuilder.part(\"filePart1\", new FileSystemResource(\"...logo.png\"));\nbuilder.part(\"jsonPart\", new Person(\"Jason\"));\nbuilder.part(\"myPart\", part); // Part from a server request\n\nMultiValueMap<String, HttpEntity<?>> parts = builder.build();"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "val builder = MultipartBodyBuilder().apply {\n\tpart(\"fieldPart\", \"fieldValue\")\n\tpart(\"filePart1\", FileSystemResource(\"...logo.png\"))\n\tpart(\"jsonPart\", Person(\"Jason\"))\n\tpart(\"myPart\", part) // Part from a server request\n}\n\nval parts = builder.build()"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In most cases, you do not have to specify the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Content-Type"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " for each part. The content type is determined automatically based on the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "HttpMessageWriter"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " chosen to serialize it or, in the case of a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Resource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", based on the file extension. If necessary, you can explicitly provide the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MediaType"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to use for each part through one of the overloaded builder "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "part"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " methods."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Once a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MultiValueMap"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is prepared, the easiest way to pass it to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "WebClient"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is through the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "body"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method, as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "MultipartBodyBuilder builder = ...;\n\nMono<Void> result = client.post()\n\t\t.uri(\"/path\", id)\n\t\t.body(builder.build())\n\t\t.retrieve()\n\t\t.bodyToMono(Void.class);"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
