                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "val builder: MultipartBodyBuilder = ...\n\nclient.post()\n\t\t.uri(\"/path\", id)\n\t\t.body(builder.build())\n\t\t.retrieve()\n\t\t.awaitBody<Unit>()"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
