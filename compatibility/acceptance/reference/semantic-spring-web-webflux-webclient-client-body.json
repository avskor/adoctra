                          "inlines": [
                            {
                              "kind": "text",
                              "value": "Person person = ... ;\n\nMono<Void> result = client.post()\n\t\t.uri(\"/persons/{id}\", id)\n\t\t.contentType(MediaType.APPLICATION_JSON)\n\t\t.bodyValue(person)\n\t\t.retrieve()\n\t\t.bodyToMono(Void.class);"
                            }
                          ],
