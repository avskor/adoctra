            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can also have a stream of objects be encoded, as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "Flux<Person> personFlux = ... ;\n\nMono<Void> result = client.post()\n\t\t.uri(\"/persons/{id}\", id)\n\t\t.contentType(MediaType.APPLICATION_STREAM_JSON)\n\t\t.body(personFlux, Person.class)\n\t\t.retrieve()\n\t\t.bodyToMono(Void.class);"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "val people: Flow<Person> = ...\n\nclient.post()\n\t\t.uri(\"/persons/{id}\", id)\n\t\t.contentType(MediaType.APPLICATION_JSON)\n\t\t.body(people)\n\t\t.retrieve()\n\t\t.awaitBody<Unit>()"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
