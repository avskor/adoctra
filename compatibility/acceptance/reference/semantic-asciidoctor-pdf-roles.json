    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can apply the built-in roles that Asciidoctor PDF supports as well as custom roles you define in your theme. Built-in roles are not supported universally, but rather on specific elements. Custom roles are limited to paragraphs and inline phrases."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor PDF supports a subset of the built-in roles defined in AsciiDoc. Where these built-in roles can be applied is limited. If a built-in role is not listed in this section, then you can expect that it’s not supported."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The following built-in roles can be assigned to paragraphs and inline phrases."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "page$role.adoc"
                      }
                    ],
                    "kind": "link",
                    "metadata": {
                      "role": "bare include"
                    },
                    "target": "theme:page$role.adoc"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In the example below, the built-in role "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "big"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " is applied to an inline phrase."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The sign spelled out [.big]#WELCOME# in glowing neon lights."
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "When text is enclosed in a pair of single or double hash symbols ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "#"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ") and has at least one role, the role or roles will be applied to the text without any other implicit formatting. That is, the text will appear with custom styling rather than being displayed as marked (i.e., highlighted) text."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The following built-in roles can be assigned to paragraphs, list items, and discrete headings."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "page$role.adoc"
                      }
                    ],
                    "kind": "link",
                    "metadata": {
                      "role": "bare include"
                    },
                    "target": "theme:page$role.adoc"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In the example below, the built-in role "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "text-right"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " is applied to a paragraph so it aligns to the right."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[.text-right]\nA response is often shown right-aligned like this."
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "on-text",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "On text"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The following built-in roles can be assigned to block images."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [],
                      "checkbox": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Aligns the image to the left margin. Analogous to "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "align=left"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": "."
                        }
                      ]
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "left"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [],
                      "checkbox": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Aligns the image to the right margin. Analogous to "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "align=right"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": "."
                        }
                      ]
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "right"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [],
                      "checkbox": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Aligns the image to the middle of the page. Analogous to "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "align=center"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": "."
                        }
                      ]
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "center"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [],
                      "checkbox": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "The border will not be drawn even if configured on the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "image"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " category in the theme."
                        }
                      ]
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "noborder"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The purpose of the built-in roles on block images cannot be redefined."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "on-block-images",
            "level": 2,
