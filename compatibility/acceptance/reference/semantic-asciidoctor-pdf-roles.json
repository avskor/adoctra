                "value": "On block images"
              }
            ]
          }
        ],
        "context": "section",
        "id": "built-in",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Use a built-in role"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In AsciiDoc, you can add any role name to an element that supports roles. However, in order for that role to have any effect, you must assign styles to it in a theme."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In Asciidoctor PDF, the theme properties mapped to custom roles currently only apply to paragraphs and inline phrases."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can define additional roles in your theme using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "role"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " category. In addition to custom roles, the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "built-in roles"
                  }
                ],
                "kind": "xref",
                "target": "#built-in"
              },
              {
                "kind": "text",
                "value": ", such as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "lead"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", can be augmented or redefined in the same way."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Before you can use a custom role in your document, you need to define it in your theme. See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "theme:custom-role.html"
                  }
                ],
                "kind": "xref",
                "target": "theme:custom-role.html"
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "theme:role.html"
                  }
                ],
                "kind": "xref",
                "target": "theme:role.html"
              },
              {
                "kind": "text",
                "value": " to learn how to create a custom role."
              }
            ],
            "roles": [],
            "title": null,
            "type": "important"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Let’s assume you’ve defined a custom role named "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "labeled"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in your theme."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "role:\n  labeled:\n    font-color: #0000FF"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Now, you can use this role in your documents. In the following example, the custom role is assigned to the second paragraph and an inline phrase in the last paragraph."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "== Section title\n\nA paragraph.\n\n[.labeled]\nA paragraph styled according to the custom role assigned to it.\n\nAnother paragraph.\nThe text [.labeled]#label me# is formatted using the styles of the custom role."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "custom",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Use a custom role"
          }
        ]
      }
    ],
