    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "url"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key tells Antora where to find a content source repository."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Antora can connect to public and private git repositories that are defined be a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "url"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key in a playbook. At least one "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "url"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key must be specified under the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sources"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key. You can add as many "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "url"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " keys as you need. Each "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "url"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key tells Antora where to find a git repository that contains content source files."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "content:\n  sources:\n  - url: https://git-service.com/org/repo.git\n  - url: /absolute/path/to/local-repo"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "url"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key accepts any URI that git supports, including a local filesystem path."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Like with git, Antora differentiates between a local filesystem path and a remote URI based on certain characters in the value. If the value matches either of the two rules listed below, the value will always be handled as a remote URI, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "not"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " a local filesystem path."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The value contains a colon that’s not followed by a forward slash or backslash ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "host:repo"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ")."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The value contains a colon that’s followed by two forward slashes ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "://"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ")."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          }
        ],
        "context": "section",
        "id": "url-key",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "url key"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "All remote content repositories must be accessible via a URL (a web address that’s fetched using either the basic or encrypted HTTP protocol) (i.e., http:// or https://). The repository location can be expressed using a URL, an SSH URI, or a git URI. Internally, that location is always converted to a URL."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "content:\n  sources:\n  - url: https://git-service.com/org/repo-z.git\n  - url: git@git-service.com:org/repo-y.git\n  - url: git://git-service.com/org/repo-x.git"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Whether the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".git"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " extension is required depends on the settings of the git host. It’s not needed for repositories hosted on GitHub, required for repositories hosted on GitLab, and forbidden for repositories hosted on Team Foundation Server (TFS) or Azure DevOps, to cite a few scenarios (and to exhibit the nature of the problem). That’s why the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ensure_git_suffix key"
                  }
                ],
                "kind": "xref",
                "target": "git-suffix.html"
              },
              {
                "kind": "text",
                "value": " is provided for you, which is enabled by default."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When using a secure URL with a self-signed certificate, you will need to provide additional configuration in order for Node.js to recognize and accept that certificate. Refer to "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "using self-signed certificates"
                  }
                ],
                "kind": "xref",
                "target": "set-up-playbook.html#self-signed-certificates"
              },
              {
                "kind": "text",
                "value": " to learn how."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Antora can connect to private git repositories as long as a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "supported authentication method"
                  }
                ],
                "kind": "xref",
                "target": "private-repository-auth.html"
              },
              {
                "kind": "text",
                "value": " is specified for the private content source repositories."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "remote-urls",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Use remote content repositories"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Antora permits the value of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "url"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to be a relative or absolute filesystem path to a local repository (even if the repository has no commits)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "content:\n  sources:\n  - url: /absolute/path/to/local-repo "
              },
              {
                "guard": "# ",
                "icons": null,
                "id": "CO1-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\n  - url: https://git-service.com/org/repo-z.git\n  - url: ./another-local-repo "
              },
              {
                "guard": "# ",
                "icons": null,
                "id": "CO1-2",
                "kind": "callout",
                "number": "2",
                "src": "",
                "xml": false
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": null
          },
          {
            "context": "colist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-1"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Absolute path to git repository"
                  }
                ],
                "src": ""
              },
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-2"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Relative path to git repository (starting from the directory of the playbook)"
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A relative path is expanded to an absolute path using the following rules:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If the first path segment is a tilde ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "~"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), the remaining path is resolved relative to the user’s home directory."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If the first path segment is a dot ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "."
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), the remaining path is resolved relative to the location of the playbook file."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If the first path segment is a tilde directly followed by a plus sign ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "~+"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), or does not begin with an aforementioned prefix, the remaining path is resolved relative to the current working directory."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          }
        ],
        "context": "section",
        "id": "local-urls",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Use local content repositories"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the URL for a content source is a local repository, and the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "branches filter"
                  }
                ],
                "kind": "xref",
                "target": "content-branches.html"
              },
              {
                "kind": "text",
                "value": " matches the branch that’s currently checked out (aka the worktree branch), Antora reads files from the worktree (i.e., the working directory on the local filesystem) "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "instead of"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " from the git index. This behavior is central to the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "author mode"
                  }
                ],
                "kind": "xref",
                "target": "author-mode.html"
              },
              {
                "kind": "text",
                "value": " in Antora. It means you "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "don’t have to commit files locally"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " before Antora can use them."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "content:\n  sources:\n  - url: ./demo-component-b\n    branches: main\n  - url: https://gitlab.com/antora/demo/demo-component-b.git\n    branches: v1.0, v2.0"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Use files from the worktree"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Instead of specifying the name of the current branch explicitly, you can use the symbolic name "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "HEAD"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " as an alias for the current branch name. This saves you the trouble of having to update your playbook when you switch branches."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "content:\n  sources:\n  - url: ./demo-component-b\n    branches: HEAD\n  - url: https://gitlab.com/antora/demo/demo-component-b.git\n    branches: v1.0, v2.0"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Use files from the worktree"
              }
            ]
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the branches filter matches both the worktree branch and another branch that contains the same files for the same component version, Antora will fail to run because it does not permit duplicate files."
              }
            ],
            "roles": [],
            "title": null,
            "type": "caution"
          }
        ],
        "context": "section",
        "id": "git-worktree",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Use the git worktree"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To ensure Antora "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "doesn’t"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " use files from the worktree, even if the branch filter matches the worktree branch, you can point the URL directly at the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".git"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " directory. This effectively hides the worktree from Antora so it won’t get used."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "content:\n  sources:\n  - url: ./demo-component-b/.git\n    branches: HEAD\n  - url: https://gitlab.com/antora/demo/demo-component-b.git\n    branches: v1.0, v2.0"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Refers directly at the .git folder to bypass files in the worktree"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A better way to bypass the git worktree is to set the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "worktrees"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "false"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "content:\n  sources:\n  - url: ./demo-component-b\n    branches: HEAD\n    worktrees: false\n  - url: https://gitlab.com/antora/demo/demo-component-b.git\n    branches: v1.0, v2.0"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Sets worktrees to false to bypass files in the worktree"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Keep in mind that, in this case, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "all files must be committed locally"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in order for Antora to use them."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "bypassing-the-git-worktree",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Bypassing the git worktree"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "URLs for Content Sources"
      }
    ]
  }
}
