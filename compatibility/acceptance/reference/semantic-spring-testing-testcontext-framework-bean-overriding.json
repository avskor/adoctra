{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Bean overriding in tests refers to the ability to override specific beans in the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " for a test class, by annotating one or more fields in the test class."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This feature is intended as a less risky alternative to the practice of registering a bean via "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Bean"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " with the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DefaultListableBeanFactory"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "setAllowBeanDefinitionOverriding"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " flag set to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "true"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The Spring TestContext framework provides two sets of annotations for bean overriding."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "@TestBean"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ],
                    "kind": "xref",
                    "target": "testing/annotations/integration-spring/annotation-testbean.html"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "@MockitoBean"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " and "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "@MockitoSpyBean"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ],
                    "kind": "xref",
                    "target": "testing/annotations/integration-spring/annotation-mockitobean.html"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The former relies purely on Spring, while the latter set relies on the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Mockito"
                  }
                ],
                "kind": "link",
                "target": "https://site.mockito.org/"
              },
              {
                "kind": "text",
                "value": " third-party library."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The three annotations mentioned above build upon the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@BeanOverride"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " meta-annotation and associated infrastructure, which allows one to define custom bean overriding variants."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To implement custom bean override support, the following is needed:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "An annotation meta-annotated with "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@BeanOverride"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " that defines the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "BeanOverrideProcessor"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " to use"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "A custom "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "BeanOverrideProcessor"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " implementation"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "One or more concrete "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "BeanOverrideHandler"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " implementations created by the processor"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The Spring TestContext framework includes implementations of the following APIs that support bean overriding and are responsible for setting up the rest of the infrastructure."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "a "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "BeanFactoryPostProcessor"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "a "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "ContextCustomizerFactory"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "a "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "TestExecutionListener"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "spring-test"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " module registers implementations of the latter two ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "BeanOverrideContextCustomizerFactory"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "BeanOverrideTestExecutionListener"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") in its "
              },
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "META-INF/spring.factories"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " properties file"
                  }
                ],
                "kind": "link",
                "target": "https://github.com/spring-projects/spring-framework/tree/main/spring-test/src/main/resources/META-INF/spring.factories"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The bean overriding infrastructure searches in test classes for any field meta-annotated with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@BeanOverride"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and instantiates the corresponding "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "BeanOverrideProcessor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " which is responsible for creating an appropriate "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "BeanOverrideHandler"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The internal "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "BeanOverrideBeanFactoryPostProcessor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " then uses bean override handlers to alter the test’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " by creating, replacing, or wrapping beans as defined by the corresponding "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "BeanOverrideStrategy"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ":"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Replaces the bean. Throws an exception if a corresponding bean does not exist."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "REPLACE"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Replaces the bean if it exists. Creates a new bean if a corresponding bean does not exist."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "REPLACE_OR_CREATE"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Retrieves the original bean and wraps it."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "WRAP"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Only "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "singleton"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " beans can be overridden. Any attempt to override a non-singleton bean will result in an exception."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "When replacing a bean created by a "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "FactoryBean"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "FactoryBean"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " itself will be replaced with a singleton bean corresponding to bean override instance created by the applicable "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "BeanOverrideHandler"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "When wrapping a bean created by a "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "FactoryBean"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", the object created by the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "FactoryBean"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " will be wrapped, not the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "FactoryBean"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " itself."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "admonition",
            "id": null,
            "roles": [],
            "title": null,
            "type": "tip"
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In contrast to Spring’s autowiring mechanism (for example, resolution of an "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@Autowired"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " field), the bean overriding infrastructure in the TestContext framework has limited heuristics it can perform to locate a bean. Either the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "BeanOverrideProcessor"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " can compute the name of the bean to override, or it can be unambiguously selected given the type of the annotated field and its qualifying annotations."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Typically, the bean is selected \"by type\" by the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "BeanOverrideFactoryPostProcessor"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ". Alternatively, the user can directly provide the bean name in the custom annotation."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "BeanOverrideProcessor"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " implementations may also internally compute a bean name based on a convention or some other method."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "admonition",
            "id": null,
            "roles": [],
            "title": null,
            "type": "note"
          }
        ],
        "context": "section",
        "id": "testcontext-bean-overriding-custom",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Custom Bean Override Support"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Bean Overriding in Tests"
      }
    ]
  }
}
