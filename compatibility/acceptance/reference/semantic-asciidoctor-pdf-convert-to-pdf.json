              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Notice that the body of the document is arranged in a single column. If the doctype is set to article (the default) or manpage, the body of the document can be arranged into multiple columns by assigning a column count to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "page-columns"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key in a custom theme. The width of the gap between the columns can be adjusted using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "page-column-gap"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " theme key. See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Page Columns"
                  }
                ],
                "kind": "xref",
                "target": "theme:page.html#columns"
