              {
                "kind": "text",
                "value": " gem installed to run this example since it uses the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "source-highlighter"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute with the value of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "rouge"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null,
            "type": "important"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Converting to PDF is as straightforward as running the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor-pdf"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " command using Ruby and passing the AsciiDoc document as the first argument:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor-pdf basic-example.adoc"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This command is a shorter way of running "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " with the PDF converter and backend enabled:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor -r asciidoctor-pdf -b pdf basic-example.adoc"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor-pdf"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " command saves you from having to remember these low-level options. That’s why we provide it."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the command completes, you should see the file "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "basic-example.pdf"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " in the current directory. Asciidoctor creates the output file in the same directory as the input file by default. Open the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "basic-example.pdf"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " file with a PDF viewer to see the result."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "alt": [
              {
                "kind": "text",
                "value": "Screenshot of PDF document"
              }
            ],
            "attributes": {
              "height": "540",
              "width": "960"
            },
            "caption": [
              {
                "kind": "text",
                "value": "Figure 1. "
              }
            ],
            "context": "image",
            "id": null,
            "roles": [],
            "src": "basic-example-pdf-screenshot.png",
            "svg": null,
            "target": "basic-example-pdf-screenshot.png",
            "title": [
              {
                "kind": "text",
