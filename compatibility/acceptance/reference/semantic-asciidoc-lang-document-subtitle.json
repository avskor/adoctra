        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An optional subtitle can be appended to a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "document title"
                  }
                ],
                "kind": "xref",
                "target": "title.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The HTML 5 converter does not currently split the subtitle out from the document title when generating HTML from AsciiDoc. The document title is only partitioned into a main and subtitle in the output of the DocBook, EPUB 3, and PDF converters. However, the subtitle is still available via the API, so you could add support for it by extending the HTML 5 converter."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the document title contains a colon followed by a space (i.e, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ": "
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), the text after the final colon-space sequence is treated as a subtitle."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Main Title: Subtitle"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "A document title and subtitle"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The separator is searched for from the end of the text. Therefore, only the last occurrence of the separator (i.e, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ": "
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") is used for partitioning the title."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Main Title: Main Title Continued: Subtitle"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "A document title that contains more than one colon-space sequence"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "You can change the title separator by specifying the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "separator"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " block attribute explicitly above the document title. A space will automatically be appended to the separator value."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[separator=::]\n= Main Title:: Subtitle"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Assign separator to the document title"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "You can also assign a separator using a document attribute "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "title-separator"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " in the header."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "= Main Title:: Subtitle\n:title-separator: ::"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Assign title-separator to the document title"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "title-separator"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " can also be assigned via the CLI."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "literal",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "$ asciidoctor -a title-separator=:: document.adoc"
                  }
                ],
                "language": null,
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "_modify_the_title_separator",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Modify the title separator"
              }
            ]
          }
        ],
        "context": "section",
        "id": "_subtitle_syntax",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Subtitle syntax"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can partition the title from the API when calling the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "doctitle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method on Document:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "title_parts = document.doctitle partition: true\nputs title_parts.title\nputs title_parts.subtitle"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Retrieving a partitioned document title"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can partition the title in an arbitrary way by passing the separator as a value to the partition option. In this case, the partition option both activates subtitle partitioning and passes in a custom separator."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "title_parts = document.doctitle partition: '::'\nputs title_parts.title\nputs title_parts.subtitle"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Retrieving a partitioned document title with a custom separator"
              }
            ]
          }
        ],
