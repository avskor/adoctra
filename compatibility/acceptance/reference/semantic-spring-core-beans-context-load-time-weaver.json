          {
            "kind": "text",
            "value": "The "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "LoadTimeWeaver"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is used by Spring to dynamically transform classes as they are loaded into the Java virtual machine (JVM)."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "To enable load-time weaving, you can add the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@EnableLoadTimeWeaving"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " to one of your "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Configuration"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " classes, as the following example shows:"
          }
