        "context": "section",
        "id": "jdbc-embedded-database-types-custom",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Customizing the Embedded Database Type"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Embedded databases provide a lightweight way to test data access code. The next example is a data access integration test template that uses an embedded database. Using such a template can be useful for one-offs when the embedded database does not need to be reused across test classes. However, if you wish to create an embedded database that is shared within a test suite, consider using the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Spring TestContext Framework"
                  }
                ],
                "kind": "xref",
                "target": "testing/testcontext-framework.html"
              },
              {
                "kind": "text",
                "value": " and configuring the embedded database as a bean in the Spring "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " as described in "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Creating an Embedded Database"
                  }
                ],
                "kind": "xref",
                "target": "data-access/jdbc/embedded-database-support.html#jdbc-embedded-database"
              },
              {
                "kind": "text",
                "value": ". The following listing shows the test template:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "public class DataAccessIntegrationTestTemplate {\n\n\tprivate EmbeddedDatabase db;\n\n\t@BeforeEach\n\tpublic void setUp() {\n\t\t// creates an HSQL in-memory database populated from default scripts\n\t\t// classpath:schema.sql and classpath:data.sql\n\t\tdb = new EmbeddedDatabaseBuilder()\n\t\t\t\t.generateUniqueName(true)\n\t\t\t\t.addDefaultScripts()\n\t\t\t\t.build();\n\t}\n\n\t@Test\n\tpublic void testDataAccess() {\n\t\tJdbcTemplate template = new JdbcTemplate(db);\n\t\ttemplate.query( /* ... */ );\n\t}\n\n\t@AfterEach\n\tpublic void tearDown() {\n\t\tdb.shutdown();\n\t}\n\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "class DataAccessIntegrationTestTemplate {\n\n\tprivate lateinit var db: EmbeddedDatabase\n\n\t@BeforeEach\n\tfun setUp() {\n\t\t// creates an HSQL in-memory database populated from default scripts\n\t\t// classpath:schema.sql and classpath:data.sql\n\t\tdb = EmbeddedDatabaseBuilder()\n\t\t\t\t.generateUniqueName(true)\n\t\t\t\t.addDefaultScripts()\n\t\t\t\t.build()\n\t}\n\n\t@Test\n\tfun testDataAccess() {\n\t\tval template = JdbcTemplate(db)\n\t\ttemplate.query( /* ... */)\n\t}\n\n\t@AfterEach\n\tfun tearDown() {\n\t\tdb.shutdown()\n\t}\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
