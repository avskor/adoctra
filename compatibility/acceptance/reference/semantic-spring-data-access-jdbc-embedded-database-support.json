        ],
        "context": "section",
        "id": "jdbc-embedded-database-types",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Selecting the Embedded Database Type"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "While each supported type comes with default connection settings, it is possible to customize them if necessary. The following example uses H2 with a custom driver:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "   @Configuration\n   public class DataSourceConfig {\n\n       @Bean\n       public DataSource dataSource() {\n           return new EmbeddedDatabaseBuilder()\n                   .setDatabaseConfigurer(EmbeddedDatabaseConfigurers\n                           .customizeConfigurer(H2, this::customize))\n                   .addScript(\"schema.sql\")\n                   .build();\n       }\n\n       private EmbeddedDatabaseConfigurer customize(EmbeddedDatabaseConfigurer defaultConfigurer) {\n           return new EmbeddedDatabaseConfigurerDelegate(defaultConfigurer) {\n               @Override\n               public void configureConnectionProperties(ConnectionProperties properties, String databaseName) {\n                   super.configureConnectionProperties(properties, databaseName);\n                   properties.setDriverClass(CustomDriver.class);\n               }\n           };\n       }\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Configuration\nclass DataSourceConfig {\n\n\t@Bean\n\tfun dataSource(): DataSource {\n\t\treturn EmbeddedDatabaseBuilder()\n\t\t\t.setDatabaseConfigurer(EmbeddedDatabaseConfigurers\n\t\t\t\t.customizeConfigurer(EmbeddedDatabaseType.H2) { this.customize(it) })\n\t\t\t.addScript(\"schema.sql\")\n\t\t\t.build()\n\t}\n\n\tprivate fun customize(defaultConfigurer: EmbeddedDatabaseConfigurer): EmbeddedDatabaseConfigurer {\n\t\treturn object : EmbeddedDatabaseConfigurerDelegate(defaultConfigurer) {\n\t\t\toverride fun configureConnectionProperties(\n\t\t\t\tproperties: ConnectionProperties,\n\t\t\t\tdatabaseName: String\n\t\t\t) {\n\t\t\t\tsuper.configureConnectionProperties(properties, databaseName)\n\t\t\t\tproperties.setDriverClass(CustomDriver::class.java)\n\t\t\t}\n\t\t}\n\t}\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
