        "title": [
          {
            "kind": "text",
            "value": "Reference the document title"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By default, the text of the document title is used as the value of the HTML "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<title>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " element and main DocBook "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<info>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " element. You can override this behavior by setting the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "title"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute in the header with an attribute entry. If neither a level 0 section title or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "doctitle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is specified in the header, but "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "title"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is, its value is used as a fallback document title."
              }
            ],
            "roles": [],
            "title": null
          }
