            "inlines": [
              {
                "kind": "text",
                "value": "A document title, while optional, is usually the first element in the document header."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A document title is specified using a single equals sign ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "="
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), followed by a space, then the title text."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-title",
            "inlines": [
              {
                "kind": "text",
                "value": "= The Intrepid Chronicles\n\nThis adventure begins on a frigid morning."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Document with a title"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 1"
                  }
                ],
                "kind": "xref",
                "target": "#ex-title"
              },
              {
                "kind": "text",
                "value": ", notice the empty line between the document title and the first line of prose. That empty line is what separates the document header from the document body."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "alt": [
              {
                "kind": "text",
                "value": "Title of document"
              }
            ],
            "attributes": {},
            "context": "image",
            "id": null,
            "roles": [],
            "src": "document-title.png",
            "svg": null,
            "target": "document-title.png",
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Technically, a document title is a level 0 section title ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "="
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "). The "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "article"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " and "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "manpage"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " document types ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "doctype"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ") can only have one level 0 section."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "book"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " document type permits multiple level 0 section titles. When the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "doctype"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " is "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "book"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", the title of the level 0 section in the header is used as the document’s title. Subsequent level 0 section titles in the document body are interpreted as "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "part titles"
                      }
                    ],
                    "kind": "xref",
                    "target": "sections:parts.html"
                  },
                  {
                    "kind": "text",
                    "value": ", unless labeled with a "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "style"
                      }
                    ],
                    "kind": "xref",
                    "target": "sections:styles.html"
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "_doctypes_and_titles",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Doctypes and titles"
              }
            ]
          }
        ],
        "context": "section",
        "id": "_title_syntax",
