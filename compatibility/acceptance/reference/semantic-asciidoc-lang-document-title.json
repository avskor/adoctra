          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When converting a standalone document, the document title is shown by default. You can control whether the document title appears with the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "showtitle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute. If you don’t want the title to be shown, unset the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "showtitle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute using "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "showtitle!"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in the document header or via the CLI or API."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When converted to an embeddable document, the document title isn’t shown by default. To show the title in the embeddable document, set "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "showtitle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in the document header or via the CLI or API. The author and revision information isn’t shown below the document title in the embeddable version of the document like it is in the standalone document, even when "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "showtitle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is set."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "hide-or-show",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Hide or show the document title"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The level 0 section title in a document’s header, that is, its title, is automatically assigned to the document attribute "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "doctitle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". You can reference the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "doctitle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute anywhere in your document and the document’s title will be displayed."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-doctitle",
            "inlines": [
              {
                "kind": "text",
                "value": "= The Intrepid Chronicles\n\n{doctitle} begin on a frigid morning."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Reference the doctitle attribute"
              }
            ]
          },
          {
            "alt": [
              {
                "kind": "text",
                "value": "The document title is displayed wherever the doctitle attribute is referenced"
              }
            ],
            "attributes": {},
            "context": "image",
            "id": null,
            "roles": [],
            "src": "doctitle.png",
            "svg": null,
            "target": "doctitle.png",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "doctitle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute can also be explicitly set and assigned a value using an attribute entry in the header."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "reference-doctitle",
        "level": 1,
