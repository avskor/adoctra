      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "After you configure the SMT for a connector, whenever the connector captures schema change events that match the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "configured types"
                  }
                ],
                "kind": "xref",
                "target": "#schema-change-event-exclude-list"
              },
              {
                "kind": "text",
                "value": ", it resets the values for those events to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "null"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The connector does not send events with the resulting "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "null"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " values to Kafka."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following examples shows a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "schema change event record before it is processed"
                  }
                ],
                "kind": "xref",
                "target": "#schema-change-event-filter-example-before-processing"
              },
              {
                "kind": "text",
                "value": " by the SMT, followed by the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "output after the SMT filters the event"
                  }
                ],
                "kind": "xref",
                "target": "#schema-change-event-filter-example-after-processing"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "{\n    \"schema\":{\n        \"type\":\"struct\",\n        \"fields\":[\n            {\n                \"type\":\"int64\",\n                \"optional\":false,\n                \"field\":\"ts_ms\"\n            },\n            {\n                \"type\":\"string\",\n                \"optional\":true,\n                \"field\":\"databaseName\"\n            },\n            {\n                \"type\":\"string\",\n                \"optional\":true,\n                \"field\":\"schemaName\"\n            },\n            {\n                \"type\":\"string\",\n                \"optional\":true,\n                \"field\":\"ddl\"\n            },\n            {\n                \"type\":\"array\",\n                \"items\":{\n                    \"type\":\"struct\",\n                    \"fields\":[\n                        {\n                            \"type\":\"string\",\n                            \"optional\":false,\n                            \"field\":\"type\"\n                        },\n                        {\n                            \"type\":\"string\",\n                            \"optional\":false,\n                            \"field\":\"id\"\n                        }\n                    ],\n                    \"optional\":false,\n                    \"name\":\"io.debezium.connector.schema.Change\"\n                },\n                \"optional\":false,\n                \"field\":\"tableChanges\"\n            }\n        ],\n        \"optional\":false,\n        \"name\":\"filter.SchemaChangeValue\"\n    },\n    \"payload\":{\n        \"ts_ms\":1691035505397,\n        \"databaseName\":\"test\",\n        \"schemaName\":\"test_schema\",\n        \"ddl\":\"\",\n        \"tableChanges\":[\n            {\n                \"type\":\"DROP\",\n                \"id\":\"test.table\"\n            }\n        ]\n    }\n}"
                  }
                ],
                "language": "json",
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": "schema-change-event-filter-example-before-processing",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Schema change event record before it is processed by the "
              },
              {
                "id": null,
