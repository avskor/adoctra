              {
                "kind": "text",
                "value": ", it resets the values for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DROP"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " event to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "null"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", as shown in the following example:"
              }
