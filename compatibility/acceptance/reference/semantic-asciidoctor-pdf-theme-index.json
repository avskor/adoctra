                  "inlines": [
                    {
                      "kind": "text",
                      "value": "A combination of the "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "default"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " and "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
