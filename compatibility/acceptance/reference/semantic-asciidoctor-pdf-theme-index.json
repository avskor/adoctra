                        {
                          "kind": "text",
                          "value": "media=prepress"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": "."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "default-for-print"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
