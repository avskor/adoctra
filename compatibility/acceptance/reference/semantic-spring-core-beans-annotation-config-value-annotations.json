                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@Component\npublic class MovieRecommender {\n\n    private final String catalog;\n\n    public MovieRecommender(@Value(\"${catalog.name:defaultCatalog}\") String catalog) {\n        this.catalog = catalog;\n    }\n}"
                        }
                      ],
