      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "A Spring "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "BeanPostProcessor"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " uses a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ConversionService"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " behind the scenes to handle the process for converting the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "String"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " value in "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Value"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " to the target type. If you want to provide conversion support for your own custom type, you can provide your own "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ConversionService"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " bean instance as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@Configuration\npublic class AppConfig {\n\n    @Bean\n    public ConversionService conversionService() {\n        DefaultFormattingConversionService conversionService = new DefaultFormattingConversionService();\n        conversionService.addConverter(new MyCustomConverter());\n        return conversionService;\n    }\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@Configuration\nclass AppConfig {\n\n\t@Bean\n\tfun conversionService(): ConversionService {\n\t\treturn DefaultFormattingConversionService().apply {\n\t\t\taddConverter(MyCustomConverter())\n\t\t}\n\t}\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
