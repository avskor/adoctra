          }
        ],
        "roles": [],
        "title": null,
        "type": "note"
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Using the above configuration ensures Spring initialization failure if any "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "${}"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " placeholder could not be resolved. It is also possible to use methods like "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "setPlaceholderPrefix"
              }
            ],
            "kind": "monospace",
