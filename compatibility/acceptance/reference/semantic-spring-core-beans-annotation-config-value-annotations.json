        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "A default lenient embedded value resolver is provided by Spring. It will try to resolve the property value and if it cannot be resolved, the property name (for example "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "${catalog.name}"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ") will be injected as the value. If you want to maintain strict control over nonexistent values, you should declare a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "PropertySourcesPlaceholderConfigurer"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " bean, as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@Configuration\npublic class AppConfig {\n\n\t@Bean\n\tpublic static PropertySourcesPlaceholderConfigurer propertyPlaceholderConfigurer() {\n\t\treturn new PropertySourcesPlaceholderConfigurer();\n\t}\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
