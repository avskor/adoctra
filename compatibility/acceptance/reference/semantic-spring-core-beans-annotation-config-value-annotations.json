          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Bean"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method must be "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "static"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
