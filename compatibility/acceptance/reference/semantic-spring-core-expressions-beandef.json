    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can use SpEL expressions with configuration metadata for defining bean instances. In both cases, the syntax to define the expression is of the form "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "#{ <expression string> }"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "All beans in the application context are available as predefined variables with their common bean name. This includes standard context beans such as "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "environment"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " (of type "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "org.springframework.core.env.Environment"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ") as well as "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "systemProperties"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "systemEnvironment"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " (of type "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Map<String, Object>"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ") for access to the runtime environment."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "To specify a default value, you can place the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Value"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation on fields, methods, and method or constructor parameters (or XML equivalent)."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following example sets the default value of a field:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./FieldValueTestBean[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Note that you do not have to prefix the predefined variable with the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "#"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " symbol here."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following example shows the equivalent but on a property setter method:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./PropertyValueTestBean[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Autowired methods and constructors can also use the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Value"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation, as the following examples show:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./SimpleMovieLister[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./MovieRecommender[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can also refer to other bean properties by name, as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./ShapeGuess[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Expressions in Bean Definitions"
      }
    ]
  }
