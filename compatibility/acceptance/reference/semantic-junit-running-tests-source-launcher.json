            "kind": "text",
            "value": " file with the following content:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "listing",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "import module org.junit.start;\n\nvoid main() {\n  JUnit.run();\n}\n\n@Test\nvoid stringLength() {\n  Assertions.assertEquals(11, \"Hello JUnit\".length());\n}"
          }
        ],
        "language": "java",
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "With all required modular JAR files available in a local "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "lib/"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " directory, the following Java 25+ command will discover and execute tests using the JUnit Platform. It will also print the result tree to the console."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "listing",
