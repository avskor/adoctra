          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To escape a bibliography anchor anywhere in the text, use the syntax "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[[[word]]]"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". This prevents the anchor from being matched as a bibliography anchor or a normal anchor."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By default, the bibliography anchor and reference to the bibliography entry is converted to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[<label>]"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", where <label> is the ID of the entry. If you specify xreftext on the bibliography anchor (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[[[label,xreftext]]]"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), the bibliography anchor and reference to the bibliography entry converts to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[<xreftext>]"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instead."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want the bibliography anchor and reference to appear as a number, assign the number of the entry using the xreftext. For example, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[[[label,1]]]"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " will be converted to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[1]"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want more advanced features such as automatic numbering and custom citation styles, try the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "asciidoctor-bibtex"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://github.com/asciidoctor/asciidoctor-bibtex"
              },
              {
                "kind": "text",
                "value": " project."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
