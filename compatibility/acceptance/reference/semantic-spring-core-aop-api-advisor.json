              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "BeforeAdvice"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ThrowsAdvice"
              }
            ],
            "kind": "monospace",
            "roles": []
