      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An extension is not active until registered with Antora. There are two ways to register an extension. You can specify it using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--extension"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " CLI option or you can list it as an entry in the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "extensions"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key under the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "antora"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " category key in the playbook file."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Once registered, Antora invokes the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "register function"
                  }
                ],
                "kind": "xref",
                "target": "define-extension.html"
              },
              {
                "kind": "text",
                "value": " of the extension in the order it’s listed in the playbook file or passed to the CLI. The extensions in the playbook file are registered before the extensions passed to the CLI, though this order can be changed by "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "enabling a registered extension on request"
                  }
                ],
                "kind": "xref",
                "target": "enable-extension.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A quick way to register (and enable) an extension without modifying the playbook file is to specify it using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--extension"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option provided by the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "antora"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " CLI. If you have more than one extension to register, you can specify this option multiple times."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example of how to use this CLI option to register our extension."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "--extension ./my-extension.js"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--extension"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " CLI option normally appends the entry to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "extensions"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key in the Antora playbook at runtime. (In other words, the extensions listed in the playbook get registered first). However, if there’s an extension listed in the playbook with an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "id"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key with a value that matches the value specified using the CLI option, then the extension’s order relative to other extensions in the playbook is preserved."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Using the CLI option requires you to type a longer command each time you run Antora. For that reason, it’s often better to specify it in the playbook file, particularly if you’re going to always use it. Later on you’ll learn that even if you do add it to the playbook file, it’s still possible to control when it’s activated using the CLI. The CLI can also influence the order in which extensions are registered."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "extension-option",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "CLI option"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An Antora extension can be registered in the playbook file using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "extensions"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "extensions"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is specified under the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "antora"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " category key. The value of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "extensions"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key must be an array. Each entry in the array is either a string or a map (key/value pairs)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the value is a string, the value is assumed to be a require request (i.e., path or module name) that resolves to the extension script. When the value is a map, the require request must be specified using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "require"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key. Using a map leaves room for additional configuration keys, both predefined (like "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "enabled"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") and custom."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you were to publish the extension to a package repository, then the require request would be the name of that package (i.e., its module name). In that case, ensure that the package is configured as a dependency of the playbook project so that Node.js fetches it. Antora doesn’t download npm packages for you."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Let’s register our extension in the playbook file so we can see it in action. In its simplest form, the extension entry is the require request (i.e., path) to the extension script."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "antora:\n  extensions:\n  - ./my-extension.js"
                  }
                ],
                "language": "yaml",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "antora-playbook.yml with extension"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "We prefix the path with "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "./"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " to indicate that its location is relative to the playbook file. See the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@antora/user-require-helper usage"
                      }
                    ],
                    "kind": "link",
                    "target": "https://gitlab.com/antora/user-require-helper/blob/main/README.adoc#user-content-usage"
                  },
                  {
                    "kind": "text",
                    "value": " to learn how Antora resolves require requests in the playbook file."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "When you run Antora, you should now see a line like this in your terminal:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "literal",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Antora is building the Example Docs."
                  }
                ],
                "language": null,
                "roles": [
                  "output"
                ],
                "title": null
              }
            ],
            "context": "section",
            "id": "without-configuration",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Without configuration"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If you need to specify configuration settings for the extension, then you must change the entry type from a string to a map. When making this change, the require request must now be specified on the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "require"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " key."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "antora:\n  extensions:\n  - require: ./my-extension.js\n    optional_behavior: true"
                  }
                ],
                "language": "yaml",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "antora-playbook.yml with extension specified using require key"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "By using a map, additional keys can be added as siblings of the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "require"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " key in order to pass configuration to the extension. You can find an example of how to use these additional keys to configure an extension on the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "configure-extension.html"
                      }
                    ],
                    "kind": "xref",
                    "target": "configure-extension.html"
                  },
                  {
                    "kind": "text",
                    "value": " page."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Our next step is to add "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "event listeners"
                      }
                    ],
                    "kind": "xref",
                    "target": "add-event-listeners.html"
                  },
                  {
                    "kind": "text",
                    "value": " to our extension."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "with-configuration",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "With configuration"
              }
            ]
          }
        ],
        "context": "section",
        "id": "extensions-key",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Playbook key"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Register an Extension"
      }
    ]
  }
}
