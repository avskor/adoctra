                                    "id": null,
                                    "inlines": [
                                      {
                                        "kind": "text",
                                        "value": "{\n    \"header_x\": 0,\n    \"event_timestamp\": 1626102708861,\n    \"key\": 100,\n}"
                                      }
                                    ],
                                    "language": null,
