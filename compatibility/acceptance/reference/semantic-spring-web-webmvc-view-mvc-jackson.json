            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MappingJackson2XmlView"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " uses the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Jackson XML extension’s"
                  }
                ],
                "kind": "link",
                "target": "https://github.com/FasterXML/jackson-dataformat-xml"
              },
              {
                "kind": "text",
                "value": " "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "XmlMapper"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to render the response content as XML. If the model contains multiple entries, you should explicitly set the object to be serialized by using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "modelKey"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " bean property. If the model contains a single entry, it is serialized automatically."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can customize XML mapping as needed by using JAXB or Jackson’s provided annotations. When you need further control, you can inject a custom "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "XmlMapper"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " through the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ObjectMapper"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " property, for cases where custom XML you need to provide serializers and deserializers for specific types."
              }
            ],
            "roles": [],
            "title": null
          }
