            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "IntelliJ IDEA supports running tests on the JUnit Platform since version 2016.2. For more information, please consult this "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "IntelliJ IDEA resource"
                  }
                ],
                "kind": "link",
                "target": "https://jb.gg/junit-idea/"
              },
              {
                "kind": "text",
                "value": ". Note, however, that it is recommended to use IDEA 2017.3 or newer since more recent versions of IDEA download the following JARs automatically based on the API version used in the project: "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "junit-platform-launcher"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "junit-jupiter-engine"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "junit-vintage-engine"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In order to use a different JUnit version (e.g., {version}), you may need to include the corresponding versions of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "junit-platform-launcher"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "junit-jupiter-engine"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "junit-vintage-engine"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " JARs in the classpath."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "testImplementation(platform(\"org.junit:junit-bom:{version}\"))\ntestRuntimeOnly(\"org.junit.platform:junit-platform-launcher\")\ntestRuntimeOnly(\"org.junit.jupiter:junit-jupiter-engine\")\ntestRuntimeOnly(\"org.junit.vintage:junit-vintage-engine\")"
              }
            ],
            "language": "groovy",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Additional Gradle Dependencies"
              }
            ]
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "<!-- ... -->\n<dependencies>\n\t<dependency>\n\t\t<groupId>org.junit.platform</groupId>\n\t\t<artifactId>junit-platform-launcher</artifactId>\n\t\t<scope>test</scope>\n\t</dependency>\n\t<dependency>\n\t\t<groupId>org.junit.jupiter</groupId>\n\t\t<artifactId>junit-jupiter-engine</artifactId>\n\t\t<scope>test</scope>\n\t</dependency>\n\t<dependency>\n\t\t<groupId>org.junit.vintage</groupId>\n\t\t<artifactId>junit-vintage-engine</artifactId>\n\t\t<scope>test</scope>\n\t</dependency>\n</dependencies>\n<dependencyManagement>\n\t<dependencies>\n\t\t<dependency>\n\t\t\t<groupId>org.junit</groupId>\n\t\t\t<artifactId>junit-bom</artifactId>\n\t\t\t<version>{version}</version>\n\t\t\t<type>pom</type>\n\t\t\t<scope>import</scope>\n\t\t</dependency>\n\t</dependencies>\n</dependencyManagement>"
              }
            ],
            "language": "xml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Additional Maven Dependencies"
              }
            ]
          }
