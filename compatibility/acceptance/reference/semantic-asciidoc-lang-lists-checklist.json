        "inlines": [
          {
            "kind": "text",
            "value": "List items can be marked complete using checklists."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Checklists (i.e., task lists) are unordered lists that have items marked as checked ("
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[*]"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[x]"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ") or unchecked ("
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[ ]"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "). Here’s an example:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "listing",
        "id": "ex-syntax",
        "inlines": [
          {
            "kind": "text",
            "value": "* [*] checked\n* [x] also checked\n* [ ] not checked\n* normal list item"
          }
        ],
        "language": "asciidoc",
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Checklist syntax"
          }
        ]
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The result of "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Example 1"
              }
            ],
            "kind": "xref",
            "target": "#ex-syntax"
          },
          {
            "kind": "text",
            "value": " is displayed below."
          }
        ],
        "roles": [],
        "title": null
      },
      {
