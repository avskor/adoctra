        "inlines": [
          {
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "See equivalent in the Reactive stack"
                  }
                ],
                "kind": "xref",
                "target": "web/webflux/controller/ann-methods/typeconversion.html"
              }
            ],
            "kind": "span",
            "roles": [
              "small"
            ]
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Some annotated controller method arguments that represent "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "String"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "-based request input (such as "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestParam"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestHeader"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@PathVariable"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@MatrixVariable"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@CookieValue"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ") can require type conversion if the argument is declared as something other than "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "String"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "For such cases, type conversion is automatically applied based on the configured converters. By default, simple types ("
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "int"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "long"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Date"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", and others) are supported. You can customize type conversion through a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebDataBinder"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " (see "
          },
          {
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DataBinder"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "kind": "xref",
            "target": "web/webmvc/mvc-controller/ann-initbinder.html"
          },
          {
            "kind": "text",
            "value": ") or by registering "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Formatters"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " with the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "FormattingConversionService"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". See "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Spring Field Formatting"
              }
            ],
            "kind": "xref",
            "target": "core/validation/format.html"
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "A practical issue in type conversion is the treatment of an empty String source value. Such a value is treated as missing if it becomes "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "null"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " as a result of type conversion. This can be the case for "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Long"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "UUID"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", and other target types. If you want to allow "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "null"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " to be injected, either use the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "required"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " flag on the argument annotation, or declare the argument as "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Nullable"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "As of 5.3, non-null arguments will be enforced even after type conversion. If your handler method intends to accept a null value as well, either declare your argument as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Nullable"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or mark it as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "required=false"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in the corresponding "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@RequestParam"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", etc. annotation. This is a best practice and the recommended solution for regressions encountered in a 5.3 upgrade."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Alternatively, you may specifically handle, for example, the resulting "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MissingPathVariableException"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in the case of a required "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@PathVariable"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". A null value after conversion will be treated like an empty original value, so the corresponding "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Missing…​Exception"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " variants will be thrown."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "admonition",
        "id": null,
        "roles": [],
        "title": null,
        "type": "note"
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Type Conversion"
      }
    ]
  }
}
