{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can mark index terms explicitly in AsciiDoc content. Index terms form a controlled vocabulary that can be used to navigate the document by keyword starting from an index."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Although index terms are always processed, only Asciidoctor PDF and the DocBook toolchain support creating an index catalog automatically. To create an index, define a level 1 section ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "=="
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") marked with the style "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "index"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " at the end of your document."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[index]\n== Index"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Both Asciidoctor PDF and the DocBook toolchain will automatically populate an index into this seed section."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The built-in HTML5 converter in Asciidoctor does not generate an index."
              }
            ],
            "roles": [],
            "title": null,
            "type": "warning"
          }
        ],
        "context": "section",
        "id": "_index_catalog",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Index catalog"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "There are two types of index terms in AsciiDoc:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "paragraph",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "An index term that appears in the flow of text (i.e., a visible term) and in the index. This type of index term can only be used to define a primary entry."
                        }
                      ],
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "indexterm2:[<primary>]"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "line-break"
                    },
                    {
                      "kind": "text",
                      "value": " "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "((<primary>))"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "flow index term"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "paragraph",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "A group of index terms that appear only in the index. This type of index term can be used to define a primary entry as well as optional secondary and tertiary entries."
                        }
                      ],
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "indexterm:[<primary>, <secondary>, <tertiary>]"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "line-break"
                    },
                    {
                      "kind": "text",
                      "value": " "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "(((<primary>, <secondary>, <tertiary>)))"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "concealed index term"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example that shows the two forms in use."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The Lady of the Lake, her arm clad in the purest shimmering samite,\nheld aloft Excalibur from the bosom of the water,\nsignifying by divine providence that I, ((Arthur)), "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO1-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\nwas to carry Excalibur (((Sword, Broadsword, Excalibur))). "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO1-2",
                "kind": "callout",
                "number": "2",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\nThat is why I am your king. Shut up! Will you shut up?!\nBurn her anyway! I'm not a witch.\nLook, my liege! We found them.\n\nindexterm2:[Lancelot] was one of the Knights of the Round Table. "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO1-3",
                "kind": "callout",
                "number": "3",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\nindexterm:[knight, Knight of the Round Table, Lancelot] "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO1-4",
                "kind": "callout",
                "number": "4",
                "src": "",
                "xml": false
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "colist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-1"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The double parenthesis form adds a primary index term and includes the term in the generated output."
                  }
                ],
                "src": ""
              },
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-2"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The triple parenthesis form allows for an optional second and third index term and "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "does not"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " include the terms in the generated output (i.e., concealed index term)."
                  }
                ],
                "src": ""
              },
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-3"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The inline macro "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "indexterm2:[primary]"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " is equivalent to the double parenthesis form."
                  }
                ],
                "src": ""
              },
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-4"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The inline macro "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "indexterm:[primary, secondary, tertiary]"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " is equivalent to the triple parenthesis form."
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you’re defining a concealed index term (i.e., the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "indexterm"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " macro), and one of the terms contains a comma, you must surround that segment in double quotes so the comma is treated as content. For example:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "I, King Arthur.\nindexterm:[knight, \"Arthur, King\"]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "or"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "I, King Arthur.\n(((knight, \"Arthur, King\")))"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_index_terms",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Index terms"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Hidden index entries should be directly adjacent to the paragraph content to which they apply. "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 1"
                  }
                ],
                "kind": "xref",
                "target": "#ex-hidden-terms-correct"
              },
              {
                "kind": "text",
                "value": " shows where to place hidden index terms for a paragraph."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-hidden-terms-correct",
            "inlines": [
              {
                "kind": "text",
                "value": "=== Create a new Git repository\n\n(((Repository, create)))\n(((Create Git repository)))\nTo create a new git repository,"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Correct"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the terms are offset from the paragraph content by an empty line, it will cause an empty paragraph to be created in the parsed document, thus leaving extra space in the generated output. "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 2"
                  }
                ],
                "kind": "xref",
                "target": "#ex-hidden-terms-incorrect-1"
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 3"
                  }
                ],
                "kind": "xref",
                "target": "#ex-hidden-terms-incorrect-2"
              },
              {
                "kind": "text",
                "value": " show where you should not place hidden index terms for a paragraph."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-hidden-terms-incorrect-1",
            "inlines": [
              {
                "kind": "text",
                "value": "=== Create a new Git repository\n\n(((Repository, create)))\n(((Create Git repository)))\n\nTo create a new git repository,"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Incorrect"
              }
            ]
          },
          {
            "context": "listing",
            "id": "ex-hidden-terms-incorrect-2",
            "inlines": [
              {
                "kind": "text",
                "value": "=== Create a new Git repository\n(((Repository, create)))\n(((Create Git repository)))\n\nTo create a new git repository,"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Also incorrect"
              }
            ]
          }
        ],
        "context": "section",
        "id": "_placement_of_hidden_index_terms",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Placement of hidden index terms"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Index"
      }
    ]
  }
}
