                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Convert using pandoc as shown above."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "blocks": [
                      {
                        "context": "paragraph",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "If for some reason pandoc is not extracting images, you can always extract them by using unzip tool. Docx is just a zip file with a docx file extension. Embedded images are located in "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "word/media"
                              }
                            ],
                            "kind": "emphasis",
                            "roles": [
                              "path"
                            ]
                          },
                          {
                            "kind": "text",
                            "value": " directory."
                          }
                        ],
                        "roles": [],
                        "title": null
                      },
                      {
                        "context": "literal",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "$ unzip input.docx -d input-docx\n  ls input-docx/word/media/"
                          }
                        ],
                        "language": null,
                        "roles": [],
                        "title": null
                      }
                    ],
                    "context": "admonition",
                    "id": null,
                    "roles": [],
                    "title": null,
                    "type": "note"
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Check that the output document looks OK, and that all images have been extracted."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "ulist",
                    "id": null,
                    "items": [
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Delete automatic ids (those beginning with underscores)"
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Replace long table delimiters with short ones."
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Insert line-breaks to get to 1 sentence per paragraph."
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Re-insert images and turn caption paragraphs back into Asciidoctor captions."
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Replace the hard cross references with AsciiDoc references."
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Fix tables: merged cells will have unmerged, column widths need putting back."
                          }
                        ]
                      }
                    ],
                    "roles": [],
                    "style": null,
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Fix up the output, preferably with an editor that can do regular expressions:"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Try to convert it, and fix any errors that come up."
                  }
                ]
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following are POSIX shell one-liners to automate some of these steps (adjust the regexps to match your particular document):"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [
                  {
                    "context": "literal",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "$ perl -W -pe  's!\\[\\[_.*]]!!g' -i output.adoc"
                      }
                    ],
                    "language": null,
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Delete automatically inserted ids"
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "literal",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "$ perl -W -pe  's!\\|==*!|====!g' -i output.adoc"
                      }
                    ],
                    "language": null,
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Shorten table delimiters"
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "literal",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "$ perl -W -pe 's!(\\w\\w+)\\.\\s+(\\w)!$1.\\n$2!g' -i output.adoc"
                      }
                    ],
                    "language": null,
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "1 sentence per line. Be careful not to match lists. It will get confused by abbreviations, but there is no way around that."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "literal",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "$ perl -W -pe 's!^Figure (\\d+)\\s?(.*)![[fig-$1]]\\n.$2\\n!g' -i output.adoc"
                      }
                    ],
                    "language": null,
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Replace figure captions with id and title"
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "literal",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "$ perl -W -pe 's!Figure (\\d+)!<<fig-$1>>!g' -i output.adoc"
                      }
                    ],
                    "language": null,
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Replace references to figures with AsciiDoc xref"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          }
        ],
        "context": "section",
        "id": "_optimizing_for_pandoc",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Optimizing for Pandoc"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Google Docs can already upload and edit MS Word docx files. Using the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "AsciiDoc Processor add-on"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://workspace.google.com/marketplace/app/asciidoc_processor/1023004302050"
              },
              {
                "kind": "text",
                "value": " by "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Guillaume Grossetie"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://github.com/ggrossetie"
              },
              {
                "kind": "text",
                "value": ", you can copy and paste part or all of the document from Google Docs as AsciiDoc text. The features that it can handle seem to be substantially fewer than pandoc but expect further development. The source for the add-on can be found in "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "its repository"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://github.com/ggrossetie/asciidoc-googledocs-addon/"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_google_docs",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Google Docs"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This method is only useful for very small files or if the other methods are not available."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "It keeps the text, and "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "fixes"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " fields like auto-numbered lists and cross references."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "It loses tables (converted to plain paragraphs), images, symbols, form fields, and text boxes."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In MS Word, use \"Save as > Plain text\", then when the File Conversion dialog appears, set:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Other encoding: UTF-8"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Do not insert line breaks"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Allow character substitution"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Save the file then apply AsciiDoc markup manually."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Experiment with the encoding. Try UTF-8 first, but if you get problems you can always revert to US-ASCII."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
