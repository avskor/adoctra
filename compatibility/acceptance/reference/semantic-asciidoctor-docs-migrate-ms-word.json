          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The basic usage documented above is fine for one-off imports. If you have a lot to do, it’s worthwhile cleaning the input document first, and automating the post-conversion tidy up."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "olist",
            "id": null,
            "items": [
              {
                "blocks": [
                  {
                    "context": "ulist",
                    "id": null,
                    "items": [
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Remove non-essential material (title pages, headers and footers, table of contents etc.); it is usually easiest to copy just the body text into a new blank document"
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Switch off tracking and accept all changes"
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Ensure you have used Heading styles for headings"
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Ensure table titles are immediately "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "above"
                              }
                            ],
                            "kind": "strong",
                            "roles": []
                          },
                          {
                            "kind": "text",
                            "value": " their table"
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Ensure figure titles are immediately "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "above"
                              }
                            ],
                            "kind": "strong",
                            "roles": []
                          },
                          {
                            "kind": "text",
                            "value": " their figure"
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Ensure images are inserted as embedded files, not as links"
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Remove canvases and put any images they contained into the main flow as paragraph images (this limitation may be removed in the next release of pandoc)"
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "id": "remove-refs",
                            "kind": "anchor"
                          },
                          {
                            "kind": "text",
                            "value": "Remove hyperlinks and replace all internal references and auto-generated sequence numbers with their literal values (kbd:[Ctrl+A], kbd:[Ctrl+Shift+F9])"
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Remove text boxes and put their text into the main flow"
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Replace special characters: smart quotes with simple quotes, non-breaking hyphens with normal hyphens."
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Remove all character formatting (kbd:[Ctrl+A], kbd:[Ctrl+B], kbd:[Ctrl+B], kbd:[Ctrl+I], kbd:[Ctrl+I], kbd:[Ctrl+U], kbd:[Ctrl+U])"
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Optional: insert ids and cross references using AsciiDoc notation (You might find it easier doing it now rather than in the AsciiDoc document later.)"
