          },
          {
            "kind": "text",
            "value": " is also supported at the class level, in which case it is inherited by all controller methods. This is the effect of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RestController"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", which is nothing more than a meta-annotation marked with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Controller"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ResponseBody"
              }
            ],
            "kind": "monospace",
            "roles": []
