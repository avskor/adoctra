          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "A "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Resource"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " object can be returned for file content, copying the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "InputStream"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " content of the provided resource to the response "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "OutputStream"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". Note that the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "InputStream"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " should be lazily retrieved by the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Resource"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " handle in order to reliably close it after it has been copied to the response. If you are using "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "InputStreamResource"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " for such a purpose, make sure to construct it with an on-demand "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "InputStreamSource"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " (for example, through a lambda expression that retrieves the actual "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "InputStream"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ")."
          }
        ],
