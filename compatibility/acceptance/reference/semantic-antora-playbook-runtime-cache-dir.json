    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The first time Antora runs, it caches any remote content sources git repositories and UI bundles. On subsequent runs, Antora resolves these resources from the cache folder, effectively running offline."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The remote resources are stored in Antora’s default cache location unless an alternate location is configured using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "cache_dir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key. The default location for the cache varies by operating system."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "$XDG_CACHE_HOME/antora"
                        }
                      ],
                      "kind": "emphasis",
                      "roles": [
                        "path"
                      ]
                    },
                    {
                      "kind": "text",
                      "value": " or "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "$HOME/.cache/antora"
                        }
                      ],
                      "kind": "emphasis",
                      "roles": [
                        "path"
                      ]
                    },
                    {
                      "kind": "text",
                      "value": " if "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "$XDG_CACHE_HOME"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " isn’t set"
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Linux"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "$HOME/Library/Caches/antora"
                        }
                      ],
                      "kind": "emphasis",
                      "roles": [
                        "path"
                      ]
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "macOS"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "$APPDATA/antora/Caches"
                        }
                      ],
                      "kind": "emphasis",
                      "roles": [
                        "path"
                      ]
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Windows"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Before downloading remote resources, Antora will first look for them in the cache folder. If you want to update your cache, configure Antora to "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fetch updates"
                  }
                ],
                "kind": "xref",
                "target": "runtime-fetch.html"
              },
              {
                "kind": "text",
                "value": ". Another option is to locate the Antora cache directory on your system and manually delete it."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "default",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Default cache directory"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The optional "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "cache_dir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is configured under the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "runtime key"
                  }
                ],
                "kind": "xref",
                "target": "configure-runtime.html"
              },
              {
                "kind": "text",
                "value": " in a playbook. "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "cache_dir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " specifies the directory where the remote repositories should be cloned and the remote UI bundle should be downloaded. It accepts a relative or absolute filesystem path."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "runtime:\n  cache_dir: ./.cache/antora"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In this case, the value resolves to the folder "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".cache/antora"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " relative to the location of the playbook file. We know the resolved location is relative to the playbook file because it starts with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "./"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The resolution rules for "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "cache_dir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " are the same as for any path in the playbook. A relative path is expanded to an absolute path using the following rules:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If the first path segment is a tilde ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "~"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), the remaining path is resolved relative to the user’s home directory."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If the first path segment is a dot ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "."
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), the remaining path is resolved relative to the location of the playbook file."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If the first path segment is a tilde directly followed by a plus sign ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "~+"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), or does not begin with an aforementioned prefix, the remaining path is resolved relative to the current working directory."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The cache directory can also be configured from the CLI with the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--cache-dir option"
                  }
                ],
                "kind": "xref",
                "target": "cli:options.html#cache-dir"
              },
              {
                "kind": "text",
                "value": " or using the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ANTORA_CACHE_DIR variable"
                  }
                ],
                "kind": "xref",
                "target": "environment-variables.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "cache-dir-key",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "cache_dir key"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Cache Directory"
      }
    ]
  }
}
