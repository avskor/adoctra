        "title": [
          {
            "kind": "text",
            "value": "Insert an icon"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When icon fonts are enabled, Asciidoctor PDF will replace the label of an admonition with a predefined icon. You can customize the icon per admonition type using a custom theme."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example of a theme that shows how to customize the icon for a tip."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "extends: default\nadmonition:\n  icon:\n    tip:\n      name: fas-lightbulb\n      stroke_color: #111111\n      size: 18"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "custom-theme.yml"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The name consists of an icon prefix (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fas-"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") followed by the name of the icon in that icon set (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "lightbulb"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). If a category key is not specified for a particular admonition type, Asciidoctor PDF will use the predefined icon for that type."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "customize-an-admonition-icon",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
