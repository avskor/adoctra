            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "unbreakable"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option is applied to a block, the converter will advance the block and its title and anchor to the next page if it detects that the block is going to break across pages and it can fit on a single page."
              }
            ],
            "roles": [],
            "title": null
          },
          {
