                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Verses"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Breakable with built-in anchor and title orphan prevention"
                  }
                ],
                "kind": "strong",
                "roles": [
                  "term"
                ]
              },
              {
                "kind": "text",
                "value": " means that a block can break across pages, but the converter will automatically push the block to the next page, when necessary, to ensure a block’s anchor and title are kept with the block."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Tables, sections, and discrete headings are breakable by default, but "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "do not"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " provide automatic anchor and title orphan prevention. For tables, that means the anchor and title could be left on the current page if the table gets pushed to the next page. For sections, that means the section title may be left on the current page if the first block doesn’t fit below it. For discrete headings, that means the heading may be left on the current page if the next adjacent block doesn’t fit below it. However, you can turn on orphan prevention for tables, sections, and discrete headings by adding the (seemingly redundant) "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "breakable"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option as a hint."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "default",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Breakable by default"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Orphan prevention isn’t applied to tables, sections, and discrete headings by default. This behavior can be enabled by adding the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "breakable"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option. Since these blocks are already breakable by default, this option is merely a publisher’s hint to inform the converter to add orphan prevention."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "breakable"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " option can be applied to a table to ensure the anchor and title (i.e., caption) are kept with the table if the table gets advanced to the next page."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".Optional table title\n[#optional-id%breakable] "
                  },
                  {
                    "guard": null,
                    "icons": null,
                    "id": "CO1-1",
                    "kind": "callout",
                    "number": "1",
                    "src": "",
                    "xml": false
                  },
                  {
                    "kind": "text",
                    "value": "\n|===\n|Content |Content\n\n|Content |Content\n|==="
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "colist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "coids": [
                      "CO1-1"
                    ],
                    "icons": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Assign the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "breakable"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " option to a table, using the shorthand percent symbol ("
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "%"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": ") for the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "option"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " attribute name, to indicate that the table’s title and anchor should be kept with the table."
                      }
                    ],
                    "src": ""
                  }
                ],
                "roles": [],
                "style": "arabic",
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The behavior to keep the title with the table is "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "only"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " supported if the table caption is in its default end placement above the table (i.e., "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "top"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "). If the theme configures the caption end placement ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "table-caption-end"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ") below the table (i.e., "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "bottom"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), the title could be widowed on the next page. The lack of widow prevention for the title when placed below the table is due to a limitation in how this converter is implemented."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "table",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Table"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "breakable"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " option can be applied to a section to ensure the section title is kept with the first child block if that block gets advanced to the following page."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[%breakable]\n=== Title of Section\n\nFirst block of content in the section."
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "This option can also be added to a discrete heading to ensure the heading is kept with the next adjacent block if that block gets advanced to the next page."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[discrete%breakable]\n=== Discrete Heading\n\nNext block of content."
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "What the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "breakable"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " option on a section or discrete heading does is prevent the converter from orphaning the title and its anchor. In other words, the option prevents a page break immediately following the title, so the title won’t be the last text on the page. Instead, the page break will come "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "before"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " the title. This option does not make the converter attempt to keep an entire section on the same page."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "However, you can get the section title to stick with more than one block by wrapping the blocks that follow it in an unbreakable block."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[%breakable]\n=== Title of Section\n\n[%unbreakable]\n--\nFirst block of content in the section.\n\nSecond block of content in the section.\n--"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In this case, the section will follow the unbreakable block if it gets advanced to the next page."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If you want to prevent all sections and discrete headings from being orphaned globally, you can set the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "heading-min-height-after"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " theme key to "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "auto"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " instead."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "heading:\n  min-height-after: auto"
                  }
                ],
                "language": "yaml",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Keep in mind that this does add extra processing to the conversion, which may impact conversion time."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "section-or-discrete-heading",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Section or discrete heading"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "You don’t need to assign the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "breakable"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " option any other block types because "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "breakable is enabled by default"
                      }
                    ],
                    "kind": "xref",
                    "target": "#default"
                  },
                  {
                    "kind": "text",
                    "value": " and those other blocks already provide automatic orphan prevention."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "blocks": [
                  {
                    "context": "paragraph",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "One of the challenges of AsciiDoc is that it’s a mature language, and that means we have to be careful when introducing functionality not to break existing documents and toolchains. Repurposing the use of the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "breakable"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " option is one way to ensure that."
                      }
                    ],
                    "roles": [],
                    "title": null
                  },
                  {
                    "context": "paragraph",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Given that all blocks are breakable by default, there’s no point in ever specifying the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "breakable"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " option on the block for the purpose of making it breakable. And since it’s redundant, that provided an opportunity to use it as an author hint to mean something more without having to change the language."
                      }
                    ],
                    "roles": [],
                    "title": null
                  },
                  {
                    "context": "paragraph",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "When you add the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "breakable"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " option to a block explicitly, the converter knows you placed it there. That provides an opportunity to enable functionality that isn’t enabled by default. That extra behavior, in this case, is to keep the anchor and title with the first row of a table, the first block of a section, and the next adjacent block of a discrete heading."
                      }
                    ],
                    "roles": [],
                    "title": null
                  },
                  {
                    "context": "paragraph",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "The reason the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "breakable"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " option has to be specified explicitly on tables, sections, and discrete headings is because this computation comes at a slight cost in terms of performance and side effects. It’s minor, but it’s there. No other blocks require this."
                      }
                    ],
                    "roles": [],
                    "title": null
                  }
                ],
                "context": "sidebar",
                "id": null,
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Why do I need to specify breakable if it’s the default?"
                  }
                ]
              }
            ],
            "context": "section",
            "id": "other-blocks",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Other blocks"
              }
            ]
          }
        ],
