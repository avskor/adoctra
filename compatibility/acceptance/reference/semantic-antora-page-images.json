    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Images are source files, such as photographs, diagrams, and screenshots, that are stored in an "
              },
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "images"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " family directory"
                  }
                ],
                "kind": "xref",
                "target": "ROOT:images-directory.html"
              },
              {
                "kind": "text",
                "value": ". An image can be inserted into any page or partial, regardless of the module or component version it belongs to, using an AsciiDoc image macro. AsciiDoc supports the PNG, JPG, SVG, and GIF (static and animated) image file formats. It’s also possible to create a link to an image using the xref macro."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "There are two AsciiDoc image macro types, block and inline. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "imagesdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute is not relevant in Antora and is ignored. Unless the target is a URI, Antora automatically rewrites the target to refer to a location relative to the images output directory."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "block image"
                  }
                ],
                "kind": "xref",
                "target": "block-images.html"
              },
              {
                "kind": "text",
                "value": " is displayed as a discrete element on a page. It is defined using an image macro that has "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "a double"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " colon."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This is a paragraph.\n\nimage::resource-id-of-target-image.ext[]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Block image macro"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "inline image"
                  }
                ],
                "kind": "xref",
                "target": "inline-images.html"
              },
              {
                "kind": "text",
                "value": " is displayed in the flow of another element, such as a paragraph or sidebar block. It is defined using an image macro that has "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "a single"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " colon."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This sentence contains an inline image:resource-id-of-target-image.ext[] image."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Inline image macro"
              }
            ]
          }
        ],
        "context": "section",
        "id": "block-and-inline-image-macros",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Block and inline image macros"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "xref"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " element attribute, you can reference a page, attachment, element, or even another image from an image embedded in a page."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "image::resource-id-of-target-image.ext[xref=resource-id.ext]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "xref element attribute assigned to an image macro"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "image-xref-and-link.html"
                  }
                ],
                "kind": "xref",
                "target": "image-xref-and-link.html"
              },
              {
                "kind": "text",
                "value": " to learn more."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "link-to-a-resource-from-an-image-macro",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Link to a resource from an image macro"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An image can be cross referenced from a page using an "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "AsciiDoc xref macro"
                  }
                ],
                "kind": "xref",
                "target": "xref.html#xref-macro"
              },
              {
                "kind": "text",
                "value": " and the images’ resource ID (which must include the family). The syntax follows that of an "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "attachment reference"
                  }
                ],
                "kind": "xref",
                "target": "attachments.html#make-link"
              },
              {
                "kind": "text",
                "value": ", except that the family must be "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "image"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instead of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "attachment"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The result will be a link to an image rather than the rendered image."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want the image to be rendered in the page with a link to itself, use the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "self link"
                  }
                ],
                "kind": "xref",
                "target": "image-xref-and-link.html#link-self"
              },
              {
                "kind": "text",
                "value": " on the image macro instead."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 4"
                  }
                ],
                "kind": "xref",
                "target": "#ex-xref"
              },
              {
                "kind": "text",
                "value": " shows the structure of an xref macro with an images’ fully qualified resource ID."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-xref",
            "inlines": [
              {
                "kind": "text",
                "value": "xref:version@component:module:image$file-coordinate-of-image.ext[optional link text]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Xref macro structure for referencing an image"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "At a minimum, an xref macro consists of the macro’s prefix ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "xref:"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), the resource ID of the target image, and a set of square brackets ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[]"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "target image"
                  }
                ],
                "kind": "strong",
                "roles": [
                  "term"
                ]
              },
              {
                "kind": "text",
                "value": " is the image source file that’s being referenced by the current page. The target image is referenced by assigning its resource ID to an xref macro in the content of the current page. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "current page"
                  }
                ],
                "kind": "strong",
                "roles": [
                  "term"
                ]
              },
              {
                "kind": "text",
                "value": " is the page source file containing the xref macro that references the target image."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "How many of the target images’ "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "resource ID coordinates"
                  }
                ],
                "kind": "xref",
                "target": "resource-id-coordinates.html"
              },
              {
                "kind": "text",
                "value": " you need to specify depends on the component version and module of the target attachment in relation to the current page."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s a concrete example that shows how to link to an image in the same module:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Click the image xref:image$my-image.png[] to see a screenshot of the form."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When linking to an image, the xref macro is structured and behaves much like when it’s assigned the resource ID of a page, with three differences:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "resource ID of an attachment"
                      }
                    ],
                    "kind": "xref",
                    "target": "resource-id.html"
                  },
                  {
                    "kind": "text",
                    "value": " must specify the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "image$"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "family coordinate"
                      }
                    ],
                    "kind": "xref",
                    "target": "resource-id-coordinates.html#id-family"
                  },
                  {
                    "kind": "text",
                    "value": " when an image is assigned to an xref macro, otherwise Antora will assume the resource ID is that of a page at runtime."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "A fragment (element ID) can’t be appended to the end of the image’s resource ID."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Images don’t have default reference text. If link text isn’t specified in the xref macro, the target of the xref is displayed as the link text."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          }
        ],
        "context": "section",
        "id": "asciidoc-xref-macro-for-images",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "AsciiDoc xref macro for images"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Images"
      }
    ]
  }
}
