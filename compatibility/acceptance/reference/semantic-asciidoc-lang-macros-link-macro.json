{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The link macro is the most explicit method of making a link in AsciiDoc. It’s only necessary when the behavior of autolinks and URL macros proves insufficient. This page covers the anatomy of the link macro, when it’s required, and how to use it."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The link macro is an inline macro. Like other inline macros, its syntax follows the familiar pattern of the macro name and target separated by a colon followed by an attribute list enclosed in square brackets."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "link:<target>[<attrlist>]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<target>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " becomes the target of the link. the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<attrlist>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is the link text unless a named attribute is detected. See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "link macro attribute list"
                  }
                ],
                "kind": "xref",
                "target": "link-macro-attribute-parsing.html"
              },
              {
                "kind": "text",
                "value": " to learn how the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<attrlist>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is parsed."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Like all inline macros, the link macro can be escaped using a leading backslash ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "\\"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_anatomy",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Anatomy"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want to link to a non-AsciiDoc file that is relative to the current document, use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "link"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " macro in front of the file name."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To link to a relative AsciiDoc file, use the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "xref macro"
                  }
                ],
                "kind": "xref",
                "target": "inter-document-xref.html"
              },
              {
                "kind": "text",
                "value": " instead."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example that demonstrates how to use the link macro to link to a relative file path:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "link:downloads/report.pdf[Get Report]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The AsciiDoc processor will create a link to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "report.pdf"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " with the text \"Get Report\", even though the target is not a URL."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the target file is an HTML file, and you want to link directly to an anchor within that document, append a hash ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "#"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") followed by the name of the anchor after the file name:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "link:tools.html#editors[]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Note that when linking to a relative file, even if it’s an HTML file, the link text is required."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_link_to_a_relative_file",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Link to a relative file"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Since AsciiDoc provides autolinks and URL macros, the link macro is not often needed. Here are the few cases when the link macro is necessary:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The target is not a URL (e.g., a relative path)"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The target must be enclosed in a passthrough to escape characters with special meaning"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The URL macro is not bounded by spaces, brackets, or quotes."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The target is a URL that does not start with a scheme recognized by AsciiDoc"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The most common situation is when the target is not a URL. For example, you would use the link macro to create a link to a relative path."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "link:report.pdf[Get Report]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the relative path is another AsciiDoc file, you should use the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "xref macro"
                  }
                ],
                "kind": "xref",
                "target": "inter-document-xref.html"
              },
              {
                "kind": "text",
                "value": " instead."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You may also discover that spaces are not permitted in the target of the link macro, at least not in the AsciiDoc source. The space character in the target prevents the parser from recognizing the macro. So it’s necessary to escape or encode it. Here are three ways to do it:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "link:pass:[My Documents/report.pdf][Get Report]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Escape a space using a passthrough"
              }
            ]
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "link:My&#32;Documents/report.pdf[Get Report]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Encode a space using a character reference (&#32;)"
              }
            ]
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "link:My%20Documents/report.pdf[Get Report]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Encode a space using URL encoding (%20)"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Escaping or encoding the space ensures that the space does not prevent the link macro from being recognized. The downside of using URL encoding is that it will be visible in the automatic link text since the browser does not decode it in that location. In this case, the character reference is preferable."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "There are other characters that are not permitted in a link target as well, such as a colon. You can escape those using the same technique."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "link:Avengers%3A%20Endgame.html[]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Encode a colon using URL encoding (%3A)"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Another common case is when you need to use a passthrough to escape characters with special meaning. In this case, the AsciiDoc processor will not recognize the target as a URL, and thus the link macro is necessary. An example is when the URL contains repeating underscore characters."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "link:++https://example.org/now_this__link_works.html++[]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A similar situation is when the URL macro is not bounded by spaces, brackets, or quotes. In this case, the link macro prefix is required to increase the precedence so that the macro can be recognized."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "|link:https://asciidoctor.org[]|"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Finally, if the target is not recognized as a URL by AsciiDoc, the link macro is necessary. For example, you might use the link macro to make a file link."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "link:file:///home/username[Your files]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_when_to_use_the_link_macro",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "When to use the link macro"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The general rule of thumb is that you should only put the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "link:"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " macro prefix in front of the target if the target is "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "not"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " a URL. Otherwise, the prefix just adds verbosity."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_final_word",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Final word"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Link Macro"
      }
    ]
  }
}
