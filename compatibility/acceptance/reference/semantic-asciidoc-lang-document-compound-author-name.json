            "inlines": [
              {
                "kind": "text",
                "value": "When a name consists of multiple parts, such as a compound or composite surname, or a double middle name, the processor needs to be explicitly told which words should be assigned to a specific attribute."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
