          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the parts of an author’s name aren’t assigned to the correct built-in attributes, they may output the wrong information if they’re referenced in the body of the document. For instance, if the name "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Ann Marie Jenson"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " was entered on the author line or assigned to the attribute "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "author"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", the processor would assign "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Ann"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "firstname"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Marie"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "middlename"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Jenson"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "lastname"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " based on the location and order of each word. This assignment would be incorrect because the author’s first name is "
