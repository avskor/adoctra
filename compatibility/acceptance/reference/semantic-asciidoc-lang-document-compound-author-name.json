            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When part of an author’s name consists of more than one word, use an underscore ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "_"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") between the words to connect them."
