    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "See equivalent in the Reactive stack"
                  }
                ],
                "kind": "xref",
                "target": "web/webflux/config.html#webflux-config-message-codecs"
              }
            ],
            "kind": "span",
            "roles": [
              "small"
            ]
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can set the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "HttpMessageConverter"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " instances to use in Java configuration, replacing the ones used by default, by overriding "
          },
          {
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "configureMessageConverters()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "kind": "link",
            "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/web/servlet/config/annotation/WebMvcConfigurer.html#configureMessageConverters-java.util.List-"
          },
          {
            "kind": "text",
            "value": ". You can also customize the list of configured message converters at the end by overriding "
          },
          {
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "extendMessageConverters()"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "kind": "link",
            "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/web/servlet/config/annotation/WebMvcConfigurer.html#extendMessageConverters-java.util.List-"
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "In a Spring Boot application, the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebMvcAutoConfiguration"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " adds any "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "HttpMessageConverter"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " beans it detects, in addition to default converters. Hence, in a Boot application, prefer to use the "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "HttpMessageConverters"
              }
            ],
            "kind": "link",
            "target": "https://docs.spring.io/spring-boot/reference/web/servlet.html#web.servlet.spring-mvc.message-converters"
          },
          {
            "kind": "text",
            "value": " mechanism. Or alternatively, use "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "extendMessageConverters"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " to modify message converters at the end."
          }
        ],
        "roles": [],
        "title": null,
        "type": "tip"
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following example adds XML and Jackson JSON converters with a customized "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ObjectMapper"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " instead of the default ones:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./WebConfiguration[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "In the preceding example, "
          },
          {
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Jackson2ObjectMapperBuilder"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "kind": "link",
            "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/http/converter/json/Jackson2ObjectMapperBuilder.html"
          },
          {
            "kind": "text",
            "value": " is used to create a common configuration for both "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MappingJackson2HttpMessageConverter"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MappingJackson2XmlHttpMessageConverter"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " with indentation enabled, a customized date format, and the registration of "
          },
          {
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "jackson-module-parameter-names"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "kind": "link",
            "target": "https://github.com/FasterXML/jackson-module-parameter-names"
          },
          {
            "kind": "text",
            "value": ", Which adds support for accessing parameter names (a feature added in Java 8)."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "This builder customizes Jackson’s default properties as follows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "ulist",
        "id": null,
        "items": [
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ],
                "kind": "link",
                "target": "https://fasterxml.github.io/jackson-databind/javadoc/2.6/com/fasterxml/jackson/databind/DeserializationFeature.html#FAIL_ON_UNKNOWN_PROPERTIES"
              },
              {
                "kind": "text",
                "value": " is disabled."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "MapperFeature.DEFAULT_VIEW_INCLUSION"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ],
                "kind": "link",
                "target": "https://fasterxml.github.io/jackson-databind/javadoc/2.6/com/fasterxml/jackson/databind/MapperFeature.html#DEFAULT_VIEW_INCLUSION"
              },
              {
                "kind": "text",
                "value": " is disabled."
              }
            ]
          }
        ],
        "roles": [],
        "style": null,
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "It also automatically registers the following well-known modules if they are detected on the classpath:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "ulist",
        "id": null,
        "items": [
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "jackson-datatype-jsr310"
                  }
                ],
                "kind": "link",
                "target": "https://github.com/FasterXML/jackson-datatype-jsr310"
              },
              {
                "kind": "text",
                "value": ": Support for Java 8 Date and Time API types."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "jackson-datatype-jdk8"
                  }
                ],
                "kind": "link",
                "target": "https://github.com/FasterXML/jackson-datatype-jdk8"
              },
              {
                "kind": "text",
                "value": ": Support for other Java 8 types, such as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Optional"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "jackson-module-kotlin"
                  }
                ],
                "kind": "link",
                "target": "https://github.com/FasterXML/jackson-module-kotlin"
              },
              {
                "kind": "text",
                "value": ": Support for Kotlin classes and data classes."
              }
            ]
          }
        ],
        "roles": [],
        "style": null,
        "title": null
      },
      {
