        "context": "section",
        "id": "_copy_and_paste_friendly_callouts",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Copy and paste friendly callouts"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The font icons setting also enables callout icons drawn using CSS."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= Document Title\n:icons: font "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO6-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\n\nNOTE: Asciidoctor supports font-based admonition\nicons, powered by Font Awesome! "
