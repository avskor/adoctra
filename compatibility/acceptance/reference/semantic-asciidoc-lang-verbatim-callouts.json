                  "CO2-3"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "A callout behind a line comment for Clojure."
                  }
                ],
                "src": ""
              },
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO2-4"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "A callout behind a line comment for XML or SGML languages like HTML."
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "An AsciiDoc processor recognizes the most ubiquitous line comment prefixes as a convenience. If the source language you’re embedding does not support one of these line comment prefixes, you can customize the prefix using the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "line-comment"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " attribute on the block."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Let’s say we want to tuck a callout behind a line comment in Erlang code. In this case, we would set the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "line-comment"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " character to "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "%"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", as shown in this example:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": "ex-line-comment",
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[source,erlang,line-comment=%]\n----\n-module(hello_world).\n-compile(export_all).\n\nhello() ->\n    io:format(\"hello world~n\"). % <1>\n----\n<1> A callout behind a custom line comment prefix."
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Custom line comment prefix"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The result of "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Example 3"
                      }
                    ],
                    "kind": "xref",
                    "target": "#ex-line-comment"
                  },
                  {
                    "kind": "text",
                    "value": " is rendered below."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-module(hello_world).\n-compile(export_all).\n\nhello() ->\n    io:format(\"hello world~n\"). "
                  },
                  {
                    "guard": "% ",
                    "icons": null,
                    "id": "CO3-1",
                    "kind": "callout",
                    "number": "1",
                    "src": "",
                    "xml": false
                  }
                ],
                "language": "erlang",
                "roles": [],
                "title": null
              },
              {
                "context": "colist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "coids": [
                      "CO3-1"
                    ],
                    "icons": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "A callout behind a custom line comment prefix."
                      }
                    ],
                    "src": ""
                  }
                ],
                "roles": [],
                "style": "arabic",
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Even though it’s not specified in the attribute, one space is still permitted immediately following the line comment prefix."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "_custom_line_comment_prefix",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Custom line comment prefix"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If the source language you’re embedding does not support trailing line comments, or the line comment prefix is being misinterpreted, you can disable this feature using the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "line-comment"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " attribute."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Let’s say we want to put a callout at the end of a block delimiter for an open block in AsciiDoc. In this case, the processor will think the double hyphen is a line comment, when in fact it’s the block delimiter. We can disable line comment processing by setting the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "line-comment"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " character to an empty value, as shown in this example:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": "ex-disable-line-comment",
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[source,asciidoc,line-comment=]\n----\n-- <1>\nA paragraph in an open block.\n--\n----\n<1> An open block delimiter."
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "No line comment prefix"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The result of "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Example 4"
                      }
                    ],
                    "kind": "xref",
                    "target": "#ex-disable-line-comment"
                  },
                  {
                    "kind": "text",
                    "value": " is rendered below."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-- "
                  },
                  {
                    "guard": "",
                    "icons": null,
                    "id": "CO4-1",
                    "kind": "callout",
                    "number": "1",
                    "src": "",
                    "xml": false
                  },
                  {
                    "kind": "text",
                    "value": "\nA paragraph in an open block.\n--"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "colist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "coids": [
                      "CO4-1"
                    ],
                    "icons": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "An open block delimiter."
                      }
                    ],
                    "src": ""
                  }
                ],
                "roles": [],
                "style": "arabic",
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Since the language doesn’t support trailing line comments, there’s no way to hide the callout number in the raw source."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "_disable_line_comment_processing",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Disable line comment processing"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "XML doesn’t have line comments, so our “tuck the callout behind a line comment” trick doesn’t work here. To use callouts in XML, you must place the callout’s angled brackets around the XML comment and callout number."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Here’s how it appears in a listing:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": "ex-xml",
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[source,xml]\n----\n<section>\n  <title>Section Title</title> <!--1-->\n</section>\n----\n<1> The section title is required."
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "XML callout syntax"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The result of "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Example 5"
                      }
                    ],
                    "kind": "xref",
                    "target": "#ex-xml"
                  },
                  {
                    "kind": "text",
                    "value": " is rendered below."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<section>\n  <title>Section Title</title> "
                  },
                  {
                    "guard": null,
                    "icons": null,
                    "id": "CO5-1",
                    "kind": "callout",
                    "number": "1",
                    "src": "",
                    "xml": true
                  },
                  {
                    "kind": "text",
                    "value": "\n</section>"
                  }
                ],
                "language": "xml",
                "roles": [],
                "title": null
              },
              {
                "context": "colist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "coids": [
                      "CO5-1"
                    ],
                    "icons": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "The section title is required."
                      }
                    ],
                    "src": ""
                  }
                ],
                "roles": [],
                "style": "arabic",
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Notice the comment has been replaced with a circled number that cannot be selected (if not using font icons it will be rendered differently and selectable). Now both you and the reader can copy and paste XML source code containing callouts without worrying about errors."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
