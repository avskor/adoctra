            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Callout numbers (aka callouts) provide a means to add annotations to lines in a verbatim block."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Each callout number used in a verbatim block must appear twice. The first use, which goes within the verbatim block, marks the line being annotated (i.e., the target). The second use, which goes below the verbatim block, defines the annotation text. Multiple callout numbers may be used on a single line."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The callout number (at the target) must be placed at the end of the line."
              }
            ],
            "roles": [],
            "title": null,
            "type": "important"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s a basic example of a verbatim block that uses callouts:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-basic",
            "inlines": [
              {
                "kind": "text",
                "value": "[source,ruby]\n----\nrequire 'sinatra' <1>\n\nget '/hi' do <2> <3>\n  \"Hello World!\"\nend\n----\n<1> Library import\n<2> URL mapping\n<3> Response block"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Callout syntax"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The result of "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 1"
                  }
                ],
                "kind": "xref",
                "target": "#ex-basic"
              },
              {
                "kind": "text",
                "value": " is rendered below."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "require 'sinatra' "
              },
