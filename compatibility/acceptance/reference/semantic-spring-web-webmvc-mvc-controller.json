                      "inlines": [
                        {
                          "kind": "text",
                          "value": "import org.springframework.ui.set\n\n@Controller\nclass HelloController {\n\n\t@GetMapping(\"/hello\")\n\tfun handle(model: Model): String {\n\t\tmodel[\"message\"] = \"Hello World!\"\n\t\treturn \"index\"\n\t}\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
