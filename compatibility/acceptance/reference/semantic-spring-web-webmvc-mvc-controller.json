                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@Controller\npublic class HelloController {\n\n\t@GetMapping(\"/hello\")\n\tpublic String handle(Model model) {\n\t\tmodel.addAttribute(\"message\", \"Hello World!\");\n\t\treturn \"index\";\n\t}\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
