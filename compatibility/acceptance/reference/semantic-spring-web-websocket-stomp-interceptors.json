    },
    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Events"
              }
            ],
            "kind": "xref",
            "target": "web/websocket/stomp/application-context-events.html"
          },
          {
            "kind": "text",
            "value": " provide notifications for the lifecycle of a STOMP connection but not for every client message. Applications can also register a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ChannelInterceptor"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " to intercept any message and in any part of the processing chain. The following example shows how to intercept inbound messages from clients:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./WebSocketConfiguration[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "A custom "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ChannelInterceptor"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " can use "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "StompHeaderAccessor"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "SimpMessageHeaderAccessor"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " to access information about the message, as the following example shows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./MyChannelInterceptor[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Applications can also implement "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ExecutorChannelInterceptor"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", which is a sub-interface of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ChannelInterceptor"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " with callbacks in the thread in which the messages are handled. While a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ChannelInterceptor"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is invoked once for each message sent to a channel, the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ExecutorChannelInterceptor"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " provides hooks in the thread of each "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MessageHandler"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " subscribed to messages from the channel."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Note that, as with the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "SessionDisconnectEvent"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " described earlier, a DISCONNECT message can be from the client or it can also be automatically generated when the WebSocket session is closed. In some cases, an interceptor may intercept this message more than once for each session. Components should be idempotent with regard to multiple disconnect events."
          }
        ],
        "roles": [],
        "title": null
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Interception"
      }
    ]
  }
}
