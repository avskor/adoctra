  "diagnostics": [],
  "html": "<h1>Footnotes Category Keys</h1>\n<div class=\"paragraph\">\n<p>The keys in the <code>footnotes</code> category control the style of the footnotes list at the end of a chapter (<code>book</code> doctype) or document (other doctypes).\nThe styling of the links is controlled by the <a href=\"link.html\">global link styles</a>.\nIf the <code>footnotes-title</code> attribute is set in the document, its value will be used as the caption of the footnotes list.\nAs such, it will be styled as a <a href=\"caption.html\">block caption</a> and can also be configured independently of other captions.</p>\n</div>\n<table class=\"tableblock frame-none grid-rows stretch\">\n<colgroup>\n<col style=\"width: 25%;\">\n<col style=\"width: 33.3333%;\">\n<col style=\"width: 41.6667%;\">\n</colgroup>\n<thead>\n<tr>\n<th class=\"tableblock halign-left valign-top\">Key</th>\n<th class=\"tableblock halign-left valign-top\">Value Type</th>\n<th class=\"tableblock halign-left valign-top\">Example</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\">font-color</p></td>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\"><a href=\"color.html\">Color</a><br>\n(default: <code>$base-font-color</code>)</p></td>\n<td class=\"tableblock halign-left valign-top\"><div class=\"content\"><div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-yaml\" data-lang=\"yaml\">footnotes:\n  font-color: #CCCCCC</code></pre>\n</div>\n</div></div></td>\n</tr>\n<tr>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\">font-size</p></td>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\"><a href=\"text.html#font-size\">Font size</a><br>\n(default: <code>9</code>)</p></td>\n<td class=\"tableblock halign-left valign-top\"><div class=\"content\"><div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-yaml\" data-lang=\"yaml\">footnotes:\n  font-size: 8</code></pre>\n</div>\n</div></div></td>\n</tr>\n<tr>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\">font-style</p></td>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\"><a href=\"text.html#font-style\">Font style</a><br>\n(default: <code>$base-font-style</code>)</p></td>\n<td class=\"tableblock halign-left valign-top\"><div class=\"content\"><div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-yaml\" data-lang=\"yaml\">footnotes:\n  font-style: italic</code></pre>\n</div>\n</div></div></td>\n</tr>\n<tr>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\">item-spacing</p></td>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\"><a href=\"measurement-units.html\">Measurement</a><br>\n(default: <code>3</code>)</p></td>\n<td class=\"tableblock halign-left valign-top\"><div class=\"content\"><div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-yaml\" data-lang=\"yaml\">footnotes:\n  item-spacing: 5</code></pre>\n</div>\n</div></div></td>\n</tr>\n<tr>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\">margin-top</p></td>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\"><a href=\"measurement-units.html\">Measurement</a> | <code>auto</code><br>\n(default: <code>auto</code>)</p></td>\n<td class=\"tableblock halign-left valign-top\"><div class=\"content\"><div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-yaml\" data-lang=\"yaml\">footnotes:\n  margin-top: 0</code></pre>\n</div>\n</div></div></td>\n</tr>\n<tr>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\">text-transform</p></td>\n<td class=\"tableblock halign-left valign-top\"><p class=\"tableblock\"><a href=\"text.html#transform\">Text transform</a><br>\n(default: <em>inherit</em>)</p></td>\n<td class=\"tableblock halign-left valign-top\"><div class=\"content\"><div class=\"listingblock\">\n<div class=\"content\">\n<pre class=\"highlight\"><code class=\"language-yaml\" data-lang=\"yaml\">footnotes:\n  text-transform: lowercase</code></pre>\n</div>\n</div></div></td>\n</tr>\n</tbody>\n</table>\n"
}
