            "title": [
              {
                "kind": "text",
                "value": "ThemeResolver implementations"
              }
            ],
            "width": 100
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Spring also provides a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ThemeChangeInterceptor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " that lets theme changes on every request with a simple request parameter."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
