{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can apply Spring Web MVC framework themes to set the overall look-and-feel of your application, thereby enhancing user experience. A theme is a collection of static resources, typically style sheets and images, that affect the visual style of the application."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "as of 6.0 support for themes has been deprecated theme in favor of using CSS, and without any special support on the server side."
              }
            ],
            "roles": [],
            "title": null,
            "type": "warning"
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To use themes in your web application, you must set up an implementation of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "org.springframework.ui.context.ThemeSource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " interface. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "WebApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " interface extends "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ThemeSource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " but delegates its responsibilities to a dedicated implementation. By default, the delegate is an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "org.springframework.ui.context.support.ResourceBundleThemeSource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " implementation that loads properties files from the root of the classpath. To use a custom "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ThemeSource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " implementation or to configure the base name prefix of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ResourceBundleThemeSource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", you can register a bean in the application context with the reserved name, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "themeSource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The web application context automatically detects a bean with that name and uses it."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When you use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ResourceBundleThemeSource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", a theme is defined in a simple properties file. The properties file lists the resources that make up the theme, as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "styleSheet=/themes/cool/style.css\nbackground=/themes/cool/img/coolBg.jpg"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The keys of the properties are the names that refer to the themed elements from view code. For a JSP, you typically do this using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "spring:theme"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " custom tag, which is very similar to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "spring:message"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " tag. The following JSP fragment uses the theme defined in the previous example to customize the look and feel:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "<%@ taglib prefix=\"spring\" uri=\"http://www.springframework.org/tags\"%>\n<html>\n\t<head>\n\t\t<link rel=\"stylesheet\" href=\"<spring:theme code='styleSheet'/>\" type=\"text/css\"/>\n\t</head>\n\t<body style=\"background=<spring:theme code='background'/>\">\n\t\t...\n\t</body>\n</html>"
              }
            ],
            "language": "xml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By default, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ResourceBundleThemeSource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " uses an empty base name prefix. As a result, the properties files are loaded from the root of the classpath. Thus, you would put the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "cool.properties"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " theme definition in a directory at the root of the classpath (for example, in "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "/WEB-INF/classes"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ResourceBundleThemeSource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " uses the standard Java resource bundle loading mechanism, allowing for full internationalization of themes. For example, we could have a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "/WEB-INF/classes/cool_nl.properties"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " that references a special background image with Dutch text on it."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "mvc-themeresolver-defining",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Defining a theme"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "After you define themes, as described in the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "preceding section"
                  }
                ],
                "kind": "xref",
                "target": "web/webmvc/mvc-servlet/themeresolver.html#mvc-themeresolver-defining"
              },
              {
                "kind": "text",
                "value": ", you decide which theme to use. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DispatcherServlet"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " looks for a bean named "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "themeResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to find out which "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ThemeResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " implementation to use. A theme resolver works in much the same way as a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "LocaleResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". It detects the theme to use for a particular request and can also alter the request’s theme. The following table describes the theme resolvers provided by Spring:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "autowidth": false,
            "body": [
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "FixedThemeResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "Selects a fixed theme, set by using the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "defaultThemeName"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " property."
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ],
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "SessionThemeResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "The theme is maintained in the user’s HTTP session. It needs to be set only once for each session but is not persisted between sessions."
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ],
              [
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "CookieThemeResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                },
                {
                  "background": null,
                  "colspan": 1,
                  "halign": "left",
                  "paragraphs": [
                    [
                      {
                        "kind": "text",
                        "value": "The selected theme is stored in a cookie on the client."
                      }
                    ]
                  ],
                  "rowspan": 1,
                  "style": null,
                  "valign": "top"
                }
              ]
            ],
            "caption": [
              {
                "kind": "text",
                "value": "Table 1. "
              }
            ],
