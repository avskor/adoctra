    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Behind the scenes, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MBeanExporter"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " delegates to an implementation of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ObjectNamingStrategy"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to obtain an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ObjectName"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instance for each of the beans it registers. By default, the default implementation, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "KeyNamingStrategy"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " uses the key of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "beans"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Map"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " as the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ObjectName"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". In addition, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "KeyNamingStrategy"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " can map the key of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "beans"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Map"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to an entry in a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Properties"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " file (or files) to resolve the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ObjectName"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". In addition to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "KeyNamingStrategy"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", Spring provides two additional "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ObjectNamingStrategy"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " implementations: the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "IdentityNamingStrategy"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (which builds an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ObjectName"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " based on the JVM identity of the bean) and the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MetadataNamingStrategy"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (which uses source-level metadata to obtain the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ObjectName"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can configure your own "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "KeyNamingStrategy"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instance and configure it to read "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ObjectName"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instances from a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Properties"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instance rather than use a bean key. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "KeyNamingStrategy"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " tries to locate an entry in the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Properties"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " with a key that corresponds to the bean key. If no entry is found or if the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Properties"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instance is "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "null"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", the bean key itself is used."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following code shows a sample configuration for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "KeyNamingStrategy"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ":"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "<beans>\n\n\t<bean id=\"exporter\" class=\"org.springframework.jmx.export.MBeanExporter\">\n\t\t<property name=\"beans\">\n\t\t\t<map>\n\t\t\t\t<entry key=\"testBean\" value-ref=\"testBean\"/>\n\t\t\t</map>\n\t\t</property>\n\t\t<property name=\"namingStrategy\" ref=\"namingStrategy\"/>\n\t</bean>\n\n\t<bean id=\"testBean\" class=\"org.springframework.jmx.JmxTestBean\">\n\t\t<property name=\"name\" value=\"TEST\"/>\n\t\t<property name=\"age\" value=\"100\"/>\n\t</bean>\n\n\t<bean id=\"namingStrategy\" class=\"org.springframework.jmx.export.naming.KeyNamingStrategy\">\n\t\t<property name=\"mappings\">\n\t\t\t<props>\n\t\t\t\t<prop key=\"testBean\">bean:name=testBean1</prop>\n\t\t\t</props>\n\t\t</property>\n\t\t<property name=\"mappingLocations\">\n\t\t\t<value>names1.properties,names2.properties</value>\n\t\t</property>\n\t</bean>\n\n</beans>"
              }
            ],
            "language": "xml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The preceding example configures an instance of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "KeyNamingStrategy"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " with a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Properties"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instance that is merged from the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Properties"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instance defined by the mapping property and the properties files located in the paths defined by the mappings property. In this configuration, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "testBean"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " bean is given an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ObjectName"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "bean:name=testBean1"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", since this is the entry in the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Properties"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instance that has a key corresponding to the bean key."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If no entry in the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Properties"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instance can be found, the bean key name is used as the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ObjectName"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "jmx-naming-properties",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Reading "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ObjectName"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " Instances from Properties"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MetadataNamingStrategy"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " uses the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "objectName"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " property of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ManagedResource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute on each bean to create the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ObjectName"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The following code shows the configuration for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MetadataNamingStrategy"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ":"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "<beans>\n\n\t<bean id=\"exporter\" class=\"org.springframework.jmx.export.MBeanExporter\">\n\t\t<property name=\"beans\">\n\t\t\t<map>\n\t\t\t\t<entry key=\"testBean\" value-ref=\"testBean\"/>\n\t\t\t</map>\n\t\t</property>\n\t\t<property name=\"namingStrategy\" ref=\"namingStrategy\"/>\n\t</bean>\n\n\t<bean id=\"testBean\" class=\"org.springframework.jmx.JmxTestBean\">\n\t\t<property name=\"name\" value=\"TEST\"/>\n\t\t<property name=\"age\" value=\"100\"/>\n\t</bean>\n\n\t<bean id=\"namingStrategy\" class=\"org.springframework.jmx.export.naming.MetadataNamingStrategy\">\n\t\t<property name=\"attributeSource\" ref=\"attributeSource\"/>\n\t</bean>\n\n\t<bean id=\"attributeSource\"\n\t\t\tclass=\"org.springframework.jmx.export.annotation.AnnotationJmxAttributeSource\"/>\n\n</beans>"
              }
            ],
            "language": "xml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If no "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "objectName"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " has been provided for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ManagedResource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute, an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ObjectName"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is created with the following format: "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[fully-qualified-package-name]:type=[short-classname],name=[bean-name]"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". For example, the generated "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ObjectName"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " for the following bean would be "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "com.example:type=MyClass,name=myBean"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ":"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "<bean id=\"myBean\" class=\"com.example.MyClass\"/>"
              }
            ],
            "language": "xml",
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "jmx-naming-metadata",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Using "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MetadataNamingStrategy"
              }
            ],
            "kind": "monospace",
            "roles": []
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you prefer to use "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "the annotation-based approach"
                  }
                ],
                "kind": "xref",
                "target": "integration/jmx/interface.html#jmx-interface-metadata"
              },
              {
                "kind": "text",
                "value": " to define your management interfaces, a convenience subclass of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MBeanExporter"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is available: "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "AnnotationMBeanExporter"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". When defining an instance of this subclass, you no longer need the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "namingStrategy"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "assembler"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "attributeSource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " configuration, since it always uses standard Java annotation-based metadata (autodetection is always enabled as well). In fact, rather than defining an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MBeanExporter"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " bean, an even simpler syntax is supported by the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@EnableMBeanExport"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Configuration"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotation or the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<context:mbean-export/>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " element as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "include-code::./JmxConfiguration[tag=snippet,indent=0]"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If necessary, you can provide a reference to a particular MBean "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "server"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", and the "
