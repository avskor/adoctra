                "inlines": [
                  {
                    "kind": "text",
                    "value": "Create an attribute list directly above the table’s title and set the named attribute "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "caption"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", followed by an equals sign ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "="
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), and then a value."
                  }
                ],
                "src": ""
              },
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO2-2"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Enclose the value in double quotation marks ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "\""
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "). Otherwise the processor will remove any trailing whitespaces, and the title text will start directly after the last character of the label."
