        "title": [
          {
            "kind": "text",
            "value": "Modify the label using table-caption"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can customize the label on an individual table by setting the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "caption"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute. (Don’t let the name of the attribute mislead you. The caption attribute only sets the caption’s label, not the whole caption line). When using "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "caption"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", assign it the exact value you want displayed (including trailing spaces). Labels assigned using "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "caption"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " don’t get an automatically incremented number and only apply to the table they are set on."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want a space between the label and the title, you must add a trailing space to the value of the caption attribute."
              }
            ],
            "roles": [],
            "title": null,
            "type": "caution"
          },
          {
            "context": "listing",
            "id": "ex-caption",
            "inlines": [
