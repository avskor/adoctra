                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "ExpressionParser parser = new SpelExpressionParser();\n\nString name = parser.parseExpression(\"name?:'Unknown'\").getValue(new Inventor(), String.class);\nSystem.out.println(name);  // 'Unknown'"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
