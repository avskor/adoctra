      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor PDF supports unordered and ordered description lists. These are defined as a description list, but displayed as an unordered or ordered description list with the term as a subject. Only one term is supported. The subject is shown using the term font style (bold by default)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By default, the subject is arranged as a run-in followed by a subject stop ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ":"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " by default)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[unordered]\nalpha:: partially complete and unstable\nbeta:: feature complete and undergoing testing"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The subject stop can be customized using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "subject-stop"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[unordered,subject-stop=)]\nalpha:: partially complete and unstable\nbeta:: feature complete and undergoing testing"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "stack"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " role is present, the subject is stacked above the description. In this case, the subject stop is only used if specified explicitly."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[unordered.stack]\nalpha:: partially complete and unstable\nbeta:: feature complete and undergoing testing"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          }
        ],
