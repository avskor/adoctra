          },
          {
            "kind": "text",
            "value": " is like "
          },
          {
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@ResponseBody"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "kind": "xref",
            "target": "web/webmvc/mvc-controller/ann-methods/responsebody.html"
          },
          {
            "kind": "text",
            "value": " but with status and headers. For example:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@GetMapping(\"/something\")\npublic ResponseEntity<String> handle() {\n\tString body = ... ;\n\tString etag = ... ;\n\treturn ResponseEntity.ok().eTag(etag).body(body);\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
