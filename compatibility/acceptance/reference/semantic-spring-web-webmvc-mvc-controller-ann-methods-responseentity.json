                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@GetMapping(\"/something\")\nfun handle(): ResponseEntity<String> {\n\tval body = ...\n\tval etag = ...\n\treturn ResponseEntity.ok().eTag(etag).build(body)\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
