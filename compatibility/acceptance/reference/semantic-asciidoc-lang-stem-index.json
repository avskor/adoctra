              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "latexmath"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to the stem attribute."
              }
            ],
            "roles": [],
            "title": null
