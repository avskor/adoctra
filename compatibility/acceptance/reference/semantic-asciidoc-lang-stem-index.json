            "inlines": [
              {
                "kind": "text",
                "value": "If you need to include Science, Technology, Engineering and Math (STEM) expressions in your document, the AsciiDoc language supports embedding math-mode macros from "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "LaTeX"
                  }
                ],
                "kind": "link",
                "target": "https://docs.mathjax.org/en/latest/input/tex/index.html"
              },
              {
                "kind": "text",
                "value": " and/or "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "AsciiMath"
                  }
                ],
                "kind": "link",
                "target": "https://docs.mathjax.org/en/latest/input/asciimath.html"
              },
              {
                "kind": "text",
                "value": " notation as block or inline elements. These elements act as passthroughs to preserve the expressions as entered. The expressions are then passed on to the converter to be processed and rendered for display using a STEM provider (e.g., MathJax)."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To activate equation and formula support, set the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "stem"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute in the document’s header (or by passing the attribute to the command line or API)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "= My Diabolical Mathematical Opus\nJamie Moriarty\n:stem: "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO1-1",
                "kind": "callout",
                "number": "1",
