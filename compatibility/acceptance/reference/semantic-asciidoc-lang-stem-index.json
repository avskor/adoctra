            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By default, AsciiDoc’s stem integration assumes all equations are AsciiMath if not specified explicitly. The HTML converter supports STEM content written in "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "AsciiMath"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://docs.mathjax.org/en/latest/input/asciimath.html"
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TeX and LaTeX"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://docs.mathjax.org/en/latest/input/tex/index.html"
              },
              {
                "kind": "text",
                "value": " math notation. The DocBook converter only processes AsciiMath notation, leaving LaTeX to be processed by a separate tool in the DocBook toolchain."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want to use the LaTeX notation by default, assign "
