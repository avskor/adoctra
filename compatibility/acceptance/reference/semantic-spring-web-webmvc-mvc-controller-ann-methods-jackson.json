            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Spring offers support for the Jackson JSON library."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "See equivalent in the Reactive stack"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webflux/controller/ann-methods/jackson.html#webflux-ann-jsonview"
                  }
                ],
                "kind": "span",
                "roles": [
                  "small"
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Spring MVC provides built-in support for "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Jackson’s Serialization Views"
                  }
                ],
                "kind": "link",
                "target": "https://www.baeldung.com/jackson-json-view-annotation"
              },
              {
                "kind": "text",
                "value": ", which allow rendering only a subset of all fields in an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Object"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". To use it with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@ResponseBody"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ResponseEntity"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " controller methods, you can use Jackson’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@JsonView"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotation to activate a serialization view class, as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@RestController\npublic class UserController {\n\n\t@GetMapping(\"/user\")\n\t@JsonView(User.WithoutPasswordView.class)\n\tpublic User getUser() {\n\t\treturn new User(\"eric\", \"7!jd#h23\");\n\t}\n}\n\npublic class User {\n\n\tpublic interface WithoutPasswordView {};\n\tpublic interface WithPasswordView extends WithoutPasswordView {};\n\n\tprivate String username;\n\tprivate String password;\n\n\tpublic User() {\n\t}\n\n\tpublic User(String username, String password) {\n\t\tthis.username = username;\n\t\tthis.password = password;\n\t}\n\n\t@JsonView(WithoutPasswordView.class)\n\tpublic String getUsername() {\n\t\treturn this.username;\n\t}\n\n\t@JsonView(WithPasswordView.class)\n\tpublic String getPassword() {\n\t\treturn this.password;\n\t}\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@RestController\nclass UserController {\n\n\t@GetMapping(\"/user\")\n\t@JsonView(User.WithoutPasswordView::class)\n\tfun getUser() = User(\"eric\", \"7!jd#h23\")\n}\n\nclass User(\n\t\t@JsonView(WithoutPasswordView::class) val username: String,\n\t\t@JsonView(WithPasswordView::class) val password: String) {\n\n\tinterface WithoutPasswordView\n\tinterface WithPasswordView : WithoutPasswordView\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@JsonView"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " allows an array of view classes, but you can specify only one per controller method. If you need to activate multiple views, you can use a composite interface."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want to do the above programmatically, instead of declaring an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@JsonView"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotation, wrap the return value with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MappingJacksonValue"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and use it to supply the serialization view:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@RestController\npublic class UserController {\n\n\t@GetMapping(\"/user\")\n\tpublic MappingJacksonValue getUser() {\n\t\tUser user = new User(\"eric\", \"7!jd#h23\");\n\t\tMappingJacksonValue value = new MappingJacksonValue(user);\n\t\tvalue.setSerializationView(User.WithoutPasswordView.class);\n\t\treturn value;\n\t}\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@RestController\nclass UserController {\n\n\t@GetMapping(\"/user\")\n\tfun getUser(): MappingJacksonValue {\n\t\tval value = MappingJacksonValue(User(\"eric\", \"7!jd#h23\"))\n\t\tvalue.serializationView = User.WithoutPasswordView::class.java\n\t\treturn value\n\t}\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For controllers that rely on view resolution, you can add the serialization view class to the model, as the following example shows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Controller\npublic class UserController extends AbstractController {\n\n\t@GetMapping(\"/user\")\n\tpublic String getUser(Model model) {\n\t\tmodel.addAttribute(\"user\", new User(\"eric\", \"7!jd#h23\"));\n\t\tmodel.addAttribute(JsonView.class.getName(), User.WithoutPasswordView.class);\n\t\treturn \"userView\";\n\t}\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Controller\nclass UserController : AbstractController() {\n\n\t@GetMapping(\"/user\")\n\tfun getUser(model: Model): String {\n\t\tmodel[\"user\"] = User(\"eric\", \"7!jd#h23\")\n\t\tmodel[JsonView::class.qualifiedName] = User.WithoutPasswordView::class.java\n\t\treturn \"userView\"\n\t}\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
