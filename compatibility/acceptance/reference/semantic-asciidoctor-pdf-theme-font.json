                  {
                    "kind": "text",
                    "value": "catalog"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (or a name inherited from another theme). These fallbacks are used, in the order listed, when a glyph cannot be found in the primary font for a given element."
              }
