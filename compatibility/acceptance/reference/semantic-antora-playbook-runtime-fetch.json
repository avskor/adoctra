    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fetch"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key whenever you want to retrieve updates from the remote content sources repositories and UI bundle snapshots."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Activating the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fetch"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key from a playbook or the CLI causes Antora to perform both of the following actions each time it runs:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "olist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Run a fetch operation for all remote content sources repositories Antora has cloned, or clone them otherwise."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Download the remote UI bundle if it’s marked as a "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "snapshot"
                      }
                    ],
                    "kind": "xref",
                    "target": "ui-bundle-url.html#snapshot"
                  },
                  {
                    "kind": "text",
                    "value": ", even if it has already been downloaded."
                  }
                ]
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Antora only fetches updates for remote content sources since the clones are managed by Antora. Antora never fetches updates for local content sources (i.e., local git repositories). In other words, Antora does not run "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "git fetch"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "git pull"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " on a local git repository. Doing so would runs the risk of putting them into an inconsistent state or otherwise interfering with the author’s work. Antora leaves managing the state of local content repositories up to the author."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "fetch-operations",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Fetch operations"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The first time Antora runs a playbook, it clones any remote content sources git repositories and downloads the UI bundle into the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Antora cache directory"
                  }
                ],
                "kind": "xref",
                "target": "runtime-cache-dir.html"
              },
              {
                "kind": "text",
                "value": ". On subsequent runs, Antora resolves these resources in the cache folder, effectively running offline."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can instruct Antora to refresh the cache by setting the optional "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fetch"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "true"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fetch"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is configured under the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "runtime key"
                  }
                ],
                "kind": "xref",
                "target": "configure-runtime.html"
              },
              {
                "kind": "text",
                "value": " in a playbook."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "runtime:\n  fetch: true"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          }
        ],
        "context": "section",
        "id": "fetch-key",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "fetch key"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You don’t have to modify the playbook file directly to set this key. You can use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--fetch"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option from the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CLI"
                  }
                ],
                "kind": "xref",
                "target": "cli:options.html#fetch"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ antora --fetch antora-playbook.yml"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--fetch"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option overrides the value assigned to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fetch"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key in the playbook file."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "fetch-option",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Fetch option"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Fetch Updates"
      }
    ]
  }
