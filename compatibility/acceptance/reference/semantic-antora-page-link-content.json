            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Notice the xref doesn’t have any link text specified. As you can see in the example output below, Antora automatically fills in the link text using the title of the target page."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "See "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "resource-id.html"
                      }
                    ],
                    "kind": "xref",
                    "target": "resource-id.html"
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you click on the link, you’ll see that the clickable text and the title of the target page are the same. A page’s title is assigned to the built-in AsciiDoc "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "reftext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute by default. You can also "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "assign a custom value to the reftext attribute"
                  }
                ],
                "kind": "xref",
                "target": "reftext-and-navtitle.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the resource ID of the target page is appended with a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fragment (deep link)"
                  }
                ],
                "kind": "xref",
                "target": "xref.html#id-fragment"
              },
              {
                "kind": "text",
                "value": " and no link text is specified between the square brackets, like "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "xref:page.adoc#fragment[]"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", the link text isn’t automatically populated. You’ll need to specify the link text in the xref macro when using a fragment."
              }
            ],
            "roles": [],
            "title": null,
            "type": "caution"
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Xrefs in a navigation file behave the same way with one additional feature. Navigation files use the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "navtitle value"
                  }
                ],
                "kind": "xref",
                "target": "reftext-and-navtitle.html#navtitle"
