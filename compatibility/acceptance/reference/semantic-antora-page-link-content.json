            "inlines": [
              {
                "kind": "text",
                "value": "When an xref doesn’t specify any link text, Antora uses the target page’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "reftext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " value as the link text. Let’s create an xref to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "resource-id.adoc"
                  }
                ],
                "kind": "emphasis",
                "roles": [
