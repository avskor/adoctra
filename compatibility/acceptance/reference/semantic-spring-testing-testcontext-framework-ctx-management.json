              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DependencyInjectionTestExecutionListener"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", which is configured by default (see "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Dependency Injection of Test Fixtures"
                  }
                ],
                "kind": "xref",
