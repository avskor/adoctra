        "inlines": [
          {
            "kind": "text",
            "value": "Type conversion is applied automatically if the target method parameter type is not "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "String"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". See "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Type Conversion"
              }
            ],
            "kind": "xref",
            "target": "web/webflux/controller/ann-methods/typeconversion.html"
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "When a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestHeader"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation is used on a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Map<String, String>"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "MultiValueMap<String, String>"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "HttpHeaders"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " argument, the map is populated with all header values."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Built-in support is available for converting a comma-separated string into an array or collection of strings or other types known to the type conversion system. For example, a method parameter annotated with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@RequestHeader(\"Accept\")"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " may be of type "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "String"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " but also of "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "String[]"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "List<String>"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
