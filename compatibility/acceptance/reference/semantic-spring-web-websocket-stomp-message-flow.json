{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Once a STOMP endpoint is exposed, the Spring application becomes a STOMP broker for connected clients. This section describes the flow of messages on the server side."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "spring-messaging"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " module contains foundational support for messaging applications that originated in "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Spring Integration"
              }
            ],
            "kind": "link",
            "target": "https://spring.io/spring-integration"
          },
          {
            "kind": "text",
            "value": " and was later extracted and incorporated into the Spring Framework for broader use across many "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Spring projects"
              }
            ],
            "kind": "link",
            "target": "https://spring.io/projects"
          },
          {
            "kind": "text",
            "value": " and application scenarios. The following list briefly describes a few of the available messaging abstractions:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "ulist",
        "id": null,
        "items": [
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Message"
                  }
                ],
                "kind": "link",
                "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/messaging/Message.html"
              },
              {
                "kind": "text",
                "value": ": Simple representation for a message, including headers and payload."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MessageHandler"
                  }
                ],
                "kind": "link",
                "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/messaging/MessageHandler.html"
              },
              {
                "kind": "text",
                "value": ": Contract for handling a message."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MessageChannel"
                  }
                ],
                "kind": "link",
                "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/messaging/MessageChannel.html"
              },
              {
                "kind": "text",
                "value": ": Contract for sending a message that enables loose coupling between producers and consumers."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "SubscribableChannel"
                  }
                ],
                "kind": "link",
                "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/messaging/SubscribableChannel.html"
              },
              {
                "kind": "text",
                "value": ": "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MessageChannel"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MessageHandler"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " subscribers."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ExecutorSubscribableChannel"
                  }
                ],
                "kind": "link",
                "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/messaging/support/ExecutorSubscribableChannel.html"
              },
              {
                "kind": "text",
                "value": ": "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "SubscribableChannel"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " that uses an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Executor"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " for delivering messages."
              }
            ]
          }
        ],
        "roles": [],
        "style": null,
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Both the Java configuration (that is, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@EnableWebSocketMessageBroker"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ") and the XML namespace configuration (that is, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "<websocket:message-broker>"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ") use the preceding components to assemble a message workflow. The following diagram shows the components used when the simple built-in message broker is enabled:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "alt": [
          {
            "kind": "text",
            "value": "message flow simple broker"
          }
        ],
        "attributes": {},
        "caption": null,
        "context": "image",
        "id": null,
        "roles": [],
        "src": "message-flow-simple-broker.png",
        "svg": null,
        "target": "message-flow-simple-broker.png",
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The preceding diagram shows three message channels:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "ulist",
        "id": null,
        "items": [
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "clientInboundChannel"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ": For passing messages received from WebSocket clients."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "clientOutboundChannel"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ": For sending server messages to WebSocket clients."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "brokerChannel"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ": For sending messages to the message broker from within server-side application code."
              }
            ]
          }
        ],
        "roles": [],
        "style": null,
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The next diagram shows the components used when an external broker (such as RabbitMQ) is configured for managing subscriptions and broadcasting messages:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "alt": [
          {
            "kind": "text",
            "value": "message flow broker relay"
          }
        ],
        "attributes": {},
        "caption": null,
        "context": "image",
        "id": null,
        "roles": [],
        "src": "message-flow-broker-relay.png",
        "svg": null,
        "target": "message-flow-broker-relay.png",
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The main difference between the two preceding diagrams is the use of the “broker relay” for passing messages up to the external STOMP broker over TCP and for passing messages down from the broker to subscribed clients."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "When messages are received from a WebSocket connection, they are decoded to STOMP frames, turned into a Spring "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Message"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " representation, and sent to the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "clientInboundChannel"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " for further processing. For example, STOMP messages whose destination headers start with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "/app"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " may be routed to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@MessageMapping"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " methods in annotated controllers, while "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "/topic"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "/queue"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " messages may be routed directly to the message broker."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "An annotated "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Controller"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " that handles a STOMP message from a client may send a message to the message broker through the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "brokerChannel"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", and the broker broadcasts the message to matching subscribers through the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "clientOutboundChannel"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". The same controller can also do the same in response to HTTP requests, so a client can perform an HTTP POST, and then a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@PostMapping"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method can send a message to the message broker to broadcast to subscribed clients."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "We can trace the flow through a simple example. Consider the following example, which sets up a server:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./WebSocketConfiguration[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./GreetingController[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The preceding example supports the following flow:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "olist",
        "id": null,
        "items": [
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The client connects to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "http://localhost:8080/portfolio"
                      }
                    ],
                    "kind": "link",
                    "target": "http://localhost:8080/portfolio"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and, once a WebSocket connection is established, STOMP frames begin to flow on it."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The client sends a SUBSCRIBE frame with a destination header of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "/topic/greeting"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Once received and decoded, the message is sent to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "clientInboundChannel"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and is then routed to the message broker, which stores the client subscription."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The client sends a SEND frame to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "/app/greeting"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "/app"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " prefix helps to route it to annotated controllers. After the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "/app"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " prefix is stripped, the remaining "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "/greeting"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " part of the destination is mapped to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@MessageMapping"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " method in "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "GreetingController"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The value returned from "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "GreetingController"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is turned into a Spring "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Message"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " with a payload based on the return value and a default destination header of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "/topic/greeting"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (derived from the input destination with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "/app"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " replaced by "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "/topic"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). The resulting message is sent to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "brokerChannel"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and handled by the message broker."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The message broker finds all matching subscribers and sends a MESSAGE frame to each one through the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "clientOutboundChannel"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", from where messages are encoded as STOMP frames and sent on the WebSocket connection."
              }
            ]
          }
        ],
        "roles": [],
        "style": "arabic",
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The next section provides more details on annotated methods, including the kinds of arguments and return values that are supported."
          }
        ],
        "roles": [],
        "title": null
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Flow of Messages"
      }
    ]
  }
}
