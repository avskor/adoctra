                "inlines": [
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "See equivalent in the Reactive stack"
                      }
                    ],
                    "kind": "xref",
                    "target": "web/webflux/reactive-spring.html#webflux-multipart"
                  }
                ],
                "kind": "span",
                "roles": [
                  "small"
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MultipartResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " from the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "org.springframework.web.multipart"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " package is a strategy for parsing multipart requests including file uploads. There is a container-based "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "StandardServletMultipartResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " implementation for Servlet multipart request parsing. Note that the outdated "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CommonsMultipartResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " based on Apache Commons FileUpload is not available anymore, as of Spring Framework 6.0 with its new Servlet 5.0+ baseline."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To enable multipart handling, you need to declare a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MultipartResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " bean in your "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DispatcherServlet"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " Spring configuration with a name of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "multipartResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DispatcherServlet"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " detects it and applies it to the incoming request. When a POST with a content type of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "multipart/form-data"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is received, the resolver parses the content wraps the current "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "HttpServletRequest"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " as a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MultipartHttpServletRequest"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to provide access to resolved files in addition to exposing parts as request parameters."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Servlet multipart parsing needs to be enabled through Servlet container configuration. To do so:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In Java, set a "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "MultipartConfigElement"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " on the Servlet registration."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "web.xml"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", add a "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "\"<multipart-config>\""
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " section to the servlet declaration."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following example shows how to set a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "MultipartConfigElement"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " on the Servlet registration:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "public class AppInitializer extends AbstractAnnotationConfigDispatcherServletInitializer {\n\n\t// ...\n\n\t@Override\n\tprotected void customizeRegistration(ServletRegistration.Dynamic registration) {\n\n\t\t// Optionally also set maxFileSize, maxRequestSize, fileSizeThreshold\n\t\tregistration.setMultipartConfig(new MultipartConfigElement(\"/tmp\"));\n\t}\n\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "class AppInitializer : AbstractAnnotationConfigDispatcherServletInitializer() {\n\n\t// ...\n\n\toverride fun customizeRegistration(registration: ServletRegistration.Dynamic) {\n\n\t\t// Optionally also set maxFileSize, maxRequestSize, fileSizeThreshold\n\t\tregistration.setMultipartConfig(MultipartConfigElement(\"/tmp\"))\n\t}\n\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Once the Servlet multipart configuration is in place, you can add a bean of type "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "StandardServletMultipartResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " with a name of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "multipartResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "This resolver variant uses your Servlet container’s multipart parser as-is, potentially exposing the application to container implementation differences. By default, it will try to parse any "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "multipart/"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " content type with any HTTP method but this may not be supported across all Servlet containers. See the "
                  },
                  {
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "StandardServletMultipartResolver"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ],
                    "kind": "link",
                    "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/web/multipart/support/StandardServletMultipartResolver.html"
                  },
                  {
                    "kind": "text",
                    "value": " javadoc for details and configuration options."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "admonition",
            "id": null,
            "roles": [],
            "title": null,
            "type": "note"
          }
        ],
        "context": "section",
        "id": "mvc-multipart-resolver-standard",
