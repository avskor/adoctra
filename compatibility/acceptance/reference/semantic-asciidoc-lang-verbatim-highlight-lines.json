        "context": "section",
        "id": "_usage_criteria",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Usage criteria"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Line highlighting is activated on a source block if the highlight attribute is defined and at least one of the line numbers falls in this range."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Keep in mind that some syntax highlighter libraries require additional options (e.g., CodeRay and Rouge), and some don’t support line highlighting at all (e.g., highlight.js)."
              }
            ],
            "roles": [],
            "title": null,
            "type": "important"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "highlight"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute accepts a comma or semicolon delimited list of line ranges. The numbers correspond to the line numbers of the source block. If the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "start"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute is not specified, line numbers of the source block start at 1."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here are some examples:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "1"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "2,4,6"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "3..5"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "2,7..9"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A line range is represented by two numbers separated by a double period (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "2..5"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). The range is inclusive."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "listing",
                "id": "ex-coderay",
                "inlines": [
                  {
                    "kind": "text",
                    "value": "= Document Title\n:source-highlighter: coderay\n\n[%linenums,ruby,highlight=2..5]\n----\nORDERED_LIST_KEYWORDS = {\n  'loweralpha' => 'a',\n  'lowerroman' => 'i',\n  'upperalpha' => 'A',\n  'upperroman' => 'I',\n}\n----"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Highlight select lines when source-highlighter=coderay"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "When using CodeRay as the source highlighter, the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "linenums"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " option is required to use line highlighting. That’s because line highlighting is only applied to the line number, which is emphasized using bold text. CodeRay does not shade the line of code itself."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "_coderay",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "CodeRay"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "listing",
                "id": "ex-rouge",
                "inlines": [
                  {
                    "kind": "text",
                    "value": "= Document Title\n:source-highlighter: rouge\n:docinfo: shared\n\n[,ruby,highlight=2..5]\n----\nORDERED_LIST_KEYWORDS = {\n  'loweralpha' => 'a',\n  'lowerroman' => 'i',\n  'upperalpha' => 'A',\n  'upperroman' => 'I',\n}\n----"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Highlight select lines when source-highlighter=rouge"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "When using Rouge as the source highlighter, you must supply CSS to support line highlighting. You can do so by storing the required line highlighting CSS in a docinfo file, then including it in the output document by setting the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "docinfo"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " document attribute."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<style>\npre.rouge .hll {\n  background-color: #ffc;\n  display: block;\n}\npre.rouge .hll * {\n  background-color: initial;\n}\n</style>"
                  }
                ],
                "language": "html",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Docinfo file (docinfo.html) to support line highlighting with Rouge"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Note that this supplemental CSS is needed even when "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "rouge-css=style"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ". The Rouge integration does not embed the CSS for highlighting lines into the style attribute of the tag for each line. Instead, it sets the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "hll"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " class on the tag (e.g., "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "<span class=\"hll\">"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ")."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "_rouge",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Rouge"
              }
            ]
          },
