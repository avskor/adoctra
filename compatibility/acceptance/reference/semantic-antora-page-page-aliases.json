              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When a page is moved from one component to another component, assign the source page’s fully qualified former resource ID to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "page-aliases"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". In "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 5"
                  }
                ],
                "kind": "xref",
                "target": "#ex-component"
              },
              {
                "kind": "text",
                "value": ", the page "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "source-w.adoc"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " has moved from version "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "1.4"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "component-8"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "module-u"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to version "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "3.0"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "component-delta"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
