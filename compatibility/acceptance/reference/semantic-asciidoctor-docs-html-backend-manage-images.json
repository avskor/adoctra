          {
            "kind": "text",
            "value": "Embed images with the data-uri attribute"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the target of one or more images in the document is a URI, you must also set the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "allow-uri-read"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute securely and run Asciidoctor in "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "SECURE"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " mode or less."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor -a data-uri -a allow-uri-read my-document.adoc"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The same is true when converting the document to PDF using Asciidoctor PDF, regardless of whether the "
