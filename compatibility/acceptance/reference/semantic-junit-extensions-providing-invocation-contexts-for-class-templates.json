      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following example shows how to write a class template as well as how to register and implement a "
          },
          {
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ClassTemplateInvocationContextProvider"
                  }
                ],
                "kind": "xref",
                "target": "attachment$api/org.junit.jupiter.api/org/junit/jupiter/api/extension/ClassTemplateInvocationContextProvider.html"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "listing",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "@ClassTemplate\n@ExtendWith(ClassTemplateDemo.MyClassTemplateInvocationContextProvider.class)\nclass ClassTemplateDemo {\n\n\tstatic final List<String> WELL_KNOWN_FRUITS\n\t\t= List.of(\"apple\", \"banana\", \"lemon\");\n\n\tprivate String fruit;\n\n\t@Test\n\tvoid notNull() {\n\t\tassertNotNull(fruit);\n\t}\n\n\t@Test\n\tvoid wellKnown() {\n\t\tassertTrue(WELL_KNOWN_FRUITS.contains(fruit));\n\t}\n\n\tpublic class MyClassTemplateInvocationContextProvider\n\t\t\timplements ClassTemplateInvocationContextProvider {\n\n\t\t@Override\n\t\tpublic boolean supportsClassTemplate(ExtensionContext context) {\n\t\t\treturn true;\n\t\t}\n\n\t\t@Override\n\t\tpublic Stream<ClassTemplateInvocationContext>\n\t\t\t\tprovideClassTemplateInvocationContexts(ExtensionContext context) {\n\n\t\t\treturn Stream.of(invocationContext(\"apple\"), invocationContext(\"banana\"));\n\t\t}\n\n\t\tprivate ClassTemplateInvocationContext invocationContext(String parameter) {\n\t\t\treturn new ClassTemplateInvocationContext() {\n\t\t\t\t@Override\n\t\t\t\tpublic String getDisplayName(int invocationIndex) {\n\t\t\t\t\treturn parameter;\n\t\t\t\t}\n\n\t\t\t\t@Override\n\t\t\t\tpublic List<Extension> getAdditionalExtensions() {\n\t\t\t\t\treturn List.of(new TestInstancePostProcessor() {\n\t\t\t\t\t\t@Override\n\t\t\t\t\t\tpublic void postProcessTestInstance(\n\t\t\t\t\t\t\t\tObject testInstance, ExtensionContext context) {\n\t\t\t\t\t\t\t((ClassTemplateDemo) testInstance).fruit = parameter;\n\t\t\t\t\t\t}\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t};\n\t\t}\n\t}\n}"
          }
        ],
        "language": "java",
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "A class template with accompanying extension"
          }
        ]
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "In this example, the class template will be invoked twice, meaning all test methods in the class template will be executed twice. The display names of the invocations will be "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "apple"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "banana"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " as specified by the invocation context. Each invocation registers a custom "
          },
          {
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TestInstancePostProcessor"
                  }
                ],
                "kind": "xref",
                "target": "attachment$api/org.junit.jupiter.api/org/junit/jupiter/api/extension/TestInstancePostProcessor.html"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " which is used to inject a value into a field. The output when using the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ConsoleLauncher"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is as follows."
          }
        ],
