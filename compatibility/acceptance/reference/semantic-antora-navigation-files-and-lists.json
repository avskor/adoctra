    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "All of the source files that belong to a component version’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pages"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " family are automatically published to your site by Antora. That means visitors can find a page using search tools, links on other site pages, and in some scenarios, through dropdown menus such as the page version selector. In order for visitors to locate and go to a page using a component version page menu, a cross reference targeting that page must be entered into a list in a navigation file."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "navigation file"
                  }
                ],
                "kind": "strong",
                "roles": [
                  "term"
                ]
              },
              {
                "kind": "text",
                "value": " is one or more lists of page cross references, external URLs, and other content that is marked up in AsciiDoc and stored at the base of a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "module directory"
                  }
                ],
                "kind": "xref",
                "target": "ROOT:module-directories.html"
              },
              {
                "kind": "text",
                "value": ". If registered in an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "antora.yml"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " file, the contents of the navigation file will be incorporated into a component version page menu and published to a site."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Navigation files must end with the AsciiDoc file extension ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": ".adoc"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "). They’re typically named "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "nav.adoc"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": [
                      "path"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": "; however, you can use any name that is meaningful to you. Name your navigation files "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "kaboom.adoc"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": [
                      "path"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": " if that makes your team happy."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "filename-and-format",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Filename and format"
              }
            ]
          }
        ],
        "context": "section",
        "id": "whats-a-nav-file",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "What’s a navigation file?"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A navigation list is an "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "unordered AsciiDoc list"
                  }
                ],
                "kind": "xref",
                "target": "asciidoc:ordered-and-unordered-lists.html#unordered"
              },
              {
                "kind": "text",
                "value": ". Each top-level list item can nested items up to level five ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "*****"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "* Top level item\n** Second level item\n*** Third level item\n*** Third level item\n** Second level item\n*** Third level item\n**** Fourth level item\n***** Fifth level item\n* Top level item\n* Top level item"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Single list structure"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A top-level list item is a list title, which is denoted by a dot ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), or, when there isn’t a list title, each list item that’s marked by a single asterisk ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "*"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). When a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "file contains multiple lists"
                  }
                ],
                "kind": "xref",
                "target": "multiple-lists.html"
              },
              {
                "kind": "text",
                "value": ", each list must be initiated with a list title."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ".List title and top level item\n* List item\n\n.List title and top level item\n* List item\n** List item"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Multiple list structure"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If a navigation file only contains one list, a list title is optional. In a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "single list navigation file"
                  }
                ],
                "kind": "xref",
                "target": "single-list.html"
              },
              {
                "kind": "text",
                "value": ", each item with a single asterisk marker ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "*"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") effectively becomes a top-level item."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can compose your navigation by combining files using the include directive. Each included file must be located in a partials directory. If you want the navigation list in the included file to be added as a child of the current item, you should enclose the include directive in an open block. See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "include-lists.html"
                  }
                ],
                "kind": "xref",
                "target": "include-lists.html"
              },
              {
                "kind": "text",
                "value": " to learn how to create a navigation list using multiple files and include directives."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "list-structure",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "List structure"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "List titles and items in a navigation file can contain several types of content, such as a cross references to a page or attachment, links to external sites, and regular and formatted text. If an entry contains a cross reference (i.e., xref), that cross reference must be the only content in the list item. Only regular links may be combined with other content."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The most common items in a navigation file are items that consist of an xref to a page, typically one that belongs to the same component version and module. The target of the xref can be a reference to any page in the site, including one in another module or component. It’s generally not a good idea to reference a page in another version as that creates a confusing situation for the reader."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": ".The Special Project "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO1-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              },
