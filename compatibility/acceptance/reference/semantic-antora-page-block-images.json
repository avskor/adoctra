            "inlines": [
              {
                "kind": "text",
                "value": "An AsciiDoc block image macro is used to embed the source file of an image into a partial or page. The block image macro accepts the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Antora resource ID"
                  }
                ],
                "kind": "xref",
                "target": "resource-id.html"
              },
              {
                "kind": "text",
                "value": " of PNG, JPG, SVG, and GIF (static and animated) image files as a value."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When Antora runs, the image file referenced by the block image macro is embedded and displayed as a discrete element in the published page. For example, the SVG image below this paragraph is embedded in this page using the block image macro."
              }
            ],
            "roles": [],
            "title": null
          },
