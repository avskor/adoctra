            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor PDF adds support for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "notitle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option on a section as a way to express that you want the title of that section to be hidden in the document body. This option can also be used to add a TOC entry for a preamble, anonymous preface, or imported PDF page."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
