            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "notitle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option is set on a section, the converter will hide the section title in the body of the document, but still display it in the TOC and in cross references to that section. To hide a section title, add the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "notitle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option on the section."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can set the notitle option using either the named attribute syntax, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "opts=notitle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", or the shorthand syntax, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "%notitle"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (preferred). The following example shows how to use the shorthand syntax."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[%notitle] "
              },
              {
                "guard": null,
                "icons": null,
                "id": "CO1-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              },
              {
                "kind": "text",
                "value": "\n== Reference Text Only\n\nContent of section."
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
