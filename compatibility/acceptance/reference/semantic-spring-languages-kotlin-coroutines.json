          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Configuration\nclass RouterConfiguration {\n\n\t@Bean\n\tfun mainRouter(userHandler: UserHandler) = coRouter {\n\t\tGET(\"/\", userHandler::listView)\n\t\tGET(\"/api/user\", userHandler::listApi)\n\t}\n}"
              }
            ],
            "language": "kotlin",
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "class UserHandler(builder: WebClient.Builder) {\n\n\tprivate val client = builder.baseUrl(\"...\").build()\n\n\tsuspend fun listView(request: ServerRequest): ServerResponse =\n\t\t\tServerResponse.ok().renderAndAwait(\"users\", mapOf(\"users\" to\n\t\t\tclient.get().uri(\"...\").awaitExchange().awaitBody<User>()))\n\n\tsuspend fun listApi(request: ServerRequest): ServerResponse =\n\t\t\t\tServerResponse.ok().contentType(MediaType.APPLICATION_JSON).bodyAndAwait(\n\t\t\t\tclient.get().uri(\"...\").awaitExchange().awaitBody<User>())\n}"
              }
            ],
            "language": "kotlin",
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "webflux-fn",
