                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Controller"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is also supported."
              }
            ],
            "roles": [],
            "title": null
