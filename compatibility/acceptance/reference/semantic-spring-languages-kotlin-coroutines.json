          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Controller\nclass CoroutinesViewController(banner: Banner) {\n\n\t@GetMapping(\"/\")\n\tsuspend fun render(model: Model): String {\n\t\tdelay(10)\n\t\tmodel[\"banner\"] = banner\n\t\treturn \"index\"\n\t}\n}"
              }
            ],
