            "inlines": [
              {
                "kind": "text",
                "value": "Here is an example of Coroutines router defined via the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "coRouter { }"
                  }
                ],
                "kind": "link",
                "target": "https://docs.spring.io/spring-framework/docs/6.2.0/kdoc-api/spring-webflux/org.springframework.web.reactive.function.server/co-router.html"
              },
              {
                "kind": "text",
                "value": " DSL and related handlers."
