                          "icons": null,
                          "id": "CO1-2",
                          "kind": "callout",
                          "number": "2",
                          "src": "",
                          "xml": false
                        },
                        {
                          "kind": "text",
                          "value": "\n\t\tregistry.add(\"server.port\", server::getPort); "
                        },
