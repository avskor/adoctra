                          "kind": "text",
                          "value": "@ContextConfiguration\nclass MyIntegrationTests {\n\n\tstatic MyExternalServer server = // ...\n\n\t@DynamicPropertySource "
                        },
                        {
                          "guard": "// ",
                          "icons": null,
                          "id": "CO1-1",
                          "kind": "callout",
                          "number": "1",
                          "src": "",
                          "xml": false
                        },
                        {
                          "kind": "text",
                          "value": "\n\tstatic void dynamicProperties(DynamicPropertyRegistry registry) { "
