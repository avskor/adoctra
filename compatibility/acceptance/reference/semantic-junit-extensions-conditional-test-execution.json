                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " for each container (e.g., a test class) to determine if all the tests it contains should be executed based on the supplied "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ExtensionContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Similarly, an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ExecutionCondition"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "evaluated"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " for each test to determine if a given test method should be executed based on the supplied "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ExtensionContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
