      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Sometimes it can be useful to run a test suite "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "without"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " certain conditions being active. For example, you may wish to run tests even if they are annotated with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Disabled"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in order to see if they are still "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "broken"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". To do this, provide a pattern for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "junit.jupiter.conditions.deactivate"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "configuration parameter"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to specify which conditions should be deactivated (i.e., not evaluated) for the current test run. The pattern can be supplied as a JVM system property, as a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "configuration parameter"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "LauncherDiscoveryRequest"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " that is passed to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Launcher"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", or via the JUnit Platform configuration file (see "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "running-tests/configuration-parameters.html"
                  }
                ],
                "kind": "xref",
                "target": "running-tests/configuration-parameters.html"
              },
              {
                "kind": "text",
                "value": " for details)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For example, to deactivate JUnit’s "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Disabled"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " condition, you can start your JVM with the following system property."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-Djunit.jupiter.conditions.deactivate=org.junit.*DisabledCondition"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "roles": [],
            "title": null
          },
