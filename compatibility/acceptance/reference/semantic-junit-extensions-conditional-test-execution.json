                  {
                    "kind": "text",
                    "value": "ExecutionCondition"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is "
              },
              {
                "id": null,
                "inlines": [
