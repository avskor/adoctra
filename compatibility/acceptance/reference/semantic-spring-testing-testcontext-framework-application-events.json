    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The TestContext framework provides support for recording "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "application events"
              }
            ],
            "kind": "xref",
            "target": "core/beans/context-introduction.html#context-functionality-events"
          },
          {
            "kind": "text",
            "value": " published in the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " so that assertions can be performed against those events within tests. All events published during the execution of a single test are made available via the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationEvents"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " API which allows you to process the events as a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "java.util.Stream"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "To use "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationEvents"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " in your tests, do the following."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "ulist",
        "id": null,
        "items": [
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Ensure that your test class is annotated or meta-annotated with "
              },
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@RecordApplicationEvents"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ],
                "kind": "xref",
                "target": "testing/annotations/integration-spring/annotation-recordapplicationevents.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Ensure that the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationEventsTestExecutionListener"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is registered. Note, however, that "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationEventsTestExecutionListener"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is registered by default and only needs to be manually registered if you have custom configuration via "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@TestExecutionListeners"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " that does not include the default listeners."
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "ulist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "When using the "
                      },
                      {
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "SpringExtension for JUnit Jupiter"
                          }
                        ],
                        "kind": "xref",
                        "target": "testing/testcontext-framework/support-classes.html#testcontext-junit-jupiter-extension"
                      },
                      {
                        "kind": "text",
                        "value": ", you may declare a method parameter of type "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "ApplicationEvents"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " in a test or lifecycle method as an alternative to an "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "@Autowired"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " field in the test class."
                      }
                    ]
                  }
                ],
                "roles": [],
                "style": null,
                "title": null
              }
            ],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Annotate a field of type "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationEvents"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Autowired"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and use that instance of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationEvents"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in your test and lifecycle methods (such as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@BeforeEach"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@AfterEach"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " methods in JUnit Jupiter)."
              }
            ]
          }
        ],
        "roles": [],
        "style": null,
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following test class uses the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "SpringExtension"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " for JUnit Jupiter and "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "AssertJ"
              }
            ],
            "kind": "link",
            "target": "https://assertj.github.io/doc"
          },
          {
            "kind": "text",
            "value": " to assert the types of application events published while invoking a method in a Spring-managed component:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@SpringJUnitConfig(/* ... */)\n@RecordApplicationEvents "
                        },
                        {
                          "guard": "// ",
                          "icons": null,
                          "id": "CO1-1",
                          "kind": "callout",
                          "number": "1",
                          "src": "",
                          "xml": false
                        },
                        {
                          "kind": "text",
                          "value": "\nclass OrderServiceTests {\n\n\t@Autowired\n\tOrderService orderService;\n\n\t@Autowired\n\tApplicationEvents events; "
                        },
                        {
                          "guard": "// ",
                          "icons": null,
                          "id": "CO1-2",
                          "kind": "callout",
                          "number": "2",
                          "src": "",
                          "xml": false
                        },
                        {
                          "kind": "text",
                          "value": "\n\n\t@Test\n\tvoid submitOrder() {\n\t\t// Invoke method in OrderService that publishes an event\n\t\torderService.submitOrder(new Order(/* ... */));\n\t\t// Verify that an OrderSubmitted event was published\n\t\tlong numEvents = events.stream(OrderSubmitted.class).count(); "
                        },
                        {
                          "guard": "// ",
                          "icons": null,
                          "id": "CO1-3",
                          "kind": "callout",
                          "number": "3",
                          "src": "",
                          "xml": false
                        },
                        {
                          "kind": "text",
                          "value": "\n\t\tassertThat(numEvents).isEqualTo(1);\n\t}\n}"
                        }
                      ],
