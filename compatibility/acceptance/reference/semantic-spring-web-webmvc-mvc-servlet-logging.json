            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DEBUG and TRACE logging may log sensitive information. This is why request parameters and headers are masked by default and their logging in full must be enabled explicitly through the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "enableLoggingRequestDetails"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " property on "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DispatcherServlet"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following example shows how to do so by using Java configuration:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
