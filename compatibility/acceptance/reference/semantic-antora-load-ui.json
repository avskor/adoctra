    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Each UI bundle is stored as a zip that is attached to a release in the GitLab or GitHub repository that hosts your site’s UI project. Here’s how it works."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "olist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Antora resolves the latest release of the UI unless specified using the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "tag"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " key."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "It downloads the UI bundle attached to that release."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "It extracts this zip file and adds the file contents to the vinyl collection previously described in "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "fetch-content.html"
                      }
                    ],
                    "kind": "xref",
                    "target": "fetch-content.html"
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ]
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "From this point forward, the pipeline interfaces only with the UI files in the virtual file collection, thus abstracting away the details of the UI’s origin."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The UI bundle is cached inside "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "build"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " after the first time you run Antora. The cached bundle is used automatically on subsequent runs. New UI releases "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "are not"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " picked up automatically."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want to force Antora to resolve and download a new UI bundle, you must pass the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "--skip-theme-cache"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " switch:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ node generate --skip-theme-cache"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The alternative is to remove the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "build/themes"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " directory, which is where the cache is stored."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If you fetch the UI often, you might find that you bump into the GitLab or GitHub rate limit. If this happens, you can increase the limit by passing a "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "personal access token"
                      }
                    ],
                    "kind": "link",
                    "target": "https://docs.github.com/en/github/authenticating-to-github/creating-a-personal-access-token/"
                  },
                  {
                    "kind": "text",
                    "value": " when you run Antora:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "literal",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "$ GITHUB_TOKEN=xxxxx node generate --skip-theme-cache"
                  }
                ],
                "language": null,
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "rate-limits-and-personal-access-tokens",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Rate limits and personal access tokens"
              }
            ]
          }
        ],
        "context": "section",
        "id": "fetch-a-new-ui-bundle",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Fetch a new UI bundle"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "UI Loading"
      }
    ]
  }
}
