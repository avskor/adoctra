              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "We recommend upgrading to the "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "latest active long term support (LTS) release of Node"
                        }
                      ],
                      "kind": "link",
                      "target": "https://nodejs.org/en/about/previous-releases"
                    },
                    {
                      "kind": "text",
                      "value": ". Antora 3.2 officially supports Node.js 20 LTS, Node.js 22 LTS, Node.js 24 LTS, and Node.js 26. Antora 3 doesn’t support Node.js versions that have reached end of life (EOL). See "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Upgrade Node.js"
                        }
                      ],
                      "kind": "xref",
                      "target": "install:upgrade-antora.html#node"
                    },
                    {
                      "kind": "text",
                      "value": " for instructions."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Are you using an active LTS version of Node.js?"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Antora 3 dropped support for Asciidoctor.js 1.5.9 (which provides Asciidoctor 1.5.8) and now depends on the latest patch version of Asciidoctor.js 2.2 (which provides Asciidoctor 2.0.x). Asciidoctor 2 introduces a few substantive changes to existing features that may impact your documentation source content or UI. See "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "ROOT:asciidoctor-upgrade-notes.html"
                        }
                      ],
                      "kind": "xref",
                      "target": "ROOT:asciidoctor-upgrade-notes.html"
                    },
                    {
                      "kind": "text",
                      "value": " to learn about the affected features and the suggested actions you should take before upgrading to Antora 3."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Have you updated your AsciiDoc syntax and Asciidoctor extensions to comply with the newest patch release of Asciidoctor.js 2.2?"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Using the AsciiDoc link macro ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "link:[]"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ") and "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "{attachmentsdir}"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " attribute reference in the target value to reference an attachment has been deprecated in Antora 3. Replace the link macro with the xref macro and use the attachment’s resource ID to reference it. See "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "page:attachments.html"
                        }
                      ],
                      "kind": "xref",
                      "target": "page:attachments.html"
                    },
                    {
                      "kind": "text",
                      "value": " and "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "navigation:reference-resources.html"
                        }
                      ],
                      "kind": "xref",
                      "target": "navigation:reference-resources.html"
                    },
                    {
                      "kind": "text",
                      "value": " to learn about the "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "attachment$"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " family coordinate and for usage examples."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Are you linking to attachment files?"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "We’ve deprecated the use of the value "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "master"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ", when assigned to the "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "version"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " key, to identify a versionless component. In Antora 3, assign the tilde ("
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "~"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ") to the "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "version"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " key in a component version’s "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "antora.yml"
                        }
                      ],
                      "kind": "emphasis",
                      "roles": [
                        "path"
                      ]
                    },
                    {
                      "kind": "text",
                      "value": " file to specify it as versionless. See "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "ROOT:component-with-no-version.html"
                        }
                      ],
                      "kind": "xref",
                      "target": "ROOT:component-with-no-version.html"
                    },
                    {
                      "kind": "text",
                      "value": " to learn more."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Do any of your component versions have an empty version?"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "If the "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": ".adoc"
                        }
                      ],
                      "kind": "emphasis",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " file extension was missing from the resource ID in an xref macro or the value assigned to a "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "page-aliases"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " attribute, Antora 2 would automatically add "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": ".adoc"
                        }
                      ],
                      "kind": "emphasis",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " to the resource ID at runtime. This fallback mechanism has been deprecated because the xref macro can now reference other non-AsciiDoc resources. Review the resource IDs in your xrefs and "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "page-aliases"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " attributes to ensure the "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": ".adoc"
                        }
                      ],
                      "kind": "emphasis",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " extension is specified."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Make sure you’re using file extensions when cross referencing pages or assigning "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "page-aliases"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " values."
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "The previous default branches pattern, "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "[master, v*]"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ", has been deprecated and replaced with "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "[HEAD, v{0..9}*]"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ". It’s unlikely this will cause a change when using remote repositories. For local repositories, it may result in the worktree being used in cases it wasn’t previously."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Are you depending on the default branches pattern in your playbook?"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "The antora-lunr add-on was designed for Antora 2 and is a community-maintained project. In Antora 3, antora-lunr has been replaced by the "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Antora Lunr extension"
                        }
                      ],
                      "kind": "link",
                      "target": "https://gitlab.com/antora/antora-lunr-extension"
                    },
                    {
                      "kind": "text",
                      "value": " (package: "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@antora/lunr-extension"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": "), which is an official Antora project. This extension uses the new extension facility in Antora 3 to integrate Lunr into your site without having to resort to using a custom site generator. We encourage you to migrate from antora-lunr to the Antora Lunr Extension when upgrading to Antora 3."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Do you use the antora-lunr add-on to integrate Lunr into your site?"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "paragraph",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Also note that the recommended signature of the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "generateSite"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " function has changed. The function now accepts a single parameter, the playbook. The old signature is still supported, but using it will result in the playbook being built a second time."
                        }
                      ],
                      "roles": [],
                      "title": null
                    },
                    {
                      "context": "paragraph",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "The site generator should also depend on the "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@antora/file-publisher"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": " package instead of "
                        },
                        {
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@antora/site-publisher"
                            }
                          ],
                          "kind": "monospace",
                          "roles": []
                        },
                        {
                          "kind": "text",
                          "value": ", though technically this isn’t required."
                        }
                      ],
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "In Antora 3, the site generator must declare the "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "@antora/logger"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " package as a dependency. The CLI resolves the logger relative to the site generator. If it cannot find it there, it will fall back to the logger provided by the CLI. This may result in Antora configuring the wrong logger, which will result in the user to see a warning about the logger not being configured."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Do you use or maintain a custom site generator?"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Isomorphic-git no longer includes the "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "cores"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " (plugin) API, so the call "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "git.cores.create('antora').set('credentialManager', customCredentialManager)"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " is going to fail. Antora still honors the "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "cores"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " API, but the call to register the credential manager is now responsible for creating it (since it runs before Antora loads). Refer to "
                    },
                    {
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "Configure a custom credential manager"
                        }
                      ],
                      "kind": "xref",
                      "target": "playbook:private-repository-auth.html#custom"
                    },
                    {
                      "kind": "text",
                      "value": " for the latest instructions."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Do you use a custom git credential manager?"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "checklist",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Upgrade from Antora 2.3 to Antora {page-component-version} checklist"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can use any active LTS or maintenance LTS version of Node.js with Antora, but we recommend using the most recent active LTS version so that you benefit from the latest performance and security enhancements. The "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Node.js release schedule"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://nodejs.org/en/about/previous-releases"
              },
              {
                "kind": "text",
                "value": " shows the active Node.js LTS versions."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To check which Node.js version you have installed, open a terminal and run:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ node --version"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you need to upgrade to the active Node.js LTS version, run:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ nvm install --lts"
              }
            ],
            "language": null,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Linux and macOS"
              }
            ]
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ nvm install 26.13.0"
              }
            ],
            "language": null,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Windows"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Next, to set the latest version of Node.js as the default for any new terminal, run:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ nvm alias default 26"
              }
            ],
            "language": null,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Linux and macOS"
              }
            ]
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ nvm alias default 26.13.0"
              }
            ],
            "language": null,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Windows"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Now you’re ready to upgrade to the latest version of Antora."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "node",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Upgrade Node.js (optional)"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you installed Antora locally, you will use "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "package.json"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " to manage the version. This file tracks which version of Antora you currently have installed. You can use the file to specify a different version. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "npm i"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " command will consult this file to determine which packages and which versions of those packages to install."
              }
            ],
            "roles": [],
            "title": null
