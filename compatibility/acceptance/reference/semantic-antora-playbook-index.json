            "inlines": [
              {
                "kind": "text",
                "value": "On this page, you’ll learn:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The purpose of an Antora playbook."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Where the playbook file is located."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The playbook file formats Antora accepts."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An Antora playbook makes it easy for technical writers to control what content is included in your site, what user interface (UI) is applied to it, and where the site is published using a playbook file. The settings in the playbook file, in combination with CLI options and environment variables, tell Antora how to operate."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Specifically, a playbook tells Antora:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "What information should be applied to the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "site globally"
                      }
                    ],
                    "kind": "xref",
                    "target": "configure-site.html"
                  },
                  {
                    "kind": "text",
                    "value": ", such as its title and URL."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The page that sits at the root of the site (i.e., "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "home or landing page content"
                      }
                    ],
                    "kind": "xref",
                    "target": "site-start-page.html"
                  },
                  {
                    "kind": "text",
                    "value": ")."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Which "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "content repositories, branches, and tags"
                      }
                    ],
                    "kind": "xref",
                    "target": "configure-content-sources.html"
                  },
                  {
                    "kind": "text",
                    "value": " to feed into Antora."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "What "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "AsciiDoc attributes"
                      }
                    ],
                    "kind": "xref",
                    "target": "asciidoc-attributes.html"
                  },
                  {
                    "kind": "text",
                    "value": " and "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Asciidoctor extensions"
                      }
                    ],
                    "kind": "xref",
                    "target": "asciidoc-extensions.html"
                  },
                  {
                    "kind": "text",
                    "value": " should be applied site wide."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Which "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "UI bundle"
                      }
                    ],
                    "kind": "xref",
                    "target": "configure-ui.html"
                  },
                  {
                    "kind": "text",
                    "value": " to use to control the visual layout, style, and behavior of the pages."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Where the site should be "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "published and in what output format"
                      }
                    ],
                    "kind": "xref",
                    "target": "configure-output.html"
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": true,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "How and when Antora should handle "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "source repository updates, artifact updates, and its cache"
                      }
                    ],
                    "kind": "xref",
                    "target": "configure-runtime.html"
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Additionally, certain settings in the playbook file can be overridden using "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CLI options"
                  }
                ],
                "kind": "xref",
                "target": "cli:options.html"
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "environment variables"
                  }
                ],
                "kind": "xref",
                "target": "environment-variables.html"
              },
              {
                "kind": "text",
                "value": ", which allows an operations team to tailor the behavior for specific environments, such as production."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "whats-an-antora-playbook",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "What’s an Antora playbook?"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A playbook is usually located in a playbook project. A playbook project repository is responsible for generating a documentation site. It’s strictly a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "configuration as code"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " repository—​it does not contain any content. Instead, it contains a playbook file, and, in certain situations, supplemental UI files and extension code."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "where-is-a-playbook-stored",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Where is a playbook stored?"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Playbooks can be written in YAML, JSON, and TOML. YAML is a common configuration language for defining automated tasks and most of the playbook examples in this documentation use YAML. But you’re free to use any of these formats."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Regardless of its format, a playbook contains structured key-value pairs for specifying general site properties, content and UI input sources, and published output destinations and providers."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "playbook-file-formats",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Playbook file formats"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By default, Antora resolves relative paths in the playbook from the current working directory. For example, the path "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "public"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " is effectively "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "$PWD/public"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": ". If, instead, you want Antora to resolve relative paths from the directory where the playbook file is located, prepend "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "./"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to the path (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "./public"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By starting relative paths with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "./"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", you make your playbook more portable. It means you can run the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "antora"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " command from any directory on the filesystem and the behavior will be the same."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you don’t start relative paths with "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "./"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", the path Antora resolves is dependent on the current working directory. To get portable behavior, you have to switch to the directory where the playbook file is located before running the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "antora"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " command."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Only use bare relative paths if you intend the path to be tied to the current working directory."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "relative-paths-in-a-playbook",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Relative paths in a playbook"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Antora Playbook Introduction"
      }
    ]
  }
}
