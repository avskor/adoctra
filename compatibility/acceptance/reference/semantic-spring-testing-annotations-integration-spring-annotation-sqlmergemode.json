              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is used to annotate a test class or test method to configure whether method-level "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Sql"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " declarations are merged with class-level "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Sql"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " declarations. If "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@SqlMergeMode"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is not declared on a test class or test method, the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "OVERRIDE"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " merge mode will be used by default. With the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "OVERRIDE"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " mode, method-level "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Sql"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " declarations will effectively override class-level "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Sql"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " declarations."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Note that a method-level "
          },
