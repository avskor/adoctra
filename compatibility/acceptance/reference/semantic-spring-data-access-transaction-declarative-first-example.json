            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", but this time the code uses reactive types:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
