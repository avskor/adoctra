                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "package x.y.service;\n\npublic class DefaultFooService implements FooService {\n\n\t@Override\n\tpublic Flux<Foo> getFoo(String fooName) {\n\t\t// ...\n\t}\n\n\t@Override\n\tpublic Publisher<Foo> getFoo(String fooName, String barName) {\n\t\t// ...\n\t}\n\n\t@Override\n\tpublic Mono<Void> insertFoo(Foo foo) {\n\t\t// ...\n\t}\n\n\t@Override\n\tpublic Mono<Void> updateFoo(Foo foo) {\n\t\t// ...\n\t}\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
