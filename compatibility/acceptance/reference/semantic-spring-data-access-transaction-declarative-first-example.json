                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "// the reactive service interface that we want to make transactional\n\npackage x.y.service\n\ninterface FooService {\n\n\tfun getFoo(fooName: String): Flow<Foo>\n\n\tfun getFoo(fooName: String, barName: String): Publisher<Foo>\n\n\tfun insertFoo(foo: Foo) : Mono<Void>\n\n\tfun updateFoo(foo: Foo) : Mono<Void>\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
