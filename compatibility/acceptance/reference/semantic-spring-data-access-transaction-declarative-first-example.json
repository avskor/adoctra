                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "// the reactive service interface that we want to make transactional\n\npackage x.y.service;\n\npublic interface FooService {\n\n\tFlux<Foo> getFoo(String fooName);\n\n\tPublisher<Foo> getFoo(String fooName, String barName);\n\n\tMono<Void> insertFoo(Foo foo);\n\n\tMono<Void> updateFoo(Foo foo);\n\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
