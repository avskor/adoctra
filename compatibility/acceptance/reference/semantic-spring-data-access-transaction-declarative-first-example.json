                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "// the service interface that we want to make transactional\n\npackage x.y.service;\n\npublic interface FooService {\n\n\tFoo getFoo(String fooName);\n\n\tFoo getFoo(String fooName, String barName);\n\n\tvoid insertFoo(Foo foo);\n\n\tvoid updateFoo(Foo foo);\n\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "// the service interface that we want to make transactional\n\npackage x.y.service\n\ninterface FooService {\n\n\tfun getFoo(fooName: String): Foo\n\n\tfun getFoo(fooName: String, barName: String): Foo\n\n\tfun insertFoo(foo: Foo)\n\n\tfun updateFoo(foo: Foo)\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
