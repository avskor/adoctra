      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following example shows an implementation of the preceding interface:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "package x.y.service;\n\npublic class DefaultFooService implements FooService {\n\n\t@Override\n\tpublic Foo getFoo(String fooName) {\n\t\t// ...\n\t}\n\n\t@Override\n\tpublic Foo getFoo(String fooName, String barName) {\n\t\t// ...\n\t}\n\n\t@Override\n\tpublic void insertFoo(Foo foo) {\n\t\t// ...\n\t}\n\n\t@Override\n\tpublic void updateFoo(Foo foo) {\n\t\t// ...\n\t}\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "package x.y.service\n\nclass DefaultFooService : FooService {\n\n\toverride fun getFoo(fooName: String): Foo {\n\t\t// ...\n\t}\n\n\toverride fun getFoo(fooName: String, barName: String): Foo {\n\t\t// ...\n\t}\n\n\toverride fun insertFoo(foo: Foo) {\n\t\t// ...\n\t}\n\n\toverride fun updateFoo(foo: Foo) {\n\t\t// ...\n\t}\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
