{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This page breaks down the difference between positional and named attributes on an element and the rules for parsing an attribute list."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Entries in an attribute list that only consist of a value are referred to as positional attributes. The position is the 1-based index of the entry once all named attributes have been removed (so they may be interspersed)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The positional attribute may be dually assigned to an implicit attribute name if the block or macro defines a mapping for positional attributes. Here are some examples of those mappings:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "icon:"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " 1 ⇒ size"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "image:"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " and "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "image::"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " 1 ⇒ alt (text), 2 ⇒ width, 3 ⇒ height"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Delimited blocks: 1 ⇒ block style and attribute shorthand"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Other inline quoted text: 1 ⇒ attribute shorthand"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "link:"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " and "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "xref:"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " 1 ⇒ text"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Custom blocks and macros can also specify positional attributes"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For example, the following two image macros are equivalent."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "image::sunset.jpg[Sunset,300,400]\n\nimage::sunset.jpg[alt=Sunset,width=300,height=400]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The second macro is the same as the first, but written out in longhand form."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The first positional attribute on all blocks (including sections) is special. It’s used to define the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "block style"
                      }
                    ],
                    "kind": "xref",
                    "target": "blocks:index.html#block-style"
                  },
                  {
                    "kind": "text",
                    "value": ". It also supports a shorthand syntax for defining the ID, role, and options attributes. This shorthand syntax can also be used on formatted text, even though formatted text doesn’t technically support attributes."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The attribute shorthand is inspired by the HAML and Slim template languages as a way of saving the author some typing. Instead of having to use the longhand form of a name attribute, it’s possible to compress the assignment to a value prefixed by a special marker. The markers are mapped as follows:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "ulist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "#"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " - ID"
                      }
                    ]
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "."
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " - role"
                      }
                    ]
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "%"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " - option"
                      }
                    ]
                  }
                ],
                "roles": [],
                "style": null,
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Each shorthand entry is placed directly adjacent to previous one, starting immediately after the optional block style. The order of the entries does not matter, except for the style, which must come first."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Here’s an example that shows how to set an ID on a section using this shorthand syntax:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[#custom-id]\n== Section with Custom ID"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The shorthand entry must follow the block style, if present. Here’s an example that shows how to set an ID on an appendix section using this shorthand syntax:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[appendix#custom-id]\n== Appendix with Custom ID"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Here’s an example of a block that uses the shorthand syntax to set the ID, a role, and an option for a list. Specifically, this syntax sets the ID to "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "rules"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", adds the role "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "prominent"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", and sets the option "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "incremental"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[#rules.prominent%incremental]\n* Work hard\n* Play hard\n* Be happy"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "A block can have multiple roles and options, so these shorthand entries may be repeated. Here’s an example that shows how to set several options on a table. Specifically, this syntax sets the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "header"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "footer"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", and "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "autowidth"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " options."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[%header%footer%autowidth]\n|===\n|Header A |Header B\n|Footer A |Footer B\n|==="
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "This shorthand syntax also appears on formatted text. Here’s an example that shows how to set the ID and add a role to a strong phrase. Specifically, this syntax sets the ID to "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "free-world"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " and adds the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "goals"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " role."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "[#free-world.goals]*free the world*"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Formatted text does not support a style, so the first and only positional attribute is always the shorthand syntax."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "_block_style_and_attribute_shorthand",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Block style and attribute shorthand"
              }
            ]
          }
        ],
        "context": "section",
        "id": "positional",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Positional attribute"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A named attribute consists of a name and a value separated by an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "="
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " character (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "name=value"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the value contains a space, comma, or quote character, it must be enclosed in double or single quotes (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "name=\"value with space\""
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). In all other cases, the surrounding quotes are optional."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the value contains the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "same"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": " quote character used to enclose the value, the quote character in the value must be escaped by prefixing it with a backslash (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "value=\"the song \\\"Dark Horse\\\"\""
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If enclosing quotes are used, they are dropped from the parsed value and the preceding backslash is dropped from any escaped quotes."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "To undefine a named attribute, set the value to "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "None"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " (case sensitive)."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "unset",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Unset a named attribute"
              }
            ]
          }
        ],
        "context": "section",
        "id": "named",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Named attribute"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The source text that’s used to define attributes for an element is referred to as an "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "attrlist"
                  }
                ],
                "kind": "strong",
                "roles": [
                  "term"
                ]
              },
              {
                "kind": "text",
                "value": ". An attrlist is always enclosed in a pair of square brackets. This applies for block attributes as well as attributes on a block or inline macro. The processor splits the attrlist into individual attribute entries, determines whether each entry is a positional or named attribute, parses the entry accordingly, and assigns the result as an attribute on the node."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The rules for what defines the boundaries of an individual attribute, and whether the attribute is positional or named, are defined below. In these rules, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "name"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " consists of a word character (letter or numeral) followed by any number of word or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "-"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " characters (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "see-also"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Attribute references are expanded before the attrlist is parsed (i.e., the attributes substitution is applied)."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "ulist",
                    "id": null,
                    "items": [
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "The first character of an attribute list cannot be a tab or space. For subsequent attributes, any leading space or tab characters are skipped."
                          }
                        ]
                      }
                    ],
                    "roles": [],
                    "style": null,
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Parsing an attribute proceeds from the beginning of the attribute list string or after a previously identified delimiter ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": ","
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ")."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If a valid attribute name is found, and it is followed by an equals sign (=), then the parser recognizes this as a named attribute. The text after the equals sign (=) and up to the next comma or end of list is taken as the attribute value. Space and tab characters around the equals sign (=) and at the end of the value are ignored."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Otherwise, this is a positional attribute with a value that ends at the next delimiter or end of list. Any space or tab characters at the boundaries of the value are ignored."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "ulist",
                    "id": null,
                    "items": [
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "If the first character is not a quote, the string is read until the next delimiter or end of string."
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "If the first character is a double quote (i.e., "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "\""
                              }
                            ],
                            "kind": "monospace",
                            "roles": []
                          },
                          {
                            "kind": "text",
                            "value": "), then the string is read until the next unescaped double quote or, if there is no closing double quote, the next delimiter. If there is a closing double quote, the enclosing double quote characters are removed and escaped double quote characters are unescaped; if not, the initial double quote is retained."
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "If the next character is a single quote (i.e., "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "'"
                              }
                            ],
                            "kind": "monospace",
                            "roles": []
                          },
                          {
                            "kind": "text",
                            "value": "), then the string is read until the next unescaped single quote or, if there is no closing single quote, the next delimiter. If there is a closing single quote, the enclosing single quote characters are removed and escaped single quote characters are unescaped; if not, the initial single quote is retained. If there is a closing single quote, and the first character is not an escaped single quote, substitutions are performed on the value as described in "
                          },
                          {
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "Substitutions"
                              }
                            ],
                            "kind": "xref",
                            "target": "#_substitutions"
                          },
                          {
                            "kind": "text",
                            "value": "."
                          }
                        ]
                      }
                    ],
                    "roles": [],
                    "style": null,
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "To parse the attribute value:"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Since the terminal of an attrlist is a closing square bracket, it’s sometimes necessary to escape a closing square bracket if it appears in the value of an attribute."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In line-oriented syntax such as a block attribute list, a block macro, and an include directive, you do not have to escape closing square brackets that appear in the attrlist itself. That’s because the parser already knows to look for the closing square bracket at the end of the line."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If a closing square bracket appears in the attrlist of an inline element, such as an inline macro, it usually has to be escaped using a backslash or by using the character reference "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "&#93;"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ". There are some exceptions to this rule, such as a link macro in a footnote, which are influenced by the substitution order."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "sidebar",
            "id": null,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "When to escape a closing square bracket"
              }
            ]
          }
        ],
        "context": "section",
        "id": "_attribute_list_parsing",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Attribute list parsing"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Recall that attribute references are expanded before the attrlist is parsed. Therefore, it’s not necessary to force substitutions to be applied to a value if you’re only interested in applying the attributes substitution. The attributes substitution has already been applied at this point."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the attribute name (in the case of a positional attribute) or value (in the case of a named attribute) is enclosed in single quotes (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "citetitle='Processed by https://asciidoctor.org'"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "), and the attribute is defined in an attrlist on a block, then the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "normal substitution group"
                  }
                ],
                "kind": "xref",
                "target": "subs:index.html#normal-group"
              },
              {
                "kind": "text",
                "value": " is applied to the value at assignment time. No special processing is performed, aside from the expansion of attribute references, if the value is not enclosed in quotes or is enclosed in double quotes."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the value contains the same quote character used to enclose the value, escape the quote character in the value by prefixing it with a backslash (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "citetitle='A \\'use case\\' diagram, generated by https://plantuml.com'"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_substitutions",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Substitutions"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Positional and Named Attributes"
      }
    ]
  }
}
