{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In addition to using a PDF page for the front or back cover, you can also insert a PDF page at an arbitrary location in your document. This technique is useful for adding pages that have complex layouts and graphics prepared in a specialized design program, which would otherwise not be achievable using this converter. One such example is an insert for an advertisement or visual interlude."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To import the first page from a PDF file, use the block image macro with the PDF filename as the image target."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "image::custom-page.pdf[]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The converter will insert the page from the PDF as a dedicated page that matches the size and layout of the page being imported (no matter where the block image occurs). Therefore, there’s no need to put a manual page break (i.e., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<<<"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") around the image macro."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By default, this macro will import the first page of the PDF. To import a different page, specify it as a 1-based index using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "page"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "image::custom-pages.pdf[page=2]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To learn how to add a TOC entry for imported PDF pages, see "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Add a TOC entry for an imported PDF"
                  }
                ],
                "kind": "xref",
                "target": "notitle.html#imported"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          }
        ],
        "context": "section",
        "id": "page",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Import a page"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can import multiple pages either using multiple image macros or using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pages"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pages"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute accepts individual page numbers or page number ranges (two page numbers separated by "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".."
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). The values can be separated either by commas or semicolons. (The syntax is similar to the syntax uses for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "lines"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute of the AsciiDoc include directive)."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "image::custom-pages.pdf[pages=3;1..2]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Pages are imported in the order listed."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An image macro used to import PDF pages should never be nested inside a delimited block or table cell. It should be a direct descendant of the document or a section. That’s because what it imports are entire pages. If it’s used inside a delimited block or table cell, the behavior is unspecified."
              }
            ],
            "roles": [],
            "title": null,
            "type": "caution"
          }
        ],
        "context": "section",
        "id": "multiple-pages",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Import multiple pages"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Import PDF Pages"
      }
    ]
  }
}
