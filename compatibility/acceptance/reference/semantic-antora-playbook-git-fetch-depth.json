      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "By default, Antora will only fetch the latest commit when cloning a repository. When fetching, Antora will only fetch as many commits as needed to get the latest commit."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "default",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Default git fetch depth"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want to increase the number of recent commits Antora fetches from a remote repository, set the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fetch_depth"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key to a positive integer."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "git:\n  fetch_depth: 10"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you are using a commit as a content source, you’re strongly encouraged to increase the value of this key from the default of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "1"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Otherwise, Antora will fetch one commit at a time until it finds the specified commit."
              }
            ],
            "roles": [],
            "title": null,
            "type": "tip"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want Antora to fetch the full history, set the value of this key to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "0"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "git:\n  fetch_depth: 0"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora-playbook.yml"
              }
            ]
