            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the admonition content is not interrupted by blank lines, start the first line with a style label. The label must be all uppercase and followed by a colon ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ":"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") and a single blank space."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-admonitions",
            "inlines": [
              {
                "kind": "text",
                "value": "CAUTION: Don't stick forks in electric sockets.\n\nTIP: After someone sticks a fork in a socket, you'll need to reset the circuit in the dark basement.\n\nWARNING: Never go into the basement.\n\nIMPORTANT: A monster lives in the basement.\n\nNOTE: If you go into the basement, see if you can find Kenny's parka."
              }
            ],
