{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The include directive recognizes when the target is a URI and can include the content referenced by that URI. This example demonstrates how to include an AsciiDoc file from a GitHub repository directly into your document."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "include::https://raw.githubusercontent.com/asciidoctor/asciidoctor/main/README.adoc[]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For security reasons, this capability is "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "not enabled by default"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". To allow content to be read from a URI, you must enable the URI read permission by:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "olist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "running Asciidoctor in "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "SERVER"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " mode or less and"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "setting the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "allow-uri-read"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " attribute securely from the CLI or API"
                  }
                ]
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example that shows how to run Asciidoctor from the console so it can read content from a URI:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "$ asciidoctor -a allow-uri-read filename.adoc"
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Remember that Asciidoctor executes in "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "UNSAFE"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " mode by default when run from the command line."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example that shows how to run Asciidoctor from the API so it can read content from a URI:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor.convert_file 'filename.adoc', safe: :safe, attributes: { 'allow-uri-read' => '' }"
              }
            ],
            "language": "ruby",
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Including content from sources outside your control carries certain risks, including the potential to introduce malicious behavior into your documentation. Because "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "allow-uri-read"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is a potentially dangerous feature, it is forcefully disabled when the safe mode is "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "SECURE"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or higher."
              }
            ],
            "roles": [],
            "title": null,
            "type": "warning"
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "URI stands for "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Uniform Resource Identifier"
                      }
                    ],
                    "kind": "link",
                    "metadata": {
                      "rel": "noopener",
                      "window": "_blank"
                    },
                    "target": "https://en.wikipedia.org/wiki/Uniform_Resource_Identifier"
                  },
                  {
                    "kind": "text",
                    "value": ". When we talk about a URI, we’re usually talking about a URL, or Uniform Resource Locator. A URL is simply a URI that points to a resource over a network, or web address."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "As far as Asciidoctor is concerned, all URIs share the same restriction, whether or not it’s actually local or remote, or whether it points to a web address (http or https prefix), FTP address (ftp prefix), or some other addressing scheme."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "sidebar",
            "id": null,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "URI vs URL"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The same restriction described in this section applies when embedding an image referenced from a URI, such as when "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "data-uri"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is set or when converting to PDF using Asciidoctor PDF."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Reading content from a URI is obviously much slower than reading it from a local file."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Asciidoctor provides a way for the content read from a URI to be cached, which is highly recommended."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "To enable the built-in cache, you must:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "olist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Install the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "open-uri-cached"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " gem."
                      }
                    ]
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Set the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "cache-uri"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " attribute in the document."
                      }
                    ]
                  }
                ],
                "roles": [],
                "style": "arabic",
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "When these two conditions are satisfied, Asciidoctor caches content read from a URI according the to "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "HTTP caching recommendations"
                      }
                    ],
                    "kind": "link",
                    "metadata": {
                      "rel": "noopener",
                      "window": "_blank"
                    },
                    "target": "https://www.w3.org/Protocols/rfc2616/rfc2616-sec13.html"
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "_caching_uri_content",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Caching URI content"
              }
            ]
          }
        ],
        "context": "section",
        "id": "_reference_include_content_by_uri",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Reference include content by URI"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Include Content by URI"
      }
    ]
  }
}
