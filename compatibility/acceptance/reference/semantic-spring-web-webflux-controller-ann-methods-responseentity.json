      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "WebFlux supports using a single value "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "reactive type"
              }
            ],
            "kind": "xref",
            "target": "web-reactive.html#webflux-reactive-libraries"
          },
          {
            "kind": "text",
            "value": " to produce the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ResponseEntity"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " asynchronously, and/or single and multi-value reactive types for the body. This allows a variety of async responses with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ResponseEntity"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " as follows:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "ulist",
        "id": null,
        "items": [
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ResponseEntity<Mono<T>>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ResponseEntity<Flux<T>>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " make the response status and headers known immediately while the body is provided asynchronously at a later point. Use "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Mono"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " if the body consists of 0..1 values or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Flux"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " if it can produce multiple values."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Mono<ResponseEntity<T>>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " provides all three — response status, headers, and body, asynchronously at a later point. This allows the response status and headers to vary depending on the outcome of asynchronous request handling."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Mono<ResponseEntity<Mono<T>>>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Mono<ResponseEntity<Flux<T>>>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " are yet another possible, albeit less common alternative. They provide the response status and headers asynchronously first and then the response body, also asynchronously, second."
              }
            ]
          }
        ],
