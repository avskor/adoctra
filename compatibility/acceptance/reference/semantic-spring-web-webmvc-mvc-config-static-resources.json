{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "See equivalent in the Reactive stack"
                  }
                ],
                "kind": "xref",
                "target": "web/webflux/config.html#webflux-config-static-resources"
              }
            ],
            "kind": "span",
            "roles": [
              "small"
            ]
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "This option provides a convenient way to serve static resources from a list of "
          },
          {
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Resource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "kind": "link",
            "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/core/io/Resource.html"
          },
          {
            "kind": "text",
            "value": "-based locations."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "In the next example, given a request that starts with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "/resources"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", the relative path is used to find and serve static resources relative to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "/public"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " under the web application root or on the classpath under "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "/static"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". The resources are served with a one-year future expiration to ensure maximum use of the browser cache and a reduction in HTTP requests made by the browser. The "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Last-Modified"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " information is deduced from "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Resource#lastModified"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " so that HTTP conditional requests are supported with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "\"Last-Modified\""
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " headers."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following listing shows how to do so:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./WebConfiguration[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "See also "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "HTTP caching support for static resources"
              }
            ],
            "kind": "xref",
            "target": "web/webmvc/mvc-caching.html#mvc-caching-static-resources"
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The resource handler also supports a chain of "
          },
          {
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ResourceResolver"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "kind": "link",
            "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/web/servlet/resource/ResourceResolver.html"
          },
          {
            "kind": "text",
            "value": " implementations and "
          },
          {
            "inlines": [
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ResourceTransformer"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "kind": "link",
            "target": "https://docs.spring.io/spring-framework/docs/6.2.0/javadoc-api/org/springframework/web/servlet/resource/ResourceTransformer.html"
          },
          {
            "kind": "text",
            "value": " implementations, which you can use to create a toolchain for working with optimized resources."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can use the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "VersionResourceResolver"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " for versioned resource URLs based on an MD5 hash computed from the content, a fixed application version, or other. A "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ContentVersionStrategy"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " (MD5 hash) is a good choice — with some notable exceptions, such as JavaScript resources used with a module loader."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following example shows how to use "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "VersionResourceResolver"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ":"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./VersionedConfiguration[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can then use "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ResourceUrlProvider"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " to rewrite URLs and apply the full chain of resolvers and transformers — for example, to insert versions. The MVC configuration provides a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ResourceUrlProvider"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " bean so that it can be injected into others. You can also make the rewrite transparent with the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ResourceUrlEncodingFilter"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " for Thymeleaf, JSPs, FreeMarker, and others with URL tags that rely on "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "HttpServletResponse#encodeURL"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Note that, when using both "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "EncodedResourceResolver"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " (for example, for serving gzipped or brotli-encoded resources) and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "VersionResourceResolver"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", you must register them in this order. That ensures content-based versions are always computed reliably, based on the unencoded file."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "For "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "WebJars"
              }
            ],
            "kind": "link",
            "target": "https://www.webjars.org/documentation"
          },
          {
            "kind": "text",
            "value": ", versioned URLs like "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "/webjars/jquery/1.2.0/jquery.min.js"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " are the recommended and most efficient way to use them. The related resource location is configured out of the box with Spring Boot (or can be configured manually via "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ResourceHandlerRegistry"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ") and does not require to add the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "org.webjars:webjars-locator-core"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " dependency."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Version-less URLs like "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "/webjars/jquery/jquery.min.js"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " are supported through the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebJarsResourceResolver"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " which is automatically registered when the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "org.webjars:webjars-locator-core"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " library is present on the classpath, at the cost of a classpath scanning that could slow down application startup. The resolver can re-write URLs to include the version of the jar and can also match against incoming URLs without versions — for example, from "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "/webjars/jquery/jquery.min.js"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "/webjars/jquery/1.2.0/jquery.min.js"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The Java configuration based on "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ResourceHandlerRegistry"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " provides further options for fine-grained control, for example, last-modified behavior and optimized resource resolution."
          }
        ],
        "roles": [],
        "title": null,
        "type": "tip"
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Static Resources"
      }
    ]
  }
}
