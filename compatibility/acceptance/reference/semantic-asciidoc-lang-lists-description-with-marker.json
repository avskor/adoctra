                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To make an ordered list instead, change the block style to "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ordered"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[ordered]\n&:: ampersand\n>:: greater than"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s how this syntax will appear, where supported:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "olist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
