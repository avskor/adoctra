    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Not yet an official part of the AsciiDoc language and thus should be considered experimental."
              }
            ],
            "roles": [],
            "title": null,
            "type": "warning"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor introduces a list type that’s a hybrid between a description list and either an unordered or ordered list. This hybrid list, often referred to as an unordered or ordered description list, has the appearance of an unordered or ordered list, respectively, except that the subject of each list item is emphasized in bold text and either offset from the description by a stop character followed by a space or stacked above it."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Currently, only Asciidoctor PDF supports the syntax defined on this page, though support in the HTML converter is in the works. Asciidoctor EPUB 3 supports a slightly different variation in that is uses a different block style for unordered lists ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "itemized"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instead of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "unordered"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": "). Though that difference will be aligned in a future release."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In an unordered and ordered description list, the first term in each item is preceded by a marker. Additional terms are ignored. The marker is a bullet for an unordered list or a number for an ordered list. The term effectively becomes the subject, appearing in bold text."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example of a description list with marker."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "ulist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "boolean:"
                          }
                        ],
                        "kind": "strong",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " use true and false, not 1 and 0 or T and F"
                      }
                    ]
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "number:"
                          }
                        ],
                        "kind": "strong",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " use Arabic numerals without punctuation (other than the decimal point in a floating point number)"
                      }
                    ]
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "enumerated value:"
                          }
                        ],
                        "kind": "strong",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " use only one of the allowed values, respecting case"
                      }
                    ]
                  }
                ],
                "roles": [],
                "style": null,
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This list type also provides control over the stop character that’s inserted after the term so it can more naturally flow into the item description. It can also be configured so that the subject is stacked above the description. This page describes the syntax of this list type and how to customize its appearance."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_introduction",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Introduction"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In AsciiDoc, a description list with a marker is defined just like a normal description list. The difference is that it must be annotated with either the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "unordered"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ordered"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " block style. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "unordered"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " block style creates an unordered list and the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ordered"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " block style creates an ordered list."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example of an unordered description list."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[unordered]\nboolean:: use true and false, not 1 and 0 or T and F\nnumber:: use Arabic numerals without punctuation (other than the decimal point to make a floating point number)\nenumerated value:: use only one of the allowed values, respecting case"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s how this syntax will appear, where supported:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
