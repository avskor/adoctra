                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " use Arabic numerals without punctuation (other than the decimal point in a floating point number)"
                      }
                    ]
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "id": null,
                        "inlines": [
                          {
