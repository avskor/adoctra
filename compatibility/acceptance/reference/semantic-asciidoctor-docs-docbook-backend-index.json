            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor can produce the DocBook 5 XML output format from an AsciiDoc document. Although DocBook XML is not a publishable format, it can be used to tie into an existing publishing toolchain that processes DocBook. This page explains how to use Asciidoctor to convert AsciiDoc to DocBook."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor’s built-in DocBook converter is registered for the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "docbook"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "docbook5"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " backends. The DocBook converter generates XML that adheres to the DocBook XML schema. There’s a corresponding DocBook tag for each AsciiDoc element."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
