{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Some category keys allow background, foreground, and other category-specific images to be specified directly in the theme."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The theme supports the following image formats:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "PNG (.png)"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "JPEG (.jpg)"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "SVG (.svg)"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When specified, the filename of the image must use the file extension that matches its format."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "CAUTION: The GIF (.gif), WebP (.webp), TIFF (.tiff), BMP (.bmp), and interlaced PNG formats are not supported unless you install prawn-gmagick. See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Supporting additional image file formats"
                  }
                ],
                "kind": "xref",
                "target": "ROOT:image-paths-and-formats.html#other-image-formats"
              },
              {
                "kind": "text",
                "value": " for details."
              }
            ],
            "roles": [],
            "title": null,
            "type": "caution"
          }
        ],
        "context": "section",
        "id": "formats",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Supported image formats"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In the theme, an image can be specified as an AsciiDoc inline image macro. The image can also be specified as a bare path, except in running content. The benefit of using the image macro is that you can specify configuration, such as the alt text and size."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The image path can be an absolute path, a data URI, or a relative path. If the image path is absolute or a data URI, the path is used as is. If the image path is relative, it’s resolved relative to the value of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf-themesdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute. If the value of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf-theme"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute is a path that ends in "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": ".yml"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pdf-themesdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is not otherwise set, then images are resolved relative to the directory of the theme path."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want to reference an image relative to the document you’re converting, prefix the path with the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "{docdir}"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "{docimagesdir}"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute references, which both resolve to an absolute path. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "docimagesdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is a combination of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "docdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "imagesdir"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute values. When using one of these attribute references, it should be followed by the path separator."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "paths",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Image paths in the theme"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Several key categories, such as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "page"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "title-page"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", and the running content "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "header"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "footer"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", allow a background image to be specified directly by the theme with the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "background-image"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key. "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Front and back cover images"
                  }
                ],
                "kind": "xref",
                "target": "covers.html"
              },
              {
                "kind": "text",
                "value": " are handled like background images, too."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In the theme, a background image can specified either using the AsciiDoc inline image macro or as a bare image path. Here’s how a background image is specified in the theme file as a bare path:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "title-page:\n  background-image: title-cover.png"
                  }
                ],
                "language": "yaml",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Here’s how the background image is specified using the inline image macro:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "title-page:\n  background-image: image:title-cover.png[]"
                  }
                ],
                "language": "yaml",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "As described above, these relative paths will be resolved from the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "pdf-themesdir"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ". Here’s an example of an image that is resolved relative to the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "imagesdir"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " value of the document being converted:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "title-page:\n  background-image: image:{docimagesdir}/title-cover.png[]"
                  }
                ],
                "language": "yaml",
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "specify",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Specify a background image in the theme"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "You can configure any background image to be selected per page layout by including the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "{page-layout}"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " attribute reference in the image path."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "footer:\n  background-image: image:footer-bg-{page-layout}.png[]"
                  }
                ],
                "language": "yaml",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The image is resolved once per page layout that’s encountered in the document. Using this technique requires that the page layout value be included in the path of the image (e.g., footer-bg-landscape.png)."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "per-page-layout",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Per page layout"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "By default, background images are automatically scaled to fit the bounds of the page (i.e., "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "fit=contain"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ") and centered (i.e., "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "position=center"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "). Wrapping the value in the image macro allows you to customize an image’s size and position. The size of the image assigned with an image macro can be controlled using the sizing attributes, "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "fit"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "pdfwidth"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "scaledwidth"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", or "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "width"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", when "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "fit=none"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ". The position of the image can be controlled using the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "position"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " attribute."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "page:\n  background-image: image:page-bg.png[fit=none,position=top center]"
                  }
                ],
                "language": "yaml",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "See "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "ROOT:background-images.html"
                      }
                    ],
                    "kind": "xref",
                    "target": "ROOT:background-images.html"
                  },
                  {
                    "kind": "text",
                    "value": " for the available "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "fit"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " and "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "position"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " values. See "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "ROOT:image-scaling.html"
                      }
                    ],
                    "kind": "xref",
                    "target": "ROOT:image-scaling.html"
                  },
                  {
                    "kind": "text",
                    "value": " to learn about the sizing attributes the image macro accepts."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "attributes",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Fit, width, and position"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "page"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " category allows a background image to be set for recto pages (right-hand, odd-numbered pages) and verso pages (left-hand, even-numbered pages). The recto background image is specified using "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "page-background-image-recto"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " and the verso background image using "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "page-background-image-verso"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "page:\n  background-image:\n    recto: image:page-bg-recto.png[]\n    verso: image:page-bg-verso.png[]"
                  }
                ],
                "language": "yaml",
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If you define the keys using the flattened structure (e.g., "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "page-background-image-recto"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), you can also set the default page background image ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "page-background-image"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), which will be used as a fallback if a background image isn’t specified for a given side."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "page-background-image: image:page-bg.png[]\npage-background-image-verso: image:verso-bg.png[]"
                  }
                ],
                "language": "yaml",
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "recto-and-verso",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Recto and verso"
              }
            ]
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "To deactivate an inherited background image, assign the value "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "none"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " to "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "background-image"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "title-page:\n  background-image: none"
                  }
                ],
                "language": "yaml",
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "deactivate-a-background-image",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Deactivate a background image"
              }
            ]
          }
        ],
        "context": "section",
        "id": "background",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Background images"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In addition to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "background-image"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "page"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " category has a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "foreground-image"
                  }
