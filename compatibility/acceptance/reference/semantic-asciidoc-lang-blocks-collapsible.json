            "inlines": [
              {
                "kind": "text",
                "value": "You can designate block content to be revealed or hidden on interaction using the collapsible option and its companion, the open option. When the AsciiDoc source is converted to HTML, this block gets mapped to a disclosure summary element (i.e., a summary/details pair). If the output format does not support this interaction, it may be rendered as an unstyled block (akin to an open block)."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You make block content collapsible by specifying the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "collapsible"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option on the example structural container. This option changes the block from an example block to a collapsible block."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-collapsible",
            "inlines": [
              {
                "kind": "text",
                "value": "[%collapsible]\n====\nThis content is only revealed when the user clicks the block title.\n===="
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Collapsible block syntax"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In the output, the content of this block is hidden until the reader clicks the default title, “Details”. The result of "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Example 1"
                  }
                ],
                "kind": "xref",
                "target": "#ex-collapsible"
              },
              {
                "kind": "text",
                "value": " is displayed below."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
