            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Much like the open block, the collapsible block is an enclosure. If you want to make other types of blocks collapsible, such as an listing block, you can nest the block inside the collapsible block."
              }
            ],
            "roles": [],
            "title": null
