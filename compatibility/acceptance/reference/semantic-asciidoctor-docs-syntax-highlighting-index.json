          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Asciidoctor does not apply syntax highlighting when generating DocBook. The assumption is that this is a task the DocBook toolchain can handle. The DocBook converter generates a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<programlisting>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " element for the source block and passes through the source language as specified in the AsciiDoc. It’s then up to the DocBook toolchain to apply syntax highlighting to the contents of that tag."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can explore these integrations in depth on the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "highlightjs.html"
                  }
                ],
                "kind": "xref",
                "target": "highlightjs.html"
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "rouge.html"
                  }
                ],
                "kind": "xref",
                "target": "rouge.html"
              },
              {
                "kind": "text",
                "value": ", "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "pygments.html"
                  }
                ],
                "kind": "xref",
                "target": "pygments.html"
              },
              {
                "kind": "text",
                "value": ", and "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "coderay.html"
                  }
                ],
                "kind": "xref",
                "target": "coderay.html"
              },
              {
                "kind": "text",
                "value": " pages."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can also create your own integration by making a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "custom.html"
                  }
                ],
                "kind": "xref",
                "target": "custom.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
