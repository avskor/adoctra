              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ContextCustomizerFactory"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is responsible for creating a "
              },
              {
