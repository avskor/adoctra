                  {
                    "kind": "text",
                    "value": "ContextCustomizer"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is necessary for a given test class — for example, based on the presence of a certain annotation. Factories are invoked after "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
