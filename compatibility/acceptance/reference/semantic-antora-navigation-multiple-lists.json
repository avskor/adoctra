          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When converted to HTML, the list titles become top-level items and all of their list items are nested under them in cascading order. The blank line between the lists is not present in the published menu."
              }
            ],
            "roles": [],
            "title": null
