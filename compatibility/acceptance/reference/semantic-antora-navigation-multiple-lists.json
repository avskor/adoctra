        "title": [
          {
            "kind": "text",
            "value": "Structuring multiple lists"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Let’s create a navigation file that contains two navigation lists for the pages in a module. The most common items in a navigation list are xrefs to pages "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "that belong to the same module as the navigation file"
                  }
                ],
                "kind": "xref",
                "target": "organize-files.html"
              },
              {
                "kind": "text",
                "value": ". The exercise below assumes that the navigation file will belong to the same component version and module as the pages it is referencing. That means the resource IDs won’t need to specify version, component, or module coordinates."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "olist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Open a new file in the text editor or IDE of your choice."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "listing",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": ".xref:get-started.adoc"
                      }
                    ],
                    "language": "asciidoc",
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "On the first line, type a dot ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "."
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), directly followed by an xref macro prefix and the resource ID of the target page."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "blocks": [
                      {
                        "context": "listing",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": ".xref:get-started.adoc[]"
                          }
                        ],
                        "language": "asciidoc",
                        "roles": [],
                        "title": null
                      },
                      {
                        "context": "paragraph",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Since there isn’t any link text specified inside the square brackets, Antora will use the value of the target page’s "
                          },
                          {
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "default link text"
                              }
                            ],
                            "kind": "xref",
                            "target": "xrefs-and-link-text.html#default-link-text"
                          },
                          {
                            "kind": "text",
                            "value": " when it generates the site."
                          }
                        ],
                        "roles": [],
                        "title": null
                      }
                    ],
                    "context": "open",
                    "id": null,
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "At the end of the resource ID, complete the macro with a set of square brackets ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "[]"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "). Press "
                  },
                  {
                    "keys": [
                      [
                        {
                          "kind": "text",
                          "value": "Enter"
                        }
                      ]
                    ],
                    "kind": "kbd"
                  },
                  {
                    "kind": "text",
                    "value": " to go to the next line."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "blocks": [
                      {
                        "context": "listing",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": ".xref:get-started.adoc[]\n* xref:install.adoc[Installation Setup and Steps]"
                          }
                        ],
                        "language": "asciidoc",
                        "roles": [],
                        "title": null
                      },
                      {
                        "context": "paragraph",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "The link text, "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "Installation Setup and Steps"
                              }
                            ],
                            "kind": "emphasis",
                            "roles": []
                          },
                          {
                            "kind": "text",
                            "value": ", will be displayed in the component version page menu."
                          }
                        ],
                        "roles": [],
                        "title": null
                      }
                    ],
                    "context": "open",
                    "id": null,
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Let’s add a list item. Type an asterisk ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "*"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), followed by a blank space, and then an xref. This time, enter link text inside the set of square brackets ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "[]"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "). Press "
                  },
                  {
                    "keys": [
                      [
                        {
                          "kind": "text",
                          "value": "Enter"
                        }
                      ]
                    ],
                    "kind": "kbd"
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "listing",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": ".xref:get-started.adoc[]\n* xref:install.adoc[Installation Setup and Steps]\n\n.CLI Commands and Options"
                      }
                    ],
                    "language": "asciidoc",
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Let’s start a new list. Press "
                  },
                  {
                    "keys": [
                      [
                        {
                          "kind": "text",
                          "value": "Enter"
                        }
                      ]
                    ],
                    "kind": "kbd"
                  },
                  {
                    "kind": "text",
                    "value": " to insert a blank like between the lists. On a new line, type a dot ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "."
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), directly followed by regular text. This list title won’t reference a page."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "listing",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": ".xref:get-started.adoc[]\n* xref:install.adoc[Installation Setup and Steps]\n\n.CLI Commands and Options\n* xref:commands.adoc[]"
                      }
                    ],
                    "language": "asciidoc",
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "On the next line, type an asterisk ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "*"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), a blank space, and then an xref macro. This item is a cross reference that will use the target page’s default link text."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "listing",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": ".xref:get-started.adoc[]\n* xref:install.adoc[Installation Setup and Steps]\n\n.CLI Commands and Options\n* xref:commands.adoc[]\n** xref:commands-in-action.adoc[]"
                      }
                    ],
                    "language": "asciidoc",
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Finally, nest a list item under the previous item. Type two asterisks ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "**"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), followed by a blank space, and then an xref."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "blocks": [
                      {
                        "context": "listing",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "📂 modules\n  📂 a-module\n    📂 pages\n    📄 nav.adoc"
                          }
                        ],
                        "language": null,
                        "roles": [],
                        "title": null
                      },
                      {
                        "context": "paragraph",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "You can also save the file with the filename of your choice, as long as the extension is "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": ".adoc"
                              }
                            ],
                            "kind": "emphasis",
                            "roles": []
                          },
                          {
                            "kind": "text",
                            "value": "."
                          }
                        ],
                        "roles": [],
                        "title": null
                      }
                    ],
                    "context": "open",
                    "id": null,
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Save the file as "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "nav.adoc"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": [
                      "path"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": " in the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "module directory"
                      }
                    ],
                    "kind": "xref",
                    "target": "ROOT:module-directories.html#module-dir"
                  },
                  {
                    "kind": "text",
                    "value": " that contains the page source files referenced in the list. The navigation file should be located at the same hierarchy level as the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "pages"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": [
                      "path"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": " directory. "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Don’t save it in the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "pages"
                          }
                        ],
                        "kind": "emphasis",
                        "roles": [
                          "path"
                        ]
                      },
                      {
                        "kind": "text",
                        "value": " folder!"
                      }
                    ],
                    "kind": "strong",
                    "roles": []
                  }
                ]
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You’ve now create a navigation file for a module! Make sure you "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "register it in "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "antora.yml"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": []
                  }
                ],
                "kind": "xref",
                "target": "register-navigation-files.html"
              },
              {
                "kind": "text",
                "value": " so it becomes part of the component version page menu."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
