      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "By default Spring MVC considers the request Locale when parsing and formatting date values. This works for forms where dates are represented as Strings with \"input\" form fields. For \"date\" and \"time\" form fields, however, browsers use a fixed format defined in the HTML spec. For such cases date and time formatting can be customized as follows:"
          }
        ],
        "roles": [],
        "title": null
      },
