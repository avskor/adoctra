            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example of how you can generate an HTML TOC with the depth limited to 1 for the previously loaded document:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "html_toc = document.converter.convert_outline document, toclevels: 1"
              }
            ],
