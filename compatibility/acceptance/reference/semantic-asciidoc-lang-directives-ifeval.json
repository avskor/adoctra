                      "value": ") quotes."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "quoted string"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "Literal value of "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "true"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " or "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "false"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": "."
                    }
                  ]
