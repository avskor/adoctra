                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If a value is enclosed in quotes, the characters between the quotes is used and always coerced to a string."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If a value is "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "not"
                      }
                    ],
                    "kind": "strong",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " enclosed in quotes, it’s subject to the following type coercion rules:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "ulist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "an empty value becomes nil (aka null) (and thus safe for use in a comparison)."
                      }
                    ]
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "a value of "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "true"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " or "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "false"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " becomes a boolean value."
                      }
                    ]
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "a value of only repeating whitespace becomes a single whitespace string."
                      }
                    ]
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "a value containing a period becomes a floating-point number."
                      }
                    ]
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "any other value is coerced to an integer value."
                      }
                    ]
                  }
                ],
                "roles": [],
                "style": null,
                "title": null
              }
            ],
