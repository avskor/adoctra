      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "An "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "antora.yml"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " file is referred to as a "
              },
