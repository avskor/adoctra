          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "jms"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " elements deal with configuring JMS-related beans, such as Spring’s "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Message Listener Containers"
                      }
                    ],
                    "kind": "xref",
                    "target": "integration/jms/using.html#jms-mdp"
                  },
                  {
                    "kind": "text",
                    "value": ". These elements are detailed in the section of the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "JMS chapter"
                      }
                    ],
                    "kind": "xref",
                    "target": "integration/jms.html"
                  },
                  {
                    "kind": "text",
                    "value": " entitled "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "JMS Namespace Support"
                      }
                    ],
                    "kind": "xref",
                    "target": "integration/jms/namespace.html"
                  },
                  {
                    "kind": "text",
                    "value": " . See that chapter for full details on this support and the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "jms"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " elements themselves."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In the interest of completeness, to use the elements in the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "jms"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " schema, you need to have the following preamble at the top of your Spring XML configuration file. The text in the following snippet references the correct schema so that the elements in the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "jms"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " namespace are available to you:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<beans xmlns=\"http://www.springframework.org/schema/beans\"\n\txmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n\txmlns:jms=\"http://www.springframework.org/schema/jms\"\n\txsi:schemaLocation=\"\n\t\thttp://www.springframework.org/schema/beans\n\t\thttps://www.springframework.org/schema/beans/spring-beans.xsd\n\t\thttp://www.springframework.org/schema/jms\n\t\thttps://www.springframework.org/schema/jms/spring-jms.xsd\">\n\n\t<!-- bean definitions here -->\n\n</beans>"
                  }
