                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "cache"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " namespace are available to you:"
                  }
