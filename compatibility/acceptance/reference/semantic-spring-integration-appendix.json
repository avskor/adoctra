                    ],
                    "roles": [],
                    "title": null
                  },
                  {
                    "context": "listing",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "<bean id=\"simple\" class=\"org.springframework.jndi.JndiObjectFactoryBean\">\n\t<property name=\"jndiName\" value=\"jdbc/MyDataSource\"/>\n\t<property name=\"jndiEnvironment\">\n\t\t<props>\n\t\t\t<prop key=\"ping\">pong</prop>\n\t\t</props>\n\t</property>\n</bean>"
                      }
                    ],
                    "language": "xml",
                    "roles": [],
                    "title": null
                  },
                  {
                    "context": "paragraph",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "The following example shows how to use JNDI to look up an environment variable with "
