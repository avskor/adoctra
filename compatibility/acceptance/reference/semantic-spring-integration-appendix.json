        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "This part of the appendix lists XML schemas related to integration technologies."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "jee"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " elements deal with issues related to Jakarta EE (Enterprise Edition) configuration, such as looking up a JNDI object and defining EJB references."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "To use the elements in the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "jee"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " schema, you need to have the following preamble at the top of your Spring XML configuration file. The text in the following snippet references the correct schema so that the elements in the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "jee"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " namespace are available to you:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<beans xmlns=\"http://www.springframework.org/schema/beans\"\n\txmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n\txmlns:jee=\"http://www.springframework.org/schema/jee\"\n\txsi:schemaLocation=\"\n\t\thttp://www.springframework.org/schema/beans\n\t\thttps://www.springframework.org/schema/beans/spring-beans.xsd\n\t\thttp://www.springframework.org/schema/jee\n\t\thttps://www.springframework.org/schema/jee/spring-jee.xsd\">\n\n\t<!-- bean definitions here -->\n\n</beans>"
                  }
                ],
                "language": "xml",
                "roles": [],
                "title": null
              },
              {
                "blocks": [
                  {
                    "context": "paragraph",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "The following example shows how to use JNDI to look up a data source without the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "jee"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " schema:"
                      }
                    ],
                    "roles": [],
                    "title": null
                  },
                  {
                    "context": "listing",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "<bean id=\"dataSource\" class=\"org.springframework.jndi.JndiObjectFactoryBean\">\n\t<property name=\"jndiName\" value=\"jdbc/MyDataSource\"/>\n</bean>\n<bean id=\"userDao\" class=\"com.foo.JdbcUserDao\">\n\t<!-- Spring will do the cast automatically (as usual) -->\n\t<property name=\"dataSource\" ref=\"dataSource\"/>\n</bean>"
                      }
                    ],
                    "language": "xml",
                    "roles": [],
                    "title": null
                  },
                  {
                    "context": "paragraph",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "The following example shows how to use JNDI to look up a data source with the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "jee"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " schema:"
                      }
                    ],
                    "roles": [],
                    "title": null
                  },
                  {
                    "context": "listing",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "<jee:jndi-lookup id=\"dataSource\" jndi-name=\"jdbc/MyDataSource\"/>\n\n<bean id=\"userDao\" class=\"com.foo.JdbcUserDao\">\n\t<!-- Spring will do the cast automatically (as usual) -->\n\t<property name=\"dataSource\" ref=\"dataSource\"/>\n</bean>"
                      }
                    ],
                    "language": "xml",
                    "roles": [],
                    "title": null
                  }
                ],
                "context": "section",
                "id": "appendix.xsd-schemas-jee-jndi-lookup",
                "level": 3,
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "<jee:jndi-lookup/> (simple)"
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "paragraph",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "The following example shows how to use JNDI to look up an environment variable without "
