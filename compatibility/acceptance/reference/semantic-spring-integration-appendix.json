                        "kind": "text",
                        "value": "<jee:jndi-lookup id=\"simple\" jndi-name=\"jdbc/MyDataSource\">\n\t<!-- newline-separated, key-value pairs for the environment (standard Properties format) -->\n\t<jee:environment>\n\t\tsing=song\n\t\tping=pong\n\t</jee:environment>\n</jee:jndi-lookup>"
                      }
