                      {
                        "kind": "text",
                        "value": "<bean id=\"simple\" class=\"org.springframework.jndi.JndiObjectFactoryBean\">\n\t<property name=\"jndiName\" value=\"jdbc/MyDataSource\"/>\n\t<property name=\"jndiEnvironment\">\n\t\t<props>\n\t\t\t<prop key=\"sing\">song</prop>\n\t\t\t<prop key=\"ping\">pong</prop>\n\t\t</props>\n\t</property>\n</bean>"
                      }
