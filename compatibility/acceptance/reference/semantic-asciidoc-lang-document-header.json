      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The optional document header is a series of contiguous lines at the start of the AsciiDoc source, after skipping any empty or comment lines. If a document has a header, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "no content blocks are permitted above it"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". In other words, the document must start with a document header if it has one."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "The document header may not contain empty lines."
                      }
                    ],
                    "kind": "strong",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " The first empty line the processor encounters after the document header begins marks the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "end of the document header"
                      }
                    ],
                    "kind": "xref",
                    "target": "#when-does-the-document-header-end"
                  },
                  {
                    "kind": "text",
                    "value": " and the start of the document body."
                  }
                ],
                "roles": [
                  "lead"
                ],
                "title": null
              }
            ],
            "context": "admonition",
            "id": null,
            "roles": [],
            "title": null,
            "type": "important"
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A header typically begins with a "
              },
