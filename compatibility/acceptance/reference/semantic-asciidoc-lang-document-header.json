                    "value": "title.html"
                  }
                ],
                "kind": "xref",
                "target": "title.html"
              },
              {
                "kind": "text",
                "value": ". When a document title is specified, it may be immediately followed by one or two designated lines of content. These implicit content lines are used to assign "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "author-information.html"
                  }
                ],
                "kind": "xref",
