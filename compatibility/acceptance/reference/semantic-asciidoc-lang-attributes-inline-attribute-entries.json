{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "An attribute reference can be used to set or unset an attribute inline as an alternative to a dedicated attribute entry line. This mechanism allows you to set or unset an attribute in places where attribute entries lines are not permitted, such as in a normal table cell or a list item."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Attributes can be defined inline using the following notation:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "listing",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "{set:name:value}"
          }
        ],
        "language": "asciidoc",
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The value segment is optional. If absent, the value defaults to empty string. In that case, the notation is reduced to:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "listing",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "{set:name}"
          }
        ],
        "language": "asciidoc",
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If you add a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "!"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " character after the name to unset the attribute instead:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "listing",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "{set:name!}"
          }
        ],
        "language": "asciidoc",
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Here’s an example that uses an inline attribute entry to set the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "sourcedir"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " attribute to the value "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "src/main/java"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "listing",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "{set:sourcedir:src/main/java}"
          }
        ],
        "language": "asciidoc",
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "This assignment is effectively the same as:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "listing",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": ":sourcedir: src/main/java"
          }
        ],
        "language": "asciidoc",
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "However, it’s important to understand that inline attribute assignments are processed in a different phase than attribute entry lines. Inline attribute entries are processed when attribute references are replaced, as part of the attributes substitution. Therefore, the result of the assignment is only available to attribute references that follow it. These assignments are not visible in the document model after the document has been loaded."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You’re strongly discouraged from using inline attribute entries unless you understand their limitations or they are a last resort for fulfilling a use case."
          }
        ],
        "roles": [],
        "title": null
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Inline Attribute Entries"
      }
    ]
  }
}
