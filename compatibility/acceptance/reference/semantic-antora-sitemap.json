        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If the value of the site URL defined in the playbook is an absolute URL, Antora will automatically generate a sitemap and output it to the root of the generated site."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The sitemap that Antora produces consists of several files. Rather than just a single "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sitemap.xml"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " file, Antora partitions the sitemap into multiple files. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sitemap.xml"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " file is a sitemap index that lists each of the individual component sitemap files. The sitemap files are placed at the root of the published site, where a search engine will expect to find them."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "literal",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "404.html\nindex.html\nrobots.txt\nsitemap.xml\nsitemap-colorado.xml\nsitemap-wyoming.xml\n..."
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Each component sitemap file is named "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sitemap-<name>.xml"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": ", where "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<name>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is the component name. The file contains a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<url>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " entry for each publishable page in the site. No other type of resource is included in the sitemap."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The value of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<loc>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " tag for a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<url>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is the absolute URL to that page. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<url>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " value is constructed by combining the site URL (including the subpath) with the (root-relative) URL of the page. The value of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<lastmod>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " tag for a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<url>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is the date the site was generated."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The entries are sorted merely to ensure that the order remains stable between runs."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "sitemap-structure",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Sitemap structure"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Let’s look at an example. We’ll assume that your site has two components, named colorado and wyoming, and the site URL is "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "https://docs.example.org"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Here’s how the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sitemap.xml"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " might look:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<sitemapindex xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n<sitemap>\n<loc>https://docs.example.org/sitemap-colorado.xml</loc>\n</sitemap>\n<sitemap>\n<loc>https://docs.example.org/sitemap-wyoming.xml</loc>\n</sitemap>\n</sitemapindex>"
              }
            ],
            "language": "xml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s how the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sitemap-colorado.xml"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " might look:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n<url>\n<loc>https://docs.example.org/colorado/6.0/index.html</loc>\n<lastmod>2021-12-24T23:00:00.123Z</lastmod>\n</url>\n...\n</urlset>"
              }
            ],
            "language": "xml",
            "roles": [],
            "title": null
          }
        ],
