  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The JUnit Platform provides opt-in support for capturing output printed to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "System.out"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "System.err"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". To enable it, set the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "junit.platform.output.capture.stdout"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and/or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "junit.platform.output.capture.stderr"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "configuration parameter"
              }
            ],
            "kind": "xref",
            "target": "running-tests/configuration-parameters.html"
          },
          {
            "kind": "text",
            "value": " to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "true"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". In addition, you may configure the maximum number of buffered bytes to be used per executed test or container using "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "junit.platform.output.capture.maxBuffer"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If enabled, the JUnit Platform captures the corresponding output and publishes it as a report entry using the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "stdout"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "stderr"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " keys to all registered "
          },
          {
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TestExecutionListener"
                  }
                ],
                "kind": "xref",
                "target": "attachment$api/org.junit.platform.launcher/org/junit/platform/launcher/TestExecutionListener.html"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " instances immediately before reporting the test or container as finished."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Please note that the captured output will only contain output emitted by the thread that was used to execute a container or test. Any output by other threads will be omitted because particularly when "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "executing tests in parallel"
              }
            ],
            "kind": "xref",
            "target": "writing-tests/parallel-execution.html"
          },
          {
            "kind": "text",
            "value": " it would be impossible to attribute it to a specific test or container."
          }
        ],
        "roles": [],
        "title": null
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Capturing Standard Output/Error"
      }
    ]
  }
}
