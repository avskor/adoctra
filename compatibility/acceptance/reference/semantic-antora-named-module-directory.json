              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Can’t contain characters that aren’t permitted in AsciiDoc macros and directives"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Shouldn’t contain characters that inhibit web server portability, search engine optimization, or the best practices of your site’s search solution"
