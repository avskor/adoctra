          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Antora uses a module’s directory name to create a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "module’s name"
                  }
                ],
                "kind": "xref",
                "target": "#named-module"
              },
              {
                "kind": "text",
                "value": ". A module name is used for source-to-source referencing and as a URL segment for the publishable resources that belong to the module. Therefore, the name of the module directory:"
              }
            ],
            "roles": [],
            "title": null
          },
