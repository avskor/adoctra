        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To use CodeRay with Asciidoctor, you need the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "coderay gem"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://rubygems.org/gems/coderay"
              },
              {
                "kind": "text",
                "value": ". You can use one of the following methods to install CodeRay."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "literal",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "$ gem install coderay"
                        }
                      ],
                      "language": null,
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Install using gem (all systems)"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "literal",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "$ sudo apt-get install ruby-coderay"
                        }
                      ],
                      "language": null,
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Install using apt-get (Debian-based systems)"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "literal",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "$ sudo dnf install rubygem-coderay"
                        }
                      ],
                      "language": null,
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Install using dnf (Fedora-based systems)"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
