            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following example shows how to use these callbacks to calculate and log the execution time of a test method. "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "TimingExtension"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " implements both "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "BeforeTestExecutionCallback"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "AfterTestExecutionCallback"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in order to time and log the test execution."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
