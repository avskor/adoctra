    },
    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The cache abstraction provides several storage integration options. To use them, you need to declare an appropriate "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CacheManager"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (an entity that controls and manages "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Cache"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instances and that can be used to retrieve these for storage)."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The JDK-based "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Cache"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " implementation resides under "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "org.springframework.cache.concurrent"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " package. It lets you use "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ConcurrentHashMap"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " as a backing "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Cache"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " store. The following example shows how to configure two caches:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "include-code::./CacheConfiguration[tag=snippet,indent=0]"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The preceding snippet uses the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "SimpleCacheManager"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " to create a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CacheManager"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " for the two nested "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ConcurrentMapCache"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instances named "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "default"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "books"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". Note that the names are configured directly for each cache."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "As the cache is created by the application, it is bound to its lifecycle, making it suitable for basic use cases, tests, or simple applications. The cache scales well and is very fast, but it does not provide any management, persistence capabilities, or eviction contracts."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "cache-store-configuration-jdk",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "JDK "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ConcurrentMap"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "-based Cache"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Ehcache 3.x is fully JSR-107 compliant and no dedicated support is required for it. See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "JSR-107 Cache"
                  }
                ],
                "kind": "xref",
                "target": "integration/cache/store-configuration.html#cache-store-configuration-jsr107"
              },
              {
                "kind": "text",
                "value": " for details."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "cache-store-configuration-eviction",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Ehcache-based Cache"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Caffeine is a Java 8 rewrite of Guava’s cache, and its implementation is located in the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "org.springframework.cache.caffeine"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " package and provides access to several features of Caffeine."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following example configures a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CacheManager"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " that creates the cache on demand:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "include-code::./CacheConfiguration[tag=snippet,indent=0]"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can also provide the caches to use explicitly. In that case, only those are made available by the manager. The following example shows how to do so:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "include-code::./CustomCacheConfiguration[tag=snippet,indent=0]"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The Caffeine "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CacheManager"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " also supports custom "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Caffeine"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CacheLoader"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". See the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Caffeine documentation"
                  }
                ],
                "kind": "link",
                "target": "https://github.com/ben-manes/caffeine/wiki"
              },
              {
                "kind": "text",
                "value": " for more information about those."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "cache-store-configuration-caffeine",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Caffeine Cache"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "GemFire is a memory-oriented, disk-backed, elastically scalable, continuously available, active (with built-in pattern-based subscription notifications), globally replicated database and provides fully-featured edge caching. For further information on how to use GemFire as a "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CacheManager"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (and more), see the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Spring Data GemFire reference documentation"
                  }
                ],
                "kind": "link",
                "target": "https://docs.spring.io/spring-gemfire/docs/current/reference/html/"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "cache-store-configuration-gemfire",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "GemFire-based Cache"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Spring’s caching abstraction can also use JSR-107-compliant caches. The JCache implementation is located in the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "org.springframework.cache.jcache"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " package."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Again, to use it, you need to declare the appropriate "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CacheManager"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". The following example shows how to do so:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "include-code::./CacheConfiguration[tag=snippet,indent=0]"
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "cache-store-configuration-jsr107",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "JSR-107 Cache"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Sometimes, when switching environments or doing testing, you might have cache declarations without having an actual backing cache configured. As this is an invalid configuration, an exception is thrown at runtime, since the caching infrastructure is unable to find a suitable store. In situations like this, rather than removing the cache declarations (which can prove tedious), you can wire in a simple dummy cache that performs no caching — that is, it forces the cached methods to be invoked every time. The following example shows how to do so:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "include-code::./CacheConfiguration[tag=snippet,indent=0]"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CompositeCacheManager"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in the preceding chains multiple "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "CacheManager"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instances and, through the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "fallbackToNoOpCache"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " flag, adds a no-op cache for all the definitions not handled by the configured cache managers. That is, every cache definition not found in either "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "jdkCache"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "gemfireCache"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " (configured earlier in the example) is handled by the no-op cache, which does not store any information, causing the target method to be invoked every time."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "cache-store-configuration-noop",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Dealing with Caches without a Backing Store"
          }
        ]
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Configuring the Cache Storage"
      }
    ]
  }
}
