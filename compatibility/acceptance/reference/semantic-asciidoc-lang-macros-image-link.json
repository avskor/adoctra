          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can turn an image into a link by using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "link"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The link attribute on a block or image macro acts as though the image is wrapped in a link macro. While it’s possible to wrap an inline image macro in a link macro, that combination is not well supported and may introduce subtle parsing problems. Therefore, you should use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "link"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute on the image macro instead."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The value of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "link"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute is akin to the target of the link macro. It can point to any URL or relative path."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For a block image macro, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "link"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute can be added to the block attribute line above the macro or inside the contents of the macro."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "[link=https://example.org]\nimage::logo.png[Logo]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "or"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "image::logo.png[Logo,link=https://example.org]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For an inline macro, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "link"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute must be added inside the contents of the macro."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "image:apply.jpg[Apply,link=https://apply.example.org] today!"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_link_attribute",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "link attribute"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When using the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "link"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute, you can also use the same controls supported by the link macro to control how the link is constructed. Those controls are as follows:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "window"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " attribute - instructs the browser to open the link in the specified named window"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "nofollow"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " option - instructs search engines to not follow the link"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "noopener"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " option - instructs the browser to navigate to the target without granting the new browsing context access to the original document"
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the value of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "window"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute is "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "_blank"
                  }
                ],
                "kind": "strong",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "noopener"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " option is automatically enabled."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example that shows how to use these controls."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "image::logo.png[Logo,link=https://example.org,window=_blank,opts=nofollow]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Refer to the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Target a separate window"
                  }
                ],
                "kind": "xref",
                "target": "link-macro-attribute-parsing.html#target-a-separate-window"
              },
              {
                "kind": "text",
                "value": " section in the link macro documentation for more information about how these link controls work."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
