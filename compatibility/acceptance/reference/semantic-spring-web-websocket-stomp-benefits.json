                    "value": "@Controller"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " instances and messages can be routed to them based on the STOMP destination header versus handling raw WebSocket messages with a single "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "WebSocketHandler"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
