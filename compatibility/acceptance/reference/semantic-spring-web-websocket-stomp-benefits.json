                    "value": "Java client"
                  }
                ],
                "kind": "xref",
                "target": "web/websocket/stomp/client.html"
              },
              {
                "kind": "text",
                "value": " in the Spring Framework, are available."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can (optionally) use message brokers (such as RabbitMQ, ActiveMQ, and others) to manage subscriptions and broadcast messages."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Application logic can be organized in any number of "
              },
              {
                "id": null,
