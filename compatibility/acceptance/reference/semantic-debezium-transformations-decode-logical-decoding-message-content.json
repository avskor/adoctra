                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "{\n\t\"op\": \"c\",\n\t\"ts_ms\": 1723115415729,\n\t\"source\": {\n\t\t\"version\": \"3.0.0-SNAPSHOT\",\n\t\t\"connector\": \"postgresql\",\n\t\t\"name\": \"connector-name\",\n\t\t\"ts_ms\": 1723115415640,\n\t\t\"snapshot\": \"false\",\n\t\t\"db\": \"source-db\",\n\t\t\"sequence\": \"[\\\"26717416\\\",\\\"26717576\\\"]\",\n\t\t\"ts_us\": 1723115415640161,\n\t\t\"ts_ns\": 1723115415640161000,\n\t\t\"schema\": \"\",\n\t\t\"table\": \"\",\n\t\t\"txId\": 745,\n\t\t\"lsn\": 26717576,\n\t\t\"xmin\": null\n\t},\n\t\"after\": {\n\t\t\"id\": 1,\n\t\t\"item\": \"Debezium in Action\",\n\t\t\"status\": \"ENTERED\",\n\t\t\"quantity\": 2,\n\t\t\"totalPrice\": 39.98\n\t}\n}"
                            }
                          ],
                          "language": "json",
