          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DecodeLogicalDecodingMessageContent"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " SMT converts the binary content of a PostgreSQL logical decoding message to a structured form."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the Debezium PostgreSQL connector captures logical decoding messages, it emits "
              },
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "message"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " event records"
                  }
                ],
                "kind": "xref",
                "target": "connectors/postgresql.html#postgresql-message-events"
              },
              {
                "kind": "text",
                "value": " to Kafka. By default, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "content"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " field in these message records contain encoded binary data. To facilitate processing of PostgreSQL event messages by other Kafka consumers, you can use the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DecodeLogicalDecodingMessageContent"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " SMT to decode the binary content of the original message, and convert it into a more consumable format."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You also use the SMT in conjunction with other SMTs, such as the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Debezium Outbox Event Router"
                  }
                ],
                "kind": "link",
                "target": "/documentation/reference/transformations/outbox-event-router"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To enable a Debezium PostgreSQL connector to decode the binary content in message events, add the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DecodeLogicalDecodingMessageContent"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " SMT to the Kafka Connect configuration for the connector, as shown in the following example:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "\"connector.class\": \"io.debezium.connector.postgresql.PostgresConnector\",\n...\n\"transforms\": \"decodeLogicalDecodingMessageContent\",\n\"transforms.decodeLogicalDecodingMessageContent.type\": \"io.debezium.connector.postgresql.transforms.DecodeLogicalDecodingMessageContent\",\n\"key.converter\": \"org.apache.kafka.connect.json.JsonConverter\",\n\"key.converter.schemas.enable\": false,\n\"value.converter\": \"org.apache.kafka.connect.json.JsonConverter\",\n\"value.converter.schemas.enable\": \"false\",\n..."
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following example shows the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "key"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "value"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " of an event record before and after the transformation is applied."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "{\n\t\"prefix\": \"test-prefix\"\n}"
                            }
                          ],
                          "language": "json",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Event key before the SMT processes the record"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "{\n\t\"op\": \"m\",\n\t\"ts_ms\": 1723115240065,\n\t\"source\": {\n\t\t\"version\": \"3.0.0-SNAPSHOT\",\n\t\t\"connector\": \"postgresql\",\n\t\t\"name\": \"connector-name\",\n\t\t\"ts_ms\": 1723115239782,\n\t\t\"snapshot\": \"false\",\n\t\t\"db\": \"source-db\",\n\t\t\"sequence\": \"[\\\"26997744\\\",\\\"26997904\\\"]\",\n\t\t\"ts_us\": 1723115239782690,\n\t\t\"ts_ns\": 1723115239782690000,\n\t\t\"schema\": \"\",\n\t\t\"table\": \"\",\n\t\t\"txId\": 756,\n\t\t\"lsn\": 26997904,\n\t\t\"xmin\": null\n\t},\n\t\"message\": {\n\t\t\"prefix\": \"test-prefix\",\n\t\t\"content\": \"eyJpZCI6IDEsICJpdGVtIjogIkRlYmV6aXVtIGluIEFjdGlvbiIsICJzdGF0dXMiOiAiRU5URVJFRCIsICJxdWFudGl0eSI6IDIsICJ0b3RhbFByaWNlIjogMzkuOTh9\"\n\t}\n}"
                            }
                          ],
                          "language": "json",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Event value before the SMT processes the record"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Before processing"
                  }
                ]
              },
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": null,
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Event key after the SMT processes the record"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "After processing"
                  }
                ]
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "null"
                  }
                ],
                "language": "json",
                "roles": [],
                "title": null
