                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In the preceding example, the SMT applies the following changes to the original event record:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "ulist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Removes the key that contained the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "prefix"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " field in the original logical decoding message ("
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "\"prefix\": \"test-prefix\""
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": ")."
                      }
                    ]
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Converts the value of the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "op"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " field from "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "m"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " (message) to "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "c"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " (create), effectively changing the event type from "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "message"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " to "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "INSERT"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": "."
                      }
                    ]
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Replaces the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "message"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " field with an "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "after"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " field that contains the decoded content of a logical decoding message."
                      }
                    ]
                  }
                ],
                "roles": [],
                "style": null,
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "After the SMT applies these changes, the record can be more easily processed by downstream consumers or by other SMTs, such as the Debezium Outbox Event Router."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
