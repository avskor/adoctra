      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can automatically apply validation after data binding by adding the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "jakarta.validation.Valid"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation or Spring’s "
          },
          {
            "id": null,
            "inlines": [
