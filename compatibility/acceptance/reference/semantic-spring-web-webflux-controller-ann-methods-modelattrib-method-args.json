      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Form data and query parameters take precedence over URI variables and headers, which are included only if they don’t override request parameters with the same name. Dashes are stripped from header names."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Pet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " instance may be:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "ulist",
        "id": null,
        "items": [
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Accessed from the model where it could have been added by a "
              },
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Model"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ],
                "kind": "xref",
                "target": "web/webflux/controller/ann-modelattrib-methods.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Accessed from the HTTP session if the model attribute was listed in the class-level "
              },
              {
                "inlines": [
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "@SessionAttributes"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ],
                "kind": "xref",
                "target": "web/webflux/controller/ann-methods/sessionattributes.html"
              },
              {
                "kind": "text",
                "value": "."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Instantiated through a default constructor."
              }
            ]
          },
          {
            "blocks": [],
            "checkbox": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Instantiated through a “primary constructor” with arguments that match to Servlet request parameters. Argument names are determined through runtime-retained parameter names in the bytecode."
              }
            ]
          }
        ],
        "roles": [],
        "style": null,
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "By default, both constructor and property "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "data binding"
              }
            ],
            "kind": "xref",
            "target": "core/validation/beans-beans.html#beans-binding"
          },
          {
            "kind": "text",
            "value": " are applied. However, model object design requires careful consideration, and for security reasons it is recommended either to use an object tailored specifically for web binding, or to apply constructor binding only. If property binding must still be used, then "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "allowedFields"
              }
            ],
            "kind": "emphasis",
            "roles": []
          },
          {
            "kind": "text",
            "value": " patterns should be set to limit which properties can be set. For further details on this and example configuration, see "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "model design"
              }
            ],
            "kind": "xref",
            "target": "web/webflux/controller/ann-initbinder.html#webflux-ann-initbinder-model-design"
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "When using constructor binding, you can customize request parameter names through an "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@BindParam"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation. For example:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "class Account {\n\n    private final String firstName;\n\n\tpublic Account(@BindParam(\"first-name\") String firstName) {\n\t\tthis.firstName = firstName;\n\t}\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "class Account(@BindParam(\"first-name\") val firstName: String)"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
