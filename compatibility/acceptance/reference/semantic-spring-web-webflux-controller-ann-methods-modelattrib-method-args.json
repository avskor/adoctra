      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@BindParam"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " may also be placed on the fields that correspond to constructor parameters. While "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@BindParam"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is supported out of the box, you can also use a different annotation by setting a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DataBinder.NameResolver"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " on "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DataBinder"
              }
            ],
            "kind": "monospace",
            "roles": []
          }
        ],
        "roles": [],
        "title": null,
        "type": "note"
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Constructor binding supports "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "List"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Map"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", and array arguments either converted from a single string, for example, comma-separated list, or based on indexed keys such as "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "accounts[2].name"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " or "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "account[KEY].name"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "WebFlux, unlike Spring MVC, supports reactive types in the model, for example, "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Mono<Account>"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". You can declare a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ModelAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " argument with or without a reactive type wrapper, and it will be resolved accordingly to the actual value."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If data binding results in errors, by default a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebExchangeBindException"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is raised, but you can also add a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "BindingResult"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " argument immediately next to the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@ModelAttribute"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " in order to handle such errors in the controller method. For example:"
          }
        ],
        "roles": [],
        "title": null
      },
