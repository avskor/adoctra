          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "It’s possible to influence the virtual page numbering, the folio placement, and where page numbers are displayed using a combination of theme keys and document attributes. See "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
