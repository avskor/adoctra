                  }
                ],
                "kind": "xref",
                "target": "apply-subs-to-blocks.html"
              },
              {
                "kind": "text",
                "value": ". For inline elements, the built-in values "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "c"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "specialchars"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
