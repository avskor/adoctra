    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DispatcherServlet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " expects a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " (an extension of a plain "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ") for its own configuration. "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " has a link to the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ServletContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Servlet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " with which it is associated. It is also bound to the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ServletContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " such that applications can use static methods on "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "RequestContextUtils"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " to look up the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " if they need access to it."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "For many applications, having a single "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is simple and suffices. It is also possible to have a context hierarchy where one root "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is shared across multiple "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "DispatcherServlet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " (or other "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Servlet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ") instances, each with its own child "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " configuration. See "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Additional Capabilities of the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ApplicationContext"
                  }
                ],
                "kind": "monospace",
                "roles": []
              }
            ],
            "kind": "xref",
            "target": "core/beans/context-introduction.html"
          },
          {
            "kind": "text",
            "value": " for more on the context hierarchy feature."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The root "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " typically contains infrastructure beans, such as data repositories and business services that need to be shared across multiple "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Servlet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " instances. Those beans are effectively inherited and can be overridden (that is, re-declared) in the Servlet-specific child "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", which typically contains beans local to the given "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Servlet"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". The following image shows this relationship:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "alt": [
          {
            "kind": "text",
            "value": "mvc context hierarchy"
          }
        ],
        "attributes": {},
        "caption": null,
        "context": "image",
        "id": null,
        "roles": [],
        "src": "mvc-context-hierarchy.png",
        "svg": null,
        "target": "mvc-context-hierarchy.png",
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following example configures a "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "WebApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " hierarchy:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "public class MyWebAppInitializer extends AbstractAnnotationConfigDispatcherServletInitializer {\n\n\t@Override\n\tprotected Class<?>[] getRootConfigClasses() {\n\t\treturn new Class<?>[] { RootConfig.class };\n\t}\n\n\t@Override\n\tprotected Class<?>[] getServletConfigClasses() {\n\t\treturn new Class<?>[] { App1Config.class };\n\t}\n\n\t@Override\n\tprotected String[] getServletMappings() {\n\t\treturn new String[] { \"/app1/*\" };\n\t}\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "class MyWebAppInitializer : AbstractAnnotationConfigDispatcherServletInitializer() {\n\n\toverride fun getRootConfigClasses(): Array<Class<*>> {\n\t\treturn arrayOf(RootConfig::class.java)\n\t}\n\n\toverride fun getServletConfigClasses(): Array<Class<*>> {\n\t\treturn arrayOf(App1Config::class.java)\n\t}\n\n\toverride fun getServletMappings(): Array<String> {\n\t\treturn arrayOf(\"/app1/*\")\n\t}\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If an application context hierarchy is not required, applications can return all configuration through "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "getRootConfigClasses()"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "null"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " from "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "getServletConfigClasses()"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null,
        "type": "tip"
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The following example shows the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "web.xml"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " equivalent:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "listing",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "<web-app>\n\n\t<listener>\n\t\t<listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>\n\t</listener>\n\n\t<context-param>\n\t\t<param-name>contextConfigLocation</param-name>\n\t\t<param-value>/WEB-INF/root-context.xml</param-value>\n\t</context-param>\n\n\t<servlet>\n\t\t<servlet-name>app1</servlet-name>\n\t\t<servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>\n\t\t<init-param>\n\t\t\t<param-name>contextConfigLocation</param-name>\n\t\t\t<param-value>/WEB-INF/app1-context.xml</param-value>\n\t\t</init-param>\n\t\t<load-on-startup>1</load-on-startup>\n\t</servlet>\n\n\t<servlet-mapping>\n\t\t<servlet-name>app1</servlet-name>\n\t\t<url-pattern>/app1/*</url-pattern>\n\t</servlet-mapping>\n\n</web-app>"
          }
        ],
        "language": "xml",
        "roles": [],
        "title": null
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If an application context hierarchy is not required, applications may configure a “root” context only and leave the "
