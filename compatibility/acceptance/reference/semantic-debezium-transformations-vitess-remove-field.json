                      "kind": "text",
                      "value": " SMT"
                    }
                  ],
                  "sections": []
                }
              ],
              "title": [
                {
                  "kind": "text",
                  "value": "Table of Contents"
                }
              ]
            },
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "RemoveField"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " SMT removes a specified field from the event record. When the connector is configured to provide transaction metadata, use this SMT to remove the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "transaction.id"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " field to avoid storing a duplicate entry of the VGTID. This transformation is designed for use only with the Debezium connector for Vitess."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The SMT uses the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "field_names"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " configuration option to specify a comma-separated list of paths that identify the fields to remove. The SMT removes each field that you specify from the event record and the event schema. The following example shows how to add the SMT to the connector configuration so that it removes specific fields from the change event records that the connector emits."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "\"connector.class\": \"io.debezium.connector.vitess.VitessConnector\",\n...\n\"transforms\": \"removeField\",\n\"transforms.removeField.type\": \"io.debezium.connector.vitess.transforms.RemoveField\",\n\"transforms.removeField.field_names\": \"transaction.id\",\n..."
              }
            ],
            "language": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following example shows the value of a change event record before and after the transformation is applied."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "{\n    \"before\": {...}\n    \"after\": {...}\n    \"source\": {...}\n    \"transaction\": {\n        \"id\": \"[{\\\"keyspace\\\":\\\"test_unsharded_keyspace\\\",\\\"shard\\\":\\\"0\\\",\\\"gtid\\\":\\\"MySQL56/e03ece6c-4c04-11ec-8e20-0242ac110004:1-68\\\"}]\",\n        \"total_order\": 1,\n        \"data_collection_order\": 1\n      }\n}"
                            }
                          ],
                          "language": "json",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Value before the SMT processes the record"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "{\n    \"before\": {...}\n    \"after\": {...}\n    \"source\": {...}\n    \"transaction\": {\n        \"total_order\": 1,\n        \"data_collection_order\": 1\n      }\n}"
                            }
                          ],
                          "language": "json",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Value after the SMT processes the record"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
