              {
                "kind": "text",
                "value": " key is required. This key is configured under the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "bundle key"
                  }
                ],
                "kind": "xref",
                "target": "configure-ui.html"
              },
              {
                "kind": "text",
                "value": " of the ui category key in a playbook. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "url"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key accepts a URL or filesystem path from where Antora can locate and fetch the site’s UI bundle. The filesystem path must point to a ZIP archive or a local directory where the ZIP archive has been extracted."
              }
            ],
            "roles": [],
            "title": null
          },
