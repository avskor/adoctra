            "inlines": [
              {
                "kind": "text",
                "value": "A UI bundle is a "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ZIP archive"
                  }
                ],
                "kind": "link",
                "target": "https://en.wikipedia.org/wiki/Zip_(file_format)"
              },
              {
                "kind": "text",
                "value": " or directory that contains one or more UIs for a site. The only required file in the UI bundle is the default layout for pages (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "layouts/default.hbs"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": ") (and, if the 404 page is enabled, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "layouts/404.hbs"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": " as well). Antora automatically fetches and loads a UI bundle when generating a site."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
