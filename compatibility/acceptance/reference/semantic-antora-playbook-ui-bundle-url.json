        "context": "section",
        "id": "url-key",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "url key"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the value of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "url"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is a remote URL, Antora downloads and caches the UI bundle the first time it runs. In this case, the target must be a ZIP archive."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ui:\n  bundle:\n    url: https://repo.org/path/to/a-ui-bundle.zip"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Remote UI bundle"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The UI bundle is cached based on the signature of the URL. On subsequent runs, Antora loads the bundle from the cache as long as the value of "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "url"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " remains unchanged. This saves Antora from having to download the bundle each time you generate your site."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When using a secure URL with a self-signed certificate, you will need to provide additional configuration in order for Node.js to recognize and accept that certificate. Refer to "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "using self-signed certificates"
                  }
                ],
                "kind": "xref",
                "target": "set-up-playbook.html#self-signed-certificates"
              },
              {
                "kind": "text",
                "value": " to learn how."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Antora won’t download the UI bundle again if it exists in the cache, even when "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "fetch"
                      }
                    ],
                    "kind": "xref",
                    "target": "runtime-fetch.html"
                  },
                  {
                    "kind": "text",
                    "value": " is enabled. If the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "url"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " value remains the same, but the archive it points to changes over time, the UI bundle needs to be identified as a snapshot to bypass this cache."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In order to retrieve UI bundle updates without changing the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "url"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " value, you need to enable the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "snapshot"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " key adjacent to the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "url"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " key. By default, snapshot is not enabled (set to "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "false"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "). When snapshot is set to "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "true"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", Antora will download the UI bundle whenever the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "fetch key"
                      }
                    ],
                    "kind": "xref",
                    "target": "runtime-fetch.html#fetch-key"
                  },
                  {
                    "kind": "text",
                    "value": " under the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "runtime"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " category of the playbook is enabled. The "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "fetch key"
                      }
                    ],
                    "kind": "xref",
                    "target": "runtime-fetch.html#fetch-key"
                  },
                  {
                    "kind": "text",
                    "value": " instructs Antora to retrieve updates (including the UI bundle snapshot)."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "ui:\n  bundle:\n    url: https://gitlab.com/antora/antora-ui-default/-/jobs/artifacts/HEAD/raw/build/ui-bundle.zip?job=bundle-stable\n    snapshot: true"
                  }
                ],
                "language": "yaml",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Remote UI bundle marked as a snapshot"
                  }
                ]
              },
              {
                "context": "admonition",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If you’re using Antora’s reference UI bundle, you should mark the bundle as a snapshot because its URL never changes."
                  }
                ],
                "roles": [],
                "title": null,
                "type": "tip"
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If you want to control when Antora retrieves updates, pass the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "--fetch"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " option when invoking the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "antora"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " command. To make this setting permanent, set the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "runtime.fetch"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " key in the playbook to "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "true"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "runtime:\n  fetch: true"
                  }
                ],
                "language": "yaml",
                "roles": [],
                "title": [
                  {
                    "kind": "text",
                    "value": "Fetch updates as persistent setting"
                  }
                ]
              },
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "The snapshot key is only required if you’re referring to a remote bundle (which Antora caches by default). If you’re referencing a bundle from the filesystem, Antora will always use the file specified."
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "snapshot",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Use a snapshot"
              }
            ]
          }
        ],
        "context": "section",
        "id": "remote-bundle",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Load a remote bundle"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "url"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key can reference a local UI bundle using an absolute or relative filesystem path."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ui:\n  bundle:\n    url: ./../docs-ui/build/ui-bundle.zip"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Relative UI bundle path"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "A relative path is expanded to an absolute path using the following rules:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If the first path segment is a tilde ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "~"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), the remaining path is resolved relative to the user’s home directory."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If the first path segment is a dot ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "."
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), the remaining path is resolved relative to the location of the playbook file."
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "If the first path segment is a tilde directly followed by a plus sign ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "~+"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "), or does not begin with an aforementioned prefix, the remaining path is resolved relative to the current working directory."
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s the path to the same UI bundle, but using an absolute path instead."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ui:\n  bundle:\n    url: /home/user/projects/docs-ui/build/ui-bundle.zip"
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Absolute UI bundle path"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s the path to the location where the UI bundle has been extracted (or it was organized with the same layout as an extracted archive)."
              }
            ],
