          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Here’s an example of an icon with a link that targets a separate window:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "icon:download[link=https://rubygems.org/downloads/whizbang-1.0.0.gem, window=_blank]"
