    "blocks": [
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "In addition to built-in icons, you can add icons anywhere in your content where macros are substituted using the icon macro. This page covers the anatomy of the icon macro, how the target is resolved, and what features it support (subject to the icon mode)."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The icon macro is an inline macro. Like other inline macros, its syntax follows the familiar pattern of the macro name and target separated by a colon followed by an attribute list enclosed in square brackets."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "icon:<target>[<attrlist>]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<target>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is the icon name or path. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "<attrlist>"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " specifies various named attributes to configure how the icon is displayed."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "For example:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "icon:heart[2x,role=red]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_anatomy",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Anatomy"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s an example that shows how to inserts an icon named "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "tags"
                  }
                ],
                "kind": "emphasis",
                "roles": []
              },
              {
                "kind": "text",
                "value": " in front of a list of tag names."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "icon:tags[] ruby, asciidoctor"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s how the HTML converter converts an icon macro when the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "icons"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute is not set or empty."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "<div class=\"paragraph\">\n  <p><span class=\"image\"><img src=\"./images/icons/tags.png\" alt=\"tags\"></span> ruby, asciidoctor</p>\n</div>"
              }
            ],
            "language": "html",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Result: HTML output"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Here’s how the DocBook converter converts an icon macro."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "<inlinemediaobject>\n  <imageobject>\n    <imagedata fileref=\"./images/icons/tags.png\"/>\n  </imageobject>\n  <textobject><phrase>tags</phrase></textobject>\n</inlinemediaobject> ruby, asciidoctor"
              }
            ],
            "language": "xml",
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When the image for an icon can’t be located in the icons directory, the AsciiDoc processor displays the icon macro’s alt (i.e. fallback) text."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "_example",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Example"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The target of the icon macro is an icon name (or path). How that target is resolved depends on the icon mode assigned to the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "icons attribute"
                  }
                ],
                "kind": "xref",
                "target": "icons.html#icons-attribute"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "The icon name will be enclosed in square brackets (e.g., "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "[heart]"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ")."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "text"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "The icon name will be resolved to a file in the "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "iconsdir"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " with the file extension specified by "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "icontype"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " (e.g., "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "./images/icons/heart.png"
                        }
                      ],
                      "kind": "emphasis",
                      "roles": [
                        "path"
                      ]
                    },
                    {
                      "kind": "text",
                      "value": ")."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "image"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "The icon name will be resolved to a glyph in an icon font (as mapped by a CSS class) (e.g., "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "fa fa-heart"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": ")."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "font"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you include a file extension in the image target, the icon macro will not work correctly when using the font icon mode (i.e., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "icons=font"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null,
            "type": "warning"
          }
        ],
        "context": "section",
        "id": "_how_the_icon_is_resolved",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "How the icon is resolved"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following attributes of the icon macro are shared for all icon modes."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "The role applied to the element that surrounds the icon."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "role"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "The title of the image displayed when the mouse hovers over it."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "title"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "The URI target used for the icon, which will wrap the converted icon in a link."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "link"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [],
                  "checkbox": null,
                  "inlines": [
                    {
                      "kind": "text",
                      "value": "The target window of the link (when the "
                    },
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "link"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    },
                    {
                      "kind": "text",
                      "value": " attribute is specified)."
                    }
                  ]
                },
                "terms": [
                  [
                    {
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "window"
                        }
                      ],
                      "kind": "monospace",
                      "roles": []
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Here’s an example of an icon that uses a role to specify the color."
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "listing",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "icon:tags[role=blue] ruby, asciidoctor"
                  }
                ],
                "language": "asciidoc",
                "roles": [],
                "title": null
              }
            ],
            "context": "section",
            "id": "_role",
            "level": 2,
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Role"
              }
