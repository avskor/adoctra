{
  "semantics": {
    "attributes": {
      "final": {},
      "header": {}
    },
    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Test engines may encounter issues during test discovery. For example, the declaration of a test class or method may be invalid. To avoid such issues from going unnoticed, the JUnit Platform provides a "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "mechanism for test engines"
              }
            ],
            "kind": "xref",
            "target": "advanced-topics/engines.html#discovery-issues"
          },
          {
            "kind": "text",
            "value": " to report them with different severity levels:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "dlist",
        "id": null,
        "items": [
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "Indicates that the engine encountered something that could be potentially problematic, but could also happen due to a valid setup or configuration."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "INFO"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "Indicates that the engine encountered something that is problematic and might lead to unexpected behavior or will be removed or changed in a future release."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "WARNING"
                }
              ]
            ]
          },
          {
            "description": {
              "blocks": [],
              "checkbox": null,
              "inlines": [
                {
                  "kind": "text",
                  "value": "Indicates that the engine encountered something that is definitely problematic and will lead to unexpected behavior."
                }
              ]
            },
            "terms": [
              [
                {
                  "kind": "text",
                  "value": "ERROR"
                }
              ]
            ]
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "If an engine reports an issue with a severity equal to or higher than a configurable "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "critical"
              }
            ],
            "kind": "emphasis",
            "roles": []
          },
          {
            "kind": "text",
            "value": " severity, its tests will not be executed. Instead, the engine will be reported as failed during execution with a "
          },
          {
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "DiscoveryIssueException"
                  }
                ],
                "kind": "xref",
                "target": "attachment$api/org.junit.platform.launcher/org/junit/platform/launcher/core/DiscoveryIssueException.html"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " listing all critical issues. Non-critical issues will be logged but will not prevent the engine from executing its tests. The "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "junit.platform.discovery.issue.severity.critical"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "configuration parameter"
              }
            ],
            "kind": "xref",
            "target": "running-tests/configuration-parameters.html"
          },
          {
            "kind": "text",
            "value": " can be used to set the critical severity level. Currently, the default value is "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ERROR"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " but it may be changed in a future release."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "To surface all discovery issues in your project, it is recommended to set the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "junit.platform.discovery.issue.severity.critical"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " configuration parameter to "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "INFO"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null,
        "type": "tip"
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "In addition, registered "
          },
          {
            "id": null,
            "inlines": [
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "LauncherDiscoveryListener"
                  }
                ],
                "kind": "xref",
                "target": "attachment$api/org.junit.platform.launcher/org/junit/platform/launcher/LauncherDiscoveryListener.html"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " implementations can receive discovery issues via the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "issueEncountered()"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " method. This allows IDEs and build tools to report issues to the user in a more user-friendly way. For example, IDEs may choose to display all issues in a list or table."
          }
        ],
        "roles": [],
        "title": null
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Discovery Issues"
      }
    ]
  }
}
