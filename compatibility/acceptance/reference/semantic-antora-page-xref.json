      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Let’s break down the xref macro and resource ID coordinates you need to create a cross reference to a page (the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "target page"
                  }
                ],
                "kind": "xref",
                "target": "#target"
              },
              {
                "kind": "text",
                "value": ") from a page that you’re currently editing (the "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "current page"
                  }
                ],
                "kind": "xref",
                "target": "#current"
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "olist",
            "id": null,
            "items": [
              {
                "blocks": [
                  {
                    "context": "listing",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "=== Console options\n\nSee the"
                      }
                    ],
                    "language": "asciidoc",
                    "roles": [],
                    "title": [
                      {
                        "kind": "text",
                        "value": "satellites.adoc (current page)"
                      }
                    ]
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In your IDE or text editor, open the page where you want to create a cross reference. For this step and the subsequent steps, let’s assume you’ve opened the file "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "satellites.adoc"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": [
                      "path"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": ". "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "satellites.adoc"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": [
                      "path"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": " is the current page."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "listing",
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "=== Console options\n\nSee the "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "xref:"
                          }
                        ],
                        "kind": "strong",
                        "roles": []
                      }
                    ],
                    "language": null,
                    "roles": [],
                    "title": [
                      {
                        "kind": "text",
                        "value": "satellites.adoc (current page)"
                      }
                    ]
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "In the current page, select the location in the content flow where you want the link to the target page to be displayed. Enter the name of the xref macro followed by one colon, "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "xref:"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "blocks": [
                      {
                        "context": "listing",
                        "id": "ex-target",
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "=== Console options\n\nSee the xref:"
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "modes.adoc"
                              }
                            ],
                            "kind": "strong",
                            "roles": []
                          }
                        ],
                        "language": null,
                        "roles": [],
                        "title": [
                          {
                            "kind": "text",
                            "value": "satellites.adoc (current page)"
                          }
                        ]
                      },
                      {
                        "context": "paragraph",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "The file coordinate for the "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "modes.adoc"
                              }
                            ],
                            "kind": "emphasis",
                            "roles": [
                              "path"
                            ]
                          },
                          {
                            "kind": "text",
                            "value": " page is "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "modes.adoc"
                              }
                            ],
                            "kind": "monospace",
                            "roles": []
                          },
                          {
                            "kind": "text",
                            "value": ". The target page’s file coordinate consists solely of its filename and file extension because it’s stored at the root of the "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "pages"
                              }
                            ],
                            "kind": "emphasis",
                            "roles": [
                              "path"
                            ]
                          },
                          {
                            "kind": "text",
                            "value": " directory."
                          }
                        ],
                        "roles": [],
                        "title": null
                      },
                      {
                        "context": "admonition",
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "The resource ID for "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "modes.adoc"
                              }
                            ],
                            "kind": "emphasis",
                            "roles": [
                              "path"
                            ]
                          },
                          {
                            "kind": "text",
                            "value": " doesn’t include the "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "page$"
                              }
                            ],
                            "kind": "monospace",
                            "roles": []
                          },
                          {
                            "kind": "text",
                            "value": " family coordinate. The xref macro assumes the family coordinate is "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "page$"
                              }
                            ],
                            "kind": "monospace",
                            "roles": []
                          },
                          {
                            "kind": "text",
                            "value": " when it isn’t specified."
                          }
                        ],
                        "roles": [],
                        "title": null,
                        "type": "note"
                      }
                    ],
                    "context": "open",
                    "id": null,
                    "roles": [],
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Assign the resource ID of the target page to the xref macro. In "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "Example 3"
                      }
                    ],
                    "kind": "xref",
