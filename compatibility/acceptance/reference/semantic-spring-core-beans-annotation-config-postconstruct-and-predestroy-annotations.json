        "inlines": [
          {
            "kind": "text",
            "value": "The "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "CommonAnnotationBeanPostProcessor"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " not only recognizes the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Resource"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation but also the JSR-250 lifecycle annotations: "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "jakarta.annotation.PostConstruct"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "jakarta.annotation.PreDestroy"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ". Introduced in Spring 2.5, the support for these annotations offers an alternative to the lifecycle callback mechanism described in "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "initialization callbacks"
              }
            ],
            "kind": "xref",
            "target": "core/beans/factory-nature.html#beans-factory-lifecycle-initializingbean"
          },
          {
            "kind": "text",
            "value": " and "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "destruction callbacks"
              }
            ],
            "kind": "xref",
            "target": "core/beans/factory-nature.html#beans-factory-lifecycle-disposablebean"
          },
          {
            "kind": "text",
            "value": ". Provided that the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "CommonAnnotationBeanPostProcessor"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " is registered within the Spring "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "ApplicationContext"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ", a method carrying one of these annotations is invoked at the same point in the lifecycle as the corresponding Spring lifecycle interface method or explicitly declared callback method. In the following example, the cache is pre-populated upon initialization and cleared upon destruction:"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "dlist",
            "id": null,
            "items": [
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "public class CachingMovieLister {\n\n\t@PostConstruct\n\tpublic void populateMovieCache() {\n\t\t// populates the movie cache upon initialization...\n\t}\n\n\t@PreDestroy\n\tpublic void clearMovieCache() {\n\t\t// clears the movie cache upon destruction...\n\t}\n}"
                        }
                      ],
                      "language": "java",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Java"
                    }
                  ]
                ]
              },
              {
                "description": {
                  "blocks": [
                    {
                      "context": "listing",
                      "id": null,
                      "inlines": [
                        {
                          "kind": "text",
                          "value": "class CachingMovieLister {\n\n\t@PostConstruct\n\tfun populateMovieCache() {\n\t\t// populates the movie cache upon initialization...\n\t}\n\n\t@PreDestroy\n\tfun clearMovieCache() {\n\t\t// clears the movie cache upon destruction...\n\t}\n}"
                        }
                      ],
                      "language": "kotlin",
                      "roles": [],
                      "title": null
                    }
                  ],
                  "checkbox": null,
                  "inlines": []
                },
                "terms": [
                  [
                    {
                      "kind": "text",
                      "value": "Kotlin"
                    }
                  ]
                ]
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "example",
        "id": null,
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "For details about the effects of combining various lifecycle mechanisms, see "
          },
          {
            "inlines": [
              {
                "kind": "text",
                "value": "Combining Lifecycle Mechanisms"
              }
            ],
            "kind": "xref",
            "target": "core/beans/factory-nature.html#beans-factory-lifecycle-combined-effects"
          },
          {
            "kind": "text",
            "value": "."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Like "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@Resource"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@PostConstruct"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "@PreDestroy"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " annotation types were a part of the standard Java libraries from JDK 6 to 8. However, the entire "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "javax.annotation"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " package got separated from the core Java modules in JDK 9 and eventually removed in JDK 11. As of Jakarta EE 9, the package lives in "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "jakarta.annotation"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " now. If needed, the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "jakarta.annotation-api"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " artifact needs to be obtained via Maven Central now, simply to be added to the application’s classpath like any other library."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
