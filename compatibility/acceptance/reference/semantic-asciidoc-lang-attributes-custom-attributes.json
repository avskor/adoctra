            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Although uppercase characters are permitted in an attribute name, the name is converted to lowercase before being stored. For example, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "URL"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " and "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Url"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " are treated as "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "url"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ". A best practice is to only use lowercase letters in the name and avoid starting the name with a number."
              }
            ],
            "roles": [],
            "title": null
          },
