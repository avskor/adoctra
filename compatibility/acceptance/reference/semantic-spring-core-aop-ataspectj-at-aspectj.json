    "blocks": [
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "With @AspectJ support enabled, any bean defined in your application context with a class that is an @AspectJ aspect (has the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Aspect"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation) is automatically detected by Spring and used to configure Spring AOP. The next two examples show the minimal steps required for a not-very-useful aspect."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The first of the two examples shows a regular bean definition in the application context that points to a bean class that is annotated with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Aspect"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ":"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./ApplicationConfiguration[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "The second of the two examples shows the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "NotVeryUsefulAspect"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " class definition, which is annotated with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Aspect"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ":"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "include-code::./NotVeryUsefulAspect[tag=snippet,indent=0]"
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "paragraph",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "Aspects (classes annotated with "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Aspect"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": ") can have methods and fields, the same as any other class. They can also contain pointcut, advice, and introduction (inter-type) declarations."
          }
        ],
        "roles": [],
        "title": null
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "You can register aspect classes as regular beans in your Spring XML configuration, via "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Bean"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " methods in "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Configuration"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " classes, or have Spring autodetect them through classpath scanning — the same as any other Spring-managed bean. However, note that the "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Aspect"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation is not sufficient for autodetection in the classpath. For that purpose, you need to add a separate "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Component"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation (or, alternatively, a custom stereotype annotation that qualifies, as per the rules of Spring’s component scanner)."
          }
        ],
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Autodetecting aspects through component scanning"
          }
        ],
        "type": "note"
      },
      {
        "context": "admonition",
        "id": null,
        "inlines": [
          {
            "kind": "text",
            "value": "In Spring AOP, aspects themselves cannot be the targets of advice from other aspects. The "
          },
          {
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "@Aspect"
              }
            ],
            "kind": "monospace",
            "roles": []
          },
          {
            "kind": "text",
            "value": " annotation on a class marks it as an aspect and, hence, excludes it from auto-proxying."
          }
        ],
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Advising aspects with other aspects?"
          }
        ],
        "type": "note"
      }
    ],
    "outline": null,
    "title": [
      {
        "kind": "text",
        "value": "Declaring an Aspect"
      }
    ]
  }
}
