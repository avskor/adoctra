                    "kind": "xref",
                    "target": "playbook:urls-latest-version-segment.html"
                  },
                  {
                    "kind": "text",
                    "value": " or "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "latest_prerelease_version_segment key"
                      }
                    ],
                    "kind": "xref",
                    "target": "playbook:urls-latest-prerelease-version-segment.html"
                  },
                  {
                    "kind": "text",
                    "value": " is set in the playbook, unless the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "latest_version_segment_strategy"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " is "
                  },
                  {
                    "id": null,
