            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Sometimes the project or process you’re documenting isn’t versioned. For example, hosted technology services and team handbooks may only need their content to represent how the service or process works as of right now. This is where the reserved version value of a tilde, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "~"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", comes into play."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "To define a component version that doesn’t have a version, assign a tilde, "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "~"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "version"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "~"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " is shorthand for the value "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "null"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", which has the same effect."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "name: component-name\nversion: ~ "
              },
              {
                "guard": "# ",
                "icons": null,
                "id": "CO1-1",
                "kind": "callout",
                "number": "1",
                "src": "",
                "xml": false
              }
            ],
            "language": "yaml",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "antora.yml for a versionless component version"
              }
            ]
          },
          {
            "context": "colist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "coids": [
                  "CO1-1"
                ],
                "icons": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "On a new line, type the key "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "version"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": ", directly followed by a colon and a blank space ("
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": ": "
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "). Then enter the value "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "~"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": "."
                  }
                ],
                "src": ""
              }
            ],
            "roles": [],
            "style": "arabic",
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Antora doesn’t apply the same behavior and output rules to an versionless component version that it does to a component version with a named or semantic version. For example, Antora doesn’t include the version segment in the publishable resource URLs of an versionless component version (e.g., "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "/component-name/module-name/page-name.html"
                  }
                ],
                "kind": "emphasis",
                "roles": [
                  "path"
                ]
              },
              {
                "kind": "text",
                "value": ")."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "assign-to-the-version-key",
        "level": 1,
        "roles": [],
        "title": [
          {
            "kind": "text",
            "value": "Assign ~ to the version key"
          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "version"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is required for a component version since versioning is central to how Antora works. The behavior and output rules that are influenced by the version are described in "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "How Antora uses version"
                  }
                ],
                "kind": "xref",
                "target": "component-version-key.html#usage"
              },
              {
                "kind": "text",
                "value": ". However, Antora accounts for the fact that some components are versionless or have an empty component version co-located with non-empty component versions. When the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "version"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " key is assigned "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "~"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ", defining the component version as versionless, Antora:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "ulist",
            "id": null,
            "items": [
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "sorts the versionless component version above "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "other versions that belong to the same component"
                      }
                    ],
                    "kind": "xref",
                    "target": "how-component-versions-are-sorted.html"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "identifies it as the "
                  },
                  {
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "latest version of a component"
                      }
                    ],
                    "kind": "xref",
                    "target": "how-component-versions-are-sorted.html#latest-version"
                  },
                  {
                    "kind": "text",
                    "value": " or, if the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "prerelease"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " key is set, as the latest prerelease version of a component"
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "ulist",
                    "id": null,
                    "items": [
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "the "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "display_version"
                              }
                            ],
                            "kind": "monospace",
                            "roles": []
                          },
                          {
                            "kind": "text",
                            "value": " key is assigned a value in "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "antora.yml"
                              }
                            ],
                            "kind": "emphasis",
                            "roles": [
                              "path"
                            ]
                          },
                          {
                            "kind": "text",
                            "value": ", or"
                          }
                        ]
                      },
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "the "
                          },
                          {
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "prerelease key is assigned an identifier"
                              }
                            ],
                            "kind": "xref",
                            "target": "component-prerelease.html#identifier"
                          },
                          {
                            "kind": "text",
                            "value": " and the "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "display_version"
                              }
                            ],
                            "kind": "monospace",
                            "roles": []
                          },
                          {
                            "kind": "text",
                            "value": " key isn’t set in "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "antora.yml"
                              }
                            ],
                            "kind": "emphasis",
                            "roles": [
                              "path"
                            ]
                          },
                          {
                            "kind": "text",
                            "value": "; at runtime, Antora assigns the identifier to the "
                          },
                          {
                            "id": null,
                            "inlines": [
                              {
                                "kind": "text",
                                "value": "display_version"
                              }
                            ],
                            "kind": "monospace",
                            "roles": []
                          },
                          {
                            "kind": "text",
                            "value": " key"
                          }
                        ]
                      }
                    ],
                    "roles": [],
                    "style": null,
                    "title": null
                  }
                ],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "assigns the fallback value "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "default"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  },
                  {
                    "kind": "text",
                    "value": " to the "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "display_version"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
