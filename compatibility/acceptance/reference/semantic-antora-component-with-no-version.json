                  {
                    "kind": "text",
                    "value": " key at runtime for display purposes in the UI menus, except when:"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "doesn’t add a "
