                      {
                        "kind": "text",
                        "value": "redirect:from"
                      }
                    ],
                    "kind": "monospace",
                    "roles": []
                  }
                ]
              }
            ],
            "roles": [],
            "style": null,
            "title": null
          },
          {
            "blocks": [
              {
                "context": "paragraph",
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "When a component version is defined as versionless:"
                  }
                ],
                "roles": [],
                "title": null
              },
              {
                "context": "ulist",
                "id": null,
                "items": [
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "the reserved version value, "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "~"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " or "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "null"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": ", is coerced into and stored as an empty string internally"
                      }
                    ]
                  },
                  {
                    "blocks": [],
                    "checkbox": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "a version segment isn’t added to "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "pub.url"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      },
                      {
                        "kind": "text",
                        "value": " or "
                      },
                      {
                        "id": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "out.path"
                          }
                        ],
                        "kind": "monospace",
                        "roles": []
                      }
                    ]
                  }
                ],
                "roles": [],
                "style": null,
