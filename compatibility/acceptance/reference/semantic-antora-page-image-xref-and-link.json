        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "You can create a link from an image to a page, attachment, image, or element by assigning the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "xref"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute to an inline or block image macro."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "xref"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " element attribute can be set in the attribute list of block and inline image macros. The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "xref"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute is optional. It’s structured and behaves the same way regardless of whether you assign it to a block image macro or inline image macro."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "xref"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute accepts the resource ID of a publishable resource—​a page, attachment, or image—​as a value."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-resource-base",
            "inlines": [
              {
                "kind": "text",
                "value": "image::an-image.jpg[xref=version@component:module:family$file.ext]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Set the xref attribute and assign it a resource ID"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "It also accepts the ID of an element that’s specified in the current page. The element ID must be prefixed with the hash symbol ("
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "#"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": ") when assigned to the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "xref"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-element-base",
            "inlines": [
              {
                "kind": "text",
                "value": "image::an-image.gif[xref=#fragment]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Set the xref attribute and assign is an element ID"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "When your site is published and a visitor selects the embedded image, they’ll be linked to the URL of the published resource or jump to the anchor in the current published page that corresponds to the specified element ID."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "xref"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " attribute in a named attribute. If you set positional attributes, such as alt text, width, or height, on the image macro, assign them in the attribute list before setting the "
              },
              {
                "id": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "xref"
                  }
                ],
                "kind": "monospace",
                "roles": []
              },
              {
                "kind": "text",
                "value": " or any other named attributes."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": "ex-attributes-base",
            "inlines": [
              {
                "kind": "text",
                "value": "image:an-image.svg[The image alt text,xref=version@component:module:family$file.ext,title=\"A tooltip for the image\"]"
              }
            ],
            "language": "asciidoc",
            "roles": [],
            "title": [
              {
                "kind": "text",
                "value": "Optional positional and named attributes assigned to an image macro"
              }
            ]
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Positional and named element attributes are separated by commas in the attribute list of the image macros."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
