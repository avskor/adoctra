                "inlines": [
                  {
                    "kind": "text",
                    "value": "resource ID coordinates"
                  }
                ],
                "kind": "xref",
                "target": "resource-id-coordinates.html"
              },
              {
                "kind": "text",
                "value": " you need to specify depends on the component version and module of the target page in relation to the current page."
