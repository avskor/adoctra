                  {
                    "kind": "text",
                    "value": " When running tests via one of the tools provided by the JUnit Platform you can specify configuration parameters as follows:"
                  }
                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
