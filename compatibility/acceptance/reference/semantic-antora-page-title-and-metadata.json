            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "If you want the text formatting to be present in the page title, but not in the navigation or other cross references to the page, you can set the "
