                },
                "target": "https://highlightjs.org/"
              },
              {
                "kind": "text",
                "value": " is a popular client-side syntax highlighter that supports a broad range of "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "languages"
                  }
                ],
                "kind": "link",
                "metadata": {
                  "rel": "noopener",
                  "window": "_blank"
                },
                "target": "https://highlightjs.org/download/"
              },
              {
                "kind": "text",
                "value": "."
              }
            ],
            "roles": [],
            "title": null
          }
        ],
