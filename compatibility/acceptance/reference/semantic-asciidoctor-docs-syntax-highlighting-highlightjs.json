              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Download and unpack the zip into a folder called "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
