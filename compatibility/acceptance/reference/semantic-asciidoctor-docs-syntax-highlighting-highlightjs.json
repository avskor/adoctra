                    "inlines": [
                      {
                        "kind": "text",
                        "value": "highlight/styles/github.min.css"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": [
                      "path"
                    ]
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "context": "ulist",
                    "id": null,
                    "items": [
                      {
                        "blocks": [],
                        "checkbox": null,
                        "inlines": [
                          {
                            "kind": "text",
                            "value": "Alternatively, you can pass the "
                          },
