                ]
              },
              {
                "blocks": [],
                "checkbox": null,
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Rename "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "highlight/highlight.pack.js"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": [
                      "path"
                    ]
                  },
                  {
                    "kind": "text",
                    "value": " to "
                  },
                  {
                    "id": null,
                    "inlines": [
                      {
                        "kind": "text",
                        "value": "highlight/highlight.min.js"
                      }
                    ],
                    "kind": "emphasis",
                    "roles": [
                      "path"
                    ]
                  }
                ]
              },
              {
                "blocks": [
                  {
