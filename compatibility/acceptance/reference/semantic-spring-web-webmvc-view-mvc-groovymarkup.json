          }
        ]
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "Unlike traditional template engines, Groovy Markup relies on a DSL that uses a builder syntax. The following example shows a sample template for an HTML page:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "yieldUnescaped '<!DOCTYPE html>'\nhtml(lang:'en') {\n\thead {\n\t\tmeta('http-equiv':'\"Content-Type\" content=\"text/html; charset=utf-8\"')\n\t\ttitle('My page')\n\t}\n\tbody {\n\t\tp('This is an example of HTML contents')\n\t}\n}"
              }
            ],
            "language": "groovy",
            "roles": [],
            "title": null
          }
        ],
