                "kind": "text",
                "value": "The "
              },
              {
                "inlines": [
                  {
                    "kind": "text",
                    "value": "Groovy Markup Template Engine"
                  }
                ],
                "kind": "link",
                "target": "https://groovy-lang.org/templating.html#_the_markuptemplateengine"
              },
              {
                "kind": "text",
                "value": " is primarily aimed at generating XML-like markup (XML, XHTML, HTML5, and others), but you can use it to generate any text-based content. The Spring Framework has a built-in integration for using Spring MVC with Groovy Markup."
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "admonition",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The Groovy Markup Template engine requires Groovy 2.3.1+."
              }
            ],
            "roles": [],
            "title": null,
            "type": "note"
          }
        ],
        "context": "preamble",
        "id": null,
        "outline": null,
        "roles": [],
        "title": null
      },
      {
        "blocks": [
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following example shows how to configure the Groovy Markup Template Engine:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "blocks": [
              {
                "context": "dlist",
                "id": null,
                "items": [
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Configuration\n@EnableWebMvc\npublic class WebConfig implements WebMvcConfigurer {\n\n\t@Override\n\tpublic void configureViewResolvers(ViewResolverRegistry registry) {\n\t\tregistry.groovy();\n\t}\n\n\t// Configure the Groovy Markup Template Engine...\n\n\t@Bean\n\tpublic GroovyMarkupConfigurer groovyMarkupConfigurer() {\n\t\tGroovyMarkupConfigurer configurer = new GroovyMarkupConfigurer();\n\t\tconfigurer.setResourceLoaderPath(\"/WEB-INF/\");\n\t\treturn configurer;\n\t}\n}"
                            }
                          ],
                          "language": "java",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Java"
                        }
                      ]
                    ]
                  },
                  {
                    "description": {
                      "blocks": [
                        {
                          "context": "listing",
                          "id": null,
                          "inlines": [
                            {
                              "kind": "text",
                              "value": "@Configuration\n@EnableWebMvc\nclass WebConfig : WebMvcConfigurer {\n\n\toverride fun configureViewResolvers(registry: ViewResolverRegistry) {\n\t\tregistry.groovy()\n\t}\n\n\t// Configure the Groovy Markup Template Engine...\n\n\t@Bean\n\tfun groovyMarkupConfigurer() = GroovyMarkupConfigurer().apply {\n\t\tresourceLoaderPath = \"/WEB-INF/\"\n\t}\n}"
                            }
                          ],
                          "language": "kotlin",
                          "roles": [],
                          "title": null
                        }
                      ],
                      "checkbox": null,
                      "inlines": []
                    },
                    "terms": [
                      [
                        {
                          "kind": "text",
                          "value": "Kotlin"
                        }
                      ]
                    ]
                  }
                ],
                "roles": [],
                "title": null
              }
            ],
            "context": "example",
            "id": null,
            "roles": [],
            "title": null
          },
          {
            "context": "paragraph",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "The following example shows how to configure the same in XML:"
              }
            ],
            "roles": [],
            "title": null
          },
          {
            "context": "listing",
            "id": null,
            "inlines": [
              {
                "kind": "text",
                "value": "<mvc:annotation-driven/>\n\n<mvc:view-resolvers>\n\t<mvc:groovy/>\n</mvc:view-resolvers>\n\n<!-- Configure the Groovy Markup Template Engine... -->\n<mvc:groovy-configurer resource-loader-path=\"/WEB-INF/\"/>"
              }
            ],
            "language": "xml",
            "roles": [],
            "title": null
          }
        ],
        "context": "section",
        "id": "mvc-view-groovymarkup-configuration",
        "level": 1,
